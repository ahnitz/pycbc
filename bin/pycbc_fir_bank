#!/usr/bin/env python
import os
# Default to single-threaded numerical libraries (one process per core), but
# respect anything the user has already exported.
for _var in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
             "VECLIB_MAXIMUM_THREADS", "NUMEXPR_NUM_THREADS"):
    os.environ.setdefault(_var, "1")
os.environ.setdefault("HDF5_USE_FILE_LOCKING", "FALSE")

import argparse
import hashlib
import logging
import multiprocessing as mp
import sys
from collections import defaultdict

import numpy as np
import scipy.linalg
from scipy.linalg import solve_toeplitz
from scipy.sparse.linalg import LinearOperator, lsqr
from tqdm import tqdm

import pycbc
import pycbc.psd
from pycbc.filter import match, sigma
from pycbc.types import TimeSeries
from pycbc.waveform.bank import FilterBank, correction_basis

mp.set_start_method('fork', force=True) 

# --- GLOBAL WORKER DATA (set by initializer) ---
g_coarse_waveforms = None
g_coarse_sigmasq = None
g_coarse_tau0 = None
g_fine_bank = None
g_fine_tau0 = None
g_psd = None
g_args = None
# numpy views used by the fast zero-lag verification / fit-problem code
g_coarse_np = None
g_coarse_ss = None
g_psd_np = None
g_inv_psd = None
g_kslice = None
g_nfft = None
g_freqs = None
g_delta_f = None
g_band_mask = None
g_correction_basis = None
g_correction_band = None

def init_worker(coarse_waveforms, fine_bank, psd, args_namespace):
    """
    Initializer function for each worker process.
    Sets read-only global variables.
    """
    global g_coarse_waveforms, g_coarse_sigmasq, g_coarse_tau0, g_fine_bank, g_fine_tau0, g_psd, g_args
    global g_coarse_np, g_coarse_ss, g_psd_np, g_inv_psd, g_kslice, g_nfft, g_freqs, g_delta_f, g_band_mask
    global g_correction_basis, g_correction_band
    try:
        import pycbc.filter.matchedfilter as mf
        import pycbc.filter.matchedfilter_cpu as mc
        mf.correlate = mc.correlate_numpy
    except Exception:
        pass
    from pycbc.filter.matchedfilter import get_cutoff_indices
    g_coarse_waveforms = coarse_waveforms
    g_fine_bank = fine_bank
    g_psd = psd
    g_args = args_namespace
    g_coarse_tau0 = getattr(args_namespace, '_coarse_tau0', None)
    g_fine_tau0 = getattr(args_namespace, '_fine_tau0', None)
    g_coarse_sigmasq = [pycbc.filter.sigmasq(h, psd=g_psd, low_frequency_cutoff=g_args.f_low) for h in coarse_waveforms]

    g_delta_f = float(psd.delta_f)
    g_psd_np = psd.numpy().astype(np.float64)
    g_nfft = 2 * (len(g_psd_np) - 1)
    g_freqs = np.arange(len(g_psd_np)) * g_delta_f
    g_inv_psd = np.zeros_like(g_psd_np)
    np.divide(1.0, g_psd_np, out=g_inv_psd, where=g_psd_np > 0)
    kmin, kmax = get_cutoff_indices(g_args.f_low, None, g_delta_f, g_nfft)
    g_kslice = slice(kmin, kmax)
    g_band_mask = (g_freqs >= g_args.f_low) & (g_freqs < g_args.sample_rate / 2.0) & (g_psd_np > 0)
    g_coarse_np = [h.numpy().astype(np.complex128) for h in coarse_waveforms]
    g_coarse_ss = [float(np.sum(np.abs(h[g_kslice]) ** 2 * g_inv_psd[g_kslice]))
                   for h in g_coarse_np]
    g_correction_basis, g_correction_band = correction_basis(
        len(g_psd_np), g_delta_f, g_args.f_low, 800.0)
    # Silence worker logging
    logging.getLogger('pycbc').setLevel(logging.CRITICAL + 1)

# --- 1. Filter Designer (Double Precision) ---
def design_optimal_real_filter(H_target_pos, valid_mask_pos, K_taps, weights_pos=None, reg_type='ridge', reg_val=1e-4,
                                peak_cap_factor=10.0, peak_bad_weight_fraction=1.0, peak_max_passes=3):
    """
    Designs a filter using regularized least squares.
    reg_type='ridge'      -> Minimizes energy (Standard)
    reg_type='derivative' -> Minimizes roughness (Smooth coefficients)

    Peak suppression (peak_cap_factor > 0): the fit above is only
    constrained inside valid_mask_pos (the analysis passband). Outside it,
    for templates poorly matched to their coarse reference, the achieved
    frequency response can develop an enormous, essentially unconstrained
    gain at a handful of bins -- harmless in exact arithmetic (that region
    gets multiplied by ~zero data content), but applying such a filter in
    single precision causes floating-point cancellation error large enough
    to produce wildly incorrect reconstructed SNR values. After the initial
    fit, any bin (evaluated across the FULL band, not just valid_mask_pos)
    whose magnitude exceeds peak_cap_factor times the filter's own median
    magnitude is nudged toward zero by adding extra rows to the same
    least-squares system -- weighted like a typical in-band fit row, not
    the (much larger) bin value itself, since matching that scale bleeds
    energy back into the passband -- and refitting, up to peak_max_passes
    times. Set peak_cap_factor to 0 or None to disable.
    """
    # 1. Setup Grid
    N_nyquist = len(H_target_pos)
    N_full = 2 * (N_nyquist - 1)
    f_grid_pos = np.arange(N_nyquist) / N_full

    # 2. Select Valid
    valid_indices = np.where(valid_mask_pos)[0]
    f_valid = f_grid_pos[valid_indices]
    b_complex = H_target_pos[valid_indices]

    # 3. Design Matrix A
    if K_taps % 2 == 1:
        k_idx = np.arange(-(K_taps-1)//2, (K_taps-1)//2 + 1)
    else:
        k_idx = np.arange(-K_taps//2 + 1, K_taps//2 + 1)

    A_complex = np.exp(-1j * 2 * np.pi * np.outer(f_valid, k_idx))

    # Weights
    if weights_pos is not None:
        w_valid = weights_pos[valid_indices]
        A_complex *= w_valid[:, None]
        b_complex *= w_valid
    else:
        w_valid = np.ones(len(valid_indices))

    # Real Stack
    A_real = np.vstack([A_complex.real, A_complex.imag])
    b_real = np.concatenate([b_complex.real, b_complex.imag])

    if reg_type == 'derivative':
        reg_matrix = np.zeros((K_taps - 1, K_taps))
        for i in range(K_taps - 1):
            reg_matrix[i, i] = 1
            reg_matrix[i, i+1] = -1
        reg_matrix *= np.sqrt(reg_val)
        target_reg = np.zeros(K_taps - 1)

    elif reg_type == 'composite':
        # 1. Ridge component (Size control)
        reg_ridge = np.eye(K_taps) * np.sqrt(reg_val * 0.5)

        # 2. Derivative component (Smoothness control)
        reg_deriv = np.zeros((K_taps - 1, K_taps))
        for i in range(K_taps - 1):
            reg_deriv[i, i] = 1
            reg_deriv[i, i+1] = -1
        reg_deriv *= np.sqrt(reg_val * 0.5)

        # Stack both penalties together
        reg_matrix = np.vstack([reg_ridge, reg_deriv])
        target_reg = np.zeros(K_taps + K_taps - 1)

    else: # Default 'ridge'
        reg_matrix = np.eye(K_taps) * np.sqrt(reg_val)
        target_reg = np.zeros(K_taps)

    A_final = np.vstack([A_real, reg_matrix])
    b_final = np.concatenate([b_real, target_reg])

    h_optimal, _, _, _ = scipy.linalg.lstsq(A_final, b_final, lapack_driver='gelss')

    n_peak_passes = 0
    n_bins_capped = 0
    if peak_cap_factor:
        A_full = np.exp(-1j * 2 * np.pi * np.outer(f_grid_pos, k_idx))
        positive_w = w_valid[w_valid > 0]
        typical_w = np.median(positive_w) if len(positive_w) else 1.0
        constrained_bins = set()
        cap = None
        for _pass in range(peak_max_passes):
            achieved = A_full @ h_optimal
            mag = np.abs(achieved)
            if cap is None:
                cap = peak_cap_factor * np.median(mag)
            bad = np.where(mag > cap)[0]
            n_bins_capped = len(bad)
            if n_bins_capped == 0:
                break
            n_peak_passes += 1
            constrained_bins.update(bad.tolist())

            idxs = np.array(sorted(constrained_bins))
            f_bad = f_grid_pos[idxs]
            w_bad = peak_bad_weight_fraction * typical_w
            row = np.exp(-1j * 2 * np.pi * np.outer(f_bad, k_idx)) * w_bad
            extra_A = np.vstack([row.real, row.imag])
            extra_b = np.zeros(2 * len(idxs))

            A_aug = np.vstack([A_real, reg_matrix, extra_A])
            b_aug = np.concatenate([b_real, target_reg, extra_b])
            h_optimal, _, _, _ = scipy.linalg.lstsq(A_aug, b_aug, lapack_driver='gelss')

    return h_optimal, n_peak_passes, n_bins_capped


def _hermitian_corr(bins, values, nfft):
    """0.5 * nfft * ifft(F).real for the Hermitian F with F[b] = v, F[-b] = conj(v).

    Same as filling the full spectrum with np.add.at (DC / Nyquist counted
    twice) and inverse transforming, but via a single irfft of the half
    spectrum. `values` may be 1-D (len(bins)) or 2-D (n, len(bins)).
    """
    values = np.asarray(values)
    half = np.zeros(values.shape[:-1] + (nfft // 2 + 1,), dtype=np.complex128)
    half[..., bins] = values
    half[..., 0] *= 2.0
    half[..., -1] *= 2.0
    return (0.5 * nfft) * np.fft.irfft(half, n=nfft, axis=-1)


def design_fft_toeplitz_filter(target, valid_mask, n_taps, weights, reg_val,
                                peak_cap_factor=10.0, peak_bad_weight_fraction=1.0,
                                peak_max_passes=3, cap_mode='inband', toeplitz_solve=None):
    """Fit a real FIR on a fine grid using direct Levinson-Durbin Toeplitz inversion.

    The normal equations (A^T W^2 A + lambda I) h = A^T W^2 d form an exact
    symmetric Toeplitz system, solvable in O(n_taps^2) via Levinson-Durbin
    without dense matrix storage or iterative LSQR passes.

    Peak suppression (peak_cap_factor > 0) adds zero-target rows for bins
    whose achieved gain exceeds the cap, and refits.

    cap_mode='inband' (default): only bins *outside* the fitted band are
        constrained, and the cap is peak_cap_factor times the filter's
        weighted RMS gain over the fitted band. Inside the band the target
        itself decides the gain, so constraining it would only fight the fit.
    cap_mode='median' (legacy): any bin may be constrained, cap relative to
        the median gain over the full band.
    """
    nfft = 2 * (len(target) - 1)
    if n_taps >= nfft:
        raise ValueError('FIR tap count must be below fit-grid FFT length')
    if reg_val < 0:
        raise ValueError('regularization must be nonnegative')
    center = n_taps // 2
    positions = (np.arange(n_taps) - center) % nfft
    base_bins = np.flatnonzero(valid_mask)
    base_weights = np.asarray(weights[base_bins], dtype=np.float64)
    base_target = np.asarray(target[base_bins], dtype=np.complex128)
    if len(base_bins) == 0 or not np.any(base_weights > 0):
        raise ValueError('FIR fit has no weighted fit bins')
    fitted = np.zeros(len(target), dtype=bool)
    fitted[base_bins] = True
    extra_bins = np.array([], dtype=int)
    typical = np.median(base_weights[base_weights > 0])
    cap = None
    n_passes = 0
    n_bad = 0
    for attempt in range(peak_max_passes + 1):
        bins = np.concatenate((base_bins, extra_bins))
        w = np.concatenate((base_weights,
                            np.full(len(extra_bins),
                                    peak_bad_weight_fraction * typical)))
        desired = np.concatenate((base_target,
                                  np.zeros(len(extra_bins), dtype=np.complex128)))

        r = _hermitian_corr(bins, w**2, nfft)[:n_taps].copy()
        r[0] += reg_val
        b = _hermitian_corr(bins, desired * (w**2), nfft)[positions]

        taps = (toeplitz_solve or solve_toeplitz)(r, b)
        if not peak_cap_factor:
            break
        waveform = np.zeros(nfft, dtype=np.float64)
        waveform[positions] = taps
        magnitudes = np.abs(np.fft.rfft(waveform))
        if cap_mode == 'median':
            if cap is None:
                cap = peak_cap_factor * np.median(magnitudes)
            bad = np.flatnonzero(magnitudes > cap)
        else:
            if cap is None:
                inband = np.sqrt(np.sum(base_weights**2 * magnitudes[base_bins]**2) /
                                 np.sum(base_weights**2))
                cap = peak_cap_factor * inband
            bad = np.flatnonzero((magnitudes > cap) & ~fitted)
        n_bad = len(bad)
        if not n_bad or attempt == peak_max_passes:
            break
        extra_bins = np.union1d(extra_bins, bad)
        n_passes += 1
    return taps, n_passes, n_bad


def design_fft_lsqr_filter(target, valid_mask, n_taps, weights, reg_val,
                           peak_cap_factor=10.0, peak_bad_weight_fraction=1.0,
                           peak_max_passes=3, atol=1e-11, btol=1e-11, iter_lim=None):
    """Fit a long real FIR on a fine grid without a dense Vandermonde matrix.

    FFT and inverse FFT implement the design matrix and its exact real-valued
    adjoint. This permits an upper fit with thousands of taps and a grid
    finer than the lower bank's, without cubic-time dense SVDs.
    """
    nfft = 2 * (len(target) - 1)
    if n_taps >= nfft:
        raise ValueError('FIR tap count must be below fit-grid FFT length')
    if reg_val < 0:
        raise ValueError('regularization must be nonnegative')
    center = n_taps // 2
    positions = (np.arange(n_taps) - center) % nfft
    base_bins = np.flatnonzero(valid_mask)
    base_weights = np.asarray(weights[base_bins], dtype=np.float64)
    base_target = np.asarray(target[base_bins], dtype=np.complex128)
    if len(base_bins) == 0 or not np.any(base_weights > 0):
        raise ValueError('upper FIR has no weighted fit bins')
    extra_bins = np.array([], dtype=int)
    typical = np.median(base_weights[base_weights > 0])
    cap = None
    n_passes = 0
    n_bad = 0
    for attempt in range(peak_max_passes + 1):
        bins = np.concatenate((base_bins, extra_bins))
        w = np.concatenate((base_weights,
                            np.full(len(extra_bins),
                                    peak_bad_weight_fraction * typical)))
        desired = np.concatenate((base_target,
                                  np.zeros(len(extra_bins), dtype=np.complex128)))
        ridge = np.sqrt(reg_val)

        def matvec(x):
            waveform = np.zeros(nfft, dtype=np.float64)
            waveform[positions] = x
            z = np.fft.fft(waveform)[bins] * w
            return np.concatenate((z.real, z.imag, ridge * x))

        def rmatvec(y):
            m = len(bins)
            freq = np.zeros(nfft, dtype=np.complex128)
            np.add.at(freq, bins, (y[:m] + 1j * y[m:2*m]) * w)
            return (np.fft.ifft(freq).real[positions] * nfft +
                    ridge * y[2*m:])

        operator = LinearOperator((2 * len(bins) + n_taps, n_taps),
                                  matvec=matvec, rmatvec=rmatvec,
                                  dtype=np.float64)
        rhs = np.concatenate(((desired * w).real, (desired * w).imag,
                              np.zeros(n_taps)))
        actual_iter_lim = iter_lim if iter_lim is not None else min(3000, 2 * n_taps)
        taps = lsqr(operator, rhs, atol=atol, btol=btol,
                    iter_lim=actual_iter_lim)[0]
        waveform = np.zeros(nfft, dtype=np.float64)
        waveform[positions] = taps
        response = np.fft.rfft(waveform)
        if not peak_cap_factor:
            break
        magnitudes = np.abs(response)
        if cap is None:
            cap = peak_cap_factor * np.median(magnitudes)
        bad = np.flatnonzero(magnitudes > cap)
        n_bad = len(bad)
        if not n_bad or attempt == peak_max_passes:
            break
        extra_bins = np.union1d(extra_bins, bad)
        n_passes += 1
    return taps, n_passes, n_bad

# --- 2. Verification (Double Precision) ---
def verify_filter_match(taps, h_ref, h_fine, psd, f_low, sample_rate=None, shift=0):
    """Check how well a designed FIR filter reconstructs the fine template.

    Applies `taps` to the coarse reference `h_ref` the way the search engine
    will (same circular tap layout) and compares the result to `h_fine`.

    Returns
    -------
    m : float
        Match between the reconstructed template and h_fine.
    sigmas : (float, float, float)
        sigma of h_ref, of the reconstruction, and of h_fine -- for sanity
        checking that reconstruction hasn't drastically changed the
        template's overall amplitude.
    """
    N = (len(h_ref) - 1) * 2
    K = len(taps)
    h_fir_time = np.zeros(N, dtype=np.float64)

    if K % 2 == 1: k_start = -(K - 1) // 2
    else: k_start = -K // 2 + 1
    indices = (np.arange(k_start, k_start + K) + N) % N
    h_fir_time[indices] = taps

    delta_t = 1.0 / (N * h_ref.delta_f)
    ts = TimeSeries(h_fir_time, delta_t=delta_t)
    H_fir = ts.to_frequencyseries(delta_f=h_ref.delta_f)

    if len(H_fir) > len(h_ref): H_fir = H_fir[:len(h_ref)]
    elif len(H_fir) < len(h_ref): H_fir.resize(len(h_ref))

    h_rec = h_ref * H_fir
    if shift != 0 and sample_rate is not None:
        freqs = h_rec.sample_frequencies.numpy()
        phase_corr = np.exp(-1j * 2 * np.pi * freqs * (1.0 / sample_rate) * shift)
        h_rec = h_rec * phase_corr

    s_rec = sigma(h_rec, psd=psd, low_frequency_cutoff=f_low)
    s_ref = sigma(h_ref, psd=psd, low_frequency_cutoff=f_low)
    s_fine = sigma(h_fine, psd=psd, low_frequency_cutoff=f_low)
    m, _ = match(h_fine, h_rec, psd=psd, low_frequency_cutoff=f_low)
    return m, (s_ref, s_rec, s_fine)

# --- 3. WORKER FUNCTION (Executes in parallel) ---
#
# Acceptance has two parts, and every tap count tried must pass both:
#
#   (i)  reconstruction accuracy: zero-lag, phase-maximised overlap between
#        the target template and (reference x FIR) >= --min-match, computed
#        with the float32 taps exactly as they will be stored;
#   (ii) downstream numerical niceness: the filter is applied in single
#        precision to a reference SNR series whose rounding noise covers the
#        whole band, so it must not have huge coefficients (--max-tap-value),
#        large gain outside the fitted band (--peak-cap-factor, relative to its
#        match-weighted in-band RMS gain) or, optionally, a large white-noise
#        gain (--max-noise-gain).
#
# The tap search returns the fewest taps that pass both.

def _positions(n_taps, nfft):
    return (np.arange(n_taps) - n_taps // 2) % nfft


def _snap(k, up=True, args=None):
    """Snap a tap count onto the odd grid min_taps + j * tap_granularity."""
    ns = args if args is not None else g_args
    gran = getattr(ns, 'tap_granularity', 8) if ns is not None else 8
    min_t = getattr(ns, 'min_taps', 15) if ns is not None else 15
    j = (k - min_t) / float(gran)
    j = int(np.ceil(j - 1e-9)) if up else int(np.floor(j + 1e-9))
    return min_t + max(j, 0) * gran


def _build_problem(c_idx, h_fine_np):
    """Fit target, masks and weights for parent c_idx (cached by caller)."""
    return _build_problem_ref(g_coarse_np[c_idx], g_coarse_ss[c_idx],
                              g_coarse_waveforms[c_idx], c_idx, h_fine_np)


def _build_problem_ref(h_ref, ref_ss, ref_fs, c_idx, h_fine_np, shared=False):
    """As _build_problem for an explicit parent (numpy array, |h|^2/S sum, series).

    shared=True marks a parent reused for many children: the normal-equation
    matrix then depends only on the parent (unless --ratio-cap masks differ),
    so _design reuses a cached factorisation for it.
    """
    band = g_band_mask.copy()
    ratio = np.zeros(len(h_ref), dtype=np.complex128)
    np.divide(h_fine_np, h_ref, out=ratio, where=np.abs(h_ref) > 0)
    ratio = np.nan_to_num(ratio, copy=False)
    w_match = np.zeros(len(h_ref), dtype=np.float64)
    np.divide(np.abs(h_ref) ** 2, g_psd_np, out=w_match, where=band)
    w_match = np.nan_to_num(w_match, copy=False)
    band[np.abs(ratio) > g_args.ratio_cap] = False
    if not band.any() or w_match[band].max() <= 0:
        return None
    # w_match = |h_ref|^2 / S is the weight the match error actually carries on
    # |H - D|^2. The least-squares row weight is w_match ** p, so the fitted
    # error weight is w_match ** (2p): p = 0.5 is match-consistent.
    w_match /= w_match[band].max()
    w_fit = w_match ** g_args.fit_weight_power

    shift = 0
    if g_args.enable_tap_centering:
        b = np.flatnonzero(band)
        phase = np.unwrap(np.angle(ratio[b]))
        gd = -np.gradient(phase, g_delta_f) / (2 * np.pi) * g_args.sample_rate
        wc = w_fit[b] ** 2
        if wc.sum() > 0:
            shift = int(np.round(np.sum(gd * wc) / np.sum(wc)))
    target = ratio * g_args.sample_rate
    if shift:
        target = target * np.exp(1j * 2 * np.pi * g_freqs * shift / g_args.sample_rate)
    return dict(c_idx=int(c_idx), h_ref=h_ref, target=target, band=band,
                w_fit=w_fit, w_match=w_match, shift=shift, ref_ss=ref_ss, ref_fs=ref_fs,
                shared=shared)


def _design(prob, n_taps, peak_cap_factor):
    d = g_args.dec_factor
    common = dict(peak_cap_factor=peak_cap_factor,
                  peak_bad_weight_fraction=g_args.peak_bad_weight_fraction,
                  peak_max_passes=g_args.peak_max_passes)
    solver = g_args.fit_solver
    if solver == 'toeplitz':
        return design_fft_toeplitz_filter(
            prob['target'][::d], prob['band'][::d], n_taps, prob['w_fit'][::d],
            g_args.regularization_magnitude, cap_mode=g_args.peak_cap_mode,
            toeplitz_solve=_toeplitz_solve_cached if prob.get('shared') else None, **common)
    if solver == 'fft-lsqr':
        return design_fft_lsqr_filter(
            prob['target'][::d], prob['band'][::d], n_taps, prob['w_fit'][::d],
            g_args.regularization_magnitude,
            atol=g_args.lsqr_atol, btol=g_args.lsqr_atol,
            iter_lim=g_args.lsqr_iter_lim, **common)
    return design_optimal_real_filter(
        prob['target'][::d], prob['band'][::d], n_taps,
        weights_pos=prob['w_fit'][::d], reg_type=g_args.regularization_type,
        reg_val=g_args.regularization_magnitude, **common)


def _response(taps):
    wave = np.zeros(g_nfft, dtype=np.float64)
    wave[_positions(len(taps), g_nfft)] = taps
    return np.fft.rfft(wave)


def _filter_metrics(H, taps, prob):
    """(max |tap|, out-of-band peak gain, white-noise gain).

    Gains are relative to the filter's match-weighted RMS gain over the fitted
    band, so they measure how much the filter amplifies content (rounding
    noise) that carries no signal, compared with how it treats the signal.
    """
    mag = np.abs(H)
    fb = prob['band']
    wm = prob['w_match'][fb]
    inband = np.sqrt(np.sum(wm * mag[fb] ** 2) / np.sum(wm))
    if inband <= 0:
        return float(np.max(np.abs(taps))), np.inf, np.inf
    oob = mag[~fb].max() / inband if (~fb).any() else 0.0
    noise_gain = np.sqrt(np.mean(mag ** 2)) / inband
    return float(np.max(np.abs(taps))), float(oob), float(noise_gain)


def _verify(H, prob, h_fine_np, fine_ss):
    """Zero-lag, phase-maximised overlap and (sigma_ref, sigma_rec, sigma_fine)."""
    # taps are fit to ratio * sample_rate; the engine response is rfft / SR
    H = H / g_args.sample_rate
    if prob['shift']:
        H = H * np.exp(-1j * 2 * np.pi * g_freqs * prob['shift'] / g_args.sample_rate)
    sl = g_kslice
    rec = prob['h_ref'][sl] * H[sl]
    ip = np.sum(np.conj(h_fine_np[sl]) * rec * g_inv_psd[sl])
    rec_ss = np.sum((rec.real ** 2 + rec.imag ** 2) * g_inv_psd[sl])
    m = abs(ip) / np.sqrt(rec_ss * fine_ss) if rec_ss > 0 else 0.0
    scale = 4.0 * g_delta_f
    ref_ss = prob['ref_ss']
    return float(m), (np.sqrt(scale * ref_ss), np.sqrt(scale * rec_ss),
                      np.sqrt(scale * fine_ss))


def _evaluate(prob, n_taps, h_fine, h_fine_np, fine_ss, stats, suppress=True):
    """Design at n_taps and run the full (accuracy + niceness) acceptance test."""
    taps, n_pp, n_bc = _design(prob, n_taps,
                               g_args.peak_cap_factor if suppress else 0)
    taps32 = np.asarray(taps, dtype=np.float32)
    H = _response(taps32.astype(np.float64))
    if suppress:
        stats['attempts'] += 1
        if n_pp:
            stats['suppressed'] += 1
    metrics = _filter_metrics(H, taps32, prob)
    if g_args.verify_mode == 'match':
        qa, sigmas = verify_filter_match(
            taps32.astype(np.float64), prob['ref_fs'], h_fine,
            g_psd, g_args.f_low, sample_rate=g_args.sample_rate, shift=prob['shift'])
    else:
        qa, sigmas = _verify(H, prob, h_fine_np, fine_ss)
    max_tap, oob, noise_gain = metrics
    ok = (qa >= g_args.min_match and np.isfinite(max_tap)
          and max_tap <= g_args.max_tap_value)
    if ok and g_args.peak_cap_factor and g_args.peak_cap_mode == 'inband':
        ok = oob <= g_args.peak_cap_factor * (1 + 1e-6)
    if ok and g_args.max_noise_gain is not None:
        ok = noise_gain <= g_args.max_noise_gain
    return ok, dict(c_idx=prob['c_idx'], n_taps=int(n_taps), qa=qa, taps=taps32,
                    sigmas=sigmas, n_pp=n_pp, n_bc=n_bc, shift=prob['shift'],
                    metrics=metrics)


def _min_taps(prob, k_cap, h_fine, h_fine_np, fine_ss, stats):
    """Fewest taps <= k_cap passing the acceptance test for one parent.

    Steps up a coarse ladder (--n-taps, + --tap-step) until a count passes,
    then (--tap-search bisect) bisects down to --tap-granularity between the
    last failing and first passing count. Returns (accepted_record or None,
    best_failed_record or None).
    """
    best_fail = None
    if k_cap < g_args.min_taps:
        return None, None
    ladder = []
    k = _snap(g_args.n_taps)
    while k <= k_cap:
        ladder.append(k)
        k = _snap(k + g_args.tap_step)
    top = k_cap if k_cap % 2 else k_cap - 1   # the cap itself is allowed (odd)
    if not ladder or ladder[-1] < top:
        ladder.append(top)
    lo, hi, hi_rec = None, None, None
    for k in ladder:
        ok, rec = _evaluate(prob, k, h_fine, h_fine_np, fine_ss, stats)
        if ok:
            hi, hi_rec = k, rec
            break
        if best_fail is None or rec['qa'] > best_fail['qa']:
            best_fail = rec
        lo = k
    if hi_rec is None:
        return None, best_fail
    if g_args.tap_search == 'bisect':
        gran = g_args.tap_granularity
        lo = lo if lo is not None else g_args.min_taps - gran
        while hi - lo > gran:
            mid = _snap((lo + hi) // 2, up=False)
            if mid <= lo:
                mid = lo + gran
            if mid >= hi:
                break
            ok, rec = _evaluate(prob, mid, h_fine, h_fine_np, fine_ss, stats)
            if ok:
                hi, hi_rec = mid, rec
            else:
                lo = mid
    return hi_rec, best_fail


def process_template(i, excluded=None):
    """Find the parent and FIR with the fewest taps that pass acceptance.

    Candidate parents are the --search-depth nearest in tau0 (never any in
    `excluded`). They are ranked
    either by how well a quick --n-taps fit reconstructs the template
    (--parent-selection min-taps) or by direct template match (direct-match).
    The top --parent-refine candidates each get the full minimum-tap search,
    capped below the best count found so far; the fewest taps wins. If none
    of them pass, the remaining candidates are tried in rank order.
    """
    h_fine = g_fine_bank[i].copy()
    h_fine_np = h_fine.numpy().astype(np.complex128)
    sl = g_kslice
    fine_ss = float(np.sum(np.abs(h_fine_np[sl]) ** 2 * g_inv_psd[sl]))
    stats = {'attempts': 0, 'suppressed': 0}

    allowed = np.arange(len(g_coarse_waveforms))
    if excluded:
        allowed = allowed[~np.isin(allowed, np.fromiter(excluded, dtype=int))]
    n_cand = min(len(allowed), g_args.search_depth)
    if g_coarse_tau0 is not None and g_fine_tau0 is not None:
        candidates = allowed[np.argsort(np.abs(g_coarse_tau0[allowed] - g_fine_tau0[i]))[:n_cand]]
    else:
        candidates = allowed

    problems = {}

    def problem(c):
        if c not in problems:
            problems[c] = _build_problem(c, h_fine_np)
        return problems[c]

    def direct_match(c):
        m, _ = match(h_fine, g_coarse_waveforms[c], psd=g_psd,
                     low_frequency_cutoff=g_args.f_low,
                     v1_norm=fine_ss * 4.0 * g_delta_f, v2_norm=g_coarse_sigmasq[c])
        return float(m)

    scores = {}
    for c in candidates:
        c = int(c)
        if problem(c) is None:
            continue
        if g_args.parent_selection == 'direct-match':
            scores[c] = direct_match(c)
        else:
            try:
                taps, _, _ = _design(problem(c), _snap(g_args.n_taps), 0)
                H = _response(np.asarray(taps, dtype=np.float32).astype(np.float64))
                scores[c] = _verify(H, problem(c), h_fine_np, fine_ss)[0]
            except Exception as e:
                logging.info('T%d parent %d probe failed: %s', i, c, e)
    ranked = sorted(scores, key=lambda c: scores[c], reverse=True)

    step = g_args.tap_granularity if g_args.tap_search == 'bisect' else g_args.tap_step
    best, best_fail = None, None
    for rank, c in enumerate(ranked):
        if best is not None and rank >= g_args.parent_refine:
            break
        cap = g_args.max_taps if best is None else best['n_taps'] - step
        try:
            rec, fail = _min_taps(problem(c), cap, h_fine, h_fine_np, fine_ss, stats)
        except Exception as e:
            logging.info('T%d parent %d failed: %s', i, c, e)
            continue
        if rec is not None and (best is None or rec['n_taps'] < best['n_taps']):
            best = rec
        if fail is not None and (best_fail is None or fail['qa'] > best_fail['qa']):
            best_fail = fail

    accepted = best is not None
    chosen = best if accepted else best_fail
    if chosen is None:
        return (i, -1.0, -1, -1.0, [], [], 0, 0, 0, stats['attempts'],
                stats['suppressed'], (np.nan, np.nan, np.nan), False)
    c = chosen['c_idx']
    coarse_match = scores[c] if g_args.parent_selection == 'direct-match' else direct_match(c)
    return (i, coarse_match, c, chosen['qa'], chosen['taps'], chosen['sigmas'],
            chosen['n_pp'], chosen['n_bc'], chosen['shift'], stats['attempts'],
            stats['suppressed'], chosen['metrics'], accepted)


def write_fir_groups(parent_group, all_results, match_dtype='float32'):
    """Write one parent-to-child edge using the existing FIR group layout."""
    results_by_parent = defaultdict(list)
    for i, result in enumerate(all_results):
        if result is not None and result[1] >= 0:
            results_by_parent[result[1]].append(result + (i,))

    comp = dict(shuffle=True, compression='gzip', compression_opts=9)
    tap_counts = []
    for parent_index, results in results_by_parent.items():
        group = parent_group.create_group(str(parent_index))
        n_group = len(results)
        counts = np.array([len(row[3]) for row in results], dtype=np.int32)
        max_taps = int(counts.max())
        taps = np.zeros((n_group, max_taps), dtype=np.float32)
        for j, row in enumerate(results):
            taps[j, :counts[j]] = np.asarray(row[3], dtype=np.float32)
        group.create_dataset('taps', data=taps, chunks=(n_group, max_taps), **comp)
        columns = (
            ('actual_tap_count', counts, 'int32'),
            ('fine_bank_index', [row[-1] for row in results], 'int32'),
            ('filter_match', [row[2] for row in results], match_dtype),
            ('coarse_match', [row[0] for row in results], 'float32'),
            ('sigmas', [row[4] for row in results], 'float32'),
            ('sample_shift', [row[5] if len(row) > 6 else 0 for row in results], 'int32'),
        )
        if all(len(row) > 7 and row[6] is not None for row in results):
            metrics = np.array([row[6] for row in results], dtype=np.float32)
            columns += (('max_tap', metrics[:, 0], 'float32'),
                        ('oob_gain', metrics[:, 1], 'float32'),
                        ('noise_gain', metrics[:, 2], 'float32'))
        for name, values, dtype in columns:
            group.create_dataset(name, data=np.asarray(values, dtype=dtype),
                                 chunks=True, **comp)
        tap_counts.append(counts)
    return np.concatenate(tap_counts) if tap_counts else np.array([], dtype=int)


def stored_row(result):
    """Worker result tuple -> row kept for writing (see write_fir_groups)."""
    (i, parent_match, parent, fit, taps, sigmas, _n_pp, _n_bc, shift,
     _attempts, _suppressed, metrics, _accepted) = result
    return (parent_match, parent, fit, taps, sigmas, shift, metrics)


def _process_excl(task):
    i, excluded = task
    return process_template(i, excluded)


def prune_parents(pool, results, n_processes, max_tap_growth=None, label='middle'):
    """Remove redundant parents (seeds) after assignment.

    Parents are visited from the smallest group up. A parent is removed when
    every one of its children can be re-fit from some other remaining parent
    and still pass the full acceptance test (including --max-taps); those
    children are then moved. With max_tap_growth, a removal is only accepted
    if the moved children's total taps grow by at most that fraction.
    `results` (stored rows) is updated in place; returns the removed parents.
    """
    groups = defaultdict(list)
    for i, row in enumerate(results):
        if row is not None and row[1] >= 0:
            groups[row[1]].append(i)
    removed = set()
    batch = max(4 * n_processes, 16)
    for parent in sorted(groups, key=lambda p: (len(groups[p]), p)):
        children = list(groups[parent])
        if not children:
            continue
        excluded = frozenset(removed | {parent})
        moved, ok = {}, True
        for start in range(0, len(children), batch):
            tasks = [(i, excluded) for i in children[start:start + batch]]
            for res in pool.imap_unordered(_process_excl, tasks):
                if not res[12]:
                    ok = False
                moved[res[0]] = res
            if not ok:
                break
        if not ok:
            continue
        old_taps = sum(len(results[i][3]) for i in children)
        new_taps = sum(len(res[4]) for res in moved.values())
        if max_tap_growth is not None and new_taps > old_taps * (1.0 + max_tap_growth):
            continue
        for i, res in moved.items():
            results[i] = stored_row(res)
            groups[res[2]].append(i)
        groups[parent] = []
        removed.add(parent)
        logging.info('Pruned %s parent %d: moved %d children, taps %d -> %d (%d removed so far)',
                     label, parent, len(children), old_taps, new_taps, len(removed))
    return removed


# --- GROUP MERGING (bottom-up mode: parents may be any child-bank template) ---
#
# After assignment (and pruning) every group is tried, smallest first, for a
# merge with each of its --merge-neighbours tau0-nearest groups. The merged
# group gets one parent chosen among the templates of the union (ranked by
# minimax distance in normalised (tau0, tau3, chi_eff)); a candidate is
# accepted only if every child of the union passes the full acceptance test
# within --max-taps. Merged groups go back into the queue. Parents here are
# identified by their index in the child bank.

_g_wave_cache = {}


def _child_wave(j):
    """Child-bank template j as (series, numpy array, |h|^2/S sum), cached per worker."""
    hit = _g_wave_cache.get(j)
    if hit is None:
        h = g_fine_bank[int(j)].copy()
        h_np = h.numpy().astype(np.complex128)
        ss = float(np.sum(np.abs(h_np[g_kslice]) ** 2 * g_inv_psd[g_kslice]))
        if len(_g_wave_cache) >= 4096:
            _g_wave_cache.clear()
        hit = _g_wave_cache[j] = (h, h_np, ss)
    return hit


_g_factor_cache = {}


def _toeplitz_solve_cached(r, b):
    """solve_toeplitz(r, b) through a per-worker cache of Cholesky factors.

    Children of one parent share the same normal-equation matrix, so the
    O(k^3/3) factorisation is paid once per (parent, tap count) and each
    further solve (any number of right-hand sides) costs O(k^2).
    """
    key = r.tobytes()
    fac = _g_factor_cache.get(key)
    if fac is None:
        if len(_g_factor_cache) >= 64:
            _g_factor_cache.clear()
        fac = _g_factor_cache[key] = scipy.linalg.cho_factor(
            scipy.linalg.toeplitz(r), lower=True, check_finite=False)
    return scipy.linalg.cho_solve(fac, b, check_finite=False)


def _toeplitz_fit_batch(prob, k, targets, reg_val, nfft):
    """Least-squares FIR fits of several targets on prob's band / weights.

    Returns (responses (n, nfft//2+1), taps (k, n)). Same normal equations as
    design_fft_toeplitz_filter (without peak suppression).
    """
    bins = np.flatnonzero(prob['band'])
    w2 = prob['w_fit'][bins] ** 2
    r = _hermitian_corr(bins, w2, nfft)[:k].copy()
    r[0] += reg_val
    pos = (np.arange(k) - k // 2) % nfft
    b = _hermitian_corr(bins, targets[:, bins] * w2[None, :], nfft)[:, pos]
    taps = _toeplitz_solve_cached(r, b.T)
    wave = np.zeros((nfft, taps.shape[1]))
    wave[pos] = taps
    return np.fft.rfft(wave, axis=0).T, taps


def _gn_apply_correction(h0, z):
    if z is None or not np.any(z):
        return h0
    h_m = h0.copy()
    h_m[g_correction_band] *= np.exp(z @ g_correction_basis[:, g_correction_band])
    return h_m


def _gn_parent(base_idx, z):
    """(numpy waveform, |h|^2/S sum, FrequencySeries) of the deformed parent."""
    h0_c, h0_np, h0_ss = _child_wave(base_idx)
    if z is None or not np.any(z):
        return h0_np, h0_ss, h0_c
    h_m = _gn_apply_correction(h0_np, z)
    mss = float(np.sum(np.abs(h_m[g_kslice]) ** 2 * g_inv_psd[g_kslice]))
    from pycbc.types import FrequencySeries
    return h_m, mss, FrequencySeries(h_m, delta_f=g_delta_f, epoch=h0_c.epoch)


def _gn_eval_lin(task):
    """Per child: (index, mismatch at k, residual R, J^T J, J^T rho) for the GN step."""
    base_idx, z, child_indices, k = task
    h_m, mss, h_fs = _gn_parent(base_idx, z)
    nz = len(g_correction_basis)
    st = {'attempts': 0, 'suppressed': 0}
    exact_qa = not (g_args.peak_cap_factor or g_args.verify_mode != 'zero-lag')
    out = []
    for i in child_indices:
        h_ch, ch_np, ch_ss = _child_wave(i)
        prob = _build_problem_ref(h_m, mss, h_fs, base_idx, ch_np, shared=True)
        if prob is None:
            out.append((i, 1.0, 1e-10, np.zeros((nz, nz)), np.zeros(nz)))
            continue
        T0 = prob['target']
        targets = np.vstack([T0[None, :], T0[None, :] * g_correction_basis])
        resp, taps = _toeplitz_fit_batch(prob, k, targets, g_args.regularization_magnitude,
                                         g_nfft)
        if exact_qa:
            # column 0 is exactly the k-tap design _evaluate would make; score
            # it the same way (float32 taps, zero-lag match)
            H = _response(taps[:, 0].astype(np.float32).astype(np.float64))
            mis = 1.0 - _verify(H, prob, ch_np, ch_ss)[0]
        else:
            mis = 1.0 - _evaluate(prob, k, h_ch, ch_np, ch_ss, st)[1]['qa']
        bins = np.flatnonzero(prob['band'])
        w = prob['w_fit'][bins]
        rho = (resp[0] - T0)[bins] * w
        J = ((T0[None, :] * g_correction_basis - resp[1:])[:, bins] * w[None, :])
        R = float(np.sum(np.abs(rho) ** 2))
        A = np.real(np.conj(J) @ J.T)
        g = np.real(np.conj(J) @ rho)
        out.append((i, mis, R, A, g))
    return out


def _gn_eval_check(task):
    """Per child: (index, mismatch, accepted) of the k-tap design from the deformed parent.

    If abort_above is given the chunk stops at the first child whose mismatch
    exceeds it (the rest are reported as (i, inf, False)): used by the GN line
    search, where one such child already rejects the step.
    """
    base_idx, z, child_indices, k, abort_above = task
    h_m, mss, h_fs = _gn_parent(base_idx, z)
    st = {'attempts': 0, 'suppressed': 0}
    out = []
    for n, i in enumerate(child_indices):
        h_ch, ch_np, ch_ss = _child_wave(i)
        prob = _build_problem_ref(h_m, mss, h_fs, base_idx, ch_np, shared=True)
        if prob is None:
            mis, ok = 1.0, False
        else:
            ok, rec = _evaluate(prob, k, h_ch, ch_np, ch_ss, st)
            mis = 1.0 - rec['qa']
        out.append((i, mis, ok))
        if abort_above is not None and mis >= abort_above:
            out.extend((j, np.inf, False) for j in child_indices[n + 1:])
            break
    return out


def _optimize_middle_group(pool, union, base_cand, args, initial_z=None, order=None):
    """Deform parent `base_cand` (20 smooth log-amplitude / phase terms) so that
    every child of `union` passes at --max-taps.

    Minimises a soft-max of the children's least-squares residuals at 85% of
    the cap (margin) with damped Gauss-Newton; after each round the actual
    acceptance at the cap is checked. `order` (children hardest first) is used
    to spread hard children over the work chunks so line-search rejections
    abort early. Returns (z, number of children failing at the cap).
    """
    max_taps = args.max_taps
    k_cap = max_taps if max_taps % 2 else max_taps - 1
    min_match = getattr(args, 'min_match', 0.9999)
    nz = 20
    z = np.zeros(nz, dtype=np.float64) if initial_z is None else np.array(initial_z, dtype=np.float64).copy()
    n_proc = getattr(args, 'n_processes', 8)
    n_chunks = max(1, min(len(union), 4 * n_proc))
    ordered = [int(x) for x in (order if order is not None else union)]
    chunks = [ordered[j::n_chunks] for j in range(n_chunks)]
    chunks = [c for c in chunks if c]

    def _run(fn, cur_z, extra):
        res = pool.imap_unordered(fn, [(base_cand, cur_z, c) + extra for c in chunks])
        return [item for sub in res for item in sub]

    def _lin(cur_z, k):
        return _run(_gn_eval_lin, cur_z, (k,))

    def _check(cur_z, k, abort_above=None):
        return _run(_gn_eval_check, cur_z, (k, abort_above))

    k = _snap(int(0.85 * max_taps), args=args)
    best_z, best_fail, best_worst = z.copy(), None, np.inf

    for rnd in range(3):
        mu = 1e-2
        p = 8.0
        zreg = 1e-3
        for it in range(8):
            lin = _lin(z, k)
            mis = np.array([x[1] for x in lin])
            worst = mis.max()
            if worst <= (1.0 - min_match):
                break
            c = (mis / worst) ** p
            A = np.zeros((nz, nz))
            g = np.zeros(nz)
            for (i, m, R, Ai, gi), ci in zip(lin, c):
                s = ci * m / max(R, 1e-300)
                A += s * Ai
                g += s * gi
            scale = np.trace(A) / nz
            if scale <= 0:
                break
            accepted = False
            for _ in range(6):
                dz = -np.linalg.solve(A + (mu + zreg) * scale * np.eye(nz), g + zreg * scale * z)
                new_mis = np.array([x[1] for x in _check(z + dz, k, abort_above=worst)])
                if new_mis.max() < worst:
                    z = z + dz
                    mu = max(mu / 3, 1e-6)
                    accepted = True
                    break
                mu *= 4
            if not accepted:
                break

        cap = _check(z, k_cap)
        n_fail = sum(1 for _, _, ok in cap if not ok)
        worst_cap = max(m for _, m, _ in cap)
        if best_fail is None or (n_fail, worst_cap) < (best_fail, best_worst):
            best_z, best_fail, best_worst = z.copy(), n_fail, worst_cap
        if best_fail == 0:
            break
    return best_z, best_fail


def _merge_check(task):
    """Can child-bank template `cand` parent every one of `children` at the cap?

    Children are tried in the given order (hardest first). Returns
    (cand, number of children passed before the first failure, worst
    mismatch). Without screening (screen <= 0) the check stops at the first
    failure. With screening it keeps going so the worst mismatch over all
    children is known (the GN deformation start point), but stops as soon as
    a child's mismatch exceeds screen * (1 - min_match): such a merge is
    treated as out of reach for the parent deformation.
    """
    cand, children, screen = task
    h_c, c_np, c_ss = _child_wave(cand)
    k = g_args.max_taps if g_args.max_taps % 2 else g_args.max_taps - 1
    limit = screen * (1.0 - g_args.min_match) if screen and screen > 0 else None
    stats = {'attempts': 0, 'suppressed': 0}
    n_pass, worst = None, 0.0
    for n, i in enumerate(children):
        if i == cand:
            continue
        h, h_np, ss = _child_wave(i)
        prob = _build_problem_ref(c_np, c_ss, h_c, cand, h_np, shared=True)
        if prob is None:
            ok, mis = False, 1.0
        else:
            ok, rec = _evaluate(prob, k, h, h_np, ss, stats)
            mis = 1.0 - rec['qa']
        worst = max(worst, mis)
        if not ok and n_pass is None:
            n_pass = n
            if limit is None:
                return cand, n, np.inf
        if limit is not None and mis > limit:
            return cand, n_pass, np.inf
    return cand, len(children) if n_pass is None else n_pass, worst


def _fit_forced(task):
    """Fewest-tap FIR of child i from child-bank template `cand` (stored-row form)."""
    if len(task) == 3:
        i, cand, z = task
    else:
        i, cand = task
        z = None
    c_np, c_ss, h_c = _gn_parent(cand, z)
    h, h_np, ss = _child_wave(i)
    stats = {'attempts': 0, 'suppressed': 0}
    prob = _build_problem_ref(c_np, c_ss, h_c, cand, h_np, shared=True)
    rec = _min_taps(prob, g_args.max_taps, h, h_np, ss, stats)[0] if prob is not None else None
    if rec is None:
        return i, None
    m, _ = match(h, h_c, psd=g_psd, low_frequency_cutoff=g_args.f_low,
                 v1_norm=4.0 * g_delta_f * ss, v2_norm=4.0 * g_delta_f * c_ss)
    return i, (float(m), int(cand), rec['qa'], rec['taps'], rec['sigmas'], rec['shift'],
               rec['metrics'])


def bank_features(bank, f_low):
    """(tau0, tau3, chi_eff) per template, used to rank merge candidates."""
    from pycbc import conversions
    t = bank.table
    names = t.dtype.names
    m1 = np.asarray(t['mass1'], dtype=np.float64)
    m2 = np.asarray(t['mass2'], dtype=np.float64)
    tau0 = (np.asarray(t['tau0'], dtype=np.float64) if 'tau0' in names
            else conversions.tau0_from_mass1_mass2(m1, m2, f_low))
    tau3 = conversions.tau3_from_mass1_mass2(m1, m2, f_low)
    s1 = np.asarray(t['spin1z'], dtype=np.float64) if 'spin1z' in names else 0 * m1
    s2 = np.asarray(t['spin2z'], dtype=np.float64) if 'spin2z' in names else 0 * m1
    return np.stack([tau0, tau3, conversions.chi_eff(m1, m2, s1, s2)], axis=1)


def merge_groups(pool, results, feats, args, label='middle',
                 parent_corrections=None, optimize_middle=True):
    """Merge groups under re-centred parents. `results` rows are stored rows whose
    parent field is a child-bank index; updated in place. Returns #merges."""
    n_neighbours = getattr(args, 'merge_neighbours', 3)
    n_candidates = getattr(args, 'merge_candidates', 16)
    groups = defaultdict(set)
    for i, row in enumerate(results):
        if row is not None and row[1] >= 0:
            groups[row[1]].add(i)
    tau0 = feats[:, 0]
    tried = set()
    n_merges = 0
    progress = True
    while progress:
        progress = False
        for p in sorted(groups, key=lambda q: (len(groups[q]), q)):
            if p not in groups:
                continue
            others = np.array([q for q in groups if q != p], dtype=int)
            if not len(others):
                break
            neigh = others[np.argsort(np.abs(tau0[others] - tau0[p]))][:n_neighbours]
            for q in neigh:
                q = int(q)
                key = (min(p, q), max(p, q), len(groups[p]), len(groups[q]))
                if key in tried:
                    continue
                tried.add(key)
                union = np.array(sorted(groups[p] | groups[q]), dtype=int)
                pool_c = np.unique(np.concatenate([union, [p, q]]))
                f_u = feats[union]
                span = f_u.max(axis=0) - f_u.min(axis=0)
                span[span <= 0] = 1.0
                d = np.sqrt((((feats[pool_c][:, None, :] - f_u[None, :, :]) / span) ** 2).sum(-1))
                cand_radius = {int(c): float(d[idx].max()) for idx, c in enumerate(pool_c)}
                cands = pool_c[np.argsort(d.max(axis=1))][:n_candidates]
                tasks = []
                gn_on = optimize_middle and label == 'middle'
                screen = getattr(args, 'merge_gn_screen', 0.0) if gn_on else 0.0
                for c in cands:
                    dc = np.sqrt((((f_u - feats[c]) / span) ** 2).sum(-1))
                    tasks.append((int(c), [int(x) for x in union[np.argsort(-dc)]], screen))
                order_of = {t[0]: t[1] for t in tasks}
                check_results = list(pool.imap_unordered(_merge_check, tasks))
                passed = {c for c, n, _ in check_results if n == len(union)}
                chosen = next((int(c) for c in cands if int(c) in passed), None)
                chosen_z = None
                if chosen is not None:
                    # the check used the undeformed template, so refit with that
                    chosen_z = np.zeros(20)
                elif gn_on:
                    if screen and screen > 0:
                        reach = [(w, cand_radius[int(c)], int(c)) for c, _, w in check_results
                                 if np.isfinite(w)]
                        best_cand = min(reach)[2] if reach else None
                    else:
                        cand_counts = {int(c): int(n) for c, n, _ in check_results}
                        best_cand = int(max(cands, key=lambda c: (cand_counts.get(int(c), 0),
                                                                  -cand_radius[int(c)])))
                    if best_cand is not None:
                        # start from the undeformed template the screen measured
                        opt_z, n_fail = _optimize_middle_group(pool, union, best_cand, args,
                                                               order=order_of[best_cand])
                        if n_fail == 0:
                            chosen = best_cand
                            chosen_z = opt_z
                if chosen is None:
                    continue
                rows = dict(pool.imap_unordered(_fit_forced, [(int(i), chosen, chosen_z) for i in union],
                                                chunksize=4))
                if any(r is None for r in rows.values()):
                    logging.warning('Merge %s %d+%d via %d: forced refit failed; skipped',
                                    label, p, q, chosen)
                    continue
                for i, r in rows.items():
                    results[i] = r
                if parent_corrections is not None:
                    parent_corrections[chosen] = chosen_z
                    if p in parent_corrections and p != chosen:
                        del parent_corrections[p]
                    if q in parent_corrections and q != chosen:
                        del parent_corrections[q]
                sizes = (len(groups[p]), len(groups[q]))
                del groups[p]
                del groups[q]
                groups[chosen] = set(int(i) for i in union)
                n_merges += 1
                progress = True
                logging.info('Merged %s groups %d (%d) + %d (%d) -> parent %d (%d children, '
                             'max taps %d, opt=%s); %d groups left', label, p, sizes[0], q, sizes[1],
                             chosen, len(union), max(len(r[3]) for r in rows.values()),
                             bool(chosen_z is not None and np.any(chosen_z)),
                             len(groups))
                break
    return n_merges


def consolidate_parents(pool, results, parent_src, feats, args, label):
    """Merge pass (if enabled) and compaction for a bottom-up level.

    `parent_src[c]` is the child-bank index of parent c. Returns the rows with
    parents renumbered 0..n-1 and the sorted child-bank indices of the parents
    actually used (the new parent bank).
    """
    rows = [None if r is None else (r[0], int(parent_src[r[1]])) + tuple(r[2:])
            for r in results]
    parent_corrections = {int(s): np.zeros(20, dtype=np.float64) for s in parent_src}
    opt_mid = getattr(args, 'optimize_middle', True) and label == 'middle'
    if args.merge_groups:
        n_before = len({r[1] for r in rows if r is not None})
        n = merge_groups(pool, rows, feats, args, label,
                         parent_corrections=parent_corrections, optimize_middle=opt_mid)
        logging.info('Group merging: %d merges, %d -> %d %s templates in use', n, n_before,
                     len({r[1] for r in rows if r is not None}), label)
    used = np.array(sorted({r[1] for r in rows if r is not None}), dtype=int)
    pos = {int(s): k for k, s in enumerate(used)}
    rows = [None if r is None else (r[0], pos[r[1]]) + tuple(r[2:]) for r in rows]
    corr_matrix = np.array([parent_corrections.get(int(s), np.zeros(20, dtype=np.float64))
                            for s in used], dtype=np.float64)
    return rows, used, corr_matrix


def _close_bank(bank):
    """Close the HDF file a FilterBank keeps open (before rewriting that file)."""
    handle = getattr(bank, 'file', None)
    if handle is not None:
        try:
            handle.close()
        except Exception:
            pass


def file_sha256(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()


def upper_namespace(args):
    """Copy of args with the --upper-* overrides applied (top->middle fit)."""
    upper = argparse.Namespace(**vars(args))
    upper.delta_f = args.upper_delta_f or args.delta_f
    upper.fit_solver = args.upper_fit_solver
    for name in ('n_taps', 'max_taps', 'tap_step', 'min_match', 'search_depth',
                 'regularization_magnitude', 'lsqr_atol', 'lsqr_iter_lim',
                 'parent_refine', 'tap_granularity', 'min_taps', 'fit_weight_power'):
        value = getattr(args, 'upper_' + name, None)
        if value is not None:
            setattr(upper, name, value)
    return upper


def upper_psd_from_cli(args):
    upper_df = args.upper_delta_f or args.delta_f
    upper_flen = int((args.sample_rate / 2.0) / upper_df) + 1
    if abs((upper_flen - 1) * upper_df - args.sample_rate / 2.0) > 1e-8:
        raise ValueError('upper delta_f must divide the Nyquist frequency')
    return upper_df, upper_flen, pycbc.psd.from_cli(args, length=upper_flen, delta_f=upper_df,
                                                    low_frequency_cutoff=args.f_low)


def fit_upper_level(args, middle_bank, psd, flen, output, used_middles=None):
    """Fit top->middle in the same output file as middle->fine.

    Only middle templates listed in used_middles (those with fine children)
    are fitted; others get no upper group.
    """
    if args.top_bank is None:
        return
    upper_df = args.upper_delta_f or args.delta_f
    upper_flen = int((args.sample_rate / 2.0) / upper_df) + 1
    if abs((upper_flen - 1) * upper_df - args.sample_rate / 2.0) > 1e-8:
        raise ValueError('upper delta_f must divide the Nyquist frequency')
    upper_psd = pycbc.psd.from_cli(args, length=upper_flen,
                                    delta_f=upper_df,
                                    low_frequency_cutoff=args.f_low)
    upper_middle = FilterBank(args.coarse_bank, upper_flen, upper_df,
                              dtype=np.complex128,
                              enable_compressed_waveforms=False)
    top_bank = FilterBank(args.top_bank, upper_flen, upper_df,
                          dtype=np.complex128,
                          enable_compressed_waveforms=False)
    top_waveforms = [h.copy() for h in top_bank]
    if not top_waveforms:
        raise ValueError('top bank is empty')

    upper = upper_namespace(args)
    upper.search_depth = min(upper.search_depth, len(top_bank))
    # Candidate parents for the upper fit are top templates, children are
    # middle templates: do not inherit the middle/fine tau0 arrays.
    def _tau0(bank):
        if hasattr(bank, 'table') and 'tau0' in bank.table.dtype.names:
            return np.array(bank.table['tau0'], dtype=np.float64)
        return None
    upper._coarse_tau0 = _tau0(top_bank)
    upper._fine_tau0 = _tau0(upper_middle)

    if used_middles is None:
        used_middles = range(len(upper_middle))
    used_middles = sorted(int(c) for c in used_middles)
    results = [None] * len(upper_middle)
    rejected = []
    with mp.Pool(processes=args.n_processes, initializer=init_worker,
                 initargs=(top_waveforms, upper_middle, upper_psd, upper)) as pool:
        for row in tqdm(pool.imap_unordered(process_template, used_middles),
                        total=len(used_middles), desc='Fitting upper level',
                        disable=bool(args.verbose), file=sys.stderr):
            i, parent_match, parent, fit, taps, sigmas = row[:6]
            shift, metrics, accepted = row[8], row[11], row[12]
            results[i] = (parent_match, parent, fit, taps, sigmas, shift, metrics)
            logging.info('Upper T%d (Top %d): direct=%.6f taps=%d fit=%.9f (shift=%d) '
                         'max_tap=%.3g oob=%.3g noise=%.3g accepted=%s',
                         i, parent, parent_match, len(taps), fit, shift,
                         metrics[0], metrics[1], metrics[2], accepted)
            if not accepted:
                rejected.append(i)
        if args.prune_seeds and not rejected:
            n_used = len({r[1] for r in results if r is not None and r[1] >= 0})
            removed = prune_parents(pool, results, args.n_processes,
                                    args.prune_max_tap_growth, label='top')
            logging.info('Seed pruning: %d -> %d top templates in use',
                         n_used, n_used - len(removed))
        top_src = getattr(args, '_top_seed_src', None)
        if top_src is not None and not rejected:
            results, used_top, _ = consolidate_parents(
                pool, results, top_src, bank_features(upper_middle, args.f_low), args, 'top')
            _close_bank(top_bank)
            write_seed_bank(args.coarse_bank, used_top, args.top_bank, force=True)
            top_bank = FilterBank(args.top_bank, upper_flen, upper_df, dtype=np.complex128,
                                  enable_compressed_waveforms=False)
            top_waveforms = [h.copy() for h in top_bank]

    failed = sorted(set(rejected) | {i for i in used_middles
                                     if results[i] is None or results[i][1] < 0})
    if failed:
        raise ValueError('upper FIR fits failed acceptance (min match %.9f) for middle '
                         'indices %s' % (upper.min_match, failed))

    top_bank.ensure_hash()
    top_bank.write_to_hdf(args.output_file, file_handler=output,
                          group_key='fir_data/upper/top_bank_params',
                          write_compressed_waveforms=True)
    if getattr(args, 'store_compressed_top_waveforms', True):
        import pycbc.waveform.compress as compress
        logging.info("Compressing %d top waveforms (tolerance=%.1e)...",
                     len(top_bank), args.compressed_top_waveforms_tolerance)
        top_group = output.require_group('fir_data/upper/top_bank_params')
        if 'template_hash' not in top_group:
            top_group.create_dataset('template_hash', data=top_bank.table.template_hash)
        else:
            top_group['template_hash'][:] = top_bank.table.template_hash
        if 'compressed_waveforms' in top_group:
            del top_group['compressed_waveforms']
        for i in range(len(top_bank)):
            h = top_waveforms[i]
            tmplt = top_bank.table[i]
            thash = str(tmplt.template_hash)
            fmin = float(getattr(tmplt, 'f_lower', args.f_low))
            kmax = int(np.nonzero(abs(h.numpy()))[0][-1])
            sp = np.array([fmin, kmax * upper_df], dtype=np.float64)
            interp = getattr(args, 'compressed_top_waveforms_interpolation', 'inline_quadratic')
            hc = compress.compress_waveform(
                h, sp, args.compressed_top_waveforms_tolerance,
                interp, 'single', psd=None
            )
            hc.write_to_hdf(top_group, thash)
            logging.info("Compressed top %d/%d (hash=%s, points=%d, mismatch=%.2e)",
                         i + 1, len(top_bank), thash, len(hc.sample_points), hc.mismatch)
    group = output.require_group('fir_data/upper')
    for name in ('sample_rate', 'delta_f', 'n_taps', 'max_taps', 'tap_step',
                 'min_match', 'search_depth', 'regularization_magnitude',
                 'fit_solver', 'fit_weight_power', 'tap_search', 'tap_granularity',
                 'min_taps', 'parent_selection', 'parent_refine', 'verify_mode',
                 'peak_cap_mode', 'peak_cap_factor', 'max_tap_value'):
        group.attrs[name] = getattr(upper, name)
    group.attrs['sample_shift_folded_into_lower'] = 1
    write_fir_groups(group, results, match_dtype='float64')
    output['fir_data'].attrs['hierarchy_version'] = 2
    for name, path in (('top', args.top_bank), ('middle', args.coarse_bank),
                       ('fine', args.fine_bank)):
        output['fir_data'].attrs[name + '_bank_sha256'] = file_sha256(path)
    return results

# --- 3b. BOTTOM-UP SEED SELECTION (used when no coarse / top bank is given) ---
#
# Seeds (parents) are chosen from the child bank itself by greedy clustering in
# tau0: the densest unassigned template becomes a seed, and every unassigned
# template within --seed-dtau-max whose FIR from that seed passes the full
# acceptance test at --seed-target-taps joins its cluster. Clusters are then
# re-centred on their tau0 medoid when that covers at least as many templates,
# and clusters smaller than --min-group-size are dropped when all their members
# can instead be fit (within --max-taps) from a seed of a large cluster.
# Membership only decides *which* seeds exist; the regular per-template pass
# then picks each child's fewest-tap parent among all seeds.

g_seed_source = None   # (FilterBank, psd, namespace, settings) for forked seed workers


def _seed_cluster(sel):
    """Greedy clustering over the worker's g_coarse_* templates; returns local seed indices."""
    tau0 = g_coarse_tau0
    n = len(g_coarse_np)
    rng = np.random.default_rng(sel['rng_seed'])
    k_target = sel['target_taps'] if sel['target_taps'] % 2 else sel['target_taps'] - 1
    k_absorb = sel['absorb_taps'] if sel['absorb_taps'] % 2 else sel['absorb_taps'] - 1
    stats = {'attempts': 0, 'suppressed': 0}

    def fits(seed, cand, k):
        h_np = g_coarse_np[cand]
        prob = _build_problem(seed, h_np)
        if prob is None:
            return False
        ok, _ = _evaluate(prob, k, g_coarse_waveforms[cand], h_np, g_coarse_ss[cand], stats)
        return ok

    def direct(seed, cand):
        m, _ = match(g_coarse_waveforms[cand], g_coarse_waveforms[seed], psd=g_psd,
                     low_frequency_cutoff=g_args.f_low,
                     v1_norm=g_coarse_sigmasq[cand], v2_norm=g_coarse_sigmasq[seed])
        return float(m)

    def grow(seed, pool):
        members = [seed]
        for c in pool:
            c = int(c)
            if c == seed or abs(tau0[c] - tau0[seed]) > sel['dtau_max']:
                continue
            if sel['direct_min'] > 0 and direct(seed, c) < sel['direct_min']:
                continue
            if fits(seed, c, k_target):
                members.append(c)
        return members

    unassigned = set(range(n))
    clusters = []
    while unassigned:
        ul = np.fromiter(unassigned, dtype=int, count=len(unassigned))
        t = tau0[ul]
        if len(ul) > 200:
            sample = rng.choice(len(ul), size=100, replace=False)
        else:
            sample = np.arange(len(ul))
        dens = [np.sum(np.abs(t - t[j]) < sel['density_window']) for j in sample]
        seed = int(ul[sample[int(np.argmax(dens))]])
        members = grow(seed, ul)
        if sel['medoid'] and len(members) > 2:
            mt = tau0[members]
            medoid = int(members[int(np.argmin(np.abs(mt[:, None] - mt[None, :]).sum(axis=1)))])
            if medoid != seed:
                alt = grow(medoid, ul)
                if len(alt) >= len(members):
                    seed, members = medoid, alt
        unassigned.difference_update(members)
        clusters.append((seed, members))

    if sel['min_group_size'] > 1:
        large = [c for c in clusters if len(c[1]) >= sel['min_group_size']]
        large_seeds = np.array([c[0] for c in large], dtype=int)
        kept = list(large)
        for seed, members in clusters:
            if len(members) >= sel['min_group_size']:
                continue
            absorbed = len(large_seeds) > 0
            for m in members:
                if not absorbed:
                    break
                near = large_seeds[np.argsort(np.abs(tau0[large_seeds] - tau0[m]))]
                near = near[:sel['absorb_depth']]
                absorbed = any(fits(int(s2), m, k_absorb) for s2 in near
                               if abs(tau0[s2] - tau0[m]) <= 1.5 * sel['dtau_max'])
            if not absorbed:
                kept.append((seed, members))
        clusters = kept
    return sorted(c[0] for c in clusters), stats['attempts']


def _seed_chunk(task):
    """Pool task: cluster one tau0-contiguous chunk of the source bank."""
    chunk_id, indices, tau0 = task
    bank, psd, ns, sel = g_seed_source
    waves = [bank[int(i)].copy() for i in indices]
    ns = argparse.Namespace(**vars(ns))
    ns._coarse_tau0 = np.asarray(tau0, dtype=np.float64)
    ns._fine_tau0 = None
    init_worker(waves, None, psd, ns)
    sel = dict(sel, rng_seed=sel['rng_seed'] + chunk_id)
    seeds, attempts = _seed_cluster(sel)
    return chunk_id, [int(indices[s]) for s in seeds], attempts


def select_seeds(bank, psd, ns, sel, candidates, n_chunks, n_processes, desc):
    """Choose seed templates among bank[candidates]; returns sorted bank indices."""
    global g_seed_source
    candidates = np.asarray(candidates, dtype=int)
    tau0_all = np.array(bank.table['tau0'], dtype=np.float64)
    order = candidates[np.argsort(tau0_all[candidates], kind='stable')]
    chunks = [c for c in np.array_split(order, max(1, n_chunks)) if len(c)]
    tasks = [(cid, c, tau0_all[c]) for cid, c in enumerate(chunks)]
    g_seed_source = (bank, psd, ns, sel)   # inherited by the forked workers
    seeds, attempts = [], 0
    with mp.Pool(processes=max(1, min(n_processes, len(tasks)))) as pool:
        for cid, s, a in tqdm(pool.imap_unordered(_seed_chunk, tasks), total=len(tasks),
                              desc=desc, disable=bool(ns.verbose), file=sys.stderr):
            seeds.extend(s)
            attempts += a
            logging.info('%s: chunk %d -> %d seeds (%d designs)', desc, cid, len(s), a)
    g_seed_source = None
    return np.array(sorted(seeds), dtype=int)


def write_seed_bank(src_path, indices, dst_path, force=False, correction_coeffs=None):
    """Write rows `indices` of template bank `src_path` to a new bank file."""
    import h5py
    if os.path.exists(dst_path) and not force:
        raise ValueError('%s exists; refusing to overwrite (use --force)' % dst_path)
    with h5py.File(src_path, 'r') as src, h5py.File(dst_path, 'w') as dst:
        n = len(src['tau0'])
        for key in src:
            obj = src[key]
            if (isinstance(obj, h5py.Dataset) and key not in ('template_hash', 'seed_source_index', 'correction_coeffs')
                    and obj.shape and obj.shape[0] == n):
                dst.create_dataset(key, data=obj[:][indices])
        for key, value in src.attrs.items():
            dst.attrs[key] = value
        dst.attrs['seed_source_bank'] = os.path.abspath(src_path)
        dst.attrs['seed_source_sha256'] = file_sha256(src_path)
        dst.create_dataset('seed_source_index', data=np.asarray(indices, dtype=np.int64))
        if correction_coeffs is not None:
            dst.create_dataset('correction_coeffs', data=np.asarray(correction_coeffs, dtype=np.float64))
        elif 'correction_coeffs' in src:
            dst.create_dataset('correction_coeffs', data=src['correction_coeffs'][:][indices])
    logging.info('Wrote %d seeds to %s', len(indices), dst_path)


def _seed_settings(args, level_ns, upper=False):
    p = 'upper_' if upper else ''
    target = getattr(args, p + 'seed_target_taps') or level_ns.n_taps
    return dict(target_taps=target, dtau_max=getattr(args, p + 'seed_dtau_max'),
                direct_min=getattr(args, p + 'seed_direct_match_min'),
                density_window=getattr(args, p + 'seed_density_window'),
                min_group_size=getattr(args, p + 'min_group_size'),
                absorb_taps=level_ns.max_taps, absorb_depth=5,
                medoid=not args.no_seed_medoid, rng_seed=12345)


# --- 4. MAIN PROCESS ---
def main():
    parser = argparse.ArgumentParser(description="Generate Optimized FIR Filter Bank (MP)")
    pycbc.add_common_pycbc_options(parser)
    parser.add_argument('--coarse-bank',
                        help='Middle (reference) bank. If omitted (recommended), the middle and '
                             'top levels are built bottom-up from --fine-bank alone.')
    parser.add_argument('--coarse-bank-output',
                        help='Optionally keep the bottom-up middle seeds as a bank file here '
                             '(they are always stored inside --output-file)')
    parser.add_argument('--fine-bank', required=True)
    parser.add_argument('--two-level', action='store_true',
                        help='With bottom-up seeding, stop after the middle level (default '
                             'builds middle and top levels from the fine bank alone)')
    parser.add_argument('--top-bank', help='Optional third, sparsest template bank')
    parser.add_argument('--top-bank-output',
                        help='Optionally keep the bottom-up top seeds as a bank file here')
    parser.add_argument('--seed-target-taps', type=int, default=501,
                        help='Bottom-up seeding: a template joins a seed cluster if its FIR from '
                             'the seed passes acceptance at this many taps')
    parser.add_argument('--seed-dtau-max', type=float, default=3.5,
                        help='Bottom-up seeding: max tau0 distance (s) from seed to member')
    parser.add_argument('--seed-direct-match-min', type=float, default=0.28,
                        help='Bottom-up seeding: direct-match prefilter before trying a fit (0 disables)')
    parser.add_argument('--seed-density-window', type=float, default=1.0,
                        help='Bottom-up seeding: tau0 window (s) for the density used to pick seeds')
    parser.add_argument('--min-group-size', type=int, default=24,
                        help='Bottom-up seeding: drop clusters smaller than this if all members can be '
                             'fit (within --max-taps) from a seed of a larger cluster')
    parser.add_argument('--no-prune-seeds', action='store_false', dest='prune_seeds',
                        help='Skip the pass that removes parents whose children can all be '
                             're-fit from other parents within the acceptance limits')
    parser.add_argument('--prune-max-tap-growth', type=float, default=None,
                        help='Only prune a parent if its moved children\'s total taps grow by at '
                             'most this fraction (default: no limit)')
    parser.add_argument('--no-seed-medoid', action='store_true',
                        help='Bottom-up seeding: skip medoid re-centring of clusters')
    parser.add_argument('--no-merge-groups', action='store_false', dest='merge_groups',
                        help='Bottom-up mode: skip the pass that merges each group with a tau0 '
                             'neighbour under one re-centred parent when all children still pass '
                             'within --max-taps')
    parser.add_argument('--no-optimize-middle', action='store_false', dest='optimize_middle',
                        help='Skip continuous Gauss-Newton middle waveform optimization during group merging')
    parser.add_argument('--merge-gn-screen', type=float, default=30.0,
                        help='Only attempt the Gauss-Newton parent deformation for a merge if some '
                             'undeformed candidate parent keeps every child within this multiple of '
                             'the allowed mismatch (1 - --min-match) at --max-taps; the best such '
                             'candidate is the GN start. 0 disables the screen (always try GN).')
    parser.add_argument('--merge-neighbours', type=int, default=3,
                        help='Group merging: number of tau0-nearest groups tried per group')
    parser.add_argument('--merge-candidates', type=int, default=16,
                        help='Group merging: candidate parents tried per merge (templates of the '
                             'union nearest its centre in normalised tau0, tau3, chi_eff)')
    parser.add_argument('--seed-chunks', type=int,
                        help='Bottom-up seeding: number of tau0-contiguous chunks clustered '
                             'independently (default: --n-processes)')
    parser.add_argument('--upper-seed-target-taps', type=int,
                        help='Top seeding analogue of --seed-target-taps (default: --upper-n-taps)')
    parser.add_argument('--upper-seed-dtau-max', type=float, default=15.0)
    parser.add_argument('--upper-seed-direct-match-min', type=float, default=0.10)
    parser.add_argument('--upper-seed-density-window', type=float, default=3.0)
    parser.add_argument('--upper-min-group-size', type=int, default=1)
    parser.add_argument('--output-file', required=True)
    parser.add_argument('--f-low', type=float, default=20.0)
    parser.add_argument('--sample-rate', type=float, default=2048.0)
    parser.add_argument('--delta-f', type=float, default=None, required=True)
    parser.add_argument('--n-taps', type=int, default=251)
    parser.add_argument('--max-taps', type=int, default=1025)
    parser.add_argument('--tap-step', type=int, default=100)
    parser.add_argument('--min-match', type=float, default=0.99)
    parser.add_argument('--upper-delta-f', type=float,
                        help='Frequency grid for the upper fit; may be finer than --delta-f')
    parser.add_argument('--upper-fit-solver', choices=('dense', 'fft-lsqr', 'toeplitz'),
                        default='toeplitz')
    parser.add_argument('--upper-min-match', type=float,
                        help='Top-to-middle FIR fit target (defaults to --min-match)')
    parser.add_argument('--upper-n-taps', type=int)
    parser.add_argument('--upper-max-taps', type=int)
    parser.add_argument('--upper-tap-step', type=int)
    parser.add_argument('--upper-search-depth', type=int)
    parser.add_argument('--upper-regularization-magnitude', type=float)
    parser.add_argument('--n-processes', '-n', type=int, default=1)
    parser.add_argument('--regularization-type', default='ridge', type=str)
    parser.add_argument('--regularization-magnitude', default=1e-2, type=float,
                        help='Ridge regularisation of the tap fit. 1e-2 keeps taps small and the '
                             'out-of-band gain low at little tap-count cost.')
    parser.add_argument('--fit-solver', choices=('dense', 'fft-lsqr', 'toeplitz'), default='toeplitz')
    parser.add_argument('--lsqr-atol', type=float, default=1e-11,
                        help="LSQR atol/btol tolerance.")
    parser.add_argument('--lsqr-iter-lim', type=int, default=2000,
                        help="LSQR max iterations per solve.")
    parser.add_argument('--upper-lsqr-atol', type=float, default=1e-11,
                        help="Upper LSQR atol/btol tolerance.")
    parser.add_argument('--upper-lsqr-iter-lim', type=int, default=2000,
                        help="Upper LSQR max iterations per solve.")
    parser.add_argument('--decimation-factor', default=1, type=int, dest='dec_factor')
    parser.add_argument('--search-depth', default=25, type=int,
                        help="Number of tau0-nearest coarse templates considered as parents")
    parser.add_argument('--ratio-cap', default=1000, type=int,
                        help="Don't fit ratio values above this number to avoid numerical instability of the fitting procedure")
    parser.add_argument('--max-tap-value', default=1e5, type=float,
                        help="If the calculated taps are larger in magnitude than this value, consider the constructionf failed")
    parser.add_argument('--peak-cap-factor', default=0.0, type=float,
                        help="After fitting, any frequency bin (checked across the full band, not just the "
                             "fitted region) whose achieved magnitude exceeds this many times the filter's own "
                             "median magnitude is nudged toward zero and the filter is refit. Guards against "
                             "single-precision numerical instability from a handful of unconstrained, "
                             "out-of-band bins with enormous gain. Set to 0 to disable.")
    parser.add_argument('--peak-bad-weight-fraction', default=1.0, type=float,
                        help="Weight given to the zero-target rows added for bins exceeding --peak-cap-factor, "
                             "relative to a typical in-band fit row.")
    parser.add_argument('--peak-max-passes', default=3, type=int,
                        help="Maximum number of fit/detect/constrain refinement passes for peak suppression.")
    parser.add_argument('--peak-cap-mode', choices=('inband', 'median'), default='inband',
                        help="inband (default): only bins outside the fitted band are capped, at "
                             "--peak-cap-factor times the filter's weighted RMS in-band gain, and an "
                             "accepted filter must satisfy that cap. median: legacy full-band cap "
                             "relative to the median gain (not part of acceptance).")
    parser.add_argument('--max-noise-gain', type=float, default=None,
                        help="Optional acceptance limit on the white-noise (full-band RMS) gain "
                             "relative to the match-weighted in-band RMS gain.")
    parser.add_argument('--fit-weight-power', type=float, default=0.5,
                        help="Least-squares row weight is (|h_ref|^2/S)**p. p=0.5 (default) makes "
                             "the fitted error weight equal the match weight; 1.0 is legacy.")
    parser.add_argument('--tap-search', choices=('bisect', 'ladder'), default='bisect',
                        help="bisect (default): after the --tap-step ladder finds a passing count, "
                             "bisect down to --tap-granularity. ladder: legacy, stop at first pass.")
    parser.add_argument('--tap-granularity', type=int, default=8,
                        help="Tap-count resolution (even, so counts stay odd).")
    parser.add_argument('--min-taps', type=int, default=15,
                        help="Smallest tap count considered (forced odd).")
    parser.add_argument('--parent-selection', choices=('min-taps', 'direct-match'),
                        default='min-taps',
                        help="Rank candidate parents by a probe fit at --n-taps (default) or by "
                             "direct template match (legacy).")
    parser.add_argument('--parent-refine', type=int, default=3,
                        help="Number of top-ranked parents that get the full minimum-tap search.")
    parser.add_argument('--verify-mode', choices=('zero-lag', 'match'), default='zero-lag',
                        help="zero-lag (default): phase-maximised overlap at zero lag, the quantity "
                             "the search uses. match: legacy time-maximised pycbc match.")
    parser.add_argument('--upper-parent-refine', type=int)
    parser.add_argument('--upper-tap-granularity', type=int)
    parser.add_argument('--upper-min-taps', type=int)
    parser.add_argument('--upper-fit-weight-power', type=float)
    parser.add_argument('--force', action='store_true',
                        help="Overwrite --output-file if it exists.")
    parser.add_argument('--store-compressed-top-waveforms', action='store_true', default=True,
                        help="Store compressed top waveforms in the bank to eliminate runtime waveform generation (default: True).")
    parser.add_argument('--no-compressed-top-waveforms', action='store_false',
                        dest='store_compressed_top_waveforms',
                        help="Do not store compressed top waveforms in the bank.")
    parser.add_argument('--compressed-top-waveforms-tolerance', type=float, default=1e-5,
                        help="Accuracy target / tolerance for compressed top waveforms mismatch (default: 1e-5, for >= 0.99999 match).")
    parser.add_argument('--compressed-top-waveforms-interpolation', default='inline_quadratic',
                        choices=('inline_quadratic', 'inline_linear', 'inline_cubic', 'inline_quartic'),
                        help="Interpolation method to use for compressed top waveforms (default: inline_quadratic).")
    parser.add_argument('--enable-tap-centering', action='store_true', default=True,
                        help="Enable group-delay phase centering for FIR tap compression (default: True).")
    parser.add_argument('--disable-tap-centering', action='store_false',
                        dest='enable_tap_centering',
                        help="Disable group-delay phase centering.")
    pycbc.psd.insert_psd_option_group(parser)
    args = parser.parse_args()
    global g_args
    g_args = args
    if args.coarse_bank is not None and args.coarse_bank_output is not None:
        parser.error('give only one of --coarse-bank / --coarse-bank-output')
    if args.top_bank is not None and args.top_bank_output is not None:
        parser.error('give only one of --top-bank / --top-bank-output')
    if args.coarse_bank is not None and args.top_bank is None and args.top_bank_output is None:
        build_top = False            # explicit two-level run on a given middle bank
    else:
        build_top = args.top_bank is None and not args.two_level
    three_level = args.top_bank is not None or build_top
    args._temp_files = []
    if args.coarse_bank is None and args.coarse_bank_output is None:
        args.coarse_bank_output = args.output_file + '.middle_seeds.tmp.hdf'
        args._temp_files.append(args.coarse_bank_output)
    if build_top and args.top_bank_output is None:
        args.top_bank_output = args.output_file + '.top_seeds.tmp.hdf'
        args._temp_files.append(args.top_bank_output)
    for path in (args.coarse_bank_output, args.top_bank_output):
        if path is not None and os.path.exists(path) and not args.force:
            parser.error('%s exists; refusing to overwrite (use --force)' % path)
    if three_level:
        # Defaults for the top->middle fit: finer grid for the long top
        # templates and a 10x tighter match so the two levels compound to
        # roughly --min-match.
        defaults = dict(upper_delta_f=args.delta_f / 16.0, upper_n_taps=3001,
                        upper_max_taps=6001, upper_tap_step=1000, upper_tap_granularity=16,
                        upper_min_match=1.0 - (1.0 - args.min_match) / 10.0,
                        upper_regularization_magnitude=1e-6)
        for name, value in defaults.items():
            if getattr(args, name) is None:
                setattr(args, name, value)
    for prefix in ('', 'upper_'):
        gran = getattr(args, prefix + 'tap_granularity')
        if gran is not None and (gran < 2 or gran % 2):
            parser.error('--%stap-granularity must be a positive even number' %
                         prefix.replace('_', '-'))
        mt = getattr(args, prefix + 'min_taps')
        if mt is not None:
            setattr(args, prefix + 'min_taps', max(1, mt | 1))
    if os.path.exists(args.output_file) and not args.force:
        parser.error('%s exists; refusing to overwrite (use --force)' % args.output_file)

    pycbc.init_logging(args.verbose)

    # Reroute logger to stdout to avoid tqdm conflict
    log = logging.getLogger()
    if args.verbose > 0 and log.handlers:
        if isinstance(log.handlers[0], logging.StreamHandler):
            log.handlers[0].stream = sys.stdout

    f_final = args.sample_rate / 2.0
    flen = int(f_final / args.delta_f) + 1
    logging.info(f"Setup: Rate={args.sample_rate}, df={args.delta_f}, flen={flen}")

    psd = pycbc.psd.from_cli(args, length=flen, delta_f=args.delta_f,
                             low_frequency_cutoff=args.f_low)

    middle_seed_src = None
    if args.coarse_bank is None:
        logging.info("Bottom-up seeding: choosing middle templates from the fine bank...")
        seed_src = FilterBank(args.fine_bank, flen, args.delta_f, dtype=np.complex128,
                              enable_compressed_waveforms=False)
        seeds = select_seeds(seed_src, psd, args, _seed_settings(args, args),
                             np.arange(len(seed_src)), args.seed_chunks or args.n_processes,
                             args.n_processes, 'Seeding middle level')
        write_seed_bank(args.fine_bank, seeds, args.coarse_bank_output, force=args.force)
        args.coarse_bank = args.coarse_bank_output
        middle_seed_src = seeds
        del seed_src

    logging.info("Loading coarse bank references...")
    coarse_bank = FilterBank(args.coarse_bank, flen, args.delta_f,
                             dtype=np.complex128,
                             enable_compressed_waveforms=False)
    show_progress = (args.verbose == 0)
    coarse_waveforms = [h.copy() for h in tqdm(coarse_bank, desc="Generating References", disable=not show_progress, file=sys.stderr)]

    if not coarse_waveforms: sys.exit("ERROR: Coarse bank empty!")

    logging.info("Opening fine bank...")
    fine_bank = FilterBank(args.fine_bank, flen, args.delta_f,
                           dtype=np.complex128,
                           enable_compressed_waveforms=False)
    n_fine = len(fine_bank)

    if hasattr(coarse_bank, 'table') and 'tau0' in coarse_bank.table.dtype.names:
        args._coarse_tau0 = np.array(coarse_bank.table['tau0'], dtype=np.float64)
    else:
        args._coarse_tau0 = None

    if hasattr(fine_bank, 'table') and 'tau0' in fine_bank.table.dtype.names:
        args._fine_tau0 = np.array(fine_bank.table['tau0'], dtype=np.float64)
    else:
        args._fine_tau0 = None

    # --- PHASE 1: Write File Headers via TemplateBank reuse ---
    logging.info("Writing bank parameters to output file...")

    # 1. Write Fine Bank to Root
    f_out = fine_bank.write_to_hdf(args.output_file, force=True,
                                   write_compressed_waveforms=True)

    # 2. The coarse (middle) bank is written to fir_data/coarse_bank_params
    #    after fitting: in bottom-up mode merging and compaction change it.

    # 3. Add Metadata attributes
    fir_group = f_out.require_group("fir_data")
    for arg, val in vars(args).items():
        if val is not None and isinstance(val, (int, float, str)):
             fir_group.attrs[arg] = val

    # --- PHASE 2: Calculation Loop ---
    logging.info(f"Starting pool with {args.n_processes} processes...")
    failed_count = 0
    peak_suppressed_count = 0
    peak_still_capped_count = 0
    total_attempts = 0
    total_attempts_suppressed = 0
    job_list = range(n_fine)
    all_results = [None] * n_fine
    all_metrics = [None] * n_fine
    failed_idx = []

    try:
        with mp.Pool(processes=args.n_processes, initializer=init_worker,
                     initargs=(coarse_waveforms, fine_bank, psd, args)) as pool:

            results_iter = pool.imap_unordered(process_template, job_list, chunksize=8)
            if not args.verbose:
                 results_iter = tqdm(results_iter, total=n_fine, desc="Designing Filters",
                                     postfix={"failed": 0}, file=sys.stderr)

            for result in results_iter:
                (i, coarse_match, c_idx, qa_match, final_taps_data, sigmas, n_peak_passes, n_bins_capped,
                 shift, n_attempts_total, n_attempts_suppressed, metrics, accepted) = result
                all_results[i] = (coarse_match, c_idx, qa_match, final_taps_data, sigmas, shift, metrics)
                all_metrics[i] = metrics

                if not accepted:
                    failed_count += 1
                    failed_idx.append(i)
                if n_peak_passes > 0:
                    peak_suppressed_count += 1
                if n_bins_capped > 0:
                    peak_still_capped_count += 1
                total_attempts += n_attempts_total
                total_attempts_suppressed += n_attempts_suppressed

                if not args.verbose:
                    results_iter.set_postfix(failed=failed_count, peak_supp=peak_suppressed_count)

                if args.verbose >= 1:
                    mismatch = 1.0 - qa_match
                    logging.info(f"T{i} (Ref {c_idx}): Coarse={coarse_match:.4f}, Taps={len(final_taps_data)}, "
                                 f"Final={qa_match:.7f}, Mism={mismatch:.3e}, Shift={shift}, "
                                 f"max_tap={metrics[0]:.3g} oob={metrics[1]:.3g} noise={metrics[2]:.3g} "
                                 f"accepted={accepted} attempts={n_attempts_total}")
                    log.handlers[0].flush() # Flush stdout

            if args.prune_seeds and not failed_count:
                n_used = len({r[1] for r in all_results if r is not None and r[1] >= 0})
                removed = prune_parents(pool, all_results, args.n_processes,
                                        args.prune_max_tap_growth, label='middle')
                all_metrics = [r[6] if r is not None else None for r in all_results]
                logging.info('Seed pruning: %d -> %d middle templates in use',
                             n_used, n_used - len(removed))

            if middle_seed_src is not None and not failed_count:
                all_results, used_src, middle_corrections = consolidate_parents(
                    pool, all_results, middle_seed_src, bank_features(fine_bank, args.f_low),
                    args, 'middle')
                all_metrics = [r[6] if r is not None else None for r in all_results]
                _close_bank(coarse_bank)
                write_seed_bank(args.fine_bank, used_src, args.coarse_bank, force=True,
                                correction_coeffs=middle_corrections)
                coarse_bank = FilterBank(args.coarse_bank, flen, args.delta_f,
                                         dtype=np.complex128, enable_compressed_waveforms=False)

        coarse_bank.write_to_hdf(args.output_file, file_handler=f_out,
                                 group_key="fir_data/coarse_bank_params",
                                 write_compressed_waveforms=True)

        # --- PHASE 3: Write Results ---
        logging.info("All templates processed. Writing grouped results to HDF5...")

        tap_counts = write_fir_groups(fir_group, all_results)

        if three_level:
            if failed_count:
                raise ValueError('%d lower-level FIR fits failed; refusing hierarchy' %
                                 failed_count)
            used_middles = sorted({row[1] for row in all_results if row is not None and row[1] >= 0})
            if args.top_bank is None:
                logging.info("Bottom-up seeding: choosing top templates from %d used middles...",
                             len(used_middles))
                upper_ns = upper_namespace(args)
                _, upper_flen, upper_psd = upper_psd_from_cli(args)
                mid_src = FilterBank(args.coarse_bank, upper_flen, upper_ns.delta_f,
                                     dtype=np.complex128, enable_compressed_waveforms=False)
                top_seeds = select_seeds(mid_src, upper_psd, upper_ns,
                                         _seed_settings(args, upper_ns, upper=True),
                                         used_middles, 1, 1, 'Seeding top level')
                write_seed_bank(args.coarse_bank, top_seeds, args.top_bank_output,
                                force=args.force)
                args.top_bank = args.top_bank_output
                args._top_seed_src = top_seeds
                del mid_src
            upper_results = fit_upper_level(args, coarse_bank, psd, flen, f_out,
                                            used_middles=used_middles)
            if upper_results is not None:
                for c_idx, u_row in enumerate(upper_results):
                    if u_row is not None and len(u_row) > 5:
                        shift_u = u_row[5]
                        c_grp_name = str(c_idx)
                        if shift_u != 0 and c_grp_name in fir_group and 'sample_shift' in fir_group[c_grp_name]:
                            fir_group[c_grp_name]['sample_shift'][:] += shift_u

        logging.info(f"Done. Saved to {args.output_file}")

    finally:
        f_out.close()
        for path in args._temp_files:
            if os.path.exists(path):
                os.remove(path)

    def _pct(x):
        x = np.asarray(x, dtype=np.float64)
        x = x[np.isfinite(x)]
        if not len(x):
            return 'n/a'
        p = np.percentile(x, [50, 90, 99, 100])
        return 'p50=%.3g p90=%.3g p99=%.3g max=%.3g' % tuple(p)

    summary_msg = (f"Summary: {failed_count}/{n_fine} templates failed acceptance "
                   f"(match >= {args.min_match}, max|tap| <= {args.max_tap_value}"
                   + (f", out-of-band gain <= {args.peak_cap_factor}" if
                      args.peak_cap_factor and args.peak_cap_mode == 'inband' else '')
                   + (f", noise gain <= {args.max_noise_gain}" if args.max_noise_gain else '')
                   + ").\n")
    if failed_idx:
        summary_msg += f"Failed indices (first 20): {sorted(failed_idx)[:20]}\n"
    if len(tap_counts):
        summary_msg += (f"Taps: mean={np.mean(tap_counts):.1f} median={np.median(tap_counts):.0f} "
                        f"min={np.min(tap_counts)} max={np.max(tap_counts)}\n")
    m = np.array([x for x in all_metrics if x is not None], dtype=np.float64).reshape(-1, 3)
    summary_msg += f"max|tap|:    {_pct(m[:, 0])}\n"
    summary_msg += f"oob gain:    {_pct(m[:, 1])}\n"
    summary_msg += f"noise gain:  {_pct(m[:, 2])}\n"
    summary_msg += (f"Peak suppression active in the final filter of {peak_suppressed_count}/{n_fine} "
                    f"templates; {peak_still_capped_count}/{n_fine} still had bins above the cap after "
                    f"{args.peak_max_passes} passes. Designs evaluated: {total_attempts} "
                    f"(suppression triggered on {total_attempts_suppressed}).\n")

    if failed_count > 0: logging.warning(summary_msg)
    else: logging.info(summary_msg)

if __name__ == '__main__':
    mp.freeze_support()
    main()
