#!/usr/bin/env python
"""Generate an Optimized Hierarchical FIR Filter Bank.

Constructs 2-level or 3-level hierarchical FIR filter banks for gravitational-wave
matched filtering. Compresses waveforms into coarse parent templates and designs
interpolating FIR filters with Toeplitz solves and out-of-band peak suppression.
"""
import os, sys, argparse, hashlib, logging, multiprocessing as mp
from collections import defaultdict

for _var in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
             "VECLIB_MAXIMUM_THREADS", "NUMEXPR_NUM_THREADS"):
    os.environ.setdefault(_var, "1")
os.environ.setdefault("HDF5_USE_FILE_LOCKING", "FALSE")
mp.set_start_method('fork', force=True)

import h5py, numpy as np, scipy.linalg
from scipy.linalg import solve_toeplitz, cho_factor, cho_solve
from scipy.spatial.distance import cdist
from tqdm import tqdm
import pycbc, pycbc.psd, pycbc.conversions as conversions
from pycbc.filter import match, get_cutoff_indices
from pycbc.types import FrequencySeries
from pycbc.waveform.bank import FilterBank, correction_basis
import pycbc.waveform.compress as compress

# --- GLOBAL WORKER STATE (Inherited via fork in worker processes) ---
g_coarse_waveforms, g_coarse_waveforms_np, g_coarse_norm_sq = None, None, None
g_coarse_tau0, g_fine_bank, g_fine_tau0, g_psd, g_args = None, None, None, None, None
g_psd_array, g_inv_psd, g_freq_slice, g_freqs, g_delta_f = None, None, None, None, None
g_fft_len, g_valid_band_mask, g_correction_basis, g_correction_band = None, None, None, None
_g_factor_cache, _g_waveform_cache = {}, {}

def init_worker(coarse_waveforms, fine_bank, psd, args_namespace):
    """Initialize spectral structures and caches in worker processes."""
    global g_coarse_waveforms, g_coarse_waveforms_np, g_coarse_norm_sq, g_coarse_tau0
    global g_fine_bank, g_fine_tau0, g_psd, g_args, g_psd_array, g_inv_psd
    global g_freq_slice, g_freqs, g_delta_f, g_fft_len, g_valid_band_mask
    global g_correction_basis, g_correction_band
    try:
        import pycbc.filter.matchedfilter as mf, pycbc.filter.matchedfilter_cpu as mc
        mf.correlate = mc.correlate_numpy
    except Exception: pass
    from pycbc.filter.matchedfilter import get_cutoff_indices

    g_args, g_coarse_waveforms, g_fine_bank, g_psd = args_namespace, coarse_waveforms, fine_bank, psd
    g_delta_f = float(psd.delta_f)
    g_psd_array = psd.numpy().astype(np.float64)
    g_fft_len = 2 * (len(g_psd_array) - 1)
    g_freqs = np.arange(len(g_psd_array)) * g_delta_f
    g_inv_psd = np.zeros_like(g_psd_array)
    np.divide(1.0, g_psd_array, out=g_inv_psd, where=g_psd_array > 0)

    k_min, k_max = get_cutoff_indices(g_args.f_low, None, g_delta_f, g_fft_len)
    g_freq_slice = slice(k_min, k_max)
    g_valid_band_mask = (g_freqs >= g_args.f_low) & (g_freqs < g_args.sample_rate / 2.0) & (g_psd_array > 0)
    g_coarse_waveforms_np = [h.numpy().astype(np.complex128) for h in coarse_waveforms]
    g_coarse_norm_sq = [float(np.sum(np.abs(h[g_freq_slice]) ** 2 * g_inv_psd[g_freq_slice])) for h in g_coarse_waveforms_np]
    g_coarse_tau0 = getattr(args_namespace, '_coarse_tau0', None)
    g_fine_tau0 = getattr(args_namespace, '_fine_tau0', None)
    g_correction_basis, g_correction_band = correction_basis(len(g_psd_array), g_delta_f, g_args.f_low, 800.0)
    logging.getLogger('pycbc').setLevel(logging.CRITICAL + 1)

# --- TOEPLITZ FILTER DESIGN ---
def hermitian_spectrum_to_correlation(frequency_bins, spectral_values, fft_len):
    """Compute real time-domain correlation from sparse Hermitian spectrum."""
    val = np.asarray(spectral_values)
    half = np.zeros(val.shape[:-1] + (fft_len // 2 + 1,), dtype=np.complex128)
    half[..., frequency_bins] = val
    half[..., 0] *= 2.0; half[..., -1] *= 2.0
    return (0.5 * fft_len) * np.fft.irfft(half, n=fft_len, axis=-1)

def tap_positions(n_taps, fft_len):
    return (np.arange(n_taps) - n_taps // 2) % fft_len

def snap_tap_count(tap_count, round_up=True):
    """Snap tap count to 8-tap SIMD boundary with minimum 15 taps."""
    steps = (tap_count - 15) / 8.0
    rounded = int(np.ceil(steps - 1e-9)) if round_up else int(np.floor(steps + 1e-9))
    return 15 + max(rounded, 0) * 8

def cached_toeplitz_solve(toeplitz_col, rhs_vector):
    """Solve symmetric Toeplitz system with Cholesky factor caching."""
    if len(toeplitz_col) > 1024: return solve_toeplitz(toeplitz_col, rhs_vector)
    key = toeplitz_col.tobytes()
    factor = _g_factor_cache.get(key)
    if factor is None:
        if len(_g_factor_cache) >= 64: _g_factor_cache.clear()
        factor = _g_factor_cache[key] = cho_factor(scipy.linalg.toeplitz(toeplitz_col), lower=True, check_finite=False)
    return cho_solve(factor, rhs_vector, check_finite=False)

def design_fft_toeplitz_filter(target_response, valid_mask, n_taps, weights, regularization, toeplitz_solver=None):
    """Design FIR filter via Toeplitz least-squares with out-of-band peak suppression."""
    fft_len = 2 * (len(target_response) - 1)
    pos = tap_positions(n_taps, fft_len)
    base_bins = np.flatnonzero(valid_mask)
    base_w, base_tgt = np.asarray(weights[base_bins], float), np.asarray(target_response[base_bins], complex)
    fitted = np.zeros(len(target_response), dtype=bool); fitted[base_bins] = True
    extra_bins, typ_w, n_passes, n_bad = np.array([], dtype=int), np.median(base_w[base_w > 0]), 0, 0

    for attempt in range(4):
        bins = np.concatenate((base_bins, extra_bins))
        w = np.concatenate((base_w, np.full(len(extra_bins), typ_w)))
        tgt = np.concatenate((base_tgt, np.zeros(len(extra_bins), dtype=complex)))
        r = hermitian_spectrum_to_correlation(bins, w ** 2, fft_len)[:n_taps].copy(); r[0] += regularization
        b = hermitian_spectrum_to_correlation(bins, tgt * (w ** 2), fft_len)[pos]
        taps = (toeplitz_solver or solve_toeplitz)(r, b)

        wave = np.zeros(fft_len, dtype=float); wave[pos] = taps
        mags = np.abs(np.fft.rfft(wave))
        cap = 10.0 * np.sqrt(np.sum(base_w ** 2 * mags[base_bins] ** 2) / np.sum(base_w ** 2))
        bad = np.flatnonzero((mags > cap) & ~fitted)
        n_bad = len(bad)
        if not n_bad or attempt == 3: break
        extra_bins = np.union1d(extra_bins, bad); n_passes += 1

    return taps, n_passes, n_bad

# --- FIT PROBLEM & TEMPLATE EVALUATION ---
def build_fit_problem(cand_idx, fine_waveform_np, ref_waveform=None, ref_norm_sq=None, ref_fs=None, shared=False):
    """Construct frequency-domain target ratio, weights, and group-delay sample shift."""
    c = int(cand_idx)
    if ref_waveform is None:
        ref_waveform, ref_norm_sq, ref_fs = g_coarse_waveforms_np[c], g_coarse_norm_sq[c], g_coarse_waveforms[c]
    band = g_valid_band_mask.copy()
    ratio, match_w = np.zeros(len(ref_waveform), complex), np.zeros(len(ref_waveform), float)
    np.divide(fine_waveform_np, ref_waveform, out=ratio, where=np.abs(ref_waveform) > 0); np.nan_to_num(ratio, copy=False)
    np.divide(np.abs(ref_waveform) ** 2, g_psd_array, out=match_w, where=band); np.nan_to_num(match_w, copy=False)
    band[np.abs(ratio) > 1000] = False
    if not band.any() or match_w[band].max() <= 0: return None
    match_w /= match_w[band].max()
    fit_w, shift = match_w ** 0.5, 0

    b = np.flatnonzero(band)
    gd = -np.gradient(np.unwrap(np.angle(ratio[b])), g_delta_f) / (2.0 * np.pi) * g_args.sample_rate
    wc = fit_w[b] ** 2
    if wc.sum() > 0: shift = int(np.round(np.sum(gd * wc) / np.sum(wc)))

    target = ratio * g_args.sample_rate
    if shift: target = target * np.exp(1j * 2.0 * np.pi * g_freqs * shift / g_args.sample_rate)
    return dict(c_idx=c, h_ref=ref_waveform, target=target, band=band, w_fit=fit_w,
                w_match=match_w, shift=shift, ref_ss=ref_norm_sq, ref_fs=ref_fs, shared=shared)

def compute_filter_frequency_response(taps):
    wave = np.zeros(g_fft_len, dtype=float); wave[tap_positions(len(taps), g_fft_len)] = taps
    return np.fft.rfft(wave)

def compute_filter_metrics(freq_response, taps, problem):
    mags, fb = np.abs(freq_response), problem['band']
    wm = problem['w_match'][fb]
    inband = np.sqrt(np.sum(wm * mags[fb] ** 2) / np.sum(wm))
    if inband <= 0: return float(np.max(np.abs(taps))), np.inf, np.inf
    oob = (mags[~fb].max() / inband) if (~fb).any() else 0.0
    return float(np.max(np.abs(taps))), float(oob), float(np.sqrt(np.mean(mags ** 2)) / inband)

def verify_filter_reconstruction(freq_response, problem, fine_waveform_np, fine_norm_sq):
    resp = freq_response / g_args.sample_rate
    if problem['shift']: resp = resp * np.exp(-1j * 2.0 * np.pi * g_freqs * problem['shift'] / g_args.sample_rate)
    sl = g_freq_slice
    rec = problem['h_ref'][sl] * resp[sl]
    ip = np.sum(np.conj(fine_waveform_np[sl]) * rec * g_inv_psd[sl])
    rec_ss = np.sum((rec.real ** 2 + rec.imag ** 2) * g_inv_psd[sl])
    m = (abs(ip) / np.sqrt(rec_ss * fine_norm_sq)) if rec_ss > 0 else 0.0
    sc = 4.0 * g_delta_f
    return float(m), (np.sqrt(sc * problem['ref_ss']), np.sqrt(sc * rec_ss), np.sqrt(sc * fine_norm_sq))

def evaluate_filter_fit(problem, n_taps, fine_waveform_np, fine_norm_sq):
    """Design FIR filter and evaluate match against target waveform."""
    taps, n_passes, n_bad = design_fft_toeplitz_filter(
        problem['target'], problem['band'], n_taps, problem['w_fit'], g_args.regularization_magnitude,
        toeplitz_solver=cached_toeplitz_solve if problem.get('shared') else None)
    taps_f32 = np.asarray(taps, dtype=np.float32)
    resp = compute_filter_frequency_response(taps_f32.astype(float))
    metrics = compute_filter_metrics(resp, taps_f32, problem)
    overlap_match, sigmas = verify_filter_reconstruction(resp, problem, fine_waveform_np, fine_norm_sq)
    is_accepted = (overlap_match >= g_args.min_match and np.isfinite(metrics[0]) and metrics[0] <= 1e5)
    return is_accepted, dict(c_idx=problem['c_idx'], n_taps=int(n_taps), match=overlap_match, taps=taps_f32,
                             sigmas=sigmas, shift=problem['shift'], metrics=metrics, n_passes=n_passes, n_bad=n_bad)

def find_minimum_taps(problem, tap_cap, fine_waveform_np, fine_norm_sq):
    """Find minimum tap count achieving target match via ladder search and bisection."""
    top = snap_tap_count(min(tap_cap, g_args.max_taps), round_up=False)
    if top < 15: return None, None
    step = 100 if top <= 1025 else 1000
    ladder = sorted(set(list(range(15, top, step)) + [top]))
    lo, hi, successful_rec, best_fail_rec = None, None, None, None

    for k in ladder:
        ok, rec = evaluate_filter_fit(problem, k, fine_waveform_np, fine_norm_sq)
        if ok: hi, successful_rec = k, rec; break
        if best_fail_rec is None or rec['match'] > best_fail_rec['match']: best_fail_rec = rec
        lo = k
    if successful_rec is None: return None, best_fail_rec

    lo = lo if lo is not None else 15 - 8
    while hi - lo > 8:
        mid = max(snap_tap_count((lo + hi) // 2, round_up=False), lo + 8)
        if mid >= hi: break
        ok, rec = evaluate_filter_fit(problem, mid, fine_waveform_np, fine_norm_sq)
        if ok: hi, successful_rec = mid, rec
        else: lo = mid
    return successful_rec, best_fail_rec

def process_template(template_idx_or_task, excluded_parents=None):
    """Match fine waveform to best coarse parent and determine minimal FIR taps."""
    if isinstance(template_idx_or_task, tuple): fine_idx, excluded_parents = template_idx_or_task
    else: fine_idx = template_idx_or_task

    fine_wave = g_fine_bank[fine_idx].copy()
    fine_np = fine_wave.numpy().astype(complex)
    sl = g_freq_slice
    fine_norm_sq = float(np.sum(np.abs(fine_np[sl]) ** 2 * g_inv_psd[sl]))

    allowed = np.arange(len(g_coarse_waveforms))
    if excluded_parents: allowed = allowed[~np.isin(allowed, np.fromiter(excluded_parents, dtype=int))]
    n_cand = min(len(allowed), 25)
    candidates = allowed[np.argsort(np.abs(g_coarse_tau0[allowed] - g_fine_tau0[fine_idx]))[:n_cand]] if (g_coarse_tau0 is not None and g_fine_tau0 is not None) else allowed

    problems, scores = {}, {}
    for c in candidates:
        prob = build_fit_problem(c, fine_np)
        if prob is None: continue
        problems[c] = prob
        try:
            taps, _, _ = design_fft_toeplitz_filter(prob['target'], prob['band'], snap_tap_count(g_args.n_taps), prob['w_fit'], g_args.regularization_magnitude)
            scores[c] = verify_filter_reconstruction(compute_filter_frequency_response(np.asarray(taps, dtype=np.float32).astype(float)), prob, fine_np, fine_norm_sq)[0]
        except Exception: pass

    ranked = sorted(scores, key=scores.get, reverse=True)
    best_rec, best_fail = None, None
    for rank, c in enumerate(ranked):
        if best_rec is not None and rank >= 3: break
        cap = g_args.max_taps if best_rec is None else best_rec['n_taps'] - 8
        try: rec, fail = find_minimum_taps(problems[c], cap, fine_np, fine_norm_sq)
        except Exception: continue
        if rec is not None and (best_rec is None or rec['n_taps'] < best_rec['n_taps']): best_rec = rec
        if fail is not None and (best_fail is None or fail['match'] > best_fail['match']): best_fail = fail

    chosen = best_rec if (best_rec is not None) else best_fail
    if chosen is None: return (fine_idx, -1.0, -1, -1.0, [], [], 0, (np.nan, np.nan, np.nan), False)

    c = chosen['c_idx']
    direct_m, _ = match(fine_wave, g_coarse_waveforms[c], psd=g_psd, low_frequency_cutoff=g_args.f_low,
                        v1_norm=fine_norm_sq * 4.0 * g_delta_f, v2_norm=g_coarse_norm_sq[c] * 4.0 * g_delta_f)
    return (fine_idx, float(direct_m), c, chosen['match'], chosen['taps'], chosen['sigmas'], chosen['shift'], chosen['metrics'], best_rec is not None)

# --- GAUSS-NEWTON PARENT OPTIMIZATION & MERGING ---
def get_cached_waveform(waveform_idx):
    hit = _g_waveform_cache.get(waveform_idx)
    if hit is None:
        fs_wave = g_fine_bank[waveform_idx].copy()
        np_wave = fs_wave.numpy().astype(complex)
        norm_sq = float(np.sum(np.abs(np_wave[g_freq_slice]) ** 2 * g_inv_psd[g_freq_slice]))
        if len(_g_waveform_cache) >= 4096: _g_waveform_cache.clear()
        hit = _g_waveform_cache[waveform_idx] = (fs_wave, np_wave, norm_sq)
    return hit

def solve_toeplitz_batch(problem, n_taps, target_matrix, regularization, fft_len):
    bins = np.flatnonzero(problem['band'])
    w2 = problem['w_fit'][bins] ** 2
    r = hermitian_spectrum_to_correlation(bins, w2, fft_len)[:n_taps].copy(); r[0] += regularization
    pos = tap_positions(n_taps, fft_len)
    b = hermitian_spectrum_to_correlation(bins, target_matrix[:, bins] * w2[None, :], fft_len)[:, pos]
    taps = cached_toeplitz_solve(r, b.T)
    wave = np.zeros((fft_len, taps.shape[1])); wave[pos] = taps
    return np.fft.rfft(wave, axis=0).T, taps

def compute_basis_corrected_parent(base_idx, correction_coeffs):
    base_fs, base_np, base_norm_sq = get_cached_waveform(base_idx)
    if correction_coeffs is None or not np.any(correction_coeffs): return base_np, base_norm_sq, base_fs
    corr_np = base_np.copy()
    corr_np[g_correction_band] *= np.exp(correction_coeffs @ g_correction_basis[:, g_correction_band])
    norm_sq = float(np.sum(np.abs(corr_np[g_freq_slice]) ** 2 * g_inv_psd[g_freq_slice]))
    return corr_np, norm_sq, FrequencySeries(corr_np, delta_f=g_delta_f, epoch=base_fs.epoch)

def evaluate_gn_linearization(task):
    base_idx, coeffs, child_indices, n_taps = task
    parent_np, parent_norm_sq, parent_fs = compute_basis_corrected_parent(base_idx, coeffs)
    n_basis, out = len(g_correction_basis), []
    for child_idx in child_indices:
        _, child_np, child_norm_sq = get_cached_waveform(child_idx)
        prob = build_fit_problem(base_idx, child_np, parent_np, parent_norm_sq, parent_fs, shared=True)
        if prob is None:
            out.append((child_idx, 1.0, 1e-10, np.zeros((n_basis, n_basis)), np.zeros(n_basis))); continue
        T0 = prob['target']
        targets = np.vstack([T0[None, :], T0[None, :] * g_correction_basis])
        resp, taps = solve_toeplitz_batch(prob, n_taps, targets, g_args.regularization_magnitude, g_fft_len)
        rec_resp = compute_filter_frequency_response(taps[:, 0].astype(np.float32).astype(float))
        mis = 1.0 - verify_filter_reconstruction(rec_resp, prob, child_np, child_norm_sq)[0]
        bins = np.flatnonzero(prob['band'])
        w = prob['w_fit'][bins]
        rho = (resp[0] - T0)[bins] * w
        J = ((T0[None, :] * g_correction_basis - resp[1:])[:, bins] * w[None, :])
        out.append((child_idx, mis, float(np.sum(np.abs(rho) ** 2)), np.real(np.conj(J) @ J.T), np.real(np.conj(J) @ rho)))
    return out

def evaluate_gn_matches(task):
    base_idx, coeffs, child_indices, n_taps, abort_threshold = task
    parent_np, parent_norm_sq, parent_fs = compute_basis_corrected_parent(base_idx, coeffs)
    out = []
    for step_idx, child_idx in enumerate(child_indices):
        _, child_np, child_norm_sq = get_cached_waveform(child_idx)
        prob = build_fit_problem(base_idx, child_np, parent_np, parent_norm_sq, parent_fs, shared=True)
        if prob is None: mis, ok = 1.0, False
        else:
            ok, rec = evaluate_filter_fit(prob, n_taps, child_np, child_norm_sq)
            mis = 1.0 - rec['match']
        out.append((child_idx, mis, ok))
        if abort_threshold is not None and mis >= abort_threshold:
            out.extend((j, np.inf, False) for j in child_indices[step_idx + 1:]); break
    return out

def optimize_parent_waveform(pool, child_group, base_cand, args, initial_coeffs=None, child_order=None):
    max_taps = args.max_taps
    cap_taps = max_taps if max_taps % 2 else max_taps - 1
    min_match, n_basis = getattr(args, 'min_match', 0.9999), 20
    coeffs = np.zeros(n_basis, dtype=float) if initial_coeffs is None else np.array(initial_coeffs, dtype=float).copy()
    n_chunks = max(1, min(len(child_group), 4 * getattr(args, 'n_processes', 8)))
    ordered = [int(x) for x in (child_order if child_order is not None else child_group)]
    chunks = [c for c in [ordered[j::n_chunks] for j in range(n_chunks)] if c]

    def _parallel_eval(func, cur_coeffs, extra):
        return [item for sub in pool.imap_unordered(func, [(base_cand, cur_coeffs, c) + extra for c in chunks]) for item in sub]

    k_eval = snap_tap_count(int(0.85 * max_taps))
    best_coeffs, best_failures, best_worst = coeffs.copy(), None, np.inf
    for _ in range(3):
        mu, p_norm, reg = 1e-2, 8.0, 1e-3
        for _ in range(8):
            lin = _parallel_eval(evaluate_gn_linearization, coeffs, (k_eval,))
            mis = np.array([row[1] for row in lin])
            worst = mis.max()
            if worst <= (1.0 - min_match): break
            weights = (mis / worst) ** p_norm
            A, g = np.zeros((n_basis, n_basis)), np.zeros(n_basis)
            for (_, m, res_norm, jt_j, jt_r), w in zip(lin, weights):
                s = w * m / max(res_norm, 1e-300)
                A += s * jt_j; g += s * jt_r
            scale = np.trace(A) / n_basis
            if scale <= 0: break
            accepted = False
            for _ in range(6):
                d_coeffs = -np.linalg.solve(A + (mu + reg) * scale * np.eye(n_basis), g + reg * scale * coeffs)
                trial = _parallel_eval(evaluate_gn_matches, coeffs + d_coeffs, (k_eval, worst))
                if max(row[1] for row in trial) < worst:
                    coeffs, mu, accepted = coeffs + d_coeffs, max(mu / 3.0, 1e-6), True; break
                mu *= 4.0
            if not accepted: break

        cap_eval = _parallel_eval(evaluate_gn_matches, coeffs, (cap_taps, None))
        n_fail, worst_cap = sum(1 for _, _, ok in cap_eval if not ok), max(row[1] for row in cap_eval)
        if best_failures is None or (n_fail, worst_cap) < (best_failures, best_worst):
            best_coeffs, best_failures, best_worst = coeffs.copy(), n_fail, worst_cap
        if best_failures == 0: break
    return best_coeffs, best_failures

def check_merge_candidate(task):
    cand_idx, children, screening_limit = task
    ref_fs, ref_np, ref_norm_sq = get_cached_waveform(cand_idx)
    cap_taps = g_args.max_taps if g_args.max_taps % 2 else g_args.max_taps - 1
    limit = screening_limit * (1.0 - g_args.min_match) if screening_limit and screening_limit > 0 else None
    n_passed, worst_mis = None, 0.0

    for step_num, child_idx in enumerate(children):
        if child_idx == cand_idx: continue
        _, child_np, child_norm_sq = get_cached_waveform(child_idx)
        prob = build_fit_problem(cand_idx, child_np, ref_np, ref_norm_sq, ref_fs, shared=True)
        if prob is None: ok, mis = False, 1.0
        else:
            ok, rec = evaluate_filter_fit(prob, cap_taps, child_np, child_norm_sq)
            mis = 1.0 - rec['match']
        worst_mis = max(worst_mis, mis)
        if not ok and n_passed is None:
            n_passed = step_num
            if limit is None: return cand_idx, step_num, np.inf
        if limit is not None and mis > limit: return cand_idx, n_passed, np.inf
    return cand_idx, len(children) if n_passed is None else n_passed, worst_mis

def fit_child_to_parent(task):
    child_idx, parent_idx, coeffs = task
    parent_np, parent_norm_sq, parent_fs = compute_basis_corrected_parent(parent_idx, coeffs)
    child_fs, child_np, child_norm_sq = get_cached_waveform(child_idx)
    prob = build_fit_problem(parent_idx, child_np, parent_np, parent_norm_sq, parent_fs, shared=True)
    if prob is None: return (child_idx, None)
    rec, _ = find_minimum_taps(prob, g_args.max_taps, child_np, child_norm_sq)
    if rec is None: return (child_idx, None)
    direct_m, _ = match(child_fs, parent_fs, psd=g_psd, low_frequency_cutoff=g_args.f_low,
                        v1_norm=child_norm_sq * 4.0 * g_delta_f, v2_norm=parent_norm_sq * 4.0 * g_delta_f)
    return (child_idx, (float(direct_m), parent_idx, rec['match'], rec['taps'], rec['sigmas'], rec['shift'], rec['metrics']))

# --- FEATURES, PRUNING & CONSOLIDATION ---
def extract_bank_features(bank, f_low):
    table = bank.table
    names = table.dtype.names
    m1, m2 = np.asarray(table['mass1'], float), np.asarray(table['mass2'], float)
    tau0 = np.asarray(table['tau0'], float) if 'tau0' in names else conversions.tau0_from_mass1_mass2(m1, m2, f_low)
    tau3 = np.asarray(table['tau3'], float) if 'tau3' in names else conversions.tau3_from_mass1_mass2(m1, m2, f_low)
    s1 = np.asarray(table['spin1z'], float) if 'spin1z' in names else 0.0 * m1
    s2 = np.asarray(table['spin2z'], float) if 'spin2z' in names else 0.0 * m1
    return np.stack([tau0, tau3, conversions.chi_eff(m1, m2, s1, s2)], axis=1)

def prune_redundant_parents(pool, results, n_processes, label='middle'):
    """Prune parent templates whose children can be reabsorbed into other parents."""
    parent_groups = defaultdict(list)
    for i, row in enumerate(results):
        if row is not None and row[1] >= 0: parent_groups[row[1]].append(i)
    removed, batch_size = set(), max(4 * n_processes, 16)

    for parent in sorted(parent_groups, key=lambda p: (len(parent_groups[p]), p)):
        children = list(parent_groups[parent])
        if not children: continue
        excluded = frozenset(removed | {parent})
        reassignments, all_absorbed = {}, True
        for start in range(0, len(children), batch_size):
            tasks = [(c_idx, excluded) for c_idx in children[start:start + batch_size]]
            for res in pool.imap_unordered(process_template, tasks):
                if not res[8]: all_absorbed = False
                reassignments[res[0]] = res
            if not all_absorbed: break
        if not all_absorbed: continue

        for c_idx, res in reassignments.items():
            results[c_idx] = res[1:8]
            parent_groups[res[2]].append(c_idx)
        parent_groups[parent] = []; removed.add(parent)
        logging.info('Pruned %s parent %d: reabsorbed %d children (%d removed)', label, parent, len(children), len(removed))
    return removed

def merge_parent_groups(pool, results, features, args, label='middle', parent_corrections=None, base_corrections=None):
    """Merge neighboring parent groups using coordinate distance and Gauss-Newton optimization."""
    groups = defaultdict(set)
    for i, r in enumerate(results):
        if r is not None and r[1] >= 0: groups[r[1]].add(i)

    tau0 = features[:, 0]
    tried_pairs, n_merges, has_progress = set(), 0, True
    while has_progress:
        has_progress = False
        for p in sorted(groups, key=lambda g: (len(groups[g]), g)):
            if p not in groups: continue
            if len(groups[p]) > 140: break
            other_parents = np.array([q for q in groups if q != p], dtype=int)
            if not len(other_parents): break

            for q in other_parents[np.argsort(np.abs(tau0[other_parents] - tau0[p]))][:3]:
                q = int(q)
                pair_key = (min(p, q), max(p, q), len(groups[p]), len(groups[q]))
                if pair_key in tried_pairs: continue
                tried_pairs.add(pair_key)

                union_children = np.array(sorted(groups[p] | groups[q]), dtype=int)
                candidate_pool = np.unique(np.concatenate([union_children, [p, q]]))
                feat_u, feat_p = features[union_children], features[candidate_pool]
                span = np.maximum(feat_u.max(axis=0) - feat_u.min(axis=0), 1e-12)
                distances = cdist(feat_p / span, feat_u / span)
                radii = dict(zip(candidate_pool, distances.max(axis=1)))
                top_cands = candidate_pool[np.argsort(distances.max(axis=1))[:16]]

                tasks = [(int(c), [int(x) for x in union_children[np.argsort(-distances[np.where(candidate_pool == c)[0][0]])]], 30.0) for c in top_cands]
                order_map = {t[0]: t[1] for t in tasks}
                check_results = list(pool.imap_unordered(check_merge_candidate, tasks))
                fully_passed = {c for c, count, _ in check_results if count == len(union_children)}

                chosen_parent, chosen_coeffs = next((int(c) for c in top_cands if int(c) in fully_passed), None), None
                if chosen_parent is not None:
                    chosen_coeffs = np.zeros(20)
                else:
                    pass_counts = {int(c): int(n) for c, n, _ in check_results}
                    min_needed = max(1, int(0.5 * len(union_children)))
                    if pass_counts and max(pass_counts.values()) >= min_needed:
                        viable = [(worst, radii[int(c)], int(c)) for c, _, worst in check_results if np.isfinite(worst) and pass_counts.get(int(c), 0) >= min_needed]
                        best_cand = min(viable)[2] if viable else int(max(top_cands, key=lambda c: (pass_counts.get(int(c), 0), -radii[int(c)])))
                        opt_coeffs, n_fail = optimize_parent_waveform(pool, union_children, best_cand, args, child_order=order_map[best_cand])
                        if n_fail == 0: chosen_parent, chosen_coeffs = best_cand, opt_coeffs

                if chosen_parent is None: continue
                refit_rows = dict(pool.imap_unordered(fit_child_to_parent, [(int(i), chosen_parent, chosen_coeffs) for i in union_children], chunksize=4))
                if any(row is None for row in refit_rows.values()): continue

                for c_idx, row in refit_rows.items(): results[c_idx] = row
                if parent_corrections is not None:
                    base_z = np.array(base_corrections[chosen_parent], float) if (base_corrections is not None and chosen_parent < len(base_corrections)) else np.zeros(20)
                    parent_corrections[chosen_parent] = base_z + chosen_coeffs
                    parent_corrections.pop(p, None); parent_corrections.pop(q, None)

                del groups[p], groups[q]
                groups[chosen_parent] = set(int(i) for i in union_children)
                n_merges += 1; has_progress = True
                logging.info('Merged %s groups %d + %d -> parent %d (%d children, opt=%s); %d left',
                             label, p, q, chosen_parent, len(union_children), bool(chosen_coeffs is not None and np.any(chosen_coeffs)), len(groups))
                break
    return n_merges

def consolidate_hierarchy_level(pool, results, parent_source_indices, child_bank, args, label):
    """Consolidate parent templates, merge groups, and remap indices."""
    rows = [None if r is None else (r[0], int(parent_source_indices[r[1]])) + tuple(r[2:]) for r in results]
    base_corrections = getattr(child_bank, 'correction_coeffs', None)
    parent_corrections = {
        int(s): np.array(base_corrections[int(s)], float).copy() if (base_corrections is not None and int(s) < len(base_corrections)) else np.zeros(20)
        for s in parent_source_indices
    }
    feats = extract_bank_features(child_bank, args.f_low)
    n_before = len({r[1] for r in rows if r is not None})
    n_merged = merge_parent_groups(pool, rows, feats, args, label, parent_corrections=parent_corrections, base_corrections=base_corrections)
    logging.info('Group merging: %d merges, %d -> %d %s templates in use', n_merged, n_before, len({r[1] for r in rows if r is not None}), label)

    used_parents = np.array(sorted({r[1] for r in rows if r is not None}), dtype=int)
    pos_map = {int(s): k for k, s in enumerate(used_parents)}
    remapped_rows = [None if r is None else (r[0], pos_map[r[1]]) + tuple(r[2:]) for r in rows]
    return remapped_rows, used_parents, np.array([parent_corrections.get(int(s), np.zeros(20)) for s in used_parents], float)

# --- I/O AND SEED SELECTION ---
def write_fir_groups(parent_hdf_group, all_results, match_dtype='float32'):
    """Write FIR tap tables and metadata datasets into HDF5 group."""
    groups = defaultdict(list)
    for i, r in enumerate(all_results):
        if r is not None and r[1] >= 0: groups[r[1]].append(r + (i,))
    comp = dict(shuffle=True, compression='gzip', compression_opts=9)
    tap_counts = []

    for parent_idx, rows in groups.items():
        grp = parent_hdf_group.create_group(str(parent_idx))
        counts = np.array([len(r[3]) for r in rows], dtype=np.int32)
        max_k = int(counts.max())
        taps_array = np.zeros((len(rows), max_k), dtype=np.float32)
        for j, r in enumerate(rows): taps_array[j, :counts[j]] = r[3]
        grp.create_dataset('taps', data=taps_array, chunks=(len(rows), max_k), **comp)
        metrics = np.array([r[6] for r in rows], dtype=np.float32)

        for name, data, dtype in (
            ('actual_tap_count', counts, 'int32'), ('fine_bank_index', [r[-1] for r in rows], 'int32'),
            ('filter_match', [r[2] for r in rows], match_dtype), ('coarse_match', [r[0] for r in rows], 'float32'),
            ('sigmas', [r[4] for r in rows], 'float32'), ('sample_shift', [r[5] for r in rows], 'int32'),
            ('max_tap', metrics[:, 0], 'float32'), ('oob_gain', metrics[:, 1], 'float32'), ('noise_gain', metrics[:, 2], 'float32'),
        ):
            grp.create_dataset(name, data=np.asarray(data, dtype=dtype), chunks=True, **comp)
        tap_counts.append(counts)
    return np.concatenate(tap_counts) if tap_counts else np.array([], dtype=int)

def write_seed_bank(src_path, seed_indices, dst_path, force=False, correction_coeffs=None):
    """Write seed bank subset to HDF5 file with source provenance tracking."""
    seed_indices = np.asarray(seed_indices, dtype=int)
    if os.path.exists(dst_path) and not force:
        raise ValueError(f'{dst_path} exists; refusing to overwrite (use --force)')
    with h5py.File(src_path, 'r') as src, h5py.File(dst_path, 'w') as dst:
        n_templates = len(src['tau0']) if 'tau0' in src else None
        skip = {'template_hash', 'seed_source_index', 'correction_coeffs'}
        for key, obj in src.items():
            if isinstance(obj, h5py.Dataset) and key not in skip and obj.shape and obj.shape[0] == n_templates:
                dst.create_dataset(key, data=obj[:][seed_indices])
        dst.attrs.update(src.attrs)
        dst.attrs['seed_source_bank'] = os.path.abspath(src_path)
        dst.attrs['seed_source_sha256'] = compute_file_sha256(src_path)
        dst.create_dataset('seed_source_index', data=seed_indices.astype(np.int64))
        if correction_coeffs is not None:
            dst.create_dataset('correction_coeffs', data=np.asarray(correction_coeffs, float))
        elif 'correction_coeffs' in src:
            dst.create_dataset('correction_coeffs', data=src['correction_coeffs'][:][seed_indices])
    logging.info('Wrote %d seeds to %s', len(seed_indices), dst_path)

def compute_file_sha256(file_path):
    with open(file_path, 'rb') as f: return hashlib.file_digest(f, 'sha256').hexdigest()

def cluster_seeds_by_filter_match(target_taps, dtau_max, direct_min, density_window, min_group_size, rng_seed):
    """Cluster waveforms via tau0 density and FIR filter feasibility."""
    tau0 = g_coarse_tau0
    rng = np.random.default_rng(rng_seed)
    k_target = target_taps if target_taps % 2 else target_taps - 1
    k_absorb = g_args.max_taps if g_args.max_taps % 2 else g_args.max_taps - 1

    def can_filter_fit(seed_idx, cand_idx, tap_count):
        prob = build_fit_problem(seed_idx, g_coarse_waveforms_np[cand_idx])
        return False if prob is None else evaluate_filter_fit(prob, tap_count, g_coarse_waveforms_np[cand_idx], g_coarse_norm_sq[cand_idx])[0]

    def compute_direct_match(seed_idx, cand_idx):
        m, _ = match(g_coarse_waveforms[cand_idx], g_coarse_waveforms[seed_idx], psd=g_psd, low_frequency_cutoff=g_args.f_low,
                     v1_norm=g_coarse_norm_sq[cand_idx] * 4.0 * g_delta_f, v2_norm=g_coarse_norm_sq[seed_idx] * 4.0 * g_delta_f)
        return float(m)

    def grow_cluster(seed_idx, candidate_pool):
        return [seed_idx] + [int(c) for c in candidate_pool if int(c) != seed_idx
                             and abs(tau0[int(c)] - tau0[seed_idx]) <= dtau_max
                             and (direct_min <= 0 or compute_direct_match(seed_idx, int(c)) >= direct_min)
                             and can_filter_fit(seed_idx, int(c), k_target)]

    unassigned, clusters = set(range(len(g_coarse_waveforms_np))), []
    while unassigned:
        unassigned_array = np.fromiter(unassigned, int, len(unassigned))
        t_unassigned = tau0[unassigned_array]
        sample_indices = rng.choice(len(unassigned_array), size=100, replace=False) if len(unassigned_array) > 200 else np.arange(len(unassigned_array))
        densities = [np.sum(np.abs(t_unassigned - t_unassigned[j]) < density_window) for j in sample_indices]
        seed = int(unassigned_array[sample_indices[int(np.argmax(densities))]])

        members = grow_cluster(seed, unassigned_array)
        if len(members) > 2:
            tau0_members = tau0[members]
            medoid_idx = int(members[np.argmin(np.abs(tau0_members - np.median(tau0_members)))])
            if medoid_idx != seed:
                alt_members = grow_cluster(medoid_idx, unassigned_array)
                if len(alt_members) >= len(members): seed, members = medoid_idx, alt_members

        unassigned.difference_update(members)
        clusters.append((seed, members))

    if min_group_size > 1:
        large_clusters = [c for c in clusters if len(c[1]) >= min_group_size]
        large_seeds = np.array([c[0] for c in large_clusters], dtype=int)
        retained = list(large_clusters)
        for seed, members in clusters:
            if len(members) >= min_group_size: continue
            is_absorbed = len(large_seeds) > 0
            for m in members:
                if not is_absorbed: break
                nearby_seeds = large_seeds[np.argsort(np.abs(tau0[large_seeds] - tau0[m]))][:5]
                is_absorbed = any(can_filter_fit(int(s2), m, k_absorb) for s2 in nearby_seeds if abs(tau0[s2] - tau0[m]) <= 1.5 * dtau_max)
            if not is_absorbed: retained.append((seed, members))
        clusters = retained

    return sorted(c[0] for c in clusters)

g_seed_source_context = None
def _seed_clustering_worker(task):
    chunk_id, indices, tau0_chunk = task
    bank, psd, args_ns, seed_params = g_seed_source_context
    worker_args = argparse.Namespace(**vars(args_ns))
    worker_args._coarse_tau0 = np.asarray(tau0_chunk, float); worker_args._fine_tau0 = None
    init_worker([bank[int(i)].copy() for i in indices], None, psd, worker_args)
    return [int(indices[s]) for s in cluster_seeds_by_filter_match(*seed_params[:5], seed_params[5] + chunk_id)]

def select_bank_seeds(bank, psd, args, seed_params, candidate_indices, n_processes, desc):
    """Partition bank into tau0 chunks and select seeds via parallel clustering."""
    global g_seed_source_context
    tau0_all = np.array(bank.table['tau0'], float)
    order = np.asarray(candidate_indices, int)[np.argsort(tau0_all[np.asarray(candidate_indices, int)], kind='stable')]
    chunks = [c for c in np.array_split(order, max(1, n_processes)) if len(c)]
    g_seed_source_context = (bank, psd, args, seed_params)
    selected_seeds = []
    with mp.Pool(processes=max(1, min(n_processes, len(chunks)))) as pool:
        tasks = [(chunk_id, chunk, tau0_all[chunk]) for chunk_id, chunk in enumerate(chunks)]
        for chunk_seeds in tqdm(pool.imap_unordered(_seed_clustering_worker, tasks), total=len(chunks), desc=desc, disable=bool(args.verbose), file=sys.stderr):
            selected_seeds.extend(chunk_seeds)
    g_seed_source_context = None
    return np.array(sorted(selected_seeds), int)

# --- CLI PARSER ---
def parse_cli():
    """Parse command line arguments for essential parameters."""
    parser = argparse.ArgumentParser(description="Generate Optimized Hierarchical FIR Filter Bank")
    pycbc.add_common_pycbc_options(parser)
    pycbc.psd.insert_psd_option_group(parser)

    # File I/O
    parser.add_argument('--fine-bank', required=True, help="Input fine template bank HDF5 file.")
    parser.add_argument('--output-file', required=True, help="Output FIR filter bank HDF5 file.")
    parser.add_argument('--delta-f', type=float, required=True, help="Frequency resolution in Hz.")
    parser.add_argument('--f-low', type=float, default=20.0, help="Low-frequency cutoff in Hz (default: 20).")
    parser.add_argument('--sample-rate', type=float, default=2048.0, help="Sampling rate in Hz (default: 2048).")
    parser.add_argument('--n-processes', '-n', type=int, default=1, help="Number of worker processes (default: 1).")
    parser.add_argument('--force', action='store_true', help="Overwrite existing output files.")

    # Primary filter parameters
    parser.add_argument('--min-match', type=float, default=0.9999, help="Minimum filter match threshold (default: 0.9999).")
    parser.add_argument('--max-taps', type=int, default=501, help="Maximum allowed tap count for middle level (default: 501).")
    parser.add_argument('--upper-max-taps', type=int, default=6001, help="Maximum allowed tap count for top level (default: 6001).")
    return parser.parse_args()

# --- PIPELINE LEVEL RUNNER ---
def run_hierarchy_level(child_path, parent_seed_path, freq_len, delta_f, psd, args,
                        child_indices=None, label='middle', seed_params=None):
    """Run seeding, template fitting, pruning, and consolidation for a single level."""
    logging.info("Bottom-up seeding: selecting %s templates...", label)
    child_bank = FilterBank(child_path, freq_len, delta_f, dtype=complex, enable_compressed_waveforms=False)
    candidates = np.arange(len(child_bank)) if child_indices is None else child_indices
    seed_source_indices = select_bank_seeds(child_bank, psd, args, seed_params, candidates, args.n_processes, f"Seeding {label} level")
    write_seed_bank(child_path, seed_source_indices, parent_seed_path, force=True)

    parent_bank = FilterBank(parent_seed_path, freq_len, delta_f, dtype=complex, enable_compressed_waveforms=False)
    parent_waveforms = [h.copy() for h in parent_bank]
    indices = list(range(len(child_bank))) if child_indices is None else list(child_indices)
    args._coarse_tau0 = np.array(parent_bank.table['tau0'], float) if hasattr(parent_bank, 'table') and 'tau0' in parent_bank.table.dtype.names else None
    args._fine_tau0 = np.array(child_bank.table['tau0'], float) if hasattr(child_bank, 'table') and 'tau0' in child_bank.table.dtype.names else None

    results, failed_count = [None] * len(child_bank), 0
    with mp.Pool(processes=args.n_processes, initializer=init_worker, initargs=(parent_waveforms, child_bank, psd, args)) as pool:
        it = pool.imap_unordered(process_template, indices, chunksize=8)
        if not args.verbose:
            it = tqdm(it, total=len(indices), desc=f"Fitting {label} level", postfix={"failed": 0}, file=sys.stderr)
        for res in it:
            fine_idx, parent_match, parent_idx, match_val, taps, sigmas, shift, metrics, accepted = res
            results[fine_idx] = (parent_match, parent_idx, match_val, taps, sigmas, shift, metrics)
            if not accepted: failed_count += 1
            if not args.verbose: it.set_postfix(failed=failed_count)

        if failed_count:
            failed_indices = [idx for idx in indices if results[idx] is None or not (results[idx][2] >= args.min_match)]
            logging.info("Self-healing: promoting %d unabsorbed %s template(s) to parent seeds", len(failed_indices), label)
            identity_taps = np.zeros(15, dtype=np.float32)
            identity_taps[7] = float(args.sample_rate)
            identity_metrics = (float(args.sample_rate), 1.0, 1.0)
            psd_arr = psd.numpy() if hasattr(psd, 'numpy') else np.asarray(psd)
            k_min, k_max = get_cutoff_indices(args.f_low, None, delta_f, freq_len)
            inv_psd = np.zeros_like(psd_arr)
            np.divide(1.0, psd_arr, out=inv_psd, where=psd_arr > 0)
            sl = slice(k_min, k_max)

            for f_idx in failed_indices:
                new_parent_pos = len(seed_source_indices)
                src_seed = candidates[f_idx] if child_indices is not None else f_idx
                seed_source_indices = np.append(seed_source_indices, src_seed)
                f_np = child_bank[f_idx].numpy().astype(complex)
                norm_sq = float(np.sum(np.abs(f_np[sl]) ** 2 * inv_psd[sl]))
                sigma_val = float(np.sqrt(4.0 * delta_f * norm_sq))
                results[f_idx] = (1.0, new_parent_pos, 1.0, identity_taps, (sigma_val, sigma_val, sigma_val), 0, identity_metrics)
            failed_count = 0

        n_used = len({r[1] for r in results if r is not None and r[1] >= 0})
        removed = prune_redundant_parents(pool, results, args.n_processes, label=label)
        logging.info('Seed pruning: %d -> %d %s templates in use', n_used, n_used - len(removed), label)
        results, used_indices, corrections = consolidate_hierarchy_level(pool, results, seed_source_indices, child_bank, args, label)
        if getattr(parent_bank, 'file', None): parent_bank.file.close()
        write_seed_bank(child_path, used_indices, parent_seed_path, force=True, correction_coeffs=corrections)
        parent_bank = FilterBank(parent_seed_path, freq_len, delta_f, dtype=complex, enable_compressed_waveforms=False)
        parent_waveforms = [h.copy() for h in parent_bank]

    return results, parent_bank, parent_waveforms, failed_count

# --- MAIN PIPELINE ---
def main():
    args = parse_cli()
    args.n_taps = snap_tap_count(args.max_taps // 2)
    args.regularization_magnitude = 1e-2
    global g_args; g_args = args

    if os.path.exists(args.output_file) and not args.force:
        sys.exit(f'Error: {args.output_file} exists; refusing to overwrite (use --force)')

    pycbc.init_logging(args.verbose)
    log = logging.getLogger()
    if args.verbose > 0 and log.handlers and isinstance(log.handlers[0], logging.StreamHandler):
        log.handlers[0].stream = sys.stdout

    flen = int((args.sample_rate / 2.0) / args.delta_f) + 1
    logging.info(f"Setup: Rate={args.sample_rate}, df={args.delta_f}, flen={flen}")
    psd = pycbc.psd.from_cli(args, length=flen, delta_f=args.delta_f, low_frequency_cutoff=args.f_low)

    fine_bank = FilterBank(args.fine_bank, flen, args.delta_f, dtype=complex, enable_compressed_waveforms=False)
    n_fine = len(fine_bank)
    out_file = fine_bank.write_to_hdf(args.output_file, force=True, write_compressed_waveforms=True)
    fir_group = out_file.require_group("fir_data")
    for arg_name, arg_val in vars(args).items():
        if arg_val is not None and isinstance(arg_val, (int, float, str)): fir_group.attrs[arg_name] = arg_val

    mid_seed_path = args.output_file + '.mid.tmp.hdf'
    top_seed_path = args.output_file + '.top.tmp.hdf'

    try:
        # Level 1: Fine -> Middle
        seed_params_mid = (args.max_taps, 3.5 * min(1.0, args.max_taps / 501.0), 0.28, 1.0, 24, 12345)
        all_results, coarse_bank, _, failed_count = run_hierarchy_level(
            args.fine_bank, mid_seed_path, flen, args.delta_f, psd, args,
            label='middle', seed_params=seed_params_mid)

        coarse_bank.write_to_hdf(args.output_file, file_handler=out_file, group_key="fir_data/coarse_bank_params", write_compressed_waveforms=True)
        tap_counts = write_fir_groups(fir_group, all_results)

        if failed_count: raise ValueError(f'{failed_count} lower-level FIR fits failed; refusing hierarchy generation')
        used_middles = sorted({row[1] for row in all_results if row is not None and row[1] >= 0})
        upper_df = args.delta_f / 16.0
        upper_flen = int((args.sample_rate / 2.0) / upper_df) + 1
        upper_psd_args = argparse.Namespace(**vars(args)); upper_psd_args.delta_f = upper_df
        upper_psd = pycbc.psd.from_cli(upper_psd_args, length=upper_flen, delta_f=upper_df, low_frequency_cutoff=args.f_low)

        upper_args = argparse.Namespace(**vars(args))
        upper_args.delta_f = upper_df
        upper_args.n_taps = snap_tap_count(args.upper_max_taps // 2)
        upper_args.max_taps = args.upper_max_taps
        upper_args.min_match = 1.0 - (1.0 - args.min_match) / 10.0
        upper_args.regularization_magnitude = 1e-6

        # Level 2: Middle -> Top
        seed_params_top = (upper_args.n_taps, 15.0, 0.10, 3.0, 1, 12345)
        upper_results, top_bank, top_waveforms, _ = run_hierarchy_level(
            mid_seed_path, top_seed_path, upper_flen, upper_df, upper_psd, upper_args,
            child_indices=used_middles, label='top', seed_params=seed_params_top)

        top_bank.ensure_hash()
        top_bank.write_to_hdf(args.output_file, file_handler=out_file, group_key='fir_data/upper/top_bank_params', write_compressed_waveforms=True)

        logging.info(f"Compressing {len(top_bank)} top waveforms...")
        top_grp = out_file.require_group('fir_data/upper/top_bank_params')
        if 'template_hash' not in top_grp:
            top_grp.create_dataset('template_hash', data=top_bank.table.template_hash)
        else:
            top_grp['template_hash'][:] = top_bank.table.template_hash
        if 'compressed_waveforms' in top_grp: del top_grp['compressed_waveforms']

        for i in range(len(top_bank)):
            wave, tmplt = top_waveforms[i], top_bank.table[i]
            thash, fmin, kmax = str(tmplt.template_hash), float(getattr(tmplt, 'f_lower', args.f_low)), int(np.nonzero(abs(wave.numpy()))[0][-1])
            hc = compress.compress_waveform(wave, np.array([fmin, kmax * upper_df], float), 1e-5, 'inline_quadratic', 'single', psd=None)
            hc.write_to_hdf(top_grp, thash)
            logging.info(f"Compressed top {i + 1}/{len(top_bank)} (hash={thash}, points={len(hc.sample_points)}, mismatch={hc.mismatch:.2e})")

        upper_group = out_file.require_group('fir_data/upper')
        for name in ('sample_rate', 'delta_f', 'n_taps', 'max_taps', 'min_match'):
            upper_group.attrs[name] = getattr(upper_args, name)
        upper_group.attrs['fit_solver'] = 'toeplitz'
        upper_group.attrs['sample_shift_folded_into_lower'] = 1

        write_fir_groups(upper_group, upper_results, match_dtype='float64')
        fir_group.attrs['hierarchy_version'] = 2
        fir_group.attrs['fine_bank_sha256'] = compute_file_sha256(args.fine_bank)
        fir_group.attrs['middle_bank_sha256'] = compute_file_sha256(mid_seed_path)
        fir_group.attrs['top_bank_sha256'] = compute_file_sha256(top_seed_path)

        for c_idx, u_row in enumerate(upper_results):
            if u_row is not None and len(u_row) > 5 and u_row[5] != 0 and str(c_idx) in fir_group and 'sample_shift' in fir_group[str(c_idx)]:
                fir_group[str(c_idx)]['sample_shift'][:] += u_row[5]

        out_file.close()
        logging.info(f"Done. Saved to {args.output_file}")
    finally:
        for p in (mid_seed_path, top_seed_path):
            if os.path.exists(p): os.remove(p)

    all_metrics = [r[6] for r in all_results if r is not None and len(r) > 6 and r[6] is not None]
    tap_arr = np.asarray(tap_counts) if len(tap_counts) else np.array([0])
    logging.info(
        f"Summary: {failed_count}/{n_fine} failed (match >= {args.min_match}).\n"
        f"Taps: mean={tap_arr.mean():.1f} median={np.median(tap_arr):.0f} min={tap_arr.min()} max={tap_arr.max()}\n"
        + ("\n".join([
            f"{name:<12} p50={np.percentile([m[idx] for m in all_metrics if np.isfinite(m[idx])], 50):.3g} "
            f"p90={np.percentile([m[idx] for m in all_metrics if np.isfinite(m[idx])], 90):.3g} "
            f"p99={np.percentile([m[idx] for m in all_metrics if np.isfinite(m[idx])], 99):.3g} "
            f"max={np.max([m[idx] for m in all_metrics if np.isfinite(m[idx])]):.3g}"
            for idx, name in enumerate(('max|tap|:', 'oob gain:', 'noise gain:'))
        ]) if all_metrics else "")
    )

if __name__ == '__main__':
    main()
