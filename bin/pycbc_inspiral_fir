tstart = time.time()
TIMERS = collections.defaultdict(float)


def drop_unfindable_injections(segments, inj_filter_rejector, instruments):
    """Apply the rejector's optimal-SNR cut once every segment has its PSD.

    Each injection's optimal SNR is computed per detector from the injected
    signal and the PSD of the segment(s) it falls in. An injection whose best
    value over all detectors is below the threshold loses its analysis window
    in every detector; a segment left with no injection window is then not
    searched at all. The injection stays in the data."""
    rejs = {ifo: (inj_filter_rejector or {}).get(ifo) for ifo in instruments}
    thr = {
        r.optimal_snr_threshold
        for r in rejs.values()
        if r is not None and r.optimal_snr_threshold is not None
    }
    if not thr:
        return
    if len(thr) > 1:
        raise ValueError(
            "--injection-filter-rejector-optimal-snr-threshold must be "
            "the same for every detector"
        )
    thr = thr.pop()
    # Keyed by row in the injection file: each detector's analyze_injections
    # rows index its own injected subset, mapped through its rejector.
    snr = collections.defaultdict(dict)  # file row -> {ifo: optimal SNR}
    for ifo in instruments:
        rej = rejs.get(ifo)
        if rej is None:
            continue
        for st in segments[ifo]:
            for _, _, row in getattr(st, "analyze_injections", None) or []:
                fid = int(rej.injection_ids[row])
                value = rej.optimal_snr(fid, st.psd)
                if value is None:
                    raise ValueError(
                        "no stored signal for injection %d in %s; was the "
                        "rejector passed when the injections were made?" % (fid, ifo)
                    )
                snr[fid][ifo] = max(snr[fid].get(ifo, 0.0), value)
    keep = {fid for fid, by_ifo in snr.items() if max(by_ifo.values()) >= thr}
    for fid in sorted(snr):
        logging.info(
            "Injection %d optimal SNR %s: %s",
            fid,
            " ".join("%s %.2f" % kv for kv in sorted(snr[fid].items())),
            "analyze" if fid in keep else "skip",
        )
    for ifo in instruments:
        ids = rejs[ifo].injection_ids if rejs.get(ifo) is not None else None
        for st in segments[ifo]:
            injs = getattr(st, "analyze_injections", None)
            if injs is None or ids is None:
                continue
            kept = [w for w in injs if int(ids[w[2]]) in keep]
            merged = []
            for a, b in sorted((w[0], w[1]) for w in kept):
                if merged and a <= merged[-1][1]:
                    merged[-1][1] = max(merged[-1][1], b)
                else:
                    merged.append([a, b])
            st.analyze_injections = kept
            st.analyze_windows = [(int(a), int(b)) for a, b in merged]
    logging.info(
        "Optimal SNR threshold %.2f: analyzing %d of %d injections",
        thr,
        len(keep),
        len(snr),
    )


# -----------------------------------------------------------------------------
# 3. Data & Setup Helpers
# -----------------------------------------------------------------------------


def get_ifo_opts(opt, ifo):
    """Return a single-ifo namespace with all multi-det options resolved for ifo."""
    opt_ifo = pycbc.types.optparse.copy_opts_for_single_ifo(opt, ifo)
    opt_ifo.ifo = ifo
    for attr in [
        "channel_name",
        "sample_rate",
        "gps_start_time",
        "gps_end_time",
        "segment_length",
        "segment_start_pad",
        "segment_end_pad",
        "psd_estimation",
        "strain_high_pass",
        "pad_data",
    ]:
        val = getattr(opt_ifo, attr, None)
        if isinstance(val, dict):
            setattr(opt_ifo, attr, val.get(ifo, None))
    return opt_ifo


def fix_frame_files_args(raw_argv=None):
    if raw_argv is None:
        raw_argv = sys.argv[1:]
    channel_ifos = []
    for i, a in enumerate(raw_argv):
        if a == "--channel-name" and i + 1 < len(raw_argv):
            for part in raw_argv[i + 1 :]:
                if part.startswith("--"):
                    break
                if ":" in part:
                    channel_ifos.append(part.split(":")[0])

    new_argv = []
    in_frame_files = False
    for a in raw_argv:
        if a == "--frame-files":
            in_frame_files = True
            new_argv.append(a)
        elif in_frame_files:
            if a.startswith("--"):
                in_frame_files = False
                new_argv.append(a)
            elif ":" in a:
                new_argv.append(a)
            else:
                base = os.path.basename(a)
                m = re.match(r"^[A-Z]-([A-Z0-9]{2})_", base)
                if m:
                    new_argv.append(f"{m.group(1)}:{a}")
                elif len(channel_ifos) == 1:
                    new_argv.append(f"{channel_ifos[0]}:{a}")
                else:
                    new_argv.append(a)
        else:
            new_argv.append(a)
    return new_argv


def setup_strain_and_segments(args, instruments, inj_filter_rejector, flow):
    """Generate, condition, and segment strain data for all instruments."""
    gating_info = {}
    gwstrain_start_time = {}
    psd_var = {}
    segments = {}
    gwstrain = {}
    sample_rate = None
    flen = None
    delta_f = None

    for count, ifo in enumerate(instruments):
        logging.info("Generating and conditioning strain for %s...", ifo)
        ifo_inj_rejector = inj_filter_rejector[ifo] if inj_filter_rejector else None
        ifo_strain = pycbc.strain.from_cli_single_ifo(
            args,
            ifo,
            inj_filter_rejector=ifo_inj_rejector,
            dyn_range_fac=pycbc.DYN_RANGE_FAC,
        )
        gating_info[ifo] = getattr(ifo_strain, "gating_info", None)
        gwstrain_start_time[ifo] = float(ifo_strain.start_time)

        raw_strain_for_psd = ifo_strain.copy() if args.overwhiten_strain else ifo_strain

        if args.subtract_lines:
            logging.info("Applying coherent line subtraction for %s...", ifo)
            from pycbc.filter.overwhiten import subtract_coherent_lines

            orig_injs = getattr(ifo_strain, "injections", None)
            orig_gating = getattr(ifo_strain, "gating_info", None)
            f_low_sub = max(25.0, args.overwhiten_f_low)
            ifo_strain, sub_lines = subtract_coherent_lines(ifo_strain, f_low=f_low_sub)
            ifo_strain = ifo_strain.astype(np.float32)
            if orig_injs is not None:
                ifo_strain.injections = orig_injs
            if orig_gating is not None:
                ifo_strain.gating_info = orig_gating
            logging.info("Subtracted %d coherent lines in %s", len(sub_lines), ifo)

        single_det_opt = pycbc.types.optparse.copy_opts_for_single_ifo(args, ifo)
        if args.overwhiten_strain:
            logging.info("Applying continuous overwhitening for %s...", ifo)
            from pycbc.filter.overwhiten import overwhiten_strain

            orig_injs = getattr(ifo_strain, "injections", None)
            orig_gating = getattr(ifo_strain, "gating_info", None)
            f_low_ow = args.overwhiten_f_low
            max_dur_ow = args.overwhiten_max_filter_duration
            inpaint_ow = getattr(args, "inpaint_edges", False)
            ow_psd_model = getattr(single_det_opt, "overwhiten_psd_model", None)
            if ow_psd_model is None:
                ow_psd_model = getattr(
                    single_det_opt, "psd_estimation_method", None
                ) or getattr(single_det_opt, "psd_estimation", "welch")
            ifo_strain, _, _ = overwhiten_strain(
                ifo_strain,
                f_low=f_low_ow,
                max_filter_duration=max_dur_ow,
                f_high=args.high_frequency_cutoff,
                inpaint_edges=inpaint_ow,
                psd_model_type=ow_psd_model,
            )
            ifo_strain = ifo_strain.astype(np.float32)
            ifo_strain._is_overwhitened = True
            if orig_injs is not None:
                ifo_strain.injections = orig_injs
            if orig_gating is not None:
                ifo_strain.gating_info = orig_gating
            logging.info("Overwhitening completed for %s", ifo)

        logging.info(
            "Making frequency-domain data segments and associating PSDs for %s...", ifo
        )
        ifo_segments = pycbc.strain.StrainSegments.from_cli_single_ifo(
            args, ifo_strain, ifo
        )

        if count == 0:
            sample_rate = ifo_strain.sample_rate
            flen = ifo_segments.freq_len
            delta_f = ifo_segments.delta_f
        else:
            assert sample_rate == ifo_strain.sample_rate, (
                f"Sample rate mismatch for {ifo}"
            )
            assert flen == ifo_segments.freq_len, f"Freq len mismatch for {ifo}"
            assert delta_f == ifo_segments.delta_f, f"Delta f mismatch for {ifo}"

        if args.psdvar_segment is not None:
            logging.info("Calculating PSD variation for %s", ifo)
            ifo_opts = get_ifo_opts(args, ifo)
            psd_var[ifo] = pycbc.psd.calc_filt_psd_variation(
                raw_strain_for_psd,
                ifo_opts.psdvar_segment,
                ifo_opts.psdvar_short_segment,
                ifo_opts.psdvar_long_segment,
                ifo_opts.psdvar_psd_duration,
                ifo_opts.psdvar_psd_stride,
                ifo_opts.psd_estimation,
                ifo_opts.psdvar_low_freq,
                ifo_opts.psdvar_high_freq,
            )

        fd_segs = ifo_segments.fourier_segments()
        pycbc.psd.associate_psds_to_segments(
            single_det_opt,
            fd_segs,
            raw_strain_for_psd,
            flen,
            delta_f,
            flow,
            dyn_range_factor=pycbc.DYN_RANGE_FAC,
            precision="single",
        )
        if not args.overwhiten_strain:
            for seg in fd_segs:
                seg[:] = seg / seg.psd
        else:
            for seg in fd_segs:
                if seg.dtype != np.complex64:
                    seg._data = seg._data.astype(np.complex64)
        for seg_idx, seg in enumerate(fd_segs):
            seg._is_whitened = True
            seg._cache_key = (ifo, seg_idx)
            if getattr(seg, "psd", None) is not None:
                seg.psd._cache_key = (ifo, seg_idx)
        segments[ifo] = fd_segs

        ifo_strain._data = np.empty(0, dtype=ifo_strain.dtype)
        if raw_strain_for_psd is not ifo_strain:
            raw_strain_for_psd._data = np.empty(0, dtype=raw_strain_for_psd.dtype)
            del raw_strain_for_psd
        gwstrain[ifo] = ifo_strain
        del ifo_segments
        logging.info("Finished strain setup for %s", ifo)

    return (
        segments,
        gwstrain,
        gating_info,
        gwstrain_start_time,
        psd_var,
        sample_rate,
        flen,
        delta_f,
    )


def prepare_segment_geometry(
    args, instruments, segments, gwstrain_start_time, num_segs, sample_rate
):
    """Precompute segment GPS bounds, sample rates, and detector overlap validity."""
    ifo_sample_rates = {}
    ifo_gps_starts = {}
    ifo_gps_cli_starts = {}
    seg_starts = {}

    for ifo in instruments:
        sr = (
            args.sample_rate[ifo]
            if isinstance(args.sample_rate, dict)
            else args.sample_rate
        )
        ifo_sample_rates[ifo] = float(sr or sample_rate or 2048.0)
        ifo_gps_starts[ifo] = gwstrain_start_time[ifo]
        cli_start = (
            args.gps_start_time[ifo]
            if isinstance(args.gps_start_time, dict)
            else args.gps_start_time
        )
        ifo_gps_cli_starts[ifo] = cli_start
        for s_num, st in enumerate(segments[ifo]):
            seg_starts[(ifo, s_num)] = (
                getattr(st, "seg_slice", slice(0)).start
                if getattr(st, "seg_slice", None) is not None
                else 0
            )

    # Follow-up needs a second detector with overlapping data in the segment;
    # otherwise a segment's primaries are recorded directly.
    can_asym_by_seg = {}
    if len(instruments) > 1:
        for s_num in range(num_segs):
            active_ifos = [ifo for ifo in instruments if s_num < len(segments[ifo])]
            if len(active_ifos) <= 1:
                can_asym_by_seg[s_num] = False
                continue
            seg_gps = {}
            for ifo in active_ifos:
                st = segments[ifo][s_num]
                sr = ifo_sample_rates[ifo]
                t0 = ifo_gps_starts[ifo]
                s_start = seg_starts[(ifo, s_num)]
                a_start = (
                    st.analyze.start if getattr(st, "analyze", None) is not None else 0
                )
                a_stop = (
                    st.analyze.stop
                    if getattr(st, "analyze", None) is not None
                    else len(st)
                )
                seg_gps[ifo] = (
                    t0 + (s_start + a_start) / sr,
                    t0 + (s_start + a_stop) / sr,
                )

            can_asym = True
            for i_idx in range(len(active_ifos)):
                for j_idx in range(i_idx + 1, len(active_ifos)):
                    ifo_1, ifo_2 = active_ifos[i_idx], active_ifos[j_idx]
                    if max(seg_gps[ifo_1][0], seg_gps[ifo_2][0]) >= min(
                        seg_gps[ifo_1][1], seg_gps[ifo_2][1]
                    ):
                        can_asym = False
                        break
                if not can_asym:
                    break
            can_asym_by_seg[s_num] = can_asym
    else:
        can_asym_by_seg = collections.defaultdict(lambda: False)

    return (
        can_asym_by_seg,
        ifo_sample_rates,
        ifo_gps_starts,
        ifo_gps_cli_starts,
        seg_starts,
    )


def init_event_managers(args, instruments, gating_info):
    """Initialize EventManager instances for each detector."""
    out_types = {
        "time_index": int,
        "snr": complex64,
        "sigmasq": float32,
        "chisq": float32,
        "chisq_dof": int,
        "bank_chisq": float32,
        "bank_chisq_dof": int,
        "cont_chisq": float32,
        "sg_chisq": float32,
        "psd_var_val": float32,
    }
    names = sorted(out_types.keys())
    event_mgr = {}
    for ifo in instruments:
        ifo_opts = get_ifo_opts(args, ifo)
        event_mgr[ifo] = pycbc.events.EventManager(
            ifo_opts,
            names,
            [out_types[n] for n in names],
            psd=None,
            gating_info=gating_info[ifo],
        )
        event_mgr[ifo].ifo = ifo
    return event_mgr


# -----------------------------------------------------------------------------
# 4. Trigger Ingestion & Output Finalization
# -----------------------------------------------------------------------------


def ingest_ifo_triggers(
    ifo,
    ifo_trigs,
    ifo_mgr,
    ifo_strain,
    bank,
    args,
    psd_var_ifo,
    cluster_window,
    has_asym_followup_ifo,
):
    """Collate, sort, normalize, and ingest all triggers for a detector into EventManager."""
    if has_asym_followup_ifo:
        ifo_mgr.non_threshold_time = float(args.asym_num_bins * args.asym_bin_width)
        logging.info(
            "[%s] Non-threshold followup window: %.2f seconds (%d raw intervals)",
            ifo,
            ifo_mgr.non_threshold_time,
            has_asym_followup_ifo,
        )
    else:
        ifo_mgr.non_threshold_time = 0.0

    if not ifo_trigs or not ifo_trigs.get("template_id"):
        logging.info("[%s] Trigger identification complete: 0 total triggers", ifo)
        return

    data = {col: np.concatenate(arrs) for col, arrs in ifo_trigs.items()}
    n_candidates = len(data["template_id"])
    logging.info(
        "[%s] Trigger identification complete: %d total triggers in %d batches",
        ifo,
        n_candidates,
        len(ifo_trigs["template_id"]),
    )

    t_ingest_start = time.time()
    logging.info("[%s] Grouping triggers by template...", ifo)

    sort_idx = np.argsort(data["template_id"], kind="stable")
    for col in data:
        data[col] = data[col][sort_idx]
    del sort_idx

    unique_gids, start_indices = np.unique(data["template_id"], return_index=True)
    end_indices = np.append(start_indices[1:], n_candidates)

    sigmasq_rescale = bank.sigma_rescale(data["template_id"]) ** 2.0

    # data['snr'] is already the true SNR: the bank's taps are pre-scaled
    data["sigmasq"] = (data["sigmasq"] * sigmasq_rescale).astype(float32)

    if "sg_chisq" not in data:
        data["sg_chisq"] = np.zeros(n_candidates, dtype=np.float32)

    ifo_opts = get_ifo_opts(args, ifo)
    use_psd_var = args.psdvar_short_segment is not None
    if use_psd_var:
        gps_start = ifo_opts.gps_start_time
        data["psd_var_val"] = pycbc.psd.find_trigger_value(
            psd_var_ifo, data["time_index"], gps_start, ifo_opts.sample_rate
        )
        ingest_cols = [
            "time_index",
            "snr",
            "sigmasq",
            "chisq",
            "chisq_dof",
            "sg_chisq",
            "psd_var_val",
        ]
    else:
        ingest_cols = ["time_index", "snr", "sigmasq", "chisq", "chisq_dof", "sg_chisq"]
    if args.autochi_stride > 0:
        ingest_cols.append("cont_chisq")  # EventManager writes cont_chisq_dof

    trig_data = IfoTriggerData.from_dict(data)
    logging.info(
        "[%s] Ingesting triggers for %d templates into EventManager...",
        ifo,
        len(unique_gids),
    )
    for t_idx, (gid, s_idx, e_idx) in enumerate(
        zip(unique_gids, start_indices, end_indices)
    ):
        ifo_mgr.new_template(tmplt=bank.table[int(gid)])
        tmpl_is_asym = trig_data.is_asym[s_idx:e_idx]
        if not np.any(tmpl_is_asym):
            ifo_mgr.add_template_events(
                ingest_cols, [trig_data[col][s_idx:e_idx] for col in ingest_cols]
            )
            if cluster_window > 0:
                ifo_mgr.cluster_template_events("time_index", "snr", cluster_window)
        else:
            for mask, do_cluster in (
                (~tmpl_is_asym, cluster_window > 0),
                (tmpl_is_asym, False),
            ):
                if np.any(mask):
                    sub = s_idx + np.flatnonzero(mask)
                    ifo_mgr.add_template_events(
                        ingest_cols, [trig_data[col][sub] for col in ingest_cols]
                    )
                    if do_cluster:
                        ifo_mgr.cluster_template_events(
                            "time_index", "snr", cluster_window
                        )

        ifo_mgr.finalize_template_events()
        if (
            args.finalize_events_template_rate is not None
            and (t_idx + 1) % args.finalize_events_template_rate == 0
        ):
            ifo_mgr.consolidate_events(ifo_opts, gwstrain=ifo_strain)

    ingest_total = time.time() - t_ingest_start
    TIMERS["event_ingest"] += ingest_total
    logging.info("[%s] Ingestion completed in %.2f s", ifo, ingest_total)


def log_performance_summary(
    run_time, tsetup, instruments, segments, bank, output_path, cores=1
):
    """Log formatted timing breakdown and write timing JSON output."""
    total_analyzed_det_sec = sum(
        sum(
            analyzed_samples(segments[ifo][s]) * segments[ifo][s].delta_t
            for s in range(len(segments[ifo]))
        )
        for ifo in instruments
    )
    total_tmpl_sec = total_analyzed_det_sec * len(bank.table)
    overall_throughput = total_tmpl_sec / max(run_time, 1e-6)
    cores = max(1, int(cores))
    core_throughput = overall_throughput / cores
    logging.info(
        "Overall search throughput: %.0f template-s/s (%.2f M templates/s, %.2f M template-s/core-s on %d cores) over %.2f s run time",
        overall_throughput,
        overall_throughput / 1e6,
        core_throughput / 1e6,
        cores,
        run_time,
    )

    other_time = max(0.0, run_time - sum(TIMERS.values()))
    categories = [
        ("Data Setup & Conditioning", TIMERS.get("data_setup", 0.0)),
        ("Upper Ref SNR Generation", TIMERS.get("upper_ref", 0.0)),
        ("Search Setup (banks, plans, calibration)", TIMERS.get("filter_prep", 0.0)),
        ("Upper Decimation FIR", TIMERS.get("upper_fir", 0.0)),
        ("Fine FIR Filtering (Primary)", TIMERS.get("fine_fir", 0.0)),
        ("Asymmetric Followup Filtering", TIMERS.get("asym_followup", 0.0)),
        ("Power Chisq Calculation", TIMERS.get("power_chisq", 0.0)),
        ("Auto Chisq Calculation", TIMERS.get("auto_chisq", 0.0)),
        ("Sine-Gaussian Chisq", TIMERS.get("sg_chisq", 0.0)),
        ("Event Ingestion & Clustering", TIMERS.get("event_ingest", 0.0)),
        ("Event Finalize & HDF Output", TIMERS.get("event_finalize", 0.0)),
        ("Other / Pipeline Overhead", other_time),
    ]

    logging.info("=" * 70)
    logging.info("PIPELINE PERFORMANCE BREAKDOWN:")
    logging.info(f"{'Pipeline Stage':<35} {'Time (s)':>12} {'Share (%)':>10}")
    logging.info("-" * 70)
    for cat_name, cat_time in categories:
        pct = (cat_time / run_time) * 100.0 if run_time > 0 else 0.0
        logging.info(f"{cat_name:<35} {cat_time:>12.3f} {pct:>9.2f}%")
    logging.info("-" * 70)
    logging.info(f"{'Total Run Time':<35} {run_time:>12.3f} {100.0:>9.2f}%")
    logging.info("=" * 70)

    try:
        import json

        timing_dict = {cat_name: cat_time for cat_name, cat_time in categories}
        timing_dict["Total Run Time"] = run_time
        timing_dict["Overall Throughput"] = overall_throughput
        timing_dict["Core Throughput"] = core_throughput
        timing_dict["Cores"] = cores
        timing_path = output_path + ".timing.json"
        with open(timing_path, "w") as tf:
            json.dump(timing_dict, tf, indent=2)
        logging.info("Saved timing breakdown to %s", timing_path)
    except Exception as e:
        logging.warning("Failed to save timing JSON: %s", e)


# -----------------------------------------------------------------------------
# 5. CLI Arguments & Main Entry Point
# -----------------------------------------------------------------------------


def get_args():
    parser = argparse.ArgumentParser(description=__doc__)
    pycbc.add_common_pycbc_options(parser)

    # Standard PyCBC Data/Segment Options
    pycbc.strain.insert_strain_option_group_multi_ifo(parser)
    pycbc.strain.StrainSegments.insert_segment_option_group_multi_ifo(parser)
    pycbc.psd.insert_psd_option_group_multi_ifo(parser)
    pycbc.scheme.insert_processing_option_group(parser)
    pycbc.fft.insert_fft_option_group(parser)
    pycbc.inject.insert_injfilterrejector_option_group_multi_ifo(parser)

    # Multi-detector & Asymmetric Windowing Options
    asym_group = parser.add_argument_group("Asymmetric Windowing Options")
    # Asymmetric follow-up is always on; the flag is accepted so existing
    # command lines and workflow configurations keep working.
    asym_group.add_argument(
        "--asym-windowing", action="store_true", help=argparse.SUPPRESS
    )
    asym_group.add_argument(
        "--asym-snr-threshold",
        type=float,
        default=6.0,
        help="SNR threshold in primary detector to trigger asymmetric windowing in other detectors.",
    )
    asym_group.add_argument(
        "--asym-secondary-snr-threshold",
        type=float,
        default=None,
        help="Secondary detector SNR threshold for asymmetric triggers. "
        "Triggers below this are discarded unless network SNR threshold is exceeded.",
    )
    asym_group.add_argument(
        "--asym-network-snr-threshold",
        type=float,
        default=None,
        help="Network SNR threshold with primary trigger. "
        "Secondary triggers with network SNR >= threshold are kept unconditionally.",
    )
    asym_group.add_argument(
        "--asym-max-followup-bins",
        type=int,
        default=2,
        help="Maximum number of loudest followup bins to keep per primary candidate trigger "
        "(default: 2, set 0 to keep all passing bins). In dynamic mode, serves as the upper cap.",
    )
    asym_group.add_argument(
        "--asym-dynamic-followup-bins",
        action="store_true",
        help="Scale followup bin budget dynamically based on the statistical difficulty "
        "of recovering the secondary signal given primary SNR.",
    )
    asym_group.add_argument(
        "--asym-min-followup-bins",
        type=int,
        default=5,
        help="Minimum number of followup bins for marginal primary triggers in dynamic mode (default: 5).",
    )
    asym_group.add_argument(
        "--asym-followup-bin-scale",
        type=float,
        default=1.2,
        help="Overall scale factor applied to the analytic bin budget in dynamic mode (default: 1.2).",
    )
    asym_group.add_argument(
        "--asym-followup-target-net-snr",
        type=float,
        default=8.5,
        help="Target minimum network SNR for a viable candidate in dynamic mode (default: 8.5).",
    )
    asym_group.add_argument(
        "--asym-followup-sec-snr-floor",
        type=float,
        default=3.0,
        help="Practical secondary matched filter SNR floor in dynamic mode (default: 3.0).",
    )
    asym_group.add_argument(
        "--asym-max-primary-per-group-sec",
        type=int,
        default=1,
        help="Maximum number of primary triggers per 1-second interval within each fine "
        "template group to instigate secondary followup windowing (default: 1, set 0 to disable).",
    )
    asym_group.add_argument(
        "--asym-bin-width",
        type=float,
        default=0.1,
        help="Width in seconds of each bin in the asymmetric window (default 0.1s).",
    )
    asym_group.add_argument(
        "--asym-num-bins",
        type=int,
        default=100,
        help="Number of bins in the asymmetric window (default 100).",
    )
    asym_group.add_argument(
        "--asym-primary-newsnr-threshold",
        type=float,
        default=None,
        help="Minimum NewSNR for primary candidate triggers to be followed up "
        "in secondary detectors within asymmetric windows "
        "(default: None, falls back to --newsnr-threshold or primary SNR threshold).",
    )
    asym_group.add_argument(
        "--asym-primary-max-rchisq",
        type=float,
        default=5.0,
        help="Maximum reduced chi-squared for primary candidate triggers to be followed up "
        "in secondary detectors within asymmetric windows (default: 5.0, set 0 to disable).",
    )

    # Analysis Options
    parser.add_argument("--output", required=True, help="Path to output HDF5 file.")
    parser.add_argument(
        "--cores",
        type=int,
        default=1,
        help="Number of CPU cores to use for multiprocessing over top templates (default: 1).",
    )
    parser.add_argument(
        "--bank-file", type=str, required=True, help="Path to the HDF5 Ratio Bank file."
    )
    parser.add_argument(
        "--snr-threshold",
        type=float,
        default=None,
        help="Ignored: the primary threshold is --asym-snr-threshold. "
        "Accepted for compatibility with existing configurations.",
    )
    parser.add_argument(
        "--newsnr-threshold",
        type=float,
        metavar="THRESHOLD",
        help="Cut triggers with NewSNR less than THRESHOLD",
    )
    parser.add_argument(
        "--low-frequency-cutoff",
        type=float,
        help="The low frequency cutoff to use for filtering (Hz)",
    )
    parser.add_argument(
        "--enable-compressed-waveforms",
        action="store_true",
        default=True,
        help="Enable use of compressed top waveforms if present in the bank (default: True).",
    )
    parser.add_argument(
        "--disable-compressed-waveforms",
        action="store_false",
        dest="enable_compressed_waveforms",
        help="Disable use of compressed waveforms and regenerate waveforms on the fly.",
    )

    # Ratio Specific Options
    group = parser.add_argument_group("Ratio Filter Options")
    group.add_argument(
        "--high-frequency-cutoff",
        type=float,
        help="High frequency cutoff (defaults to Nyquist).",
    )
    group.add_argument(
        "--ratio-filter-engine",
        default="matchedfilter-hierarchical",
        choices=("matchedfilter-hierarchical", "matchedfilter"),
        help="Which back end runs the innermost correlate.",
    )
    group.add_argument(
        "--ratio-filter-false-dismissal",
        type=float,
        default=1e-3,
        metavar="PROB",
        help="Tolerated probability of missing a signal at the SNR threshold.",
    )
    group.add_argument(
        "--ratio-filter-device",
        default=None,
        help="matchedfilter device for the fine banks (e.g. gpu:0). Default: the "
        "library's default device.",
    )
    group.add_argument(
        "--ratio-filter-band",
        type=float,
        default=0,
        metavar="HZ",
        help="Width of the band the first stage filters, in Hz. 0 uses the design table's choice.",
    )
    group.add_argument(
        "--ratio-filter-first-stage-snr",
        type=float,
        default=0,
        metavar="SNR",
        help="SNR the first stage is calibrated against. 0 uses the design table.",
    )
    group.add_argument(
        "--dynamic-snr-window",
        type=float,
        default=8.0,
        help="Rolling window duration in seconds for dynamic SNR renormalization (default: 8.0).",
    )
    group.add_argument(
        "--dynamic-snr-hollow",
        type=float,
        default=0.5,
        help="Hollow exclusion half-width in seconds for dynamic SNR renormalization (default: 0.5).",
    )
    group.add_argument(
        "--dynamic-snr-variance-floor",
        type=float,
        default=1.0,
        help="Variance floor for dynamic SNR renormalization (default: 1.0; set < 1.0 for two-sided boost).",
    )
    group.add_argument(
        "--dynamic-snr-max-boost",
        type=float,
        default=None,
        help="Maximum SNR boost factor safety ceiling for dynamic SNR renormalization (default: None).",
    )
    group.add_argument(
        "--disable-dynamic-snr-renorm",
        action="store_true",
        help="Disable dynamic SNR renormalization.",
    )

    # Overwhitening & Line Subtraction Options
    ow_group = parser.add_argument_group("Overwhitening & Line Subtraction Options")
    ow_group.add_argument(
        "--overwhiten-strain",
        action="store_true",
        default=False,
        help="Enable continuous time-domain overwhitening of strain data.",
    )
    ow_group.add_argument(
        "--overwhiten-f-low",
        type=float,
        default=18.0,
        help="Low-frequency cutoff in Hz for continuous overwhitening filter (default: 18.0).",
    )
    ow_group.add_argument(
        "--overwhiten-max-filter-duration",
        type=float,
        default=4.0,
        help="Maximum filter duration in seconds for overwhitening filter (default: 4.0).",
    )
    ow_group.add_argument(
        "--overwhiten-psd-model",
        type=str,
        default=None,
        choices=[
            "welch",
            "trimmed-welch",
            "trimmed_welch",
            "line-continuum",
            "line_continuum",
            "multitaper",
        ],
        help="PSD estimation method for overwhitening: 'welch', 'trimmed-welch', 'line-continuum', or 'multitaper' (default: None, inherits --psd-estimation).",
    )
    ow_group.add_argument(
        "--subtract-lines",
        action="store_true",
        default=False,
        help="Enable coherent line subtraction before filtering.",
    )

    # Signal Consistency (Power, Auto, SG Chisq & Chain) Options
    SignalConsistencyChain.insert_option_group(parser)
    parser.set_defaults(chisq_iterations=100)
    parser.add_argument(
        "--chisq-threshold",
        type=float,
        default=0,
        help="Maximum reduced chisq a trigger may have; 0 disables the cut.",
    )
    parser.add_argument(
        "--chisq-delta",
        type=float,
        default=0,
        help="SNR-dependent term added to the chisq dof before applying --chisq-threshold.",
    )
    parser.add_argument(
        "--chisq-block-length",
        type=int,
        default=4096,
        help="Length in samples of the block the power chisq (and auto-chisq) is "
        "computed on, centred on each trigger. Sets the chisq's frequency "
        "resolution; it must hold the longest ratio filter plus the "
        "auto-chisq lags, and is independent of the filter's own blocking.",
    )
    parser.add_argument(
        "--autochi-max-rchisq",
        "--autochisq-max-rchisq",
        type=float,
        default=5.0,
        help="Maximum reduced power chisq for which auto-chisq is evaluated "
        "(default: 5.0). Triggers with reduced power chisq exceeding this "
        "threshold bypass auto-chisq.",
    )

    # Clustering & Event Handling
    parser.add_argument(
        "--cluster-window",
        type=float,
        default=1.0,
        help="Length of clustering window in seconds.",
    )
    parser.add_argument(
        "--finalize-events-template-rate",
        default=None,
        type=int,
        metavar="NUM TEMPLATES",
        help="After NUM TEMPLATES perform event consolidation.",
    )

    # Waveform parameters
    pycbc.waveform.bank.add_approximant_arg(parser)
    parser.add_argument(
        "--order",
        type=int,
        default=-1,
        help="The integer half-PN order at which to generate approximant.",
    )
    parser.add_argument(
        "--taper-template",
        choices=["start", "end", "startend"],
        help="For time-domain approximants, taper template.",
    )
    parser.add_argument(
        "--keep-loudest-log-chirp-window",
        type=float,
        help="Keep loudest triggers within ln chirp mass window",
    )
    parser.add_argument(
        "--keep-loudest-interval",
        type=float,
        help="Window in seconds to maximize triggers over bank",
    )
    parser.add_argument(
        "--keep-loudest-num",
        type=int,
        help="Number of triggers to keep from each maximization interval",
    )
    parser.add_argument(
        "--keep-loudest-stat",
        default="newsnr",
        choices=pycbc.events.ranking.sngls_ranking_function_dict.keys(),
        help="Statistic used to determine loudest to keep",
    )

    argv = fix_frame_files_args()
    return parser, parser.parse_args(argv)


def main():
    parser, args = get_args()
    pycbc.init_logging(args.verbose)

    validate_dynamic_snr_options(
        args.dynamic_snr_variance_floor,
        args.dynamic_snr_max_boost,
        disable=args.disable_dynamic_snr_renorm,
    )

    if isinstance(args.channel_name, dict) and len(args.channel_name) > 0:
        instruments = sorted(list(args.channel_name.keys()))
    elif isinstance(args.channel_name, str):
        instruments = [args.channel_name[:2]]
    else:
        raise ValueError("Could not determine instruments to analyze.")

    # Verify Options
    pycbc.strain.verify_strain_options_multi_ifo(args, parser, instruments)
    pycbc.strain.StrainSegments.verify_segment_options_multi_ifo(
        args, parser, instruments
    )
    pycbc.psd.verify_psd_options_multi_ifo(args, parser, instruments)
    pycbc.scheme.verify_processing_options(args, parser)
    pycbc.fft.verify_fft_options(args, parser)
    pycbc.fft.from_cli(args)

    with pycbc.scheme.from_cli(args):
        inj_filter_rejector = pycbc.inject.InjFilterRejector.from_cli_multi_ifos(
            args, instruments
        )

        flow = args.low_frequency_cutoff
        if flow is None:
            with h5py.File(args.bank_file, "r") as f:
                if "f_lower" in f:
                    flow = float(np.min(f["f_lower"][:]))

        if args.high_frequency_cutoff is None:
            if isinstance(args.sample_rate, dict) and len(args.sample_rate) > 0:
                sr_val = min(args.sample_rate.values())
            else:
                sr_val = float(args.sample_rate or 2048.0)
            args.high_frequency_cutoff = 0.9 * (sr_val / 2.0)
            logging.info(
                "Defaulted high-frequency-cutoff to 0.9 * Nyquist = %.2f Hz",
                args.high_frequency_cutoff,
            )

        # With --injection-window, keep each segment once with its full analysis
        # range and the injection windows attached (StrainSegments otherwise
        # duplicates the segment per window and narrows analyze to it, which
        # reruns the top and middle stages per window and clips the asym
        # follow-up). Only the primary search is restricted to the windows.
        args.merge_injection_windows = True
        (
            segments,
            gwstrain,
            gating_info,
            gwstrain_start_time,
            psd_var,
            sample_rate,
            flen,
            delta_f,
        ) = setup_strain_and_segments(args, instruments, inj_filter_rejector, flow)
        drop_unfindable_injections(segments, inj_filter_rejector, instruments)

        logging.info("Initializing Ratio Filter Bank...")
        bank = RatioFilterBank(
            args.bank_file,
            filter_length=flen,
            delta_f=delta_f,
            dtype=np.complex64,
            enable_compressed_waveforms=args.enable_compressed_waveforms,
        )
        active_rejectors = [
            inj_filter_rejector[ifo]
            for ifo in instruments
            if inj_filter_rejector.get(ifo) is not None
            and getattr(inj_filter_rejector[ifo], "enabled", False)
        ]
        if active_rejectors:
            if len(active_rejectors) == 1:
                bank.template_thinning(active_rejectors[0])
            else:
                tables = []
                for rej in active_rejectors:
                    if (
                        hasattr(rej, "injection_params")
                        and rej.injection_params is not None
                    ):
                        if (
                            hasattr(rej.injection_params, "table")
                            and rej.injection_params.table is not None
                            and len(rej.injection_params.table) > 0
                        ):
                            tables.append(rej.injection_params.table)
                if tables:
                    import types

                    combined_table = (
                        np.concatenate(tables).view(type(tables[0]))
                        if len(tables) > 1
                        else tables[0]
                    )
                    combined_inj_params = types.SimpleNamespace(table=combined_table)
                    combined_rej = types.SimpleNamespace(
                        enabled=True,
                        chirp_time_window=max(
                            getattr(r, "chirp_time_window", 1.0)
                            for r in active_rejectors
                        ),
                        f_lower=min(
                            getattr(r, "f_lower", flow) for r in active_rejectors
                        ),
                        injection_params=combined_inj_params,
                    )
                    bank.template_thinning(combined_rej)

        primary_snr_threshold = args.asym_snr_threshold
        logging.info("Primary SNR threshold: %.2f", primary_snr_threshold)

        sg_chisq = SingleDetSGChisq.from_cli(args, bank, str(args.chisq_bins))
        event_mgr = init_event_managers(args, instruments, gating_info)
        cluster_window = (
            int(args.cluster_window * sample_rate) if args.cluster_window else 0
        )

        if all(len(segments[ifo]) == 0 for ifo in instruments):
            logging.info("No segments to analyze. Exiting.")
            if os.path.exists(args.output):
                os.remove(args.output)
            for ifo in instruments:
                event_mgr[ifo].finalize_template_events()
                event_mgr[ifo].write_events(args.output)
            logging.info("Finished.")
            return

        if len(bank.coarse_indices) == 0:
            logging.info("No coarse templates in analysis bank. Exiting.")
            if os.path.exists(args.output):
                os.remove(args.output)
            for ifo in instruments:
                event_mgr[ifo].finalize_template_events()
                event_mgr[ifo].write_events(args.output)
            logging.info("Finished.")
            return

        triggers = {ifo: collections.defaultdict(list) for ifo in instruments}
        has_asym_followup = dict.fromkeys(instruments, 0)
        num_segs = max(len(segments[ifo]) for ifo in instruments)

        (
            can_asym_by_seg,
            ifo_sample_rates,
            ifo_gps_starts,
            ifo_gps_cli_starts,
            seg_starts,
        ) = prepare_segment_geometry(
            args, instruments, segments, gwstrain_start_time, num_segs, sample_rate
        )

        # Ensure asym_num_bins is identical between full search and injection jobs
        # to eliminate trials-factor and recovery bias
        effective_asym_num_bins = args.asym_num_bins

        tsetup = time.time() - tstart
        TIMERS["data_setup"] = tsetup

        if bank.num_levels < 2:
            raise ValueError(
                "pycbc_inspiral_fir requires a hierarchical bank with at least 2 FIR levels."
            )
        # The hierarchy is real-real-complex: complex final taps (level 1), real taps above.
        for lvl, grp in bank.level_groups.items():
            want_complex = lvl == 1
            for k in bank.level_keys[lvl]:
                if (
                    np.issubdtype(grp[k]["taps"].dtype, np.complexfloating)
                    != want_complex
                ):
                    raise ValueError(
                        "%s: level_%d group %s has %s taps; pycbc_inspiral_fir needs complex "
                        "final (level 1) taps and real taps above (rebuild the bank with the "
                        "current pycbc_fir_bank)"
                        % (args.bank_file, lvl, k, grp[k]["taps"].dtype)
                    )

        max_upper_taps = int(bank.level_groups[2].attrs.get("max_taps", 0))
        if max_upper_taps == 0:
            max_upper_taps = max(
                int(c)
                for top_idx in bank.level_indices[2]
                for c in bank.level_groups[2][str(int(top_idx))]["actual_tap_count"][:]
            )
        max_lower_taps = int(bank.level_groups[1].attrs.get("max_taps", 0))
        if max_lower_taps == 0:
            max_lower_taps = max(
                int(c)
                for middle_idx in bank.coarse_indices
                for c in bank.level_groups[1][str(int(middle_idx))]["actual_tap_count"][
                    :
                ]
            )
        edge_margin = (max_upper_taps + max_lower_taps) // 2
        for ifo in instruments:
            for stilde in segments[ifo]:
                if (
                    stilde.analyze.start < edge_margin
                    or (len(stilde) - 1) * 2 - stilde.analyze.stop < edge_margin
                ):
                    raise ValueError(
                        "analysis window needs %d samples of padding for the "
                        "composed upper and lower FIRs" % edge_margin
                    )

        coarse_keep = (
            set(bank.coarse_indices)
            if len(bank.coarse_indices) < len(bank.coarse_keys)
            else None
        )

        # Chirp-time rejection per injection window: a middle group is filtered
        # only near the injections whose chirp time lies within the rejector
        # window of one of its fine templates, and a top template only in
        # segments where one of its groups is. Needs --injection-window, which
        # provides the per-injection windows of each segment.
        inj_reject = None
        rejs = [
            r
            for r in (inj_filter_rejector or {}).values()
            if r is not None and r.enabled and r.chirp_time_window is not None
        ]
        if rejs and args.injection_window is not None:
            from pycbc.pnutils import mass1_mass2_to_tau0_tau3

            fref = rejs[0].f_lower
            tau0 = lambda tbl: np.asarray(
                mass1_mass2_to_tau0_tau3(tbl["mass1"], tbl["mass2"], fref)[0]
            )
            inj_reject = {
                "window": max(float(r.chirp_time_window) for r in rejs),
                "tau0_fine": tau0(bank.table),
                # per detector, indexed like the rows of analyze_injections
                "tau0_inj": {
                    ifo: tau0(gwstrain[ifo].injections.table)
                    for ifo in instruments
                    if hasattr(gwstrain[ifo], "injections")
                },
            }
            logging.info(
                "Injection rejection per injection window, chirp-time window %.2f s, "
                "f_lower %.1f Hz",
                inj_reject["window"],
                fref,
            )

        # Free raw time-domain strain buffers now that segments and PSDs are formed
        for ifo in instruments:
            if hasattr(gwstrain[ifo], "_data"):
                gwstrain[ifo]._data = np.array([], dtype=gwstrain[ifo].dtype)

        total_valid_segs = sum(len(segments[ifo]) for ifo in instruments)
        if total_valid_segs == 0:
            logging.info(
                "Zero valid segments to analyze across all instruments. Skipping filtering."
            )
            bank_top_indices = []
        else:
            bank_top_indices = bank.level_indices[2]

        top_templates = {
            int(i): bank.get_coarse_template(int(i)) for i in bank_top_indices
        }
        upper_group_data = {}
        for i in bank_top_indices:
            i_int = int(i)
            grp = bank.level_groups[2][str(i_int)]
            upper_group_data[i_int] = {
                "counts": grp["actual_tap_count"][:],
                "m_all": grp["fine_bank_index"][:],
                "taps": grp["taps"][:],
                "sigmas": grp["sigmas"][:],
            }

        # Prepare top template tasks sorted by descending fine template count (LPT scheduling)
        top_tasks = []
        for top_idx in bank_top_indices:
            top_idx = int(top_idx)
            m_all = upper_group_data[top_idx]["m_all"]
            if coarse_keep is not None:
                m_all = [m for m in m_all if m in coarse_keep]
            if len(m_all) == 0:
                continue
            fine_count = sum(bank.group_template_count(int(m)) for m in m_all)
            top_tasks.append((top_idx, fine_count))

        top_tasks.sort(key=lambda x: x[1], reverse=True)
        n_top = len(top_tasks)
        sorted_top_tasks = [
            (item[0], rank, n_top, item[1]) for rank, item in enumerate(top_tasks)
        ]

        _SHARED_WORKER_CONTEXT.clear()
        _SHARED_WORKER_CONTEXT.update(
            {
                "bank": bank,
                "top_templates": top_templates,
                "upper_group_data": upper_group_data,
                "instruments": instruments,
                "segments": segments,
                "num_segs": num_segs,
                "can_asym_by_seg": can_asym_by_seg,
                "ifo_sample_rates": ifo_sample_rates,
                "ifo_gps_starts": ifo_gps_starts,
                "ifo_gps_cli_starts": ifo_gps_cli_starts,
                "seg_starts": seg_starts,
                "args": args,
                "primary_snr_threshold": primary_snr_threshold,
                "delta_f": delta_f,
                "sample_rate": sample_rate,
                "flow": flow,
                "effective_asym_num_bins": effective_asym_num_bins,
                "coarse_keep": coarse_keep,
                "inj_reject": inj_reject,
                "sg_chisq": sg_chisq,
            }
        )

        total_cores = max(1, int(args.cores or 1))
        n_workers = min(total_cores, n_top) if n_top > 0 else 1

        if n_workers > 1:
            logging.info(
                "Parallelizing %d top templates across %d cores using fork multiprocessing...",
                n_top,
                n_workers,
            )
            bank.close_filehandler()
            ctx = mp.get_context("fork")
            with ctx.Pool(processes=n_workers) as pool:
                for (
                    top_idx,
                    worker_trigs,
                    worker_asym,
                    worker_timers,
                ) in pool.imap_unordered(process_top_template_task, sorted_top_tasks):
                    for ifo in instruments:
                        for col, arr in worker_trigs[ifo].items():
                            if len(arr) > 0:
                                triggers[ifo][col].append(arr)
                        has_asym_followup[ifo] += worker_asym[ifo]
                    for k, v in worker_timers.items():
                        TIMERS[k] += v
        else:
            logging.info("Filtering %d top templates serially (1 core)...", n_top)
            for task_args in sorted_top_tasks:
                top_idx, worker_trigs, worker_asym, worker_timers = (
                    process_top_template_task(task_args)
                )
                for ifo in instruments:
                    for col, arr in worker_trigs[ifo].items():
                        if len(arr) > 0:
                            triggers[ifo][col].append(arr)
                    has_asym_followup[ifo] += worker_asym[ifo]
                for k, v in worker_timers.items():
                    TIMERS[k] += v

        _SHARED_WORKER_CONTEXT.clear()

        if bank.num_levels >= 2:
            logging.info(
                "Upper synthesis time: direct-reference %.3f s, FIR %.3f s",
                TIMERS["upper_ref"],
                TIMERS["upper_fir"],
            )

        # Ingest triggers into EventManager for all instruments
        for ifo in instruments:
            ingest_ifo_triggers(
                ifo,
                triggers[ifo],
                event_mgr[ifo],
                gwstrain[ifo],
                bank,
                args,
                psd_var.get(ifo),
                cluster_window,
                has_asym_followup[ifo],
            )
            triggers[ifo] = None

    # Consolidate and write events
    tstop = time.time()
    run_time = tstop - tstart

    if os.path.exists(args.output):
        os.remove(args.output)

    total_cores = args.cores or 1
    cores_per_ifo = float(total_cores) / len(instruments)

    t_fin = time.time()
    for i, ifo in enumerate(instruments):
        ifo_mgr = event_mgr[ifo]
        ifo_strain = gwstrain[ifo]
        ifo_opts = get_ifo_opts(args, ifo)
        ifo_mgr.save_performance(
            cores_per_ifo, len(segments[ifo]), len(bank), run_time, tsetup
        )
        logging.info("Consolidating and writing events for %s...", ifo)
        ifo_mgr.consolidate_events(ifo_opts, gwstrain=ifo_strain)
        ifo_mgr.finalize_events()
        ifo_mgr.write_events(args.output, mode="w" if i == 0 else "a")
    TIMERS["event_finalize"] += time.time() - t_fin

    log_performance_summary(
        run_time, tsetup, instruments, segments, bank, args.output, cores=total_cores
    )
    logging.info("Finished.")


if __name__ == "__main__":
    main()
