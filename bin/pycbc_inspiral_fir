TIMERS = collections.defaultdict(float)


# -----------------------------------------------------------------------------
# 1. Filtering Engines & Reference Synthesis
# -----------------------------------------------------------------------------

class UpperReferenceBatch:
    """Expand one top SNR series into all middle series in one library call."""

    _BUFFERS = {}

    @classmethod
    def clear_buffers(cls):
        cls._BUFFERS.clear()

    def __init__(self, taps, counts, middle_ids, series_length, scales=None):
        import matchedfilter
        from matchedfilter import _automatic_series_layout

        counts_arr = np.asarray(counts, dtype=np.int64)
        sort_order = np.argsort(counts_arr)
        self.sort_order = sort_order
        self.sorted_ids = np.asarray(middle_ids, dtype=int)[sort_order]
        self.series_length = int(series_length)
        self.scales = np.asarray(scales, dtype=np.float32)[sort_order] if scales is not None else None
        self.bank = matchedfilter.TimeDomainFilterBank(
            taps[sort_order], tap_counts=counts_arr[sort_order],
            engine='corr'
        )

        self._plan = []
        for g in self.bank._groups:
            cplan = g.get_correlation_plan()
            g_indices = g.template_indices
            g_cnt = len(g_indices)
            st, _, _ = _automatic_series_layout(self.series_length, cplan.valid)
            self._plan.append({
                'cplan': cplan,
                'g_cnt': g_cnt,
                'g_slice': slice(int(g_indices[0]), int(g_indices[0]) + g_cnt),
                'st': st,
                'valid': cplan.valid,
            })

    def run(self, top_series, valid_slice=None, ifo=None, pad=4096, scales=None):
        """Return middle-id to SNR series, scaled like direct middle filtering."""
        if len(top_series) != self.series_length:
            raise ValueError('top reference length changed between segments')

        if scales is None:
            scales = self.scales
        elif len(scales) == len(self.sorted_ids):
            scales = scales[self.sort_order]

        n_req = len(self.sorted_ids)
        if ifo is not None:
            buf_key = (ifo, self.series_length)
            buf = UpperReferenceBatch._BUFFERS.get(buf_key)
            if buf is None or buf.shape[0] < n_req:
                alloc_rows = max(n_req, 32)
                buf = np.zeros((alloc_rows, self.series_length), dtype=np.complex64)
                UpperReferenceBatch._BUFFERS[buf_key] = buf
            out = buf[:n_req]
        else:
            out = np.zeros((n_req, self.series_length), dtype=np.complex64)

        ser = np.ascontiguousarray(top_series, dtype=np.complex64)

        if valid_slice is not None:
            vs = 0 if valid_slice.start is None else int(valid_slice.start)
            ve = self.series_length if valid_slice.stop is None else int(valid_slice.stop)
            if vs < 0:
                vs = max(0, self.series_length + vs)
            if ve < 0:
                ve = max(0, self.series_length + ve)
            pad_val = int(pad) if pad is not None else 4096
            v_start = max(0, vs - pad_val)
            v_stop = min(self.series_length, ve + pad_val)
        else:
            v_start = 0
            v_stop = self.series_length

        for p in self._plan:
            cplan = p['cplan']
            st = p['st']
            lo, hi = p['valid']
            g_dest = out[p['g_slice']]
            if valid_slice is not None:
                b_start = st + lo
                b_end = np.minimum(st + hi, self.series_length)
                keep = (b_start < v_stop) & (b_end > v_start)
                if keep.any():
                    st_run = st[keep]
                    k_indices = np.flatnonzero(keep)
                    cov_start = b_start[k_indices[0]]
                    cov_end = b_end[k_indices[-1]]
                    if cov_start > v_start:
                        g_dest[:, v_start:cov_start] = 0
                    if cov_end < v_stop:
                        g_dest[:, cov_end:v_stop] = 0
                else:
                    st_run = np.empty(0, dtype=np.uintp)
                    g_dest[:, v_start:v_stop] = 0
            else:
                st_run = st
                if ifo is not None:
                    g_dest[:, :lo] = 0
                    if st_run.size > 0:
                        last_end = min(self.series_length, st_run[-1] + hi)
                        if last_end < self.series_length:
                            g_dest[:, last_end:] = 0

            if cplan._gpu is not None:
                cplan._continuous_gpu(ser, st_run, 0, p['g_cnt'], g_dest)
            else:
                cplan._execution_plan().correlate_series_continuous(
                    ser, st_run, lo, hi, 0, p['g_cnt'], g_dest
                )

        if valid_slice is not None:
            out[:, :v_start] = 0
            out[:, v_stop:] = 0
            np.multiply(out[:, v_start:v_stop], scales[:, None], out=out[:, v_start:v_stop])
        else:
            np.multiply(out, scales[:, None], out=out)

        return dict(zip(self.sorted_ids, out))


class RatioPowerChisq(SingleDetPowerChisq):
    """Calculates power chisq for ratio/FIR filtering using precomputed FFT workspaces."""

    def __init__(self, num_bins, snr_threshold, sample_rate, flow=20.0, f_final=800.0,
                 chisq_window=1.0, chisq_iterations=None, n_pad=16384):
        super(RatioPowerChisq, self).__init__(num_bins=num_bins, snr_threshold=snr_threshold)
        if self.do and self.num_bins is not None:
            self.num_bins = int(self.num_bins)
        if self.snr_threshold is not None:
            self.snr_threshold = float(self.snr_threshold)
        self.sample_rate = float(sample_rate)
        self.flow = float(flow)
        self.f_final = float(f_final)
        self.chisq_window_samp = int(chisq_window * self.sample_rate)
        self.max_iterations = chisq_iterations
        self.n_pad = int(n_pad)
        self.df_pad = self.sample_rate / self.n_pad
        self.invec = TimeSeries(zeros(self.n_pad, dtype=complex64), delta_t=1.0 / self.sample_rate)
        self.outvec = FrequencySeries(zeros(self.n_pad, dtype=complex64), delta_f=self.df_pad)
        self.plan = pycbc.fft.FFT(self.invec, self.outvec)
        self.corr = FrequencySeries(zeros(self.n_pad, dtype=complex64), delta_f=self.df_pad)
        self.bins_cache = {}
        self.ratio_cache = {}

    def compute(self, ids_local, t_idxs, snrs, fine_indices, tstarts, stilde, bank, ref_snr, filters_f, coarse_idx, args, snr_amp=None):
        global_ids = fine_indices[ids_local]
        if snr_amp is None:
            snr_amp = abs(snrs)
        num_trigs = len(snrs)
        num_b = int(self.num_bins) if self.num_bins is not None else 64
        chisq_vals = np.full(num_trigs, 2 * num_b - 2, dtype=float32)
        chisq_dof_vals = np.full(num_trigs, num_b, dtype=np.int32)
        assigned_mask = np.zeros(num_trigs, dtype=bool)

        cthresh = self.snr_threshold
        above_thresh = np.flatnonzero(snr_amp >= cthresh)
        if len(above_thresh) == 0:
            return chisq_vals, chisq_dof_vals

        sort_order = np.argsort(snr_amp)[::-1]

        bins_key = id(stilde.psd)
        if bins_key not in self.bins_cache:
            df_pad = self.df_pad
            kmin_pad = int(self.flow / df_pad)
            kmax_pad = min(int(self.f_final / df_pad), self.n_pad // 2)
            dec = max(1, int(round(df_pad / stilde.delta_f)))
            n_half_pad = self.n_pad // 2 + 1
            psd_pad = FrequencySeries(stilde.psd[::dec][:n_half_pad], delta_f=df_pad)
            norm_pad = spa_tmplt_norm(psd_pad, n_half_pad, df_pad, self.flow)
            bins = power_chisq_bins_from_sigmasq_series(norm_pad, self.num_bins, kmin_pad, kmax_pad)
            dof = (len(bins) - 1) * 2 - 2
            self.bins_cache[bins_key] = (bins, dof)
        bins, dof = self.bins_cache[bins_key]

        taps_coarse, counts_coarse, _ = bank.get_firs(coarse_idx) if (coarse_idx is not None and hasattr(bank, 'get_firs')) else (None, None, None)

        ref_f_cache = {}
        iterations = 0
        tids2_arr = np.zeros(1, dtype=np.int32)
        snrvs_arr = np.zeros(1, dtype=complex64)

        for idx in sort_order:
            if self.max_iterations is not None and iterations >= self.max_iterations:
                break
            if snr_amp[idx] < cthresh:
                break
            if assigned_mask[idx]:
                continue

            target_global_id = int(global_ids[idx])
            t_idx = int(t_idxs[idx])
            snrv = snrs[idx]
            local_id = int(ids_local[idx])
            tstart = int(tstarts[idx])

            rescale = float(bank.snr_rescale(target_global_id, method=args.template_normalization_method))
            snrvs_arr[0] = snrv / rescale

            block_len = len(filters_f[local_id])
            dt = t_idx - tstart

            cache_key = (tstart, block_len)
            if cache_key not in ref_f_cache:
                ref = ref_snr[tstart:tstart+block_len]
                if ref is None or len(ref) == 0:
                    continue
                self.invec.clear()
                self.invec.data[:len(ref)] = ref
                self.plan.execute()
                ref_f_cache[cache_key] = self.outvec.data.copy()
            ref_f_pad = ref_f_cache[cache_key]

            ratio_key = (coarse_idx, local_id)
            if ratio_key not in self.ratio_cache:
                if taps_coarse is not None:
                    cnt = int(counts_coarse[local_id])
                    half = cnt // 2
                    self.invec.clear()
                    self.invec.data[:cnt - half] = taps_coarse[local_id, half:cnt]
                    self.invec.data[self.n_pad - half:] = taps_coarse[local_id, :half]
                    self.plan.execute()
                    self.ratio_cache[ratio_key] = np.conj(self.outvec.data).copy()
                else:
                    self.ratio_cache[ratio_key] = None

            ratio_pad = self.ratio_cache[ratio_key]
            if ratio_pad is not None:
                corr_factor = 1.0 / (rescale * self.n_pad)
                self.corr.data[:] = (ratio_pad * ref_f_pad) * corr_factor
                tids2_arr[0] = dt
                chi = power_chisq_at_points_from_precomputed(self.corr, snrvs_arr, 1.0, bins, tids2_arr)
            else:
                chi = [0.0]

            same_tmpl_window = (global_ids == target_global_id) & (abs(t_idxs - t_idx) <= self.chisq_window_samp)
            update_mask = same_tmpl_window & (~assigned_mask) & (snr_amp >= cthresh)
            chisq_vals[update_mask] = float(abs(chi[0]))
            chisq_dof_vals[update_mask] = dof
            assigned_mask[update_mask] = True
            iterations += 1

        return chisq_vals, chisq_dof_vals


# -----------------------------------------------------------------------------
# 2. Trigger Management & Followup Helpers
# -----------------------------------------------------------------------------

def process_and_record_triggers(
    ids_local, t_idxs, snrs, tstarts,
    stilde, h_norm, coarse_idx, fine_indices,
    filters_f, ref_snr, bank,
    s_num, ifo, triggers,
    args, power_chisq, is_asym=False,
    shifts=None,
    timers=None,
    renorm_factor=None,
    primary_snr_threshold=6.0,
):
    """Filter triggers for analysis boundary, evaluate chisq, and append batch record."""
    if len(ids_local) > 0 and getattr(stilde, 'analyze', None) is not None:
        local_shifts_check = shifts[ids_local] if shifts is not None else 0
        phys_t = t_idxs - local_shifts_check
        in_bounds = (phys_t >= stilde.analyze.start) & (phys_t < stilde.analyze.stop)
        if not np.all(in_bounds):
            ids_local = ids_local[in_bounds]
            t_idxs = t_idxs[in_bounds]
            snrs = snrs[in_bounds]
            tstarts = tstarts[in_bounds]

    if len(ids_local) > 0 and renorm_factor is not None:
        local_shifts = shifts[ids_local] if shifts is not None else 0
        phys_t = np.clip(t_idxs - local_shifts, 0, len(renorm_factor) - 1)
        r = renorm_factor[phys_t]
        snrs_renorm = snrs * r
        if not is_asym:
            thresh = primary_snr_threshold
            if thresh is not None and thresh > 0:
                keep = np.abs(snrs_renorm) >= thresh
                if not np.all(keep):
                    ids_local = ids_local[keep]
                    t_idxs = t_idxs[keep]
                    snrs = snrs[keep]
                    snrs_renorm = snrs_renorm[keep]
                    tstarts = tstarts[keep]
    else:
        snrs_renorm = snrs

    n_trig = len(ids_local)
    if n_trig > 0:
        if power_chisq.do and np.any(abs(snrs_renorm) >= power_chisq.snr_threshold):
            t_chi0 = time.perf_counter()
            chi, chi_dof = power_chisq.compute(
                ids_local, t_idxs, snrs,
                fine_indices, tstarts, stilde, bank,
                ref_snr, filters_f, coarse_idx, args,
                snr_amp=abs(snrs_renorm))
            chi_dur = time.perf_counter() - t_chi0
            t_clock = timers if timers is not None else TIMERS
            t_clock['power_chisq'] += chi_dur
        else:
            num_b = int(getattr(power_chisq, 'num_bins', 64) or 64) if power_chisq is not None else 64
            chi = np.full(n_trig, 2 * num_b - 2, dtype=float32)
            chi_dof = np.full(n_trig, num_b, dtype=np.int32)

        local_shifts = shifts[ids_local] if shifts is not None else 0
        time_offset = (-stilde.analyze.start + stilde.cumulative_index) if getattr(stilde, 'analyze', None) is not None else 0
        batch = {
            'template_id': fine_indices[ids_local],
            'time_index': (t_idxs + time_offset - local_shifts).astype(np.int64),
            't_idx': (t_idxs - local_shifts).astype(np.int64),
            'snr': snrs_renorm.astype(complex64),
            'sigmasq': np.full(n_trig, h_norm, dtype=np.float32),
            'chisq': chi.astype(float32),
            'chisq_dof': chi_dof.astype(np.int32),
            's_num': np.full(n_trig, s_num, dtype=np.int32),
            'is_asym': np.full(n_trig, is_asym, dtype=bool),
        }
        ifo_trigs = triggers[ifo]
        for col, arr in batch.items():
            ifo_trigs[col].append(arr)



def sample_asym_bins(group_engine, ref_snr, local_id, t_center,
                     sample_rate=2048.0, bin_width=0.1, num_bins=100, valid_slice=None):
    """Sample peak SNR in each bin across an asymmetric window around t_center."""
    bs = int(round(bin_width * float(sample_rate or 2048.0)))
    win_start_samp = (t_center - bs // 2) - (num_bins // 2) * bs
    win_end_samp = win_start_samp + num_bins * bs

    v_start = 0 if valid_slice is None else valid_slice.start
    v_stop = len(ref_snr) if valid_slice is None else valid_slice.stop

    asym_start = max(win_start_samp, v_start)
    asym_stop = min(win_end_samp, v_stop)

    if asym_start >= asym_stop:
        return (
            np.empty(0, dtype=np.int32),
            np.empty(0, dtype=np.int64),
            np.empty(0, dtype=np.complex64),
            np.empty(0, dtype=np.int32),
        )

    res = group_engine._td_bank.filter_series(
        ref_snr,
        valid_slice=slice(asym_start, asym_stop),
        binsize=bs,
        threshold=0.0,
        template_index=local_id
    )
    return (
        res.template_indices.astype(np.int32, copy=False),
        res.sample_indices.astype(np.int64, copy=False),
        res.snr.astype(np.complex64, copy=False),
        res.block_starts.astype(np.int32, copy=False),
    )


def select_primary_asym_candidates(
    a_ids, a_tidxs, a_snrs, sample_rate, asym_snr_threshold,
    max_primary_per_group_sec=1, stilde=None, gps_start_time=None,
):
    """Select candidate primary triggers to instigate secondary followup windowing."""
    if len(a_ids) == 0:
        return np.empty(0, dtype=np.int64)

    cand_mask = (abs(a_snrs) >= asym_snr_threshold)
    if not np.any(cand_mask):
        return np.empty(0, dtype=np.int64)

    cand_indices = np.flatnonzero(cand_mask)
    if len(cand_indices) <= 1:
        return cand_indices

    if max_primary_per_group_sec is not None and max_primary_per_group_sec > 0 and len(cand_indices) > max_primary_per_group_sec:
        sample_rate_val = float(sample_rate or 2048.0)
        cum_idx = getattr(stilde, 'cumulative_index', 0) if stilde is not None else 0
        an_start = stilde.analyze.start if (stilde is not None and getattr(stilde, 'analyze', None) is not None) else 0
        gps_start_val = float(gps_start_time) if gps_start_time is not None else float(getattr(stilde, 'start_time', 0.0))
        gps_times = gps_start_val + (a_tidxs[cand_indices] - an_start + cum_idx) / sample_rate_val
        sec_bins = np.floor(gps_times).astype(np.int64)

        unique_secs = np.unique(sec_bins)
        throttled = []
        for s in unique_secs:
            s_cands = cand_indices[sec_bins == s]
            if len(s_cands) <= max_primary_per_group_sec:
                throttled.extend(s_cands)
            else:
                s_order = np.argsort(-abs(a_snrs[s_cands]), kind='stable')
                throttled.extend(s_cands[s_order[:max_primary_per_group_sec]])
        cand_indices = np.array(sorted(throttled), dtype=np.int64)

    return cand_indices


def filter_secondary_asym_triggers(
    asym_ids, asym_t_idxs, asym_snrs, asym_tstarts, primary_snr,
    secondary_snr_threshold=None, network_snr_threshold=None, max_followup_bins=0,
    return_indices=False,
):
    """Filter secondary triggers based on secondary SNR, network SNR, and loudest bins."""
    if len(asym_ids) == 0:
        if return_indices:
            return asym_ids, asym_t_idxs, asym_snrs, asym_tstarts, np.empty(0, dtype=np.int64)
        return asym_ids, asym_t_idxs, asym_snrs, asym_tstarts

    rho_sec = np.abs(asym_snrs)
    has_sec = (secondary_snr_threshold is not None) and (secondary_snr_threshold > 0.0)
    has_net = (network_snr_threshold is not None) and (network_snr_threshold > 0.0)

    if has_sec or has_net:
        keep_mask = np.zeros(len(asym_ids), dtype=bool)
        if has_sec:
            keep_mask |= (rho_sec >= secondary_snr_threshold)
        if has_net:
            keep_mask |= (np.sqrt(abs(primary_snr) ** 2 + rho_sec ** 2) >= network_snr_threshold)
        passing_indices = np.flatnonzero(keep_mask)
    else:
        passing_indices = np.arange(len(asym_ids))

    if len(passing_indices) == 0:
        empty_res = (asym_ids[:0], asym_t_idxs[:0], asym_snrs[:0], asym_tstarts[:0])
        if return_indices:
            return (*empty_res, np.empty(0, dtype=np.int64))
        return empty_res

    if max_followup_bins is not None and max_followup_bins > 0 and len(passing_indices) > max_followup_bins:
        order = np.argsort(-rho_sec[passing_indices], kind='stable')
        passing_indices = np.sort(passing_indices[order[:max_followup_bins]])

    res = (
        asym_ids[passing_indices],
        asym_t_idxs[passing_indices],
        asym_snrs[passing_indices],
        asym_tstarts[passing_indices],
    )
    if return_indices:
        return (*res, passing_indices)
    return res



def followup_asym_candidates(
    std_trigs, active_ifos, s_num, coarse_idx, fine_indices,
    group_engine, filters_f, shifts, h_norms, middle_series,
    segments, bank, triggers, has_asym_followup, power_chisq,
    args, primary_snr_threshold, effective_asym_num_bins,
    ifo_sample_rates, ifo_gps_starts, seg_starts, ifo_gps_cli_starts,
    timers=None,
    renorm_factors=None,
):
    """Follow up primary candidate triggers in secondary detectors within asymmetric windows."""
    t_asym0 = time.perf_counter()
    t_clock = timers if timers is not None else TIMERS
    chi_asym_before = t_clock['power_chisq']

    for ifo_A in active_ifos:
        a_ids, a_tidxs, a_snrs, a_tstarts = std_trigs[ifo_A]
        if len(a_ids) == 0:
            continue
        rf_A = renorm_factors.get(ifo_A) if renorm_factors else None
        if rf_A is not None:
            shifts_A = shifts[a_ids] if shifts is not None else 0
            phys_t_A = np.clip(a_tidxs - shifts_A, 0, len(rf_A) - 1)
            a_snrs_eval = a_snrs * rf_A[phys_t_A]
        else:
            a_snrs_eval = a_snrs

        cand_indices = select_primary_asym_candidates(
            a_ids=a_ids,
            a_tidxs=a_tidxs,
            a_snrs=a_snrs_eval,
            sample_rate=ifo_sample_rates[ifo_A],
            asym_snr_threshold=primary_snr_threshold,
            max_primary_per_group_sec=args.asym_max_primary_per_group_sec,
            stilde=segments[ifo_A][s_num],
            gps_start_time=ifo_gps_cli_starts[ifo_A],
        )
        if len(cand_indices) == 0:
            continue

        # Record candidate primary triggers
        process_and_record_triggers(
            a_ids[cand_indices], a_tidxs[cand_indices],
            a_snrs[cand_indices], a_tstarts[cand_indices],
            segments[ifo_A][s_num], h_norms[ifo_A], coarse_idx, fine_indices,
            filters_f, middle_series[ifo_A][coarse_idx], bank,
            s_num, ifo_A, triggers,
            args, power_chisq, is_asym=False,
            shifts=shifts,
            timers=timers,
            renorm_factor=rf_A,
            primary_snr_threshold=primary_snr_threshold,
        )

        sr_A = ifo_sample_rates[ifo_A]
        s_start_A = seg_starts[(ifo_A, s_num)]
        t0_A = ifo_gps_starts[ifo_A]

        for ifo_B in active_ifos:
            if ifo_B == ifo_A:
                continue
            stilde_B = segments[ifo_B][s_num]
            ref_snr_B = middle_series[ifo_B][coarse_idx]
            sr_B = ifo_sample_rates[ifo_B]
            s_start_B = seg_starts[(ifo_B, s_num)]
            t0_B = ifo_gps_starts[ifo_B]
            rf_B = renorm_factors.get(ifo_B) if renorm_factors else None

            for k in cand_indices:
                cand_lid = a_ids[k]
                a_tcenter = a_tidxs[k]
                gps_trig = t0_A + (s_start_A + a_tcenter) / sr_A
                cand_tcenter = int(round((gps_trig - t0_B) * sr_B)) - s_start_B

                asym_ids, asym_t_idxs, asym_snrs, asym_tstarts = sample_asym_bins(
                    group_engine=group_engine,
                    ref_snr=ref_snr_B,
                    local_id=cand_lid,
                    t_center=cand_tcenter,
                    sample_rate=sr_B,
                    bin_width=args.asym_bin_width,
                    num_bins=effective_asym_num_bins,
                    valid_slice=stilde_B.analyze,
                )

                has_asym_followup[ifo_B] += 1

                if rf_B is not None and len(asym_ids) > 0:
                    shifts_B = shifts[asym_ids] if shifts is not None else 0
                    phys_t_B = np.clip(asym_t_idxs - shifts_B, 0, len(rf_B) - 1)
                    asym_snrs_eval = asym_snrs * rf_B[phys_t_B]
                else:
                    asym_snrs_eval = asym_snrs

                prim_snr_eval = a_snrs_eval[k]
                asym_ids, asym_t_idxs, _, asym_tstarts, passing_idx = filter_secondary_asym_triggers(
                    asym_ids, asym_t_idxs, asym_snrs_eval, asym_tstarts,
                    primary_snr=prim_snr_eval,
                    secondary_snr_threshold=args.asym_secondary_snr_threshold,
                    network_snr_threshold=args.asym_network_snr_threshold,
                    max_followup_bins=args.asym_max_followup_bins,
                    return_indices=True,
                )

                process_and_record_triggers(
                    asym_ids, asym_t_idxs, asym_snrs[passing_idx], asym_tstarts,
                    stilde_B, h_norms[ifo_B], coarse_idx, fine_indices,
                    filters_f, ref_snr_B, bank,
                    s_num, ifo_B, triggers,
                    args, power_chisq, is_asym=True,
                    shifts=shifts,
                    timers=timers,
                    renorm_factor=rf_B,
                    primary_snr_threshold=args.asym_secondary_snr_threshold,
                )


    chi_asym_now = t_clock['power_chisq']
    asym_dur = (time.perf_counter() - t_asym0) - (chi_asym_now - chi_asym_before)
    t_clock['asym_followup'] += asym_dur


_SHARED_WORKER_CONTEXT = {}


def process_top_template_task(task_args):
    """Filter a single top template across all data segments and detectors."""
    top_idx, rank, n_top, fine_cnt = task_args
    ctx = _SHARED_WORKER_CONTEXT

    bank = ctx['bank']
    top_templates = ctx['top_templates']
    upper_group_data = ctx['upper_group_data']
    instruments = ctx['instruments']
    segments = ctx['segments']
    num_segs = ctx['num_segs']
    can_asym_by_seg = ctx['can_asym_by_seg']
    ifo_sample_rates = ctx['ifo_sample_rates']
    ifo_gps_starts = ctx['ifo_gps_starts']
    ifo_gps_cli_starts = ctx['ifo_gps_cli_starts']
    seg_starts = ctx['seg_starts']
    args = ctx['args']
    primary_snr_threshold = ctx['primary_snr_threshold']
    delta_f = ctx['delta_f']
    sample_rate = ctx['sample_rate']
    flow = ctx['flow']
    effective_asym_num_bins = ctx['effective_asym_num_bins']
    coarse_keep = ctx['coarse_keep']

    # Independent engine per worker task ensuring isolated FFT buffers
    engine = MatchedFilterRatioControl(
        snr_threshold=primary_snr_threshold,
        delta_f=delta_f,
        high_frequency_cutoff=args.high_frequency_cutoff,
        batch_size=args.batch_size,
        tap_sample_rate=bank.sample_rate,
        engine_sample_rate=sample_rate,
        engine=args.ratio_filter_engine,
        false_dismissal=args.ratio_filter_false_dismissal,
        coarse_band_hz=args.ratio_filter_band,
        first_stage_snr=args.ratio_filter_first_stage_snr,
    )

    local_timers = collections.defaultdict(float)
    worker_triggers = {ifo: collections.defaultdict(list) for ifo in instruments}
    worker_asym = {ifo: 0 for ifo in instruments}

    top_idx = int(top_idx)
    u_data = upper_group_data[top_idx]
    counts_raw = u_data['counts']
    order_raw = np.argsort(counts_raw)
    m_all = u_data['m_all'][order_raw]

    if coarse_keep is not None:
        row_mask = np.isin(m_all, list(coarse_keep))
        if not row_mask.any():
            return top_idx, {ifo: {} for ifo in instruments}, worker_asym, dict(local_timers)
        keep_idx = np.flatnonzero(row_mask)
    else:
        keep_idx = slice(None)

    middle_ids = m_all[keep_idx]
    counts_u = counts_raw[order_raw][keep_idx]
    taps_u = u_data['taps'][order_raw][keep_idx]
    sigmas_u = u_data['sigmas'][order_raw][keep_idx]

    t_dec0 = time.perf_counter()
    top_template = top_templates[top_idx]
    local_timers['top_decomp'] += time.perf_counter() - t_dec0
    ref_s = sigmas_u[:, 0]
    target_s = sigmas_u[:, 2]
    all_scales = np.asarray((ref_s / target_s) / bank.sample_rate, dtype=np.float32)
    sigmasq_ratio_by_middle = {
        int(mid): float((target_s[row] / ref_s[row]) ** 2)
        for row, mid in enumerate(middle_ids)
    }

    logging.info(f"Top template {rank+1}/{n_top} (id={top_idx}) with {len(middle_ids)} middle groups ({fine_cnt} fine templates)")

    t_up_prep = time.perf_counter()
    any_seg = next(segments[i][0] for i in instruments if len(segments[i]) > 0)
    upper_batch = UpperReferenceBatch(
        taps_u, counts_u, middle_ids, (len(any_seg) - 1) * 2, scales=all_scales
    )
    local_timers['upper_prep'] += time.perf_counter() - t_up_prep

    top_groups = []
    for mid in middle_ids:
        coarse_idx = int(mid)
        taps, counts, fine_indices, shifts = bank.get_firs(coarse_idx, return_shifts=True)
        if len(fine_indices) == 0:
            continue
        group_engine = MatchedFilterRatioControl(
            snr_threshold=primary_snr_threshold,
            delta_f=delta_f,
            high_frequency_cutoff=args.high_frequency_cutoff,
            batch_size=args.batch_size,
            tap_sample_rate=bank.sample_rate,
            engine_sample_rate=sample_rate,
            engine=args.ratio_filter_engine,
            false_dismissal=args.ratio_filter_false_dismissal,
            coarse_band_hz=args.ratio_filter_band,
            first_stage_snr=args.ratio_filter_first_stage_snr,
        )
        t_fp0 = time.perf_counter()
        filters_f, _ = group_engine.prepare_filters(taps, counts)
        local_timers['filter_prep'] += time.perf_counter() - t_fp0
        top_groups.append((coarse_idx, counts, fine_indices,
                           group_engine, filters_f, shifts,
                           np.arange(len(fine_indices))))

    if not top_groups:
        del upper_batch
        return top_idx, {ifo: {} for ifo in instruments}, worker_asym, dict(local_timers)

    top_pad = max(
        [4096] + [
            int(g.n)
            for g_entry in top_groups
            if getattr(g_entry[3], '_td_bank', None) is not None
            for g in g_entry[3]._td_bank._groups
        ]
    )

    power_chisq = RatioPowerChisq(
        args.chisq_bins,
        args.chisq_snr_threshold,
        sample_rate,
        flow=flow,
        f_final=bank.table['f_final'].max() if hasattr(bank, 'table') and 'f_final' in bank.table else 800.0,
        chisq_window=getattr(args, 'chisq_window', 1.0),
        chisq_iterations=getattr(args, 'chisq_iterations', None),
    )

    for s_num in range(num_segs):
        active_ifos = [ifo for ifo in instruments if s_num < len(segments[ifo])]
        if not active_ifos:
            continue

        can_asym_seg = can_asym_by_seg.get(s_num, False)

        middle_series = {}
        norms = {}
        renorm_factors = {}
        for ifo in active_ifos:
            st = segments[ifo][s_num]
            t_ref0 = time.perf_counter()
            series, norm = engine.make_reference_series(st, st.psd, top_template)
            dt_sample = float(st.delta_t)
            amp_scale = float(st.delta_t / engine.decimation_factor)
            if not getattr(args, 'disable_dynamic_snr_renorm', False):
                renorm_factors[ifo] = get_dynamic_snr_renorm_factor(
                    series, dt=dt_sample, scale=amp_scale,
                    window_duration=getattr(args, 'dynamic_snr_window', 8.0),
                    hollow_duration=getattr(args, 'dynamic_snr_hollow', 0.5),
                    variance_floor=getattr(args, 'dynamic_snr_variance_floor', 1.0),
                )
            else:
                renorm_factors[ifo] = None
            local_timers['upper_ref'] += time.perf_counter() - t_ref0
            norms[ifo] = norm

            t0 = time.perf_counter()
            v_slice = getattr(st, 'analyze', None) if not os.environ.get('PYCBC_UNCONSTRAINED_UPPER') else None
            middle_series[ifo] = upper_batch.run(
                series, valid_slice=v_slice, ifo=ifo, pad=top_pad
            )
            local_timers['upper_fir'] += time.perf_counter() - t0

        t_seg_start = time.time()
        t_seg_fine_start = local_timers['fine_fir']
        t_seg_chi_start = local_timers['power_chisq']
        t_seg_asym_start = local_timers['asym_followup']

        for g_entry in top_groups:
            coarse_idx, counts, fine_indices, group_engine, filters_f, shifts, local_arange = g_entry
            std_trigs = {}
            h_norms = {ifo: norms[ifo] * sigmasq_ratio_by_middle[coarse_idx] for ifo in active_ifos}

            for ifo in active_ifos:
                stilde = segments[ifo][s_num]
                h_norm = h_norms[ifo]
                ref_snr = middle_series[ifo][coarse_idx]
                t_fine0 = time.perf_counter()
                ids_local, t_idxs, snrs, tstarts, _ = group_engine.process_segment(
                    stilde, stilde.psd, h_norm, filters_f, counts,
                    local_arange,
                    valid_slice=stilde.analyze,
                    reference_series=ref_snr,
                    profile_template=top_template,
                )
                local_timers['fine_fir'] += time.perf_counter() - t_fine0

                if not can_asym_seg:
                    process_and_record_triggers(
                        ids_local, t_idxs, snrs, tstarts,
                        stilde, h_norm, coarse_idx, fine_indices,
                        filters_f, ref_snr, bank,
                        s_num, ifo, worker_triggers,
                        args, power_chisq, is_asym=False,
                        shifts=shifts,
                        timers=local_timers,
                        renorm_factor=renorm_factors.get(ifo),
                        primary_snr_threshold=primary_snr_threshold,
                    )
                else:
                    std_trigs[ifo] = (ids_local, t_idxs, snrs, tstarts)

            if can_asym_seg:
                followup_asym_candidates(
                    std_trigs, active_ifos, s_num, coarse_idx, fine_indices,
                    group_engine, filters_f, shifts, h_norms, middle_series,
                    segments, bank, worker_triggers, worker_asym, power_chisq,
                    args, primary_snr_threshold, effective_asym_num_bins,
                    ifo_sample_rates, ifo_gps_starts, seg_starts, ifo_gps_cli_starts,
                    timers=local_timers,
                    renorm_factors=renorm_factors,
                )

        t_seg_dur = max(time.time() - t_seg_start, 1e-6)
        n_tmpl_seg = sum(len(g[2]) for g in top_groups)
        stilde_ref = segments[active_ifos[0]][s_num]
        total_analyzed_dur = len(active_ifos) * (stilde_ref.analyze.stop - stilde_ref.analyze.start) * stilde_ref.delta_t
        tperf_seg = total_analyzed_dur / t_seg_dur * n_tmpl_seg
        s_fine = local_timers['fine_fir'] - t_seg_fine_start
        s_chi = local_timers['power_chisq'] - t_seg_chi_start
        s_asym = local_timers['asym_followup'] - t_seg_asym_start
        logging.info(f"[Top {top_idx}] Seg {s_num+1}/{num_segs}: {len(top_groups)} batches ({n_tmpl_seg} templates) in {t_seg_dur:.2f} s ({tperf_seg:.0f} temp-s/s) [fine={s_fine:.2f}s chi={s_chi:.2f}s asym={s_asym:.2f}s]")
        del middle_series
        del norms
        del renorm_factors


    del top_groups
    del upper_batch
    del top_template
    UpperReferenceBatch.clear_buffers()
    power_chisq.ratio_cache.clear()

    collapsed_trigs = {}
    for ifo in instruments:
        collapsed_trigs[ifo] = {}
        for col, arrs in worker_triggers[ifo].items():
            if arrs:
                collapsed_trigs[ifo][col] = np.concatenate(arrs)
            else:
                collapsed_trigs[ifo][col] = np.empty(0)

    return top_idx, collapsed_trigs, worker_asym, dict(local_timers)


# -----------------------------------------------------------------------------
# 3. Data & Setup Helpers
# -----------------------------------------------------------------------------

def get_ifo_opts(opt, ifo):
    """Return a single-ifo namespace with all multi-det options resolved for ifo."""
    opt_ifo = pycbc.types.optparse.copy_opts_for_single_ifo(opt, ifo)
    setattr(opt_ifo, 'ifo', ifo)
    for attr in ['channel_name', 'sample_rate', 'gps_start_time', 'gps_end_time',
                 'segment_length', 'segment_start_pad', 'segment_end_pad',
                 'psd_estimation', 'strain_high_pass', 'pad_data']:
        val = getattr(opt_ifo, attr, None)
        if isinstance(val, dict):
            setattr(opt_ifo, attr, val.get(ifo, None))
    return opt_ifo


def fix_frame_files_args(raw_argv=None):
    if raw_argv is None:
        raw_argv = sys.argv[1:]
    channel_ifos = []
    for i, a in enumerate(raw_argv):
        if a == '--channel-name' and i + 1 < len(raw_argv):
            for part in raw_argv[i+1:]:
                if part.startswith('--'):
                    break
                if ':' in part:
                    channel_ifos.append(part.split(':')[0])

    new_argv = []
    in_frame_files = False
    for a in raw_argv:
        if a == '--frame-files':
            in_frame_files = True
            new_argv.append(a)
        elif in_frame_files:
            if a.startswith('--'):
                in_frame_files = False
                new_argv.append(a)
            else:
                if ':' in a:
                    new_argv.append(a)
                else:
                    base = os.path.basename(a)
                    m = re.match(r'^[A-Z]-([A-Z0-9]{2})_', base)
                    if m:
                        new_argv.append(f"{m.group(1)}:{a}")
                    elif len(channel_ifos) == 1:
                        new_argv.append(f"{channel_ifos[0]}:{a}")
                    else:
                        new_argv.append(a)
        else:
            new_argv.append(a)
    return new_argv


def setup_strain_and_segments(args, instruments, inj_filter_rejector, flow):
    """Generate, condition, and segment strain data for all instruments."""
    gating_info = {}
    gwstrain_start_time = {}
    psd_var = {}
    segments = {}
    gwstrain = {}
    sample_rate = None
    flen = None
    delta_f = None

    for count, ifo in enumerate(instruments):
        logging.info("Generating and conditioning strain for %s...", ifo)
        ifo_inj_rejector = inj_filter_rejector[ifo] if inj_filter_rejector else None
        ifo_strain = pycbc.strain.from_cli_single_ifo(
            args, ifo, inj_filter_rejector=ifo_inj_rejector,
            dyn_range_fac=pycbc.DYN_RANGE_FAC
        )
        gating_info[ifo] = getattr(ifo_strain, 'gating_info', None)
        gwstrain_start_time[ifo] = float(ifo_strain.start_time)

        raw_strain_for_psd = ifo_strain.copy() if getattr(args, 'overwhiten_strain', False) else ifo_strain

        if getattr(args, 'subtract_lines', False):
            logging.info("Applying coherent line subtraction for %s...", ifo)
            from pycbc.filter.overwhiten import subtract_coherent_lines
            orig_injs = getattr(ifo_strain, 'injections', None)
            orig_gating = getattr(ifo_strain, 'gating_info', None)
            f_low_sub = max(25.0, getattr(args, 'overwhiten_f_low', 25.0))
            ifo_strain, sub_lines = subtract_coherent_lines(ifo_strain, f_low=f_low_sub)
            ifo_strain = ifo_strain.astype(np.float32)
            if orig_injs is not None:
                ifo_strain.injections = orig_injs
            if orig_gating is not None:
                ifo_strain.gating_info = orig_gating
            logging.info("Subtracted %d coherent lines in %s", len(sub_lines), ifo)

        if getattr(args, 'overwhiten_strain', False):
            logging.info("Applying continuous overwhitening for %s...", ifo)
            from pycbc.filter.overwhiten import overwhiten_strain
            orig_injs = getattr(ifo_strain, 'injections', None)
            orig_gating = getattr(ifo_strain, 'gating_info', None)
            f_low_ow = getattr(args, 'overwhiten_f_low', 18.0)
            max_dur_ow = getattr(args, 'overwhiten_max_filter_duration', 4.0)
            inpaint_ow = getattr(args, 'inpaint_edges', False)
            ifo_strain, _, _ = overwhiten_strain(
                ifo_strain, f_low=f_low_ow, max_filter_duration=max_dur_ow,
                inpaint_edges=inpaint_ow
            )
            ifo_strain = ifo_strain.astype(np.float32)
            ifo_strain._is_overwhitened = True
            if orig_injs is not None:
                ifo_strain.injections = orig_injs
            if orig_gating is not None:
                ifo_strain.gating_info = orig_gating
            logging.info("Overwhitening completed for %s", ifo)

        logging.info("Making frequency-domain data segments and associating PSDs for %s...", ifo)
        single_det_opt = pycbc.types.optparse.copy_opts_for_single_ifo(args, ifo)
        ifo_segments = pycbc.strain.StrainSegments.from_cli_single_ifo(args, ifo_strain, ifo)

        if count == 0:
            sample_rate = ifo_strain.sample_rate
            flen = ifo_segments.freq_len
            delta_f = ifo_segments.delta_f
        else:
            assert sample_rate == ifo_strain.sample_rate, f"Sample rate mismatch for {ifo}"
            assert flen == ifo_segments.freq_len, f"Freq len mismatch for {ifo}"
            assert delta_f == ifo_segments.delta_f, f"Delta f mismatch for {ifo}"

        if args.psdvar_segment is not None:
            logging.info("Calculating PSD variation for %s", ifo)
            ifo_opts = get_ifo_opts(args, ifo)
            psd_var[ifo] = pycbc.psd.calc_filt_psd_variation(
                raw_strain_for_psd, ifo_opts.psdvar_segment,
                ifo_opts.psdvar_short_segment, ifo_opts.psdvar_long_segment,
                ifo_opts.psdvar_psd_duration, ifo_opts.psdvar_psd_stride,
                ifo_opts.psd_estimation, ifo_opts.psdvar_low_freq, ifo_opts.psdvar_high_freq
            )

        fd_segs = ifo_segments.fourier_segments()
        pycbc.psd.associate_psds_to_segments(
            single_det_opt, fd_segs, raw_strain_for_psd, flen, delta_f, flow,
            dyn_range_factor=pycbc.DYN_RANGE_FAC, precision='single'
        )
        if not getattr(args, 'overwhiten_strain', False):
            for seg in fd_segs:
                seg[:] = seg / seg.psd
        else:
            for seg in fd_segs:
                if seg.dtype != np.complex64:
                    seg._data = seg._data.astype(np.complex64)
        segments[ifo] = fd_segs

        ifo_strain._data = np.empty(0, dtype=ifo_strain.dtype)
        if raw_strain_for_psd is not ifo_strain:
            raw_strain_for_psd._data = np.empty(0, dtype=raw_strain_for_psd.dtype)
            del raw_strain_for_psd
        gwstrain[ifo] = ifo_strain
        del ifo_segments
        logging.info("Finished strain setup for %s", ifo)

    return segments, gwstrain, gating_info, gwstrain_start_time, psd_var, sample_rate, flen, delta_f


def prepare_segment_geometry(args, instruments, segments, gwstrain_start_time, num_segs, sample_rate):
    """Precompute segment GPS bounds, sample rates, and detector overlap validity."""
    ifo_sample_rates = {}
    ifo_gps_starts = {}
    ifo_gps_cli_starts = {}
    seg_starts = {}

    for ifo in instruments:
        sr = args.sample_rate[ifo] if isinstance(args.sample_rate, dict) else args.sample_rate
        ifo_sample_rates[ifo] = float(sr or sample_rate or 2048.0)
        ifo_gps_starts[ifo] = gwstrain_start_time[ifo]
        cli_start = args.gps_start_time[ifo] if isinstance(args.gps_start_time, dict) else args.gps_start_time
        ifo_gps_cli_starts[ifo] = cli_start
        for s_num, st in enumerate(segments[ifo]):
            seg_starts[(ifo, s_num)] = getattr(st, 'seg_slice', slice(0)).start if getattr(st, 'seg_slice', None) is not None else 0

    can_asym_by_seg = {}
    if args.asym_windowing and len(instruments) > 1:
        for s_num in range(num_segs):
            active_ifos = [ifo for ifo in instruments if s_num < len(segments[ifo])]
            if len(active_ifos) <= 1:
                can_asym_by_seg[s_num] = False
                continue
            seg_gps = {}
            for ifo in active_ifos:
                st = segments[ifo][s_num]
                sr = ifo_sample_rates[ifo]
                t0 = ifo_gps_starts[ifo]
                s_start = seg_starts[(ifo, s_num)]
                a_start = st.analyze.start if getattr(st, 'analyze', None) is not None else 0
                a_stop = st.analyze.stop if getattr(st, 'analyze', None) is not None else len(st)
                seg_gps[ifo] = (t0 + (s_start + a_start) / sr, t0 + (s_start + a_stop) / sr)

            can_asym = True
            for i_idx in range(len(active_ifos)):
                for j_idx in range(i_idx + 1, len(active_ifos)):
                    ifo_1, ifo_2 = active_ifos[i_idx], active_ifos[j_idx]
                    if max(seg_gps[ifo_1][0], seg_gps[ifo_2][0]) >= min(seg_gps[ifo_1][1], seg_gps[ifo_2][1]):
                        can_asym = False
                        break
                if not can_asym:
                    break
            can_asym_by_seg[s_num] = can_asym
    else:
        can_asym_by_seg = collections.defaultdict(lambda: False)

    return can_asym_by_seg, ifo_sample_rates, ifo_gps_starts, ifo_gps_cli_starts, seg_starts


def init_event_managers(args, instruments, gating_info):
    """Initialize EventManager instances for each detector."""
    out_types = {
        'time_index': int,
        'snr': complex64,
        'sigmasq': float32,
        'chisq': float32,
        'chisq_dof': int,
        'bank_chisq': float32,
        'bank_chisq_dof': int,
        'cont_chisq': float32,
        'sg_chisq': float32,
        'psd_var_val': float32,
    }
    names = sorted(out_types.keys())
    event_mgr = {}
    for ifo in instruments:
        ifo_opts = get_ifo_opts(args, ifo)
        event_mgr[ifo] = pycbc.events.EventManager(
            ifo_opts, names, [out_types[n] for n in names],
            psd=None, gating_info=gating_info[ifo]
        )
        event_mgr[ifo].ifo = ifo
    return event_mgr


# -----------------------------------------------------------------------------
# 4. Trigger Ingestion & Output Finalization
# -----------------------------------------------------------------------------

def ingest_ifo_triggers(
    ifo, ifo_trigs, ifo_mgr, ifo_strain, ifo_segments, bank,
    args, psd_var_ifo, sg_chisq, cluster_window, has_asym_followup_ifo,
):
    """Collate, sort, normalize, and ingest all triggers for a detector into EventManager."""
    if has_asym_followup_ifo:
        ifo_mgr.non_threshold_time = float(args.asym_num_bins * args.asym_bin_width)
        logging.info("[%s] Non-threshold followup window: %.2f seconds (%d raw intervals)",
                     ifo, ifo_mgr.non_threshold_time, has_asym_followup_ifo)
    else:
        ifo_mgr.non_threshold_time = 0.0

    if not ifo_trigs or not ifo_trigs.get('template_id'):
        logging.info("[%s] Trigger identification complete: 0 total triggers", ifo)
        return

    data = {col: np.concatenate(arrs) for col, arrs in ifo_trigs.items()}
    n_candidates = len(data['template_id'])
    logging.info("[%s] Trigger identification complete: %d total triggers in %d batches",
                 ifo, n_candidates, len(ifo_trigs['template_id']))

    t_ingest_start = time.time()
    sg_dur = 0.0
    logging.info("[%s] Grouping triggers by template...", ifo)

    sort_idx = np.argsort(data['template_id'], kind='stable')
    for col in data:
        data[col] = data[col][sort_idx]
    del sort_idx

    unique_gids, start_indices = np.unique(data['template_id'], return_index=True)
    end_indices = np.append(start_indices[1:], n_candidates)

    if args.template_normalization_method == 'precalculated_sigma':
        if not hasattr(bank, 'sigma_snr_rescale'):
            bank.setup_sigma_norm()
        snr_rescale = bank.sigma_snr_rescale[data['template_id']]
        sigmasq_rescale = bank.sigma_sigma_rescale[data['template_id']] ** 2.0
    else:
        snr_rescale = bank.snr_rescale(data['template_id'], method=args.template_normalization_method)
        sigmasq_rescale = bank.sigma_rescale(data['template_id'], method=args.template_normalization_method) ** 2.0

    data['snr'] = (data['snr'] / snr_rescale).astype(complex64)
    data['sigmasq'] = (data['sigmasq'] * sigmasq_rescale).astype(float32)

    if sg_chisq.do:
        t_sg_start = time.time()
        data['sg_chisq'] = np.ones(n_candidates, dtype=np.float32)
        rchisq = np.where(data['chisq_dof'] > 0, data['chisq'] / data['chisq_dof'], 1.0)
        all_nsnr = ranking.newsnr(np.abs(data['snr']), rchisq)

        for gid, s_idx, e_idx in zip(unique_gids, start_indices, end_indices):
            gid_int = int(gid)
            thash = bank.table['template_hash'][gid_int]
            if thash not in sg_chisq.params:
                continue
            tmpl_nsnr = all_nsnr[s_idx:e_idx]
            if not np.any(tmpl_nsnr >= sg_chisq.snr_threshold):
                continue

            tmpl = bank[gid_int]
            snums_tmpl = data['s_num'][s_idx:e_idx]
            snrs_tmpl = data['snr'][s_idx:e_idx]
            chi_tmpl = data['chisq'][s_idx:e_idx]
            dof_tmpl = data['chisq_dof'][s_idx:e_idx]
            tidxs_tmpl = data['t_idx'][s_idx:e_idx]

            for s in np.unique(snums_tmpl):
                s_mask = (snums_tmpl == s)
                stilde = ifo_segments[s]
                res = sg_chisq.values(
                    stilde, tmpl, stilde.psd,
                    snrs_tmpl[s_mask], 1.0,
                    chi_tmpl[s_mask], dof_tmpl[s_mask],
                    tidxs_tmpl[s_mask]
                )
                if res is not None:
                    data['sg_chisq'][s_idx:e_idx][s_mask] = res
        sg_dur = time.time() - t_sg_start
        TIMERS['sg_chisq'] += sg_dur
        logging.info("[%s] SG chisq completed in %.2f s", ifo, sg_dur)
    else:
        sg_dur = 0.0
        data['sg_chisq'] = np.zeros(n_candidates, dtype=np.float32)

    ifo_opts = get_ifo_opts(args, ifo)
    use_psd_var = args.psdvar_short_segment is not None
    if use_psd_var:
        gps_start = ifo_opts.gps_start_time
        data['psd_var_val'] = pycbc.psd.find_trigger_value(
            psd_var_ifo, data['time_index'], gps_start, ifo_opts.sample_rate)
        ingest_cols = ['time_index', 'snr', 'sigmasq', 'chisq', 'chisq_dof', 'sg_chisq', 'psd_var_val']
    else:
        ingest_cols = ['time_index', 'snr', 'sigmasq', 'chisq', 'chisq_dof', 'sg_chisq']

    logging.info("[%s] Ingesting triggers for %d templates into EventManager...", ifo, len(unique_gids))
    for t_idx, (gid, s_idx, e_idx) in enumerate(zip(unique_gids, start_indices, end_indices)):
        ifo_mgr.new_template(tmplt=bank.table[int(gid)])
        tmpl_is_asym = data['is_asym'][s_idx:e_idx]
        if not np.any(tmpl_is_asym):
            ifo_mgr.add_template_events(ingest_cols, [data[col][s_idx:e_idx] for col in ingest_cols])
            if cluster_window > 0:
                ifo_mgr.cluster_template_events("time_index", "snr", cluster_window)
        else:
            for mask, do_cluster in ((~tmpl_is_asym, cluster_window > 0), (tmpl_is_asym, False)):
                if np.any(mask):
                    sub = s_idx + np.flatnonzero(mask)
                    ifo_mgr.add_template_events(ingest_cols, [data[col][sub] for col in ingest_cols])
                    if do_cluster:
                        ifo_mgr.cluster_template_events("time_index", "snr", cluster_window)

        ifo_mgr.finalize_template_events()
        if args.finalize_events_template_rate is not None and (t_idx + 1) % args.finalize_events_template_rate == 0:
            ifo_mgr.consolidate_events(ifo_opts, gwstrain=ifo_strain)

    ingest_total = time.time() - t_ingest_start
    TIMERS['event_ingest'] += max(0.0, ingest_total - sg_dur)
    logging.info("[%s] Ingestion completed in %.2f s", ifo, ingest_total)


def log_performance_summary(run_time, tsetup, instruments, segments, bank, output_path, cores=1):
    """Log formatted timing breakdown and write timing JSON output."""
    total_analyzed_det_sec = sum(
        sum((segments[ifo][s].analyze.stop - segments[ifo][s].analyze.start) * segments[ifo][s].delta_t
            for s in range(len(segments[ifo])))
        for ifo in instruments
    )
    total_tmpl_sec = total_analyzed_det_sec * len(bank.table)
    overall_throughput = total_tmpl_sec / max(run_time, 1e-6)
    cores = max(1, int(cores))
    core_throughput = overall_throughput / cores
    logging.info(
        "Overall search throughput: %.0f template-s/s (%.2f M templates/s, %.2f M template-s/core-s on %d cores) over %.2f s run time",
        overall_throughput, overall_throughput / 1e6, core_throughput / 1e6, cores, run_time,
    )

    other_time = max(0.0, run_time - sum(TIMERS.values()))
    categories = [
        ("Data Setup & Conditioning", TIMERS.get('data_setup', 0.0)),
        ("Top Template Decompression", TIMERS.get('top_decomp', 0.0)),
        ("Upper Ref SNR Generation", TIMERS.get('upper_ref', 0.0)),
        ("Upper Batch Plan Prep", TIMERS.get('upper_prep', 0.0)),
        ("Fine Ratio Filter Prep", TIMERS.get('filter_prep', 0.0)),
        ("Upper Decimation FIR", TIMERS.get('upper_fir', 0.0)),
        ("Fine FIR Filtering (Primary)", TIMERS.get('fine_fir', 0.0)),
        ("Asymmetric Followup Filtering", TIMERS.get('asym_followup', 0.0)),
        ("Power Chisq Calculation", TIMERS.get('power_chisq', 0.0)),
        ("Sine-Gaussian Chisq", TIMERS.get('sg_chisq', 0.0)),
        ("Event Ingestion & Clustering", TIMERS.get('event_ingest', 0.0)),
        ("Event Finalize & HDF Output", TIMERS.get('event_finalize', 0.0)),
        ("Other / Pipeline Overhead", other_time),
    ]

    logging.info("=" * 70)
    logging.info("PIPELINE PERFORMANCE BREAKDOWN:")
    logging.info(f"{'Pipeline Stage':<35} {'Time (s)':>12} {'Share (%)':>10}")
    logging.info("-" * 70)
    for cat_name, cat_time in categories:
        pct = (cat_time / run_time) * 100.0 if run_time > 0 else 0.0
        logging.info(f"{cat_name:<35} {cat_time:>12.3f} {pct:>9.2f}%")
    logging.info("-" * 70)
    logging.info(f"{'Total Run Time':<35} {run_time:>12.3f} {100.0:>9.2f}%")
    logging.info("=" * 70)

    try:
        import json
        timing_dict = {cat_name: cat_time for cat_name, cat_time in categories}
        timing_dict["Total Run Time"] = run_time
        timing_dict["Overall Throughput"] = overall_throughput
        timing_dict["Core Throughput"] = core_throughput
        timing_dict["Cores"] = cores
        timing_path = output_path + ".timing.json"
        with open(timing_path, "w") as tf:
            json.dump(timing_dict, tf, indent=2)
        logging.info("Saved timing breakdown to %s", timing_path)
    except Exception as e:
        logging.warning("Failed to save timing JSON: %s", e)


# -----------------------------------------------------------------------------
# 5. CLI Arguments & Main Entry Point
# -----------------------------------------------------------------------------

def get_args():
    parser = argparse.ArgumentParser(description=__doc__)
    pycbc.add_common_pycbc_options(parser)

    # Standard PyCBC Data/Segment Options
    pycbc.strain.insert_strain_option_group_multi_ifo(parser)
    pycbc.strain.StrainSegments.insert_segment_option_group_multi_ifo(parser)
    pycbc.psd.insert_psd_option_group_multi_ifo(parser)
    pycbc.scheme.insert_processing_option_group(parser)
    pycbc.fft.insert_fft_option_group(parser)
    pycbc.inject.insert_injfilterrejector_option_group_multi_ifo(parser)
    SingleDetSGChisq.insert_option_group(parser)

    # Multi-detector & Asymmetric Windowing Options
    asym_group = parser.add_argument_group("Asymmetric Windowing Options")
    asym_group.add_argument("--asym-windowing", action="store_true",
                            help="Enable asymmetric windowing across detectors.")
    asym_group.add_argument("--asym-snr-threshold", type=float, default=6.0,
                            help="SNR threshold in primary detector to trigger asymmetric windowing in other detectors.")
    asym_group.add_argument("--asym-secondary-snr-threshold", type=float, default=None,
                            help="Secondary detector SNR threshold for asymmetric triggers. "
                                 "Triggers below this are discarded unless network SNR threshold is exceeded.")
    asym_group.add_argument("--asym-network-snr-threshold", type=float, default=None,
                            help="Network SNR threshold with primary trigger. "
                                 "Secondary triggers with network SNR >= threshold are kept unconditionally.")
    asym_group.add_argument("--asym-max-followup-bins", type=int, default=2,
                            help="Maximum number of loudest followup bins to keep per primary candidate trigger "
                                 "(default: 2, set 0 to keep all passing bins).")
    asym_group.add_argument("--asym-max-primary-per-group-sec", type=int, default=1,
                            help="Maximum number of primary triggers per 1-second interval within each fine "
                                 "template group to instigate secondary followup windowing (default: 1, set 0 to disable).")
    asym_group.add_argument("--asym-bin-width", type=float, default=0.1,
                            help="Width in seconds of each bin in the asymmetric window (default 0.1s).")
    asym_group.add_argument("--asym-num-bins", type=int, default=100,
                            help="Number of bins in the asymmetric window (default 100).")

    # Analysis Options
    parser.add_argument('--output', required=True,
                        help="Path to output HDF5 file.")
    parser.add_argument('--cores', type=int, default=1,
                        help="Number of CPU cores to use for multiprocessing over top templates (default: 1).")
    parser.add_argument("--bank-file", type=str, required=True,
                        help="Path to the HDF5 Ratio Bank file.")
    parser.add_argument('--snr-threshold', type=float, default=None,
                        help="SNR threshold for trigger generation.")
    parser.add_argument("--newsnr-threshold", type=float, metavar='THRESHOLD',
                        help="Cut triggers with NewSNR less than THRESHOLD")
    parser.add_argument("--low-frequency-cutoff", type=float,
                        help="The low frequency cutoff to use for filtering (Hz)")
    parser.add_argument("--enable-compressed-waveforms", action="store_true", default=True,
                        help="Enable use of compressed top waveforms if present in the bank (default: True).")
    parser.add_argument("--disable-compressed-waveforms", action="store_false",
                        dest="enable_compressed_waveforms",
                        help="Disable use of compressed waveforms and regenerate waveforms on the fly.")

    # Ratio Specific Options
    group = parser.add_argument_group("Ratio Filter Options")
    group.add_argument('--high-frequency-cutoff', type=float,
                       help="High frequency cutoff (defaults to Nyquist).")
    group.add_argument('--batch-size', type=int, default=None,
                       help="Number of filters to process in one FFT batch (default: auto-sized based on L2 cache).")
    group.add_argument('--ratio-filter-engine', default='matchedfilter-hierarchical',
                       choices=('matchedfilter-hierarchical', 'matchedfilter'),
                       help="Which back end runs the innermost correlate.")
    group.add_argument('--ratio-filter-false-dismissal', type=float,
                       default=1e-3, metavar='PROB',
                       help="Tolerated probability of missing a signal at the SNR threshold.")
    group.add_argument('--ratio-filter-band', type=float, default=0, metavar='HZ',
                       help="Width of the band the first stage filters, in Hz. 0 uses the design table's choice.")
    group.add_argument('--ratio-filter-first-stage-snr', type=float, default=0, metavar='SNR',
                       help="SNR the first stage is calibrated against. 0 uses the design table.")
    group.add_argument('--dynamic-snr-window', type=float, default=8.0,
                       help="Rolling window duration in seconds for dynamic SNR renormalization (default: 8.0).")
    group.add_argument('--dynamic-snr-hollow', type=float, default=0.5,
                       help="Hollow exclusion half-width in seconds for dynamic SNR renormalization (default: 0.5).")
    group.add_argument('--dynamic-snr-variance-floor', type=float, default=1.0,
                       help="Variance floor for dynamic SNR renormalization (default: 1.0).")
    group.add_argument('--disable-dynamic-snr-renorm', action='store_true',
                       help="Disable dynamic SNR renormalization.")

    # Overwhitening & Line Subtraction Options
    ow_group = parser.add_argument_group("Overwhitening & Line Subtraction Options")
    ow_group.add_argument("--overwhiten-strain", action="store_true", default=False,
                          help="Enable continuous time-domain overwhitening of strain data.")
    ow_group.add_argument("--overwhiten-f-low", type=float, default=18.0,
                          help="Low-frequency cutoff in Hz for continuous overwhitening filter (default: 18.0).")
    ow_group.add_argument("--overwhiten-max-filter-duration", type=float, default=4.0,
                          help="Maximum filter duration in seconds for overwhitening filter (default: 4.0).")
    ow_group.add_argument("--subtract-lines", action="store_true", default=False,
                          help="Enable coherent line subtraction before filtering.")


    # Power Chisq Options
    parser.add_argument("--chisq-snr-threshold", type=float,
                        help="Minimum SNR to calculate the power chisq")
    parser.add_argument("--chisq-bins", default=0,
                        help="Number of frequency bins to use for power chisq.")
    parser.add_argument("--chisq-threshold", type=float, default=0,
                        help="Maximum reduced chisq a trigger may have; 0 disables the cut.")
    parser.add_argument("--chisq-window", type=float, default=1.0)
    parser.add_argument("--chisq-iterations", type=int, default=100)
    parser.add_argument("--chisq-delta", type=float, default=0,
                        help="SNR-dependent term added to the chisq dof before applying --chisq-threshold.")

    # Clustering & Event Handling
    parser.add_argument("--cluster-window", type=float, default=0,
                        help="Length of clustering window in seconds.")
    parser.add_argument("--finalize-events-template-rate", default=None, type=int,
                        metavar="NUM TEMPLATES", help="After NUM TEMPLATES perform event consolidation.")

    # Waveform parameters
    pycbc.waveform.bank.add_approximant_arg(parser)
    parser.add_argument("--order", type=int, default=-1,
                        help="The integer half-PN order at which to generate approximant.")
    parser.add_argument("--taper-template", choices=["start", "end", "startend"],
                        help="For time-domain approximants, taper template.")
    parser.add_argument("--keep-loudest-log-chirp-window", type=float,
                        help="Keep loudest triggers within ln chirp mass window")
    parser.add_argument("--keep-loudest-interval", type=float,
                        help="Window in seconds to maximize triggers over bank")
    parser.add_argument("--keep-loudest-num", type=int,
                        help="Number of triggers to keep from each maximization interval")
    parser.add_argument("--keep-loudest-stat", default="newsnr",
                        choices=pycbc.events.ranking.sngls_ranking_function_dict.keys(),
                        help="Statistic used to determine loudest to keep")
    parser.add_argument("--template-normalization-method",
                        choices=('precalculated_sigma', 'mchirp'), default='mchirp',
                        help="Method to normalize fine templates relative to their reference coarse template")

    argv = fix_frame_files_args()
    return parser, parser.parse_args(argv)


def main():
    parser, args = get_args()
    pycbc.init_logging(args.verbose)

    # Autochi dummy options required by EventManager attribute access
    for k in ('autochi_number_points', 'autochi_onesided', 'autochi_two_phase', 'autochi_max_valued_dof'):
        setattr(args, k, 0 if 'number' in k else False)

    if isinstance(args.channel_name, dict) and len(args.channel_name) > 0:
        instruments = sorted(list(args.channel_name.keys()))
    elif isinstance(args.channel_name, str):
        instruments = [args.channel_name[:2]]
    else:
        raise ValueError("Could not determine instruments to analyze.")

    # Verify Options
    pycbc.strain.verify_strain_options_multi_ifo(args, parser, instruments)
    pycbc.strain.StrainSegments.verify_segment_options_multi_ifo(args, parser, instruments)
    pycbc.psd.verify_psd_options_multi_ifo(args, parser, instruments)
    pycbc.scheme.verify_processing_options(args, parser)
    pycbc.fft.verify_fft_options(args, parser)
    pycbc.fft.from_cli(args)

    with pycbc.scheme.from_cli(args):
        inj_filter_rejector = pycbc.inject.InjFilterRejector.from_cli_multi_ifos(args, instruments)

        flow = args.low_frequency_cutoff
        if flow is None:
            with h5py.File(args.bank_file, 'r') as f:
                if 'f_lower' in f:
                    flow = float(np.min(f['f_lower'][:]))

        (segments, gwstrain, gating_info, gwstrain_start_time,
         psd_var, sample_rate, flen, delta_f) = setup_strain_and_segments(
            args, instruments, inj_filter_rejector, flow
        )

        logging.info("Initializing Ratio Filter Bank...")
        bank = RatioFilterBank(
            args.bank_file,
            filter_length=flen,
            delta_f=delta_f,
            dtype=np.complex64,
            enable_compressed_waveforms=args.enable_compressed_waveforms,
        )
        active_rejectors = [inj_filter_rejector[ifo] for ifo in instruments
                            if inj_filter_rejector.get(ifo) is not None
                            and getattr(inj_filter_rejector[ifo], 'enabled', False)]
        if active_rejectors:
            if len(active_rejectors) == 1:
                bank.template_thinning(active_rejectors[0])
            else:
                tables = []
                for rej in active_rejectors:
                    if hasattr(rej, 'injection_params') and rej.injection_params is not None:
                        if hasattr(rej.injection_params, 'table') and rej.injection_params.table is not None and len(rej.injection_params.table) > 0:
                            tables.append(rej.injection_params.table)
                if tables:
                    import types
                    combined_table = np.concatenate(tables).view(type(tables[0])) if len(tables) > 1 else tables[0]
                    combined_inj_params = types.SimpleNamespace(table=combined_table)
                    combined_rej = types.SimpleNamespace(
                        enabled=True,
                        chirp_time_window=max(getattr(r, 'chirp_time_window', 1.0) for r in active_rejectors),
                        f_lower=min(getattr(r, 'f_lower', flow) for r in active_rejectors),
                        injection_params=combined_inj_params,
                    )
                    bank.template_thinning(combined_rej)

        if args.asym_windowing:
            primary_snr_threshold = args.asym_snr_threshold if args.asym_snr_threshold is not None else (args.snr_threshold if args.snr_threshold is not None else 6.0)
        else:
            primary_snr_threshold = args.snr_threshold if args.snr_threshold is not None else 5.5
        logging.info("Primary SNR threshold: %.2f (asym_windowing=%s)", primary_snr_threshold, args.asym_windowing)


        sg_chisq = SingleDetSGChisq.from_cli(args, bank, str(args.chisq_bins))
        event_mgr = init_event_managers(args, instruments, gating_info)
        cluster_window = int(args.cluster_window * sample_rate) if args.cluster_window else 0

        if all(len(segments[ifo]) == 0 for ifo in instruments):
            logging.info("No segments to analyze. Exiting.")
            if os.path.exists(args.output):
                os.remove(args.output)
            for ifo in instruments:
                event_mgr[ifo].finalize_template_events()
                event_mgr[ifo].write_events(args.output)
            logging.info("Finished.")
            return

        if len(bank.coarse_indices) == 0:
            logging.info("No coarse templates in analysis bank. Exiting.")
            if os.path.exists(args.output):
                os.remove(args.output)
            for ifo in instruments:
                event_mgr[ifo].finalize_template_events()
                event_mgr[ifo].write_events(args.output)
            logging.info("Finished.")
            return

        triggers = {ifo: collections.defaultdict(list) for ifo in instruments}
        has_asym_followup = {ifo: 0 for ifo in instruments}
        num_segs = max(len(segments[ifo]) for ifo in instruments)

        can_asym_by_seg, ifo_sample_rates, ifo_gps_starts, ifo_gps_cli_starts, seg_starts = prepare_segment_geometry(
            args, instruments, segments, gwstrain_start_time, num_segs, sample_rate
        )

        # Ensure asym_num_bins is identical between full search and injection jobs
        # to eliminate trials-factor and recovery bias
        effective_asym_num_bins = args.asym_num_bins

        # Pre-compute normalization tables so child processes inherit them via COW
        if args.template_normalization_method == 'precalculated_sigma':
            if not hasattr(bank, 'sigma_snr_rescale'):
                bank.setup_sigma_norm()
        elif args.template_normalization_method == 'mchirp':
            if not hasattr(bank, 'mchirp_norm_rescale'):
                bank.setup_mchirp_norm()

        tsetup = time.time() - tstart
        TIMERS['data_setup'] = tsetup

        if bank.top_bank is None:
            raise ValueError("pycbc_inspiral_fir requires a hierarchical bank with top_bank.")

        max_upper_taps = int(bank.upper_group.attrs.get('max_taps', 0)) if getattr(bank, 'upper_group', None) is not None else 0
        if max_upper_taps == 0:
            max_upper_taps = max(int(c) for top_idx in bank.top_indices
                                 for c in bank.get_upper_firs(int(top_idx))[1])
        max_lower_taps = int(bank.fir_group.attrs.get('max_taps', 0)) if getattr(bank, 'fir_group', None) is not None else 0
        if max_lower_taps == 0:
            max_lower_taps = max(int(c) for middle_idx in bank.coarse_indices
                                 for c in bank.get_firs(int(middle_idx))[1])
        edge_margin = (max_upper_taps + max_lower_taps) // 2
        for ifo in instruments:
            for stilde in segments[ifo]:
                if (stilde.analyze.start < edge_margin or
                        (len(stilde) - 1) * 2 - stilde.analyze.stop < edge_margin):
                    raise ValueError(
                        'analysis window needs %d samples of padding for the '
                        'composed upper and lower FIRs' % edge_margin)

        coarse_keep = set(bank.coarse_indices) if len(bank.coarse_indices) < len(bank.coarse_keys) else None
        total_valid_segs = sum(len(segments[ifo]) for ifo in instruments)
        if total_valid_segs == 0:
            logging.info("Zero valid segments to analyze across all instruments. Skipping filtering.")
            bank_top_indices = []
        else:
            bank_top_indices = bank.top_indices

        # Pre-warm bank data structures in the parent process so they are cleanly shared via Linux COW
        if args.template_normalization_method == 'precalculated_sigma':
            bank.setup_sigma_norm()
        elif args.template_normalization_method == 'mchirp':
            bank.setup_mchirp_norm()

        top_templates = {int(i): bank.get_top_template(int(i)) for i in bank_top_indices}
        upper_group_data = {}
        for i in bank_top_indices:
            i_int = int(i)
            grp = bank.upper_group[str(i_int)]
            upper_group_data[i_int] = {
                'counts': grp['actual_tap_count'][:],
                'm_all': grp['fine_bank_index'][:],
                'taps': grp['taps'][:],
                'sigmas': grp['sigmas'][:],
            }
        for c in bank.coarse_indices:
            bank.get_firs(c, return_shifts=True)

        # Prepare top template tasks sorted by descending fine template count (LPT scheduling)
        top_tasks = []
        for top_idx in bank_top_indices:
            top_idx = int(top_idx)
            m_all = upper_group_data[top_idx]['m_all']
            if coarse_keep is not None:
                m_all = [m for m in m_all if m in coarse_keep]
            if len(m_all) == 0:
                continue
            fine_count = sum(len(bank.get_firs(int(m))[2]) for m in m_all)
            top_tasks.append((top_idx, fine_count))

        top_tasks.sort(key=lambda x: x[1], reverse=True)
        n_top = len(top_tasks)
        sorted_top_tasks = [(item[0], rank, n_top, item[1]) for rank, item in enumerate(top_tasks)]

        global _SHARED_WORKER_CONTEXT
        _SHARED_WORKER_CONTEXT = {
            'bank': bank,
            'top_templates': top_templates,
            'upper_group_data': upper_group_data,
            'instruments': instruments,
            'segments': segments,
            'num_segs': num_segs,
            'can_asym_by_seg': can_asym_by_seg,
            'ifo_sample_rates': ifo_sample_rates,
            'ifo_gps_starts': ifo_gps_starts,
            'ifo_gps_cli_starts': ifo_gps_cli_starts,
            'seg_starts': seg_starts,
            'args': args,
            'primary_snr_threshold': primary_snr_threshold,
            'delta_f': delta_f,
            'sample_rate': sample_rate,
            'flow': flow,
            'effective_asym_num_bins': effective_asym_num_bins,
            'coarse_keep': coarse_keep,
        }

        total_cores = max(1, int(getattr(args, 'cores', 1) or 1))
        n_workers = min(total_cores, n_top) if n_top > 0 else 1

        if n_workers > 1:
            logging.info("Parallelizing %d top templates across %d cores using fork multiprocessing...", n_top, n_workers)
            ctx = mp.get_context('fork')
            with ctx.Pool(processes=n_workers) as pool:
                for top_idx, worker_trigs, worker_asym, worker_timers in pool.imap_unordered(process_top_template_task, sorted_top_tasks):
                    for ifo in instruments:
                        for col, arr in worker_trigs[ifo].items():
                            if len(arr) > 0:
                                triggers[ifo][col].append(arr)
                        has_asym_followup[ifo] += worker_asym[ifo]
                    for k, v in worker_timers.items():
                        TIMERS[k] += v
        else:
            logging.info("Filtering %d top templates serially (1 core)...", n_top)
            for task_args in sorted_top_tasks:
                top_idx, worker_trigs, worker_asym, worker_timers = process_top_template_task(task_args)
                for ifo in instruments:
                    for col, arr in worker_trigs[ifo].items():
                        if len(arr) > 0:
                            triggers[ifo][col].append(arr)
                    has_asym_followup[ifo] += worker_asym[ifo]
                for k, v in worker_timers.items():
                    TIMERS[k] += v

        _SHARED_WORKER_CONTEXT.clear()

        if bank.top_bank is not None:
            logging.info('Upper synthesis time: direct-reference %.3f s, FIR %.3f s',
                         TIMERS['upper_ref'], TIMERS['upper_fir'])

        # Ingest triggers into EventManager for all instruments
        for ifo in instruments:
            ingest_ifo_triggers(
                ifo, triggers[ifo], event_mgr[ifo], gwstrain[ifo], segments[ifo], bank,
                args, psd_var.get(ifo), sg_chisq, cluster_window, has_asym_followup[ifo],
            )
            triggers[ifo] = None

    # Consolidate and write events
    tstop = time.time()
    run_time = tstop - tstart

    if os.path.exists(args.output):
        os.remove(args.output)

    total_cores = getattr(args, 'cores', 1) or 1
    cores_per_ifo = float(total_cores) / len(instruments)

    t_fin = time.time()
    for ifo in instruments:
        ifo_mgr = event_mgr[ifo]
        ifo_strain = gwstrain[ifo]
        ifo_opts = get_ifo_opts(args, ifo)
        ifo_mgr.save_performance(cores_per_ifo, len(segments[ifo]), len(bank), run_time, tsetup)
        logging.info("Consolidating and writing events for %s...", ifo)
        ifo_mgr.consolidate_events(ifo_opts, gwstrain=ifo_strain)
        ifo_mgr.finalize_events()
        ifo_mgr.write_events(args.output)
    TIMERS['event_finalize'] += time.time() - t_fin

    log_performance_summary(run_time, tsetup, instruments, segments, bank, args.output, cores=total_cores)
    logging.info("Finished.")


if __name__ == "__main__":
    main()
