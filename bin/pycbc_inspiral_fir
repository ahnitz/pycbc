TIMERS = collections.defaultdict(float)


def is_valid_segment(seg):
    """Check whether a Fourier segment contains valid (non-NaN, finite) strain and PSD."""
    if seg is None or getattr(seg, 'psd', None) is None:
        return False
    p_arr = seg.psd.numpy()
    if len(p_arr) == 0:
        return False
    mid = len(p_arr) // 2
    if np.isnan(p_arr[mid]) or p_arr[mid] <= 0 or np.isinf(p_arr[mid]):
        return False
    s_arr = seg.numpy()
    if len(s_arr) == 0 or np.isnan(s_arr[0]) or np.isnan(s_arr[mid]):
        return False
    return True



class UpperReferenceBatch:
    """Expand one top SNR series into all middle series in one library call."""

    def __init__(self, taps, counts, middle_ids, series_length):
        import matchedfilter

        self.middle_ids = np.asarray(middle_ids, dtype=int)
        self.series_length = int(series_length)
        if hasattr(matchedfilter, 'TimeDomainFilterBank') and hasattr(matchedfilter.TimeDomainFilterBank, 'correlate_series'):
            # Modern path: dynamic N partitioning, C SIMD ingestion, and fused scaling
            self.bank = matchedfilter.TimeDomainFilterBank(
                taps, tap_counts=counts,
                engine='corr'
            )
            self._use_bank = True
        else:
            # Fallback path for older matchedfilter versions
            if not hasattr(matchedfilter, 'CorrelationFilter'):
                raise ImportError('three-level FIR banks require matchedfilter.CorrelationFilter or TimeDomainFilterBank')
            self.n = max(1024, 1 << int(np.ceil(np.log2(4 * int(max(counts))))))
            self.margin = int(max(counts)) // 2
            self.step = self.n - 2 * self.margin
            self.starts = np.arange(0, self.series_length - self.margin,
                                    self.step, dtype=np.uintp)
            self.plan = matchedfilter.CorrelationFilter(
                self.n, ndata=1, ntemplates=len(self.middle_ids),
                device='cpu', valid=(self.margin, self.n - self.margin))
            spectra = np.empty((len(self.middle_ids), self.n), dtype=np.complex64)
            for row, count in enumerate(counts):
                count = int(count)
                centered = np.zeros(self.n, dtype=np.float32)
                centered[(np.arange(count) - count // 2) % self.n] = taps[row, :count]
                spectra[row] = np.fft.fft(centered).astype(np.complex64)
            self.plan.set_templates(spectra)
            self._use_bank = False
        self._scales_cache = {}

    def get_scales(self, top_norm, middle_templates, psd, tap_sample_rate):
        key = (id(psd), float(top_norm))
        scales = self._scales_cache.get(key)
        if scales is None:
            middle_norms = [
                middle_templates[int(mid)]
                if isinstance(middle_templates[int(mid)], (int, float, np.floating))
                else middle_templates[int(mid)].sigmasq(psd)
                for mid in self.middle_ids
            ]
            scales = np.asarray(
                np.sqrt(top_norm / np.asarray(middle_norms)) / tap_sample_rate,
                dtype=np.float32)
            self._scales_cache[key] = scales
        return scales

    def run(self, top_series, top_norm, middle_norms_or_scales, tap_sample_rate, valid_slice=None):
        """Return middle-id to SNR series, scaled like direct middle filtering."""
        if len(top_series) != self.series_length:
            raise ValueError('top reference length changed between segments')
        if valid_slice is not None:
            # When an explicit valid_slice is requested (e.g. narrow injection windowing),
            # pad by the maximum lower-stage FIR tap half-width so the lower-stage convolution
            # has full continuous support across the valid interval without hitting a zero cliff.
            pad = 512
            v_start = max(0, valid_slice.start - pad)
            v_stop = min(self.series_length, valid_slice.stop + pad)
            ext_slice = slice(v_start, v_stop)
        else:
            ext_slice = None

        if (isinstance(middle_norms_or_scales, np.ndarray)
                and middle_norms_or_scales.ndim == 1
                and len(middle_norms_or_scales) == len(self.middle_ids)
                and middle_norms_or_scales.dtype == np.float32):
            scales = middle_norms_or_scales
        else:
            scales = np.asarray(
                np.sqrt(top_norm / np.asarray(middle_norms_or_scales)) / tap_sample_rate,
                dtype=np.float32)

        t0 = time.perf_counter()
        if self._use_bank:
            scaled_series = self.bank.correlate_series(
                top_series, valid_slice=ext_slice, scales=scales
            )
        else:
            if hasattr(self.plan, 'run_series') and 'scales' in self.plan.run_series.__code__.co_varnames:
                scaled_series = self.plan.run_series(top_series, valid_slice=ext_slice, scales=scales)
            else:
                series = self.plan.run_series(top_series, valid_slice=ext_slice)
                scaled_series = series * scales[:, None]
        self.last_library_seconds = time.perf_counter() - t0
        self.last_scale_seconds = 0.0
        return dict(zip(self.middle_ids, scaled_series))



_CHISQ_CTX = None


def get_chisq_context(sample_rate, n_pad=16384):
    """Retrieve or allocate reusable FFT plan and workspace buffers for power chisq."""
    global _CHISQ_CTX
    if (_CHISQ_CTX is None or
            _CHISQ_CTX['n_pad'] != n_pad or
            _CHISQ_CTX['sample_rate'] != sample_rate):
        invec = TimeSeries(zeros(n_pad, dtype=complex64), delta_t=1.0 / sample_rate)
        outvec = FrequencySeries(zeros(n_pad, dtype=complex64), delta_f=sample_rate / n_pad)
        plan = pycbc.fft.FFT(invec, outvec)
        corr = FrequencySeries(zeros(n_pad, dtype=complex64), delta_f=sample_rate / n_pad)
        _CHISQ_CTX = {
            'n_pad': n_pad,
            'sample_rate': sample_rate,
            'df_pad': sample_rate / n_pad,
            'plan': plan,
            'invec': invec,
            'outvec': outvec,
            'corr': corr,
            'bins_cache': {},
            'ratio_cache': {},
        }
    return _CHISQ_CTX


def compute_batch_chisq(ids_local, t_idxs, snrs,
                        fine_indices, tstarts, stilde, bank,
                        ref_snr, filters_f, args,
                        top_template=None, mid_tap_arr=None,
                        h_norm=None, coarse_idx=None):
    """Compute power chisq for triggers using zero-padded fast frequency-domain
    correlation and same-template descending-SNR time clustering."""
    global_ids = fine_indices[ids_local]
    snr_amp = abs(snrs)
    num_trigs = len(snrs)
    chisq_vals = np.zeros(num_trigs, dtype=float32)
    chisq_dof_vals = np.zeros(num_trigs, dtype=np.int32) - 100
    assigned_mask = np.zeros(num_trigs, dtype=bool)

    cthresh = 0 if args.chisq_snr_threshold is None else args.chisq_snr_threshold
    above_thresh = np.flatnonzero(snr_amp >= cthresh)
    if len(above_thresh) == 0:
        return chisq_vals, chisq_dof_vals

    chisq_window_samp = int(args.chisq_window * stilde.sample_rate)
    max_iterations = getattr(args, 'chisq_iterations', None)
    sort_order = np.argsort(snr_amp)[::-1]

    flow = float(getattr(args, 'low_frequency_cutoff', 20.0))
    f_final = float(getattr(args, 'high_frequency_cutoff', None) or (
        bank.table['f_final'].max() if hasattr(bank, 'table') and 'f_final' in bank.table else 800.0
    ))

    sample_rate = float(stilde.sample_rate)
    N_pad = 16384
    ctx = get_chisq_context(sample_rate, N_pad)

    # Cache bins per (id(psd), flow, f_final, n_bins)
    bins_key = (id(stilde.psd), flow, f_final, int(args.chisq_bins))
    if bins_key not in ctx['bins_cache']:
        df_pad = ctx['df_pad']
        kmin_pad = int(flow / df_pad)
        kmax_pad = min(int(f_final / df_pad), N_pad // 2)
        dec = max(1, int(round(df_pad / stilde.delta_f)))
        n_half_pad = N_pad // 2 + 1
        psd_pad = FrequencySeries(stilde.psd[::dec][:n_half_pad], delta_f=df_pad)
        norm_pad = spa_tmplt_norm(psd_pad, n_half_pad, df_pad, flow)
        bins = power_chisq_bins_from_sigmasq_series(norm_pad, int(args.chisq_bins), kmin_pad, kmax_pad)
        dof = (len(bins) - 1) * 2 - 2
        ctx['bins_cache'][bins_key] = (bins, dof)
    bins, dof = ctx['bins_cache'][bins_key]

    taps_coarse, counts_coarse, _ = bank.get_firs(coarse_idx) if coarse_idx is not None else (None, None, None)

    ref_f_cache = {}
    iterations = 0
    tids2_arr = np.zeros(1, dtype=np.int32)
    snrvs_arr = np.zeros(1, dtype=complex64)

    for idx in sort_order:
        if max_iterations is not None and iterations >= max_iterations:
            break
        if snr_amp[idx] < cthresh:
            break
        if assigned_mask[idx]:
            continue

        target_global_id = int(global_ids[idx])
        t_idx = int(t_idxs[idx])
        snrv = snrs[idx]
        local_id = int(ids_local[idx])
        tstart = int(tstarts[idx])

        rescale = float(bank.snr_rescale(target_global_id, method=args.template_normalization_method))
        snrvs_arr[0] = snrv / rescale

        block_len = len(filters_f[local_id])
        dt = t_idx - tstart

        cache_key = (tstart, block_len)
        if cache_key not in ref_f_cache:
            if isinstance(ref_snr, dict):
                ref = ref_snr.get(cache_key, ref_snr.get(tstart))
            elif hasattr(ref_snr, 'ref_snr'):
                ref = ref_snr.ref_snr[tstart:tstart+block_len]
            else:
                ref = ref_snr[tstart:tstart+block_len]
            if ref is None:
                continue
            ctx['invec'].clear()
            ref_slice = ref[:block_len]
            ctx['invec'].data[:len(ref_slice)] = ref_slice
            ctx['plan'].execute()
            ref_f_cache[cache_key] = ctx['outvec'].data.copy()
        ref_f_pad = ref_f_cache[cache_key]

        ratio_key = (id(bank), coarse_idx, local_id)
        if ratio_key not in ctx['ratio_cache']:
            if taps_coarse is not None:
                cnt = int(counts_coarse[local_id])
                ctx['invec'].clear()
                ctx['invec'].data[:cnt] = taps_coarse[local_id, :cnt]
                ctx['invec'].data[:] = np.roll(ctx['invec'].data, -(cnt // 2))
                ctx['plan'].execute()
                ctx['ratio_cache'][ratio_key] = np.conj(ctx['outvec'].data).copy()
            else:
                ctx['ratio_cache'][ratio_key] = None

        ratio_pad = ctx['ratio_cache'][ratio_key]
        if ratio_pad is not None:
            corr_factor = 1.0 / (rescale * N_pad)
            ctx['corr'].data[:] = (ratio_pad * ref_f_pad) * corr_factor
            tids2_arr[0] = dt
            chi = power_chisq_at_points_from_precomputed(ctx['corr'], snrvs_arr, 1.0, bins, tids2_arr)
        else:
            chi = [0.0]

        # Same-template descending-SNR clustering within chisq_window
        same_tmpl_window = (global_ids == target_global_id) & (abs(t_idxs - t_idx) <= chisq_window_samp)
        update_mask = same_tmpl_window & (~assigned_mask) & (snr_amp >= cthresh)
        chisq_vals[update_mask] = float(abs(chi[0]))
        chisq_dof_vals[update_mask] = dof
        assigned_mask[update_mask] = True
        iterations += 1

    return chisq_vals, chisq_dof_vals


def process_and_record_triggers(
    ids_local, t_idxs, snrs, tstarts,
    stilde, h_norm, coarse_idx, fine_indices,
    filters_f, ref_snr, bank,
    s_num, top_idx, ifo, collected_batches,
    args, do_chisq, cthresh, is_asym=False,
    top_template=None, mid_tap_arr=None,
    shifts=None,
):
    """Filter triggers for analysis boundary, evaluate chisq, and append batch record."""
    if len(ids_local) > 0:
        ana = getattr(stilde, 'analyze', None)
        if ana is not None:
            local_shifts_check = shifts[ids_local] if shifts is not None else 0
            phys_t = t_idxs - local_shifts_check
            in_bounds = (phys_t >= ana.start) & (phys_t < ana.stop)
            if not np.all(in_bounds):
                ids_local = ids_local[in_bounds]
                t_idxs = t_idxs[in_bounds]
                snrs = snrs[in_bounds]
                tstarts = tstarts[in_bounds]

    if len(ids_local) > 0:
        if do_chisq and np.any(abs(snrs) >= cthresh):
            t_chi0 = time.perf_counter()
            chi, chi_dof = compute_batch_chisq(
                ids_local, t_idxs, snrs,
                fine_indices, tstarts, stilde, bank,
                ref_snr, filters_f, args,
                top_template=top_template, mid_tap_arr=mid_tap_arr,
                h_norm=h_norm, coarse_idx=coarse_idx)
            TIMERS['power_chisq'] += time.perf_counter() - t_chi0
        else:
            chi = np.zeros(len(ids_local), dtype=float32)
            chi_dof = np.zeros(len(ids_local), dtype=np.int32) - 100

        local_shifts = shifts[ids_local] if shifts is not None else 0
        time_offset = (-stilde.analyze.start + stilde.cumulative_index) if getattr(stilde, 'analyze', None) is not None else 0
        collected_batches[ifo].append({
            's_num': s_num,
            'top_idx': top_idx,
            'coarse_idx': coarse_idx,
            'gids': fine_indices[ids_local],
            'ids_local': ids_local,
            't_idxs': t_idxs - local_shifts,
            'time_index': t_idxs + time_offset - local_shifts,
            'snrs': snrs,
            'tstarts': tstarts,
            'h_norm': h_norm,
            'chisq': chi,
            'chisq_dof': chi_dof,
            'is_asym': is_asym,
        })

    return ids_local, t_idxs, snrs, tstarts


def get_ifo_opts(opt, ifo):
    """Return a single-ifo namespace with all multi-det options resolved for ifo."""
    opt_ifo = pycbc.types.optparse.copy_opts_for_single_ifo(opt, ifo)
    setattr(opt_ifo, 'ifo', ifo)
    for attr in ['channel_name', 'sample_rate', 'gps_start_time', 'gps_end_time',
                 'segment_length', 'segment_start_pad', 'segment_end_pad',
                 'psd_estimation', 'strain_high_pass', 'pad_data']:
        val = getattr(opt_ifo, attr, None)
        if isinstance(val, dict):
            setattr(opt_ifo, attr, val.get(ifo, None))
    return opt_ifo


def sample_asym_bins(
    group_engine,
    ref_snr,
    local_id,
    t_center,
    sample_rate,
    bin_width=0.1,
    num_bins=100,
    valid_slice=None,
    stilde=None,
    gps_start_time=0,
    **kwargs,
):
    """Sample peak SNR in each bin across an asymmetric window around t_center.

    Uses matchedfilter library natively with zero external FFT calls.
    """
    if sample_rate is None and stilde is not None:
        sample_rate = getattr(stilde, 'sample_rate', 2048.0)
    sample_rate_val = float(sample_rate or 2048.0)

    bs = int(round(bin_width * sample_rate_val))

    if num_bins <= 1:
        win_start_samp = t_center - bs // 2
        win_end_samp = win_start_samp + bs
    else:
        half_bins = num_bins // 2
        win_start_samp = (t_center - bs // 2) - half_bins * bs
        win_end_samp = win_start_samp + num_bins * bs

    v_start = 0 if valid_slice is None else valid_slice.start
    v_stop = len(ref_snr) if valid_slice is None else valid_slice.stop

    asym_start = max(win_start_samp, v_start)
    asym_stop = min(win_end_samp, v_stop)

    if asym_start >= asym_stop:
        return (
            np.empty(0, dtype=np.int32),
            np.empty(0, dtype=np.int64),
            np.empty(0, dtype=np.complex64),
            np.empty(0, dtype=np.int32),
            []
        )

    if gps_start_time is None:
        gps_start_val = float(getattr(stilde, 'start_time', getattr(stilde, 'epoch', 0.0)))
    else:
        gps_start_val = float(gps_start_time)

    cum_idx = getattr(stilde, 'cumulative_index', 0) if stilde is not None else 0
    an_start = valid_slice.start if valid_slice is not None else 0
    gps_s = (asym_start - an_start + cum_idx) / sample_rate_val + gps_start_val
    gps_e = (asym_stop - an_start + cum_idx) / sample_rate_val + gps_start_val
    searched_intervals = [(gps_s, gps_e)]

    res = group_engine._td_bank.filter_series(
        ref_snr,
        valid_slice=slice(asym_start, asym_stop),
        binsize=bs,
        threshold=0.0,
        template_index=local_id
    )
    return (
        res.template_indices.astype(np.int32),
        res.sample_indices.astype(np.int64),
        res.snr.astype(np.complex64),
        res.block_starts.astype(np.int32),
        searched_intervals
    )


def select_primary_asym_candidates(
    a_ids,
    a_tidxs,
    a_snrs,
    sample_rate,
    asym_snr_threshold,
    bin_width,
    num_bins,
    max_primary_per_group_sec=1,
    stilde=None,
    gps_start_time=None,
):
    """Select candidate primary triggers to instigate secondary followup windowing.

    Applies:
    1. Primary SNR threshold (rho_A >= asym_snr_threshold, e.g. 6.0).
    2. Per-template within-window pruning: within each template in the fine group,
       suppress triggers within half_win_samp of a louder trigger.
    3. Heuristic 2 (Primary Followup Throttling per Fine Group):
       Within each 1-second interval and within each fine template group,
       only allow the loudest Y (max_primary_per_group_sec) primary triggers
       to instigate secondary followup windowing (set 0 to disable).
    """
    if len(a_ids) == 0:
        return np.empty(0, dtype=np.int64)

    cand_mask = (abs(a_snrs) >= asym_snr_threshold)
    if not np.any(cand_mask):
        return np.empty(0, dtype=np.int64)

    cand_indices = np.flatnonzero(cand_mask)
    if len(cand_indices) <= 1:
        return cand_indices

    if sample_rate is None and stilde is not None:
        sample_rate = getattr(stilde, 'sample_rate', 2048.0)
    sample_rate_val = float(sample_rate or 2048.0)

    # 1. Per-template pruning across the followup half-window
    half_win_samp = int(round(bin_width * num_bins * 0.5 * sample_rate_val))
    unique_lids = np.unique(a_ids[cand_indices])
    pruned = []
    for uid in unique_lids:
        u_cands = cand_indices[a_ids[cand_indices] == uid]
        if len(u_cands) == 1:
            pruned.append(u_cands[0])
        else:
            order = np.argsort(-abs(a_snrs[u_cands]), kind='stable')
            kept_t = []
            for ci in u_cands[order]:
                ct = a_tidxs[ci]
                if not any(abs(ct - kt) < half_win_samp for kt in kept_t):
                    kept_t.append(ct)
                    pruned.append(ci)
    cand_indices = np.array(pruned, dtype=np.int64)

    # 2. Heuristic 2: Primary Followup Throttling per Fine Group per 1-second interval
    if max_primary_per_group_sec is not None and max_primary_per_group_sec > 0 and len(cand_indices) > max_primary_per_group_sec:
        cum_idx = getattr(stilde, 'cumulative_index', 0) if stilde is not None else 0
        an_start = stilde.analyze.start if (stilde is not None and hasattr(stilde, 'analyze') and stilde.analyze is not None) else 0
        if gps_start_time is None:
            gps_start_val = float(getattr(stilde, 'start_time', getattr(stilde, 'epoch', 0.0)))
        else:
            gps_start_val = float(gps_start_time)
        gps_times = gps_start_val + (a_tidxs[cand_indices] - an_start + cum_idx) / sample_rate_val
        sec_bins = np.floor(gps_times).astype(np.int64)

        unique_secs = np.unique(sec_bins)
        throttled = []
        for s in unique_secs:
            s_mask = (sec_bins == s)
            s_cands = cand_indices[s_mask]
            if len(s_cands) <= max_primary_per_group_sec:
                throttled.extend(s_cands)
            else:
                s_order = np.argsort(-abs(a_snrs[s_cands]), kind='stable')
                throttled.extend(s_cands[s_order[:max_primary_per_group_sec]])
        cand_indices = np.array(sorted(throttled), dtype=np.int64)

    return cand_indices


def filter_secondary_asym_triggers(
    asym_ids,
    asym_t_idxs,
    asym_snrs,
    asym_tstarts,
    primary_snr,
    secondary_snr_threshold=None,
    network_snr_threshold=None,
    max_followup_bins=0,
    **kwargs,
):
    """Filter secondary triggers based on secondary SNR, network SNR, and loudest bins.

    A secondary trigger is kept if EITHER:
    (1) |rho_secondary| >= secondary_snr_threshold, OR
    (2) rho_net = sqrt(|rho_primary|^2 + |rho_secondary|^2) >= network_snr_threshold.

    Heuristic 1: If max_followup_bins > 0 and more than max_followup_bins bins pass
    the thresholds, only the top max_followup_bins loudest bins (ranked by secondary SNR)
    are kept. Set max_followup_bins=0 to keep all passing bins. All bins are treated
    identically to preserve completely unbiased background estimation.
    """
    if len(asym_ids) == 0:
        return asym_ids, asym_t_idxs, asym_snrs, asym_tstarts

    has_sec = (secondary_snr_threshold is not None) and (secondary_snr_threshold > 0.0)
    has_net = (network_snr_threshold is not None) and (network_snr_threshold > 0.0)

    rho_sec = np.abs(asym_snrs)

    if has_sec or has_net:
        keep_mask = np.zeros(len(asym_ids), dtype=bool)
        if has_sec:
            keep_mask |= (rho_sec >= secondary_snr_threshold)
        if has_net:
            rho_prim = abs(primary_snr)
            rho_net = np.sqrt(rho_prim ** 2 + rho_sec ** 2)
            keep_mask |= (rho_net >= network_snr_threshold)
        passing_indices = np.flatnonzero(keep_mask)
    else:
        passing_indices = np.arange(len(asym_ids))

    if len(passing_indices) == 0:
        return (
            asym_ids[:0],
            asym_t_idxs[:0],
            asym_snrs[:0],
            asym_tstarts[:0],
        )

    if max_followup_bins is not None and max_followup_bins > 0 and len(passing_indices) > max_followup_bins:
        order = np.argsort(-rho_sec[passing_indices], kind='stable')
        passing_indices = passing_indices[order[:max_followup_bins]]
        passing_indices = np.sort(passing_indices)

    return (
        asym_ids[passing_indices],
        asym_t_idxs[passing_indices],
        asym_snrs[passing_indices],
        asym_tstarts[passing_indices],
    )


def get_args():
    parser = argparse.ArgumentParser(description=__doc__)
    pycbc.add_common_pycbc_options(parser)

    # --- Standard PyCBC Data/Segment Options ---
    pycbc.strain.insert_strain_option_group_multi_ifo(parser)
    pycbc.strain.StrainSegments.insert_segment_option_group_multi_ifo(parser)
    pycbc.psd.insert_psd_option_group_multi_ifo(parser)
    pycbc.scheme.insert_processing_option_group(parser)
    pycbc.fft.insert_fft_option_group(parser)
    pycbc.inject.insert_injfilterrejector_option_group_multi_ifo(parser)
    SingleDetSGChisq.insert_option_group(parser)

    # Multi-detector & Asymmetric Windowing Options
    asym_group = parser.add_argument_group("Asymmetric Windowing Options")
    asym_group.add_argument("--asym-windowing", action="store_true",
                            help="Enable asymmetric windowing across detectors.")
    asym_group.add_argument("--asym-snr-threshold", type=float, default=6.0,
                            help="SNR threshold in primary detector to trigger asymmetric windowing in other detectors.")
    asym_group.add_argument("--asym-secondary-snr-threshold", type=float, default=None,
                            help="Secondary detector SNR threshold for asymmetric triggers (e.g. 4.0). "
                                 "Triggers below this are discarded unless network SNR threshold is exceeded.")
    asym_group.add_argument("--asym-network-snr-threshold", type=float, default=None,
                            help="Network SNR threshold with primary trigger (e.g. 8.0). "
                                 "Secondary triggers with network SNR >= threshold are kept unconditionally.")
    asym_group.add_argument("--asym-max-followup-bins", type=int, default=2,
                            help="Maximum number of loudest followup bins to keep per primary candidate trigger "
                                 "(default: 2, set 0 to keep all passing bins).")
    asym_group.add_argument("--asym-max-primary-per-group-sec", type=int, default=1,
                            help="Maximum number of primary triggers per 1-second interval within each fine "
                                 "template group to instigate secondary followup windowing (default: 1, set 0 to disable).")
    asym_group.add_argument("--asym-bin-width", type=float, default=0.1,
                            help="Width in seconds of each bin in the asymmetric window (default 0.1s).")
    asym_group.add_argument("--asym-num-bins", type=int, default=100,
                            help="Number of bins in the asymmetric window (default 100).")

    # --- Analysis Options ---
    parser.add_argument('--output', required=True,
                        help="Path to output HDF5 file.")

    parser.add_argument("--bank-file", type=str, required=True,
                        help="Path to the HDF5 Ratio Bank file.")

    parser.add_argument('--snr-threshold', type=float, default=None,
                       help="SNR threshold for trigger generation (used in symmetric search; "
                            "in asymmetric mode, --asym-snr-threshold is used for the primary detector).")
    parser.add_argument("--newsnr-threshold", type=float, metavar='THRESHOLD',
                            help="Cut triggers with NewSNR less than THRESHOLD")
    parser.add_argument("--low-frequency-cutoff", type=float,
                        help="The low frequency cutoff to use for filtering (Hz)")
    parser.add_argument("--enable-compressed-waveforms", action="store_true", default=True,
                        help="Enable use of compressed top waveforms if present in the bank (default: True).")
    parser.add_argument("--disable-compressed-waveforms", action="store_false",
                        dest="enable_compressed_waveforms",
                        help="Disable use of compressed waveforms and regenerate waveforms on the fly.")

    # --- Ratio Specific ---
    group = parser.add_argument_group("Ratio Filter Options")
    group.add_argument('--high-frequency-cutoff', type=float,
                       help="High frequency cutoff (defaults to Nyquist).")
    group.add_argument('--batch-size', type=int, default=None,
                       help="Number of filters to process in one FFT batch (default: auto-sized based on L2 cache).")
    group.add_argument('--fir-length', type=int, default=None,
                       help=argparse.SUPPRESS)  # Deprecated and ignored; block sizes are chosen dynamically by TimeDomainFilterBank
    group.add_argument('--ratio-filter-engine', default='matchedfilter-hierarchical',
                       choices=('matchedfilter-hierarchical', 'matchedfilter'),
                       help="Which back end runs the innermost correlate,"
                            " inverse and peak search. 'matchedfilter' does the correlation in one"
                            " fused call. 'matchedfilter-hierarchical' additionally"
                            " gates on a low-band pass and reconstructs at full"
                            " resolution only where a detection is still"
                            " possible.")
    group.add_argument('--ratio-filter-false-dismissal', type=float,
                       default=1e-3, metavar='PROB',
                       help="Tolerated probability of missing a signal at the"
                            " SNR threshold, for 'matchedfilter-hierarchical'. Lower"
                            " is safer and slower. Note the realised rate can"
                            " exceed this at low SNR; see"
                            " docs/hierarchical.md in matchedfilter.")
    group.add_argument('--ratio-filter-band', type=float, default=0,
                       metavar='HZ',
                       help="Width of the band the first stage filters, in Hz."
                            " 0 uses the design table's choice. Must be below"
                            " the Nyquist frequency of the ratio filter"
                            " (engine sample rate / 2): asking for Nyquist"
                            " means filtering the whole band, which is not a"
                            " cheap first pass at all.")
    group.add_argument('--ratio-filter-first-stage-snr', type=float, default=0,
                       metavar='SNR',
                       help="SNR the first stage is calibrated against."
                            " Final triggers are still cut at"
                            " --snr-threshold; this only sets where the cheap"
                            " first pass calls for a full reconstruction."
                            " Lower is safer and slower. 0 uses the design"
                            " table, whose choice is not reliable everywhere"
                            " -- see docs/hierarchical.md in matchedfilter.")

    # power chisq related
    parser.add_argument("--chisq-snr-threshold", type=float,
                        help="Minimum SNR to calculate the power chisq")
    parser.add_argument("--chisq-bins", default=0, help=
                        "Number of frequency bins to use for power chisq. Specify"
                        " an integer for a constant number of bins, or a function "
                        "of template attributes.  Math functions are "
                        "allowed, ex. "
                        "'10./math.sqrt((params.mass1+params.mass2)/100.)'. "
                        "Non-integer values will be rounded down.")
    parser.add_argument("--chisq-threshold", type=float, default=0,
                        help="Maximum reduced chisq (chisq / (dof + delta *"
                             " snr^2)) a trigger may have; triggers above"
                             " this are removed. 0 disables the cut.")
    parser.add_argument("--chisq-window", type=float, default=1.0)
    parser.add_argument("--chisq-iterations", type=int, default=100)
    parser.add_argument("--chisq-delta", type=float, default=0,
                        help="SNR-dependent term added to the chisq dof"
                             " before applying --chisq-threshold.")

    # Clustering & Event Handling
    parser.add_argument("--cluster-window", type=float, default=0,
                       help="Length of clustering window in seconds.")
    parser.add_argument("--finalize-events-template-rate", default=None,
                        type=int, metavar="NUM TEMPLATES",
                        help="After NUM TEMPLATES perform event consolidation.")
    parser.add_argument("--user-tag", type=str, metavar="TAG",
                        help="User tag string.")

    # Waveform parameters (for compatibility with standard inspiral ini sections)
    pycbc.waveform.bank.add_approximant_arg(parser)
    parser.add_argument("--order", type=int, default=-1,
                        help="The integer half-PN order at which to generate approximant.")
    parser.add_argument("--taper-template", choices=["start", "end", "startend"],
                        help="For time-domain approximants, taper template.")

    parser.add_argument("--keep-loudest-log-chirp-window", type=float,
                        help="Keep loudest triggers within ln chirp mass window")
    parser.add_argument("--keep-loudest-interval", type=float,
                        help="Window in seconds to maximize triggers over bank")
    parser.add_argument("--keep-loudest-num", type=int,
                        help="Number of triggers to keep from each maximization interval")
    parser.add_argument("--keep-loudest-stat", default="newsnr",
                        choices=pycbc.events.ranking.sngls_ranking_function_dict.keys(),
                        help="Statistic used to determine loudest to keep")
    parser.add_argument("--template-normalization-method",
                        help="Method to normalize fine templates relative to"
                             " their reference coarse template",
                        choices=('precalculated_sigma', 'mchirp'),
                        default='mchirp')
    parser.add_argument("--fast-chisq", action='store_true')

    return parser, parser.parse_args()

def main():
    parser, args = get_args()
    pycbc.init_logging(args.verbose)

    # EventManager.write_to_hdf unconditionally reads these autochi_* options
    # to fill in cont_chisq_dof, but this engine has no autochisq step (unlike
    # pycbc_inspiral, there is no SingleDetAutoChisq here and cont_chisq is
    # always written as zeros -- see the dummy fill below). They are not real
    # options: there is no --autochi-* flag to set them, and every value here
    # is chosen so the dof computation collapses to 0. This block exists only
    # to satisfy the attribute access, not to configure anything.
    for k, v in {'autochi_number_points': 0, 'autochi_onesided': False,
                 'autochi_two_phase': False, 'autochi_max_valued_dof': False}.items():
        setattr(args, k, v)

    if isinstance(args.channel_name, dict) and len(args.channel_name) > 0:
        instruments = sorted(list(args.channel_name.keys()))
    elif isinstance(args.channel_name, str):
        instruments = [args.channel_name[:2]]
    else:
        raise ValueError("Could not determine instruments to analyze.")

    # --- 2. Verification ---
    pycbc.strain.verify_strain_options_multi_ifo(args, parser, instruments)
    pycbc.strain.StrainSegments.verify_segment_options_multi_ifo(args, parser, instruments)
    pycbc.psd.verify_psd_options_multi_ifo(args, parser, instruments)
    pycbc.scheme.verify_processing_options(args, parser)
    pycbc.fft.verify_fft_options(args, parser)

    pycbc.fft.from_cli(args)

    with pycbc.scheme.from_cli(args):

        # --- 3. Data Generation ---
        inj_filter_rejector = pycbc.inject.InjFilterRejector.from_cli_multi_ifos(args, instruments)
        gwstrain = pycbc.strain.from_cli_multi_ifos(args, instruments,
                                                    inj_filter_rejector_dict=inj_filter_rejector,
                                                    dyn_range_fac=pycbc.DYN_RANGE_FAC)

        strain_segments = pycbc.strain.StrainSegments.from_cli_multi_ifos(args, gwstrain, instruments)

        for count, ifo in enumerate(instruments):
            if count == 0:
                sample_rate = gwstrain[ifo].sample_rate
                flen = strain_segments[ifo].freq_len
                tlen = strain_segments[ifo].time_len
                delta_f = strain_segments[ifo].delta_f
            else:
                assert sample_rate == gwstrain[ifo].sample_rate, f"Sample rate mismatch for {ifo}"
                assert flen == strain_segments[ifo].freq_len, f"Freq len mismatch for {ifo}"
                assert tlen == strain_segments[ifo].time_len, f"Time len mismatch for {ifo}"
                assert delta_f == strain_segments[ifo].delta_f, f"Delta f mismatch for {ifo}"

        flow = args.low_frequency_cutoff
        if flow is None:
            with h5py.File(args.bank_file, 'r') as f:
                if 'f_lower' in f:
                    flow = float(np.min(f['f_lower'][:]))

        # --- 4. Initialize Classes ---
        logging.info("Initializing Ratio Filter Bank...")
        bank = RatioFilterBank(
            args.bank_file,
            filter_length=flen,
            delta_f=delta_f,
            dtype=np.complex64,
            enable_compressed_waveforms=args.enable_compressed_waveforms,
        )
        for ifo in instruments:
            if inj_filter_rejector.get(ifo) is not None:
                bank.template_thinning(inj_filter_rejector[ifo])

        preload_thread = None
        if hasattr(bank, 'preload_firs'):
            import threading
            preload_thread = threading.Thread(target=bank.preload_firs, daemon=True)
            preload_thread.start()
            logging.info("Started background preloading of FIR filter bank...")

        if args.asym_windowing:
            primary_snr_threshold = args.asym_snr_threshold if args.asym_snr_threshold is not None else (args.snr_threshold if args.snr_threshold is not None else 6.0)
        else:
            primary_snr_threshold = args.snr_threshold if args.snr_threshold is not None else 5.5
        logging.info("Primary SNR threshold: %.2f (asym_windowing=%s)", primary_snr_threshold, args.asym_windowing)

        logging.info("Initializing Ratio Filter Engine...")
        engine = MatchedFilterRatioControl(
            snr_threshold=primary_snr_threshold,
            delta_f=delta_f,
            high_frequency_cutoff=args.high_frequency_cutoff,
            batch_size=args.batch_size,
            tap_sample_rate=bank.sample_rate,
            engine_sample_rate=sample_rate,
            engine=args.ratio_filter_engine,
            false_dismissal=args.ratio_filter_false_dismissal,
            coarse_band_hz=args.ratio_filter_band,
            first_stage_snr=args.ratio_filter_first_stage_snr,
        )

        sg_chisq = SingleDetSGChisq.from_cli(args, bank, str(args.chisq_bins))

        # --- 5. Event Manager Setup ---
        out_types = {
            'time_index': int,
            'snr': complex64,
            'sigmasq': float32,
            'chisq': float32,
            'chisq_dof': int,
            'bank_chisq': float32,
            'bank_chisq_dof': int,
            'cont_chisq': float32,
            'sg_chisq': float32,
            'psd_var_val': float32,
        }

        out_vals_ref = {key: None for key in out_types}
        names = sorted(out_vals_ref.keys())

        gating_info = {ifo: getattr(gwstrain[ifo], 'gating_info', None) for ifo in instruments}

        event_mgr = {}
        for ifo in instruments:
            ifo_opts = get_ifo_opts(args, ifo)
            event_mgr[ifo] = pycbc.events.EventManager(
                ifo_opts, names, [out_types[n] for n in names],
                psd=None, gating_info=gating_info[ifo]
            )
            event_mgr[ifo].ifo = ifo

        cluster_window = int(args.cluster_window * sample_rate) if args.cluster_window else 0

        # --- 6. Analysis Loop ---
        logging.info("Making frequency-domain data segments")
        segments = {
            ifo: strain_segments[ifo].fourier_segments()
            for ifo in instruments
        }

        # Precompute segment-level injection chirp times if filter-inj-only is enabled
        seg_inj_tau0 = {}
        coarse_tau0_all = None
        inj_chirp_win = 5.0
        if getattr(args, 'filter_inj_only', False) and any(inj_filter_rejector.get(ifo) is not None and getattr(inj_filter_rejector[ifo], 'injection_params', None) is not None for ifo in instruments):
            ref_ifo = next(ifo for ifo in instruments if inj_filter_rejector.get(ifo) is not None and getattr(inj_filter_rejector[ifo], 'injection_params', None) is not None)
            ref_rejector = inj_filter_rejector.get(ref_ifo)
            if ref_rejector is not None and getattr(ref_rejector, 'injection_params', None) is not None:
                inj_tab = ref_rejector.injection_params.table
                f_l = ref_rejector.f_lower if ref_rejector.f_lower is not None else flow
                inj_chirp_win = ref_rejector.chirp_time_window if ref_rejector.chirp_time_window is not None else 5.0
                all_inj_m1 = inj_tab['mass1']
                all_inj_m2 = inj_tab['mass2']
                all_inj_tau0, _ = pycbc.pnutils.mass1_mass2_to_tau0_tau3(all_inj_m1, all_inj_m2, f_l)
                if hasattr(inj_tab, 'dtype') and inj_tab.dtype.names and 'tc' in inj_tab.dtype.names:
                    all_inj_tc = inj_tab['tc']
                else:
                    all_inj_tc = np.array([float(getattr(x, 'tc', getattr(x, 'geocent_end_time', 0.0))) for x in inj_tab])

                m1_c = bank.coarse_bank.table['mass1']
                m2_c = bank.coarse_bank.table['mass2']
                coarse_tau0_all, _ = pycbc.pnutils.mass1_mass2_to_tau0_tau3(m1_c, m2_c, f_l)

                num_segs = max(len(segments[ifo]) for ifo in instruments)
                for s_num in range(num_segs):
                    seg_inj_tau0[s_num] = []
                    for ifo in instruments:
                        if s_num < len(segments[ifo]):
                            st = segments[ifo][s_num]
                            c_idx = getattr(st, 'cumulative_index', 0)
                            a_sl = getattr(st, 'analyze', None)
                            if a_sl is not None:
                                t_start = float(gwstrain[ifo].start_time) + c_idx / sample_rate
                                t_stop = float(gwstrain[ifo].start_time) + (c_idx + (a_sl.stop - a_sl.start)) / sample_rate
                                m = (all_inj_tc >= t_start - 5.0) & (all_inj_tc <= t_stop + 5.0)
                                if np.any(m):
                                    seg_inj_tau0[s_num].extend(all_inj_tau0[m])
                    seg_inj_tau0[s_num] = np.array(seg_inj_tau0[s_num])

        if all(len(segments[ifo]) == 0 for ifo in instruments):
            logging.info("No segments to analyze. Exiting.")
            if os.path.exists(args.output):
                os.remove(args.output)
            for ifo in instruments:
                event_mgr[ifo].finalize_template_events()
                event_mgr[ifo].write_events(args.output)
            logging.info("Finished.")
            return

        if len(bank.coarse_indices) == 0:
            logging.info("No coarse templates in analysis bank. Exiting.")
            if os.path.exists(args.output):
                os.remove(args.output)
            for ifo in instruments:
                event_mgr[ifo].finalize_template_events()
                event_mgr[ifo].write_events(args.output)
            logging.info("Finished.")
            return

        pycbc.psd.associate_psds_to_multi_ifo_segments(
            args, segments, gwstrain, flen, delta_f, flow, instruments,
            dyn_range_factor=pycbc.DYN_RANGE_FAC, precision='single'
        )

        for ifo in instruments:
            for seg in segments[ifo]:
                if is_valid_segment(seg):
                    seg[:] = seg / seg.psd

        psd_var = {}
        if args.psdvar_segment is not None:
            logging.info("Calculating PSD variation")
            for ifo in instruments:
                ifo_opts = get_ifo_opts(args, ifo)
                psd_var[ifo] = pycbc.psd.calc_filt_psd_variation(
                    gwstrain[ifo], ifo_opts.psdvar_segment,
                    ifo_opts.psdvar_short_segment, ifo_opts.psdvar_long_segment,
                    ifo_opts.psdvar_psd_duration, ifo_opts.psdvar_psd_stride,
                    ifo_opts.psd_estimation, ifo_opts.psdvar_low_freq, ifo_opts.psdvar_high_freq
                )

        n_coarse = len(bank.coarse_indices)
        cthresh = args.chisq_snr_threshold
        do_chisq = bool(args.chisq_bins and (cthresh is not None))
        collected_batches = {ifo: [] for ifo in instruments}
        non_threshold_intervals = {ifo: [] for ifo in instruments}
        num_segs = max(len(segments[ifo]) for ifo in instruments)

        # For injections, only the 100ms foreground slice (1 bin of 0.1s) is required
        # because injections are evaluated strictly against background from the full search.
        is_injection_run = bool(getattr(args, 'injection_file', None))
        effective_asym_num_bins = 1 if is_injection_run else args.asym_num_bins

        tsetup = time.time() - tstart
        TIMERS['data_setup'] = tsetup

        upper_ref_seconds = 0.0
        upper_fir_seconds = 0.0
        upper_total_seconds = 0.0

        if bank.top_bank is None:
            raise ValueError("pycbc_inspiral_fir requires a hierarchical bank with top_bank.")

        if bank.top_bank is not None:
            max_upper_taps = int(bank.upper_group.attrs.get('max_taps', 0)) if getattr(bank, 'upper_group', None) is not None else 0
            if max_upper_taps == 0:
                max_upper_taps = max(int(c) for top_idx in bank.top_indices
                                     for c in bank.get_upper_firs(int(top_idx))[1])
            max_lower_taps = int(bank.fir_group.attrs.get('max_taps', 0)) if getattr(bank, 'fir_group', None) is not None else 0
            if max_lower_taps == 0:
                max_lower_taps = max(int(c) for middle_idx in bank.coarse_indices
                                     for c in bank.get_firs(int(middle_idx))[1])
            edge_margin = (max_upper_taps + max_lower_taps) // 2
            for ifo in instruments:
                for stilde in segments[ifo]:
                    if is_valid_segment(stilde):
                        if (stilde.analyze.start < edge_margin or
                                (len(stilde) - 1) * 2 - stilde.analyze.stop < edge_margin):
                            raise ValueError(
                                'analysis window needs %d samples of padding for the '
                                'composed upper and lower FIRs' % edge_margin)

            coarse_keep = set(bank.coarse_indices) if len(bank.coarse_indices) < len(bank.coarse_keys) else None

            if preload_thread is not None:
                preload_thread.join()
                logging.info("Background preloading of FIR filter bank complete.")

            chunk_size = 64
            total_valid_segs = sum(sum(1 for s in segments[ifo] if is_valid_segment(s)) for ifo in instruments)
            if total_valid_segs == 0:
                logging.info("Zero valid segments to analyze across all instruments. Skipping filtering.")
                bank_top_indices = []
            else:
                bank_top_indices = bank.top_indices
            n_top = len(bank_top_indices)
            for top_step, top_idx in enumerate(bank_top_indices):
                top_idx = int(top_idx)
                group_u = bank.upper_group[str(top_idx)]
                counts_raw = group_u['actual_tap_count'][:]
                order_raw = np.argsort(counts_raw)
                m_all = group_u['fine_bank_index'][:][order_raw]

                if coarse_keep is not None:
                    row_mask = np.isin(m_all, list(coarse_keep))
                    if not row_mask.any():
                        continue
                    keep_idx = np.flatnonzero(row_mask)
                else:
                    keep_idx = slice(None)

                middle_ids = m_all[keep_idx]
                counts_u = counts_raw[order_raw][keep_idx]
                taps_u = group_u['taps'][:][order_raw][keep_idx]
                sigmas_u = group_u['sigmas'][:][order_raw][keep_idx]

                t_dec0 = time.perf_counter()
                top_template = bank.get_top_template(top_idx)
                TIMERS['top_decomp'] += time.perf_counter() - t_dec0
                ref_s = sigmas_u[:, 0]
                target_s = sigmas_u[:, 2]
                all_scales = np.asarray((ref_s / target_s) / bank.sample_rate, dtype=np.float32)
                sigmasq_ratio_by_middle = {
                    int(mid): float((target_s[row] / ref_s[row]) ** 2)
                    for row, mid in enumerate(middle_ids)
                }

                logging.info(f"Top template {top_step+1}/{n_top} (id={top_idx}) with {len(middle_ids)} middle groups (chunked {chunk_size}/chunk)")

                t0 = time.perf_counter()
                ref_by_seg = {}
                for ifo in instruments:
                    cached_ref = {}
                    ifo_refs = []
                    for stilde in segments[ifo]:
                        s_slice = getattr(stilde, 'seg_slice', None)
                        k = (s_slice.start, s_slice.stop) if s_slice is not None else id(stilde)
                        if not is_valid_segment(stilde):
                            ifo_refs.append((None, 0.0))
                            continue
                        if k not in cached_ref:
                            cached_ref[k] = engine.make_reference_series(stilde, stilde.psd, top_template)
                        ifo_refs.append(cached_ref[k])
                    ref_by_seg[ifo] = ifo_refs
                upper_ref_seconds += time.perf_counter() - t0
                TIMERS['upper_ref'] += time.perf_counter() - t0

                for chunk_start in range(0, len(middle_ids), chunk_size):
                    chunk_slice = slice(chunk_start, chunk_start + chunk_size)
                    chunk_mids = middle_ids[chunk_slice]
                    chunk_counts = counts_u[chunk_slice]
                    chunk_taps = taps_u[chunk_slice]
                    chunk_scales = all_scales[chunk_slice]

                    t_up_prep = time.perf_counter()
                    any_seg = next((s for i in instruments for s in segments[i] if is_valid_segment(s)),
                                   next(segments[i][0] for i in instruments if len(segments[i]) > 0))
                    upper_chunk = UpperReferenceBatch(
                        chunk_taps, chunk_counts, chunk_mids, (len(any_seg) - 1) * 2)
                    TIMERS['upper_prep'] += time.perf_counter() - t_up_prep

                    chunk_groups = []
                    for row_c, mid in enumerate(chunk_mids):
                        coarse_idx = int(mid)
                        taps, counts, fine_indices, shifts = bank.get_firs(coarse_idx, return_shifts=True)
                        if len(fine_indices) == 0:
                            continue
                        group_engine = MatchedFilterRatioControl(
                            snr_threshold=primary_snr_threshold,
                            delta_f=delta_f,
                            high_frequency_cutoff=args.high_frequency_cutoff,
                            batch_size=args.batch_size,
                            tap_sample_rate=bank.sample_rate,
                            engine_sample_rate=sample_rate,
                            engine=args.ratio_filter_engine,
                            false_dismissal=args.ratio_filter_false_dismissal,
                            coarse_band_hz=args.ratio_filter_band,
                            first_stage_snr=args.ratio_filter_first_stage_snr)
                        t_fp0 = time.perf_counter()
                        filters_f, _ = group_engine.prepare_filters(taps, counts)
                        TIMERS['filter_prep'] += time.perf_counter() - t_fp0
                        mid_tap_arr = chunk_taps[row_c, :chunk_counts[row_c]]
                        chunk_groups.append([coarse_idx, counts, fine_indices,
                                             group_engine, filters_f,
                                             mid_tap_arr, shifts])

                    if not chunk_groups:
                        continue

                    last_middle_series = None
                    last_norms = None
                    last_seg_slices = None
                    for s_num in range(num_segs):
                        active_ifos = [ifo for ifo in instruments
                                       if s_num < len(segments[ifo]) and is_valid_segment(segments[ifo][s_num])]
                        if not active_ifos:
                            continue

                        can_asym_seg = bool(args.asym_windowing and len(active_ifos) > 1)
                        if can_asym_seg:
                            seg_gps = {}
                            for ifo in active_ifos:
                                st = segments[ifo][s_num]
                                sr = args.sample_rate[ifo] if isinstance(args.sample_rate, dict) else args.sample_rate
                                sr = float(sr or getattr(st, 'sample_rate', 2048.0))
                                t0 = float(gwstrain[ifo].start_time)
                                s_start = getattr(st, 'seg_slice', slice(0)).start if getattr(st, 'seg_slice', None) is not None else 0
                                a_start = st.analyze.start if getattr(st, 'analyze', None) is not None else 0
                                a_stop = st.analyze.stop if getattr(st, 'analyze', None) is not None else len(st)
                                seg_gps[ifo] = (t0 + (s_start + a_start) / sr, t0 + (s_start + a_stop) / sr)

                            for i_idx in range(len(active_ifos)):
                                for j_idx in range(i_idx + 1, len(active_ifos)):
                                    ifo_1, ifo_2 = active_ifos[i_idx], active_ifos[j_idx]
                                    if max(seg_gps[ifo_1][0], seg_gps[ifo_2][0]) >= min(seg_gps[ifo_1][1], seg_gps[ifo_2][1]):
                                        can_asym_seg = False
                                        break
                                if not can_asym_seg:
                                    break

                        cur_seg_slices = tuple(
                            (ifo,
                             getattr(segments[ifo][s_num], 'seg_slice', None).start if getattr(segments[ifo][s_num], 'seg_slice', None) is not None else s_num,
                             getattr(segments[ifo][s_num], 'seg_slice', None).stop if getattr(segments[ifo][s_num], 'seg_slice', None) is not None else s_num,
                             getattr(segments[ifo][s_num], 'analyze', None).start if getattr(segments[ifo][s_num], 'analyze', None) is not None else None,
                             getattr(segments[ifo][s_num], 'analyze', None).stop if getattr(segments[ifo][s_num], 'analyze', None) is not None else None)
                            for ifo in active_ifos
                        )

                        if seg_inj_tau0 and s_num in seg_inj_tau0 and coarse_tau0_all is not None:
                            s_injs = seg_inj_tau0[s_num]
                            if len(s_injs) > 0:
                                chunk_c_indices = [g[0] for g in chunk_groups]
                                if not any(np.any(np.abs(s_injs - coarse_tau0_all[cid]) <= inj_chirp_win) for cid in chunk_c_indices):
                                    continue

                        if cur_seg_slices == last_seg_slices and last_middle_series is not None:
                            middle_series = last_middle_series
                            norms = last_norms
                        else:
                            middle_series = {}
                            norms = {}
                            t_upper_start = time.perf_counter()
                            t0 = time.perf_counter()
                            for ifo in active_ifos:
                                series, norm = ref_by_seg[ifo][s_num]
                                norms[ifo] = norm
                                stilde_cur = segments[ifo][s_num]
                                # Only slice the upper filter for injection-only windowing.
                                # Full data segments have generous 32s/16s throwaway padding;
                                # evaluating the full buffer leaves all edge effects deep in the pad.
                                if getattr(args, 'filter_inj_only', False):
                                    v_slice = getattr(stilde_cur, 'analyze', None)
                                else:
                                    v_slice = None
                                middle_series[ifo] = upper_chunk.run(
                                    series, norm, chunk_scales, bank.sample_rate,
                                    valid_slice=v_slice)
                            upper_fir_seconds += time.perf_counter() - t0
                            upper_total_seconds += time.perf_counter() - t_upper_start
                            TIMERS['upper_fir'] += time.perf_counter() - t0
                            last_middle_series = middle_series
                            last_norms = norms
                            last_seg_slices = cur_seg_slices

                        t_seg_start = time.time()
                        t_seg_fine_start = TIMERS['fine_fir']
                        t_seg_chi_start = TIMERS['power_chisq']
                        t_seg_asym_start = TIMERS['asym_followup']
                        for i, g_entry in enumerate(chunk_groups):
                            coarse_idx, counts, fine_indices, group_engine, filters_f, mid_tap_arr, shifts = g_entry
                            if seg_inj_tau0 and s_num in seg_inj_tau0 and coarse_tau0_all is not None:
                                s_injs = seg_inj_tau0[s_num]
                                if len(s_injs) > 0:
                                    c_t0 = coarse_tau0_all[coarse_idx]
                                    if not np.any(np.abs(s_injs - c_t0) <= inj_chirp_win):
                                        continue
                            std_trigs = {}
                            h_norms = {}
                            for ifo in active_ifos:
                                stilde = segments[ifo][s_num]
                                h_norm = norms[ifo] * sigmasq_ratio_by_middle[coarse_idx]
                                h_norms[ifo] = h_norm
                                ref_snr = middle_series[ifo][coarse_idx]
                                t_fine0 = time.perf_counter()
                                ids_local, t_idxs, snrs, tstarts, _ = group_engine.process_segment(
                                    stilde, stilde.psd, h_norm, filters_f, counts,
                                    np.arange(len(fine_indices)),
                                    valid_slice=stilde.analyze,
                                    reference_series=ref_snr,
                                    profile_template=top_template,
                                    )
                                TIMERS['fine_fir'] += time.perf_counter() - t_fine0
                                if len(ids_local) > 0 and getattr(stilde, 'analyze', None) is not None:
                                    ana = stilde.analyze
                                    in_bounds = (t_idxs >= ana.start) & (t_idxs < ana.stop)
                                    if not np.all(in_bounds):
                                        ids_local = ids_local[in_bounds]
                                        t_idxs = t_idxs[in_bounds]
                                        snrs = snrs[in_bounds]
                                        tstarts = tstarts[in_bounds]

                                if not can_asym_seg:
                                    std_trigs[ifo] = process_and_record_triggers(
                                        ids_local, t_idxs, snrs, tstarts,
                                        stilde, h_norm, coarse_idx, fine_indices,
                                        filters_f, ref_snr, bank,
                                        s_num, top_idx, ifo, collected_batches,
                                        args, do_chisq, cthresh, is_asym=False,
                                        top_template=top_template, mid_tap_arr=mid_tap_arr,
                                        shifts=shifts,
                                    )
                                else:
                                    std_trigs[ifo] = (ids_local, t_idxs, snrs, tstarts)

                            if can_asym_seg:
                                t_asym0 = time.perf_counter()
                                chi_asym_before = TIMERS['power_chisq']
                                for ifo_A in active_ifos:
                                    a_ids, a_tidxs, a_snrs, a_tstarts = std_trigs[ifo_A]
                                    if len(a_ids) == 0:
                                        continue
                                    cand_indices = select_primary_asym_candidates(
                                        a_ids=a_ids,
                                        a_tidxs=a_tidxs,
                                        a_snrs=a_snrs,
                                        sample_rate=args.sample_rate[ifo_A] if isinstance(args.sample_rate, dict) else args.sample_rate,
                                        asym_snr_threshold=primary_snr_threshold,
                                        bin_width=args.asym_bin_width,
                                        num_bins=effective_asym_num_bins,
                                        max_primary_per_group_sec=args.asym_max_primary_per_group_sec,
                                        stilde=segments[ifo_A][s_num],
                                        gps_start_time=args.gps_start_time[ifo_A] if isinstance(args.gps_start_time, dict) else args.gps_start_time,
                                    )
                                    if len(cand_indices) == 0:
                                        continue

                                    # Only record the primary triggers that were selected as candidates
                                    # to cause secondary followup, and evaluate their chisq:
                                    stilde_A = segments[ifo_A][s_num]
                                    h_norm_A = h_norms[ifo_A]
                                    ref_snr_A = middle_series[ifo_A][coarse_idx]
                                    process_and_record_triggers(
                                        a_ids[cand_indices], a_tidxs[cand_indices], a_snrs[cand_indices], a_tstarts[cand_indices],
                                        stilde_A, h_norm_A, coarse_idx, fine_indices,
                                        filters_f, ref_snr_A, bank,
                                        s_num, top_idx, ifo_A, collected_batches,
                                        args, do_chisq, cthresh, is_asym=False,
                                        top_template=top_template, mid_tap_arr=mid_tap_arr,
                                        shifts=shifts,
                                    )

                                    sr_A = args.sample_rate[ifo_A] if isinstance(args.sample_rate, dict) else args.sample_rate
                                    sr_A = float(sr_A or getattr(stilde_A, 'sample_rate', 2048.0))
                                    s_start_A = getattr(stilde_A, 'seg_slice', slice(0)).start if getattr(stilde_A, 'seg_slice', None) is not None else 0
                                    t0_A = float(gwstrain[ifo_A].start_time)

                                    for ifo_B in active_ifos:
                                        if ifo_B == ifo_A:
                                            continue
                                        stilde_B = segments[ifo_B][s_num]
                                        h_norm_B = h_norms[ifo_B]
                                        ref_snr_B = middle_series[ifo_B][coarse_idx]
                                        sr_B = args.sample_rate[ifo_B] if isinstance(args.sample_rate, dict) else args.sample_rate
                                        sr_B = float(sr_B or getattr(stilde_B, 'sample_rate', 2048.0))
                                        s_start_B = getattr(stilde_B, 'seg_slice', slice(0)).start if getattr(stilde_B, 'seg_slice', None) is not None else 0
                                        t0_B = float(gwstrain[ifo_B].start_time)

                                        for k in cand_indices:
                                            cand_lid = a_ids[k]
                                            a_tcenter = a_tidxs[k]
                                            gps_trig = t0_A + (s_start_A + a_tcenter) / sr_A
                                            cand_tcenter = int(round((gps_trig - t0_B) * sr_B)) - s_start_B

                                            asym_ids, asym_t_idxs, asym_snrs, asym_tstarts, searched_intervals = sample_asym_bins(
                                                group_engine=group_engine,
                                                ref_snr=ref_snr_B,
                                                local_id=cand_lid,
                                                t_center=cand_tcenter,
                                                sample_rate=sr_B,
                                                bin_width=args.asym_bin_width,
                                                num_bins=effective_asym_num_bins,
                                                valid_slice=stilde_B.analyze,
                                                stilde=stilde_B,
                                                gps_start_time=t0_B,
                                            )

                                            if searched_intervals:
                                                non_threshold_intervals[ifo_B].extend(searched_intervals)

                                            asym_ids, asym_t_idxs, asym_snrs, asym_tstarts = filter_secondary_asym_triggers(
                                                asym_ids, asym_t_idxs, asym_snrs, asym_tstarts,
                                                primary_snr=a_snrs[k],
                                                secondary_snr_threshold=args.asym_secondary_snr_threshold,
                                                network_snr_threshold=args.asym_network_snr_threshold,
                                                max_followup_bins=args.asym_max_followup_bins,
                                                t_center=cand_tcenter,
                                                bin_width_samp=int(round(args.asym_bin_width * sr_B)),
                                            )

                                            process_and_record_triggers(
                                                asym_ids, asym_t_idxs, asym_snrs, asym_tstarts,
                                                stilde_B, h_norm_B, coarse_idx, fine_indices,
                                                filters_f, ref_snr_B, bank,
                                                s_num, top_idx, ifo_B, collected_batches,
                                                args, do_chisq, cthresh, is_asym=True,
                                                top_template=top_template, mid_tap_arr=mid_tap_arr,
                                                shifts=shifts,
                                            )
                                TIMERS['asym_followup'] += (time.perf_counter() - t_asym0) - (TIMERS['power_chisq'] - chi_asym_before)


                        t_seg_dur = max(time.time() - t_seg_start, 1e-6)
                        n_tmpl_seg = sum(len(g[2]) for g in chunk_groups)
                        stilde_ref = segments[active_ifos[0]][s_num]
                        total_analyzed_dur = len(active_ifos) * (stilde_ref.analyze.stop - stilde_ref.analyze.start) * stilde_ref.delta_t
                        tperf_seg = total_analyzed_dur / t_seg_dur * n_tmpl_seg
                        s_fine = TIMERS['fine_fir'] - t_seg_fine_start
                        s_chi = TIMERS['power_chisq'] - t_seg_chi_start
                        s_asym = TIMERS['asym_followup'] - t_seg_asym_start
                        logging.info(f"Top {top_step+1}/{n_top} (chunk {chunk_start//chunk_size+1}) Seg {s_num+1}/{num_segs}: {len(chunk_groups)} batches ({n_tmpl_seg} templates) in {t_seg_dur:.2f} s ({tperf_seg:.0f} temp-s/s) [fine={s_fine:.2f}s chi={s_chi:.2f}s asym={s_asym:.2f}s]")
                    del last_middle_series
                    del last_norms
                    del chunk_groups
                    del upper_chunk

                del ref_by_seg
                del top_template
                if libc is not None:
                    libc.malloc_trim(0)

        if bank.top_bank is not None:
            logging.info('Upper synthesis time: direct-reference %.3f s, FIR %.3f s, total %.3f s',
                         upper_ref_seconds, upper_fir_seconds, upper_total_seconds)

        # --- Veto Processing Complete & Trigger Ingestion ---
        for ifo in instruments:
            ifo_batches = collected_batches[ifo]
            ifo_mgr = event_mgr[ifo]
            ifo_strain = gwstrain[ifo]
            ifo_segments = segments[ifo]
            ifo_opts = get_ifo_opts(args, ifo)

            if non_threshold_intervals[ifo]:
                # In asymmetric followup, non_threshold_time is the duration of the
                # local followup window per primary trigger (W = asym_num_bins * asym_bin_width)
                if bool(getattr(args, 'asym_windowing', False)):
                    ifo_mgr.non_threshold_time = float(args.asym_num_bins * args.asym_bin_width)
                else:
                    seg_list = segmentlist([segment(s, e) for s, e in non_threshold_intervals[ifo]])
                    seg_list.coalesce()
                    ifo_mgr.non_threshold_time = float(abs(seg_list))
                logging.info("[%s] Non-threshold followup window: %.2f seconds (%d raw intervals)",
                             ifo, ifo_mgr.non_threshold_time, len(non_threshold_intervals[ifo]))
            else:
                ifo_mgr.non_threshold_time = 0.0

            n_candidates = sum(len(b['ids_local']) for b in ifo_batches)
            logging.info("[%s] Trigger identification complete: %d total triggers in %d batches",
                         ifo, n_candidates, len(ifo_batches))
            gc.collect()
            if libc is not None:
                libc.malloc_trim(0)

            t_ingest_start = time.time()
            sg_dur = 0.0
            logging.info("[%s] Grouping triggers by template...", ifo)
            if n_candidates > 0:
                all_gids = []
                all_times = []
                all_tidxs = []
                all_snums = []
                all_snrs = []
                all_chisq = []
                all_chisq_dof = []
                all_norms = []
                all_is_asym = []
                for b in ifo_batches:
                    n_b = len(b['ids_local'])
                    if n_b == 0:
                        continue
                    all_gids.append(b['gids'])
                    all_times.append(b['time_index'])
                    all_tidxs.append(b['t_idxs'])
                    all_snums.append(np.full(n_b, b['s_num'], dtype=np.int32))
                    all_snrs.append(b['snrs'])
                    all_chisq.append(b['chisq'])
                    all_chisq_dof.append(b['chisq_dof'])
                    all_norms.append(np.full(n_b, b['h_norm'], dtype=np.float32))
                    all_is_asym.append(np.full(n_b, b.get('is_asym', False), dtype=bool))

                collected_batches[ifo] = None
                del ifo_batches
                gc.collect()

                all_gids = np.concatenate(all_gids)
                all_times = np.concatenate(all_times).astype(np.int64)
                all_tidxs = np.concatenate(all_tidxs).astype(np.int64)
                all_snums = np.concatenate(all_snums).astype(np.int32)
                all_snrs = np.concatenate(all_snrs).astype(complex64)
                all_chisq = np.concatenate(all_chisq).astype(float32)
                all_chisq_dof = np.concatenate(all_chisq_dof).astype(np.int32)
                all_norms = np.concatenate(all_norms).astype(float32)
                all_is_asym = np.concatenate(all_is_asym).astype(bool)

                sort_idx = np.argsort(all_gids, kind='stable')
                all_gids = all_gids[sort_idx]
                all_times = all_times[sort_idx]
                all_tidxs = all_tidxs[sort_idx]
                all_snums = all_snums[sort_idx]
                all_snrs = all_snrs[sort_idx]
                all_chisq = all_chisq[sort_idx]
                all_chisq_dof = all_chisq_dof[sort_idx]
                all_norms = all_norms[sort_idx]
                all_is_asym = all_is_asym[sort_idx]
                del sort_idx

                unique_gids, start_indices = np.unique(all_gids, return_index=True)
                end_indices = np.append(start_indices[1:], len(all_gids))

                if args.template_normalization_method == 'precalculated_sigma':
                    if not hasattr(bank, 'sigma_snr_rescale'):
                        bank.setup_sigma_norm()
                    snr_rescale = bank.sigma_snr_rescale[all_gids]
                    sigmasq_rescale = bank.sigma_sigma_rescale[all_gids] ** 2.0
                else:
                    snr_rescale = bank.snr_rescale(all_gids, method=args.template_normalization_method)
                    sigmasq_rescale = bank.sigma_rescale(all_gids, method=args.template_normalization_method) ** 2.0

                all_snrs = (all_snrs / snr_rescale).astype(complex64)
                all_norms = (all_norms * sigmasq_rescale).astype(float32)

                if sg_chisq.do:
                    t_sg_start = time.time()
                    all_sg_chisq = np.ones(len(all_gids), dtype=np.float32)
                    rchisq = np.where(all_chisq_dof > 0, all_chisq / all_chisq_dof, 1.0)
                    all_nsnr = ranking.newsnr(np.abs(all_snrs), rchisq)

                    for gid, s_idx, e_idx in zip(unique_gids, start_indices, end_indices):
                        gid_int = int(gid)
                        thash = bank.table['template_hash'][gid_int]
                        if thash not in sg_chisq.params:
                            continue
                        tmpl_nsnr = all_nsnr[s_idx:e_idx]
                        if not np.any(tmpl_nsnr >= sg_chisq.snr_threshold):
                            continue

                        tmpl = bank[gid_int]
                        snums_tmpl = all_snums[s_idx:e_idx]
                        snrs_tmpl = all_snrs[s_idx:e_idx]
                        chi_tmpl = all_chisq[s_idx:e_idx]
                        dof_tmpl = all_chisq_dof[s_idx:e_idx]
                        tidxs_tmpl = all_tidxs[s_idx:e_idx]

                        for s in np.unique(snums_tmpl):
                            s_mask = (snums_tmpl == s)
                            stilde = ifo_segments[s]
                            res = sg_chisq.values(
                                stilde, tmpl, stilde.psd,
                                snrs_tmpl[s_mask], 1.0,
                                chi_tmpl[s_mask], dof_tmpl[s_mask],
                                tidxs_tmpl[s_mask]
                            )
                            if res is not None:
                                all_sg_chisq[s_idx:e_idx][s_mask] = res
                    sg_dur = time.time() - t_sg_start
                    TIMERS['sg_chisq'] += sg_dur
                    logging.info("[%s] SG chisq completed in %.2f s", ifo, sg_dur)
                else:
                    sg_dur = 0.0
                    all_sg_chisq = np.zeros(len(all_gids), dtype=np.float32)

                use_psd_var = args.psdvar_short_segment is not None
                if use_psd_var:
                    gps_start = ifo_opts.gps_start_time
                    all_psd_var = pycbc.psd.find_trigger_value(
                        psd_var[ifo], all_times, gps_start, sample_rate)
                    ingest_cols = ['time_index', 'snr', 'sigmasq', 'chisq', 'chisq_dof', 'sg_chisq', 'psd_var_val']
                else:
                    ingest_cols = ['time_index', 'snr', 'sigmasq', 'chisq', 'chisq_dof', 'sg_chisq']

                logging.info("[%s] Ingesting triggers for %d templates into EventManager...", ifo, len(unique_gids))
                for t_idx, (gid, s_idx, e_idx) in enumerate(zip(unique_gids, start_indices, end_indices)):
                    ifo_mgr.new_template(tmplt=bank.table[int(gid)])
                    tmpl_is_asym = all_is_asym[s_idx:e_idx]
                    std_mask = ~tmpl_is_asym
                    asym_mask = tmpl_is_asym

                    if np.any(std_mask):
                        sub_s = s_idx + np.flatnonzero(std_mask)
                        if use_psd_var:
                            vectors = [
                                all_times[sub_s],
                                all_snrs[sub_s],
                                all_norms[sub_s],
                                all_chisq[sub_s],
                                all_chisq_dof[sub_s],
                                all_sg_chisq[sub_s],
                                all_psd_var[sub_s],
                            ]
                        else:
                            vectors = [
                                all_times[sub_s],
                                all_snrs[sub_s],
                                all_norms[sub_s],
                                all_chisq[sub_s],
                                all_chisq_dof[sub_s],
                                all_sg_chisq[sub_s],
                            ]
                        ifo_mgr.add_template_events(ingest_cols, vectors)
                        if cluster_window > 0:
                            ifo_mgr.cluster_template_events("time_index", "snr", cluster_window)

                    if np.any(asym_mask):
                        sub_a = s_idx + np.flatnonzero(asym_mask)
                        if use_psd_var:
                            vectors = [
                                all_times[sub_a],
                                all_snrs[sub_a],
                                all_norms[sub_a],
                                all_chisq[sub_a],
                                all_chisq_dof[sub_a],
                                all_sg_chisq[sub_a],
                                all_psd_var[sub_a],
                            ]
                        else:
                            vectors = [
                                all_times[sub_a],
                                all_snrs[sub_a],
                                all_norms[sub_a],
                                all_chisq[sub_a],
                                all_chisq_dof[sub_a],
                                all_sg_chisq[sub_a],
                            ]
                        ifo_mgr.add_template_events(ingest_cols, vectors)

                    ifo_mgr.finalize_template_events()
                    if args.finalize_events_template_rate is not None and (t_idx + 1) % args.finalize_events_template_rate == 0:
                        ifo_mgr.consolidate_events(ifo_opts, gwstrain=ifo_strain)

                del all_gids, all_times, all_tidxs, all_snums, all_snrs, all_chisq, all_chisq_dof, all_norms, all_sg_chisq, all_is_asym
                del unique_gids, start_indices, end_indices
                gc.collect()
                if libc is not None:
                    libc.malloc_trim(0)

            ingest_total = time.time() - t_ingest_start
            TIMERS['event_ingest'] += max(0.0, ingest_total - sg_dur)
            logging.info("[%s] Ingestion completed in %.2f s", ifo, ingest_total)

    # --- 7. Finalize ---
    tstop = time.time()
    run_time = tstop - tstart

    if os.path.exists(args.output):
        os.remove(args.output)

    total_cores = getattr(args, 'cores', 1) or 1
    cores_per_ifo = float(total_cores) / len(instruments)

    t_fin = time.time()
    for ifo in instruments:
        ifo_mgr = event_mgr[ifo]
        ifo_strain = gwstrain[ifo]
        ifo_opts = get_ifo_opts(args, ifo)
        ifo_mgr.save_performance(cores_per_ifo, len(segments[ifo]), len(bank), run_time, tsetup)
        logging.info("Consolidating and writing events for %s...", ifo)
        ifo_mgr.consolidate_events(ifo_opts, gwstrain=ifo_strain)
        ifo_mgr.finalize_events()
        ifo_mgr.write_events(args.output)
    TIMERS['event_finalize'] += time.time() - t_fin

    total_analyzed_det_sec = sum(
        sum((segments[ifo][s].analyze.stop - segments[ifo][s].analyze.start) * segments[ifo][s].delta_t
            for s in range(len(segments[ifo])) if is_valid_segment(segments[ifo][s]))
        for ifo in instruments
    )
    total_tmpl_sec = total_analyzed_det_sec * len(bank.table)
    overall_throughput = total_tmpl_sec / max(run_time, 1e-6)
    logging.info("Overall search throughput: %.0f template-s/core-s (%.2f M templates/core-s) over %.2f s run time",
                 overall_throughput, overall_throughput / 1e6, run_time)

    other_time = max(0.0, run_time - sum(TIMERS.values()))
    categories = [
        ("Data Setup & Conditioning", TIMERS.get('data_setup', 0.0)),
        ("Top Template Decompression", TIMERS.get('top_decomp', 0.0)),
        ("Upper Ref SNR Generation", TIMERS.get('upper_ref', 0.0)),
        ("Upper Batch Plan Prep", TIMERS.get('upper_prep', 0.0)),
        ("Fine Ratio Filter Prep", TIMERS.get('filter_prep', 0.0)),
        ("Upper Decimation FIR", TIMERS.get('upper_fir', 0.0)),
        ("Fine FIR Filtering (Primary)", TIMERS.get('fine_fir', 0.0)),
        ("Asymmetric Followup Filtering", TIMERS.get('asym_followup', 0.0)),
        ("Power Chisq Calculation", TIMERS.get('power_chisq', 0.0)),
        ("Sine-Gaussian Chisq", TIMERS.get('sg_chisq', 0.0)),
        ("Event Ingestion & Clustering", TIMERS.get('event_ingest', 0.0)),
        ("Event Finalize & HDF Output", TIMERS.get('event_finalize', 0.0)),
        ("Other / Pipeline Overhead", other_time),
    ]

    logging.info("=" * 70)
    logging.info("PIPELINE PERFORMANCE BREAKDOWN:")
    logging.info(f"{'Pipeline Stage':<35} {'Time (s)':>12} {'Share (%)':>10}")
    logging.info("-" * 70)
    for cat_name, cat_time in categories:
        pct = (cat_time / run_time) * 100.0 if run_time > 0 else 0.0
        logging.info(f"{cat_name:<35} {cat_time:>12.3f} {pct:>9.2f}%")
    logging.info("-" * 70)
    logging.info(f"{'Total Run Time':<35} {run_time:>12.3f} {100.0:>9.2f}%")
    logging.info("=" * 70)

    try:
        import json
        timing_dict = {cat_name: cat_time for cat_name, cat_time in categories}
        timing_dict["Total Run Time"] = run_time
        timing_dict["Overall Throughput"] = overall_throughput
        timing_path = args.output + ".timing.json"
        with open(timing_path, "w") as tf:
            json.dump(timing_dict, tf, indent=2)
        logging.info("Saved timing breakdown to %s", timing_path)
    except Exception as e:
        logging.warning("Failed to save timing JSON: %s", e)

    logging.info("Finished.")

if __name__ == "__main__":
    main()
