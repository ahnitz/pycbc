#!/usr/bin/env python

""" This program adds single detector hdf trigger files together.
"""

import numpy, argparse, h5py, logging
from pycbc.io import HFile
from pycbc import add_common_pycbc_options, init_logging

def changes(arr):
    if len(arr) == 0:
        return numpy.array([0], dtype=int)
    l = numpy.where(arr[:-1] != arr[1:])[0]
    l = numpy.concatenate(([0], l+1, [len(arr)]))
    return numpy.unique(l)

def collect(key, files):
    data = []
    for fname in files:
        with HFile(fname, 'r') as fin:
            if key in fin:
                data += [fin[key][:]]
    if len(data) == 0:
        return numpy.array([])
    return numpy.concatenate(data)

def region(f, key, boundaries, ids):
    dset = f[key]
    refs = []
    for j in range(len(boundaries) - 1):
        l, r = boundaries[ids[j]], boundaries[ids[j]+1]
        refs.append(dset.regionref[l:r]) 
    f.create_dataset(key+'_template', data=refs,
                     dtype=h5py.special_dtype(ref=h5py.RegionReference))

parser = argparse.ArgumentParser()
add_common_pycbc_options(parser)
parser.add_argument('--trigger-files', nargs='+', required=True)
parser.add_argument('--output-file', required=True)
parser.add_argument('--bank-file', required=True)
parser.add_argument('--ifo', default=None,
                    help='Specify a single IFO to process from the trigger files. '
                         'If omitted, all IFOs found will be processed.')
parser.add_argument('--compression-level', type=int, default=6,
                    help='Set HDF compression level in the output file '
                         '(default 6)')
args = parser.parse_args()

init_logging(args.verbose)

# Discover all IFOs across the input files
all_ifos = set()
for fname in args.trigger_files:
    try:
        with HFile(fname, 'r') as f_in:
            for k in f_in.keys():
                if isinstance(f_in[k], h5py.Group) and (
                    'search' in f_in[k] or 'template_hash' in f_in[k] or 'snr' in f_in[k]
                ):
                    all_ifos.add(k)
    except IOError as e:
        logging.error("Cannot open %s" % fname)
        raise e

if args.ifo:
    ifos_to_process = [args.ifo]
else:
    ifos_to_process = sorted(all_ifos)

if not ifos_to_process:
    raise ValueError("No valid IFO groups found in input trigger files.")

logging.info("Processing IFOs: %s", ", ".join(ifos_to_process))

f = HFile(args.output_file, 'w')

# Load template bank once for all IFOs
hashes = HFile(args.bank_file, 'r')['template_hash'][:]
bank_tids = hashes.argsort()
unsort = bank_tids.argsort()
hashes = hashes[bank_tids]

for ifo in ifos_to_process:
    logging.info("--- Merging triggers for %s ---", ifo)
    # Find files that contain this IFO
    files_with_ifo = []
    for fname in args.trigger_files:
        with HFile(fname, 'r') as f_in:
            if ifo in f_in and isinstance(f_in[ifo], h5py.Group):
                files_with_ifo.append(fname)

    if not files_with_ifo:
        logging.warning("No files found containing IFO %s", ifo)
        continue

    # Determine list of trigger columns from representative file
    trigger_columns = []
    for fname in files_with_ifo:
        with HFile(fname, 'r') as f2:
            if ifo in f2 and len(f2[ifo].keys()) > 0:
                cols = list(f2[ifo].keys())
                for rm_col in ['search', 'template_hash', 'gating', 'template_id', 'template_boundaries']:
                    if rm_col in cols:
                        cols.remove(rm_col)
                cols = [c for c in cols if not c.endswith('_template')]
                if len(cols) > 0:
                    trigger_columns = cols
                    break

    for col in trigger_columns:
        logging.info("[%s] trigger column: %s", ifo, col)

    logging.info('[%s] reading metadata from files', ifo)
    tpc = numpy.array([], dtype=numpy.float64)
    frpc = numpy.array([], dtype=numpy.float64)
    stf = numpy.array([], dtype=numpy.float64)
    rtime = numpy.array([], dtype=numpy.float64)
    starts = numpy.array([], dtype=numpy.float64)
    ends = numpy.array([], dtype=numpy.float64)
    non_thresh_dur = 0.0
    has_non_thresh = False

    gating = {}
    for filename in files_with_ifo:
        with HFile(filename, 'r') as data:
            ifo_data = data[ifo]

            if 'search/start_time' in ifo_data:
                starts = numpy.append(starts, ifo_data['search/start_time'][:])
            if 'search/end_time' in ifo_data:
                ends = numpy.append(ends, ifo_data['search/end_time'][:])

            if 'templates_per_core' in ifo_data['search'].keys():
                tpc = numpy.append(tpc, ifo_data['search/templates_per_core'][:])
            if 'filter_rate_per_core' in ifo_data['search'].keys():
                frpc = numpy.append(frpc, ifo_data['search/filter_rate_per_core'][:])
            if 'setup_time_fraction' in ifo_data['search'].keys():
                stf = numpy.append(stf, ifo_data['search/setup_time_fraction'][:])
            if 'run_time' in ifo_data['search'].keys():
                rtime = numpy.append(rtime, ifo_data['search/run_time'][:])
            if 'non_threshold_time' in ifo_data['search'].keys():
                has_non_thresh = True
                non_thresh_dur += float(numpy.sum(ifo_data['search/non_threshold_time'][:]))

            if 'gating' in ifo_data:
                gating_keys = []
                ifo_data['gating'].visit(gating_keys.append)
                for gk in gating_keys:
                    gk_data = ifo_data['gating/' + gk]
                    if isinstance(gk_data, h5py.Dataset):
                        if gk not in gating:
                            gating[gk] = numpy.array([], dtype=numpy.float64)
                        gating[gk] = numpy.append(gating[gk], gk_data[:])

    # store de-duplicated segments sorted by start time
    if len(starts) > 0:
        starts, uindex = numpy.unique(starts, return_index=True)
        ends = ends[uindex]
        sort = starts.argsort()
        f['%s/search/start_time' % ifo] = starts[sort]
        f['%s/search/end_time' % ifo] = ends[sort]
    else:
        f['%s/search/start_time' % ifo] = numpy.array([])
        f['%s/search/end_time' % ifo] = numpy.array([])

    if len(tpc) > 0:
        f['%s/search/templates_per_core' % ifo] = tpc
    if len(frpc) > 0:
        f['%s/search/filter_rate_per_core' % ifo] = frpc
    if len(stf) > 0:
        f['%s/search/setup_time_fraction' % ifo] = stf
    if len(rtime) > 0:
        f['%s/search/run_time' % ifo] = rtime
    if has_non_thresh:
        f['%s/search/non_threshold_time' % ifo] = float(non_thresh_dur)

    for gk, gv in gating.items():
        f[ifo + '/gating/' + gk] = gv

    logging.info('[%s] setting up sorting of triggers and template ids', ifo)
    trigger_hashes = collect('%s/template_hash' % ifo, files_with_ifo)
    if len(trigger_hashes) == 0:
        # Check if template_id is present (e.g. from pre-merged files)
        tids_raw = collect('%s/template_id' % ifo, files_with_ifo)
        if len(tids_raw) > 0:
            bank_hashes_raw = HFile(args.bank_file, 'r')['template_hash'][:]
            trigger_hashes = bank_hashes_raw[tids_raw.astype(int)]
    if len(trigger_hashes) > 0:
        trigger_sort = trigger_hashes.argsort()
        trigger_hashes = trigger_hashes[trigger_sort]
        template_boundaries = changes(trigger_hashes)

        template_ids = bank_tids[numpy.searchsorted(hashes, trigger_hashes[template_boundaries[:-1]])]
        full_boundaries = numpy.searchsorted(trigger_hashes, hashes)
        full_boundaries = numpy.concatenate([full_boundaries, [len(trigger_hashes)]])
        del trigger_hashes

        idlen = (template_boundaries[1:] - template_boundaries[:-1])
        f.create_dataset('%s/template_id' % ifo,
                         data=numpy.repeat(template_ids, idlen),
                         compression='gzip', shuffle=True,
                         compression_opts=args.compression_level)
        f['%s/template_boundaries' % ifo] = full_boundaries[unsort]

        logging.info('[%s] reading and writing trigger columns', ifo)
        for col in trigger_columns:
            key = '%s/%s' % (ifo, col)
            data = collect(key, files_with_ifo)[trigger_sort]
            f.create_dataset(key, data=data, compression='gzip',
                             compression_opts=args.compression_level,
                             shuffle=True)
            del data
            region(f, key, full_boundaries, unsort)
    else:
        full_boundaries = numpy.zeros(len(hashes) + 1, dtype=int)
        f.create_dataset('%s/template_id' % ifo,
                         data=numpy.array([], dtype=int),
                         compression='gzip', shuffle=True,
                         compression_opts=args.compression_level)
        f['%s/template_boundaries' % ifo] = full_boundaries[unsort]
        for col in trigger_columns:
            key = '%s/%s' % (ifo, col)
            f.create_dataset(key, data=numpy.array([]), compression='gzip',
                             compression_opts=args.compression_level,
                             shuffle=True)
            region(f, key, full_boundaries, unsort)

f.close()
logging.info('done')
