def write_coinc_hdf(
    target_fn,
    stat_list,
    slide_list,
    tmpl_list,
    dec_list,
    time_dict,
    tid_dict,
    segs_by_ifo,
    instruments,
    pivot_ifo="H1",
    fixed_ifo="L1",
    timeslide_interval=0.1,
    asym_num_bins=2500,
    cluster_window=0.0,
    t_start=None,
):
    """Write standard PyCBC coincidence HDF5 output file supporting all
    active detector combinations.
    """
    ts_int = float(timeslide_interval) if (timeslide_interval and timeslide_interval > 0) else 0.1
    if len(stat_list) > 0:
        stat_arr = np.concatenate(stat_list)
        slide_arr = np.concatenate(slide_list)
        tmpl_arr = np.concatenate(tmpl_list)
        dec_arr = np.concatenate(dec_list)
        time_arr = {ifo: np.concatenate(time_dict[ifo]) for ifo in instruments}
        tid_arr = {ifo: np.concatenate(tid_dict[ifo]) for ifo in instruments}

        if cluster_window and cluster_window > 0 and len(stat_arr) > 0:
            cid = coinc.cluster_coincs(
                stat_arr,
                time_arr[pivot_ifo],
                time_arr[fixed_ifo],
                slide_arr,
                ts_int,
                cluster_window,
            )
            stat_arr = stat_arr[cid]
            slide_arr = slide_arr[cid]
            tmpl_arr = tmpl_arr[cid]
            dec_arr = dec_arr[cid]
            for ifo in instruments:
                time_arr[ifo] = time_arr[ifo][cid]
                tid_arr[ifo] = tid_arr[cid] if isinstance(tid_arr, np.ndarray) else tid_arr[ifo][cid]
    else:
        stat_arr = np.zeros(0, dtype=np.float32)
        slide_arr = np.zeros(0, dtype=np.int32)
        tmpl_arr = np.zeros(0, dtype=np.int32)
        dec_arr = np.zeros(0, dtype=np.int32)
        time_arr = {ifo: np.zeros(0, dtype=np.float64) for ifo in instruments}
        tid_arr = {ifo: np.zeros(0, dtype=np.int32) for ifo in instruments}

    ifo_seglists = {}
    for ifo in instruments:
        s_raw = np.asarray(segs_by_ifo[ifo][0], dtype=np.float64)
        e_raw = np.asarray(segs_by_ifo[ifo][1], dtype=np.float64)
        if len(s_raw) > 0 and len(s_raw) == len(e_raw):
            ifo_seglists[ifo] = veto.start_end_to_segments(s_raw, e_raw).coalesce()
        else:
            ifo_seglists[ifo] = igwn_segs.segmentlist([])

    with HFile(target_fn, "w") as f:
        f.create_dataset(
            "stat", data=stat_arr, compression="gzip", compression_opts=9, shuffle=True
        )
        f.create_dataset(
            "timeslide_id", data=slide_arr, compression="gzip", compression_opts=9, shuffle=True
        )
        f.create_dataset(
            "template_id", data=tmpl_arr, compression="gzip", compression_opts=9, shuffle=True
        )
        f.create_dataset(
            "decimation_factor", data=dec_arr, compression="gzip", compression_opts=9, shuffle=True
        )
        for ifo in instruments:
            f.create_dataset(
                f"{ifo}/time",
                data=time_arr[ifo],
                compression="gzip",
                compression_opts=9,
                shuffle=True,
            )
            f.create_dataset(
                f"{ifo}/trigger_id",
                data=tid_arr[ifo],
                compression="gzip",
                compression_opts=9,
                shuffle=True,
            )

        combo_strs = []
        for idx in range(len(stat_arr)):
            active = "".join(ifo for ifo in sorted(instruments) if time_arr[ifo][idx] > 0)
            combo_strs.append(active.encode("utf8"))
        f.create_dataset("ifo_combination", data=np.asarray(combo_strs, dtype="S"))

        for r in range(1, len(instruments) + 1):
            for comb in combinations(sorted(instruments), r):
                comb_key = "".join(comb)
                comb_segs = igwn_segs.segmentlist(ifo_seglists[comb[0]])
                for ifo_c in comb[1:]:
                    comb_segs = (comb_segs & ifo_seglists[ifo_c]).coalesce()
                if len(comb_segs) > 0:
                    s_c, e_c = veto.segments_to_start_end(comb_segs)
                    s_c = np.asarray(s_c, dtype=np.float64)
                    e_c = np.asarray(e_c, dtype=np.float64)
                else:
                    s_c = np.zeros(0, dtype=np.float64)
                    e_c = np.zeros(0, dtype=np.float64)
                f[f"segments/{comb_key}/start"] = s_c
                f[f"segments/{comb_key}/end"] = e_c

        full_segs = igwn_segs.segmentlist(ifo_seglists[instruments[0]])
        for ifo_c in instruments[1:]:
            full_segs = (full_segs & ifo_seglists[ifo_c]).coalesce()
        coinc_dur = float(abs(full_segs)) if len(full_segs) > 0 else 10000.0

        f.attrs["timeslide_interval"] = ts_int
        f.attrs["coinc_time"] = coinc_dur
        f.attrs["num_of_ifos"] = len(instruments)
        f.attrs["pivot"] = pivot_ifo
        f.attrs["fixed"] = fixed_ifo
        for ifo in instruments:
            fg_dur = float(abs(ifo_seglists[ifo])) if len(ifo_seglists[ifo]) > 0 else coinc_dur
            f.attrs[f"{ifo}_foreground_time"] = fg_dur
            f.attrs[f"{ifo}_non_threshold_time"] = float(asym_num_bins * ts_int)
        f.attrs["ifos"] = " ".join(sorted(instruments))
        f.attrs["num_slides"] = int(asym_num_bins) if (timeslide_interval and timeslide_interval > 0) else 0
        f.attrs["max_timeslide_id"] = (int(asym_num_bins) // 2) if (timeslide_interval and timeslide_interval > 0) else 0

    logging.info(
        "Saved %d candidates (%d foreground, %d background) to %s in %.2f s total",
        len(stat_arr),
        int(np.sum(slide_arr == 0)),
        int(np.sum(slide_arr != 0)),
        target_fn,
        (time.perf_counter() - t_start) if t_start is not None else 0.0,
    )


def main():
    t_start = time.perf_counter()
    parser, args = get_args()
    pycbc.init_logging(args.verbose)

    from pycbc.types.optparse import DictWithDefaultReturn

    # When --timeslide-interval is omitted (e.g. coinc_inj), run strictly zero-lag
    if args.timeslide_interval is None or args.timeslide_interval <= 0:
        args.zero_lag_only = True
        args.timeslide_interval = 0.0

    # Check if bank_file contains fir_data; if not, look for fir_bbh_bank_seobnrv5.hdf
    with HFile(args.bank_file, "r") as bf:
        has_fir = "fir_data" in bf
    if not has_fir:
        candidates = [
            "fir_bbh_bank_seobnrv5.hdf",
            os.path.join(os.path.dirname(args.bank_file), "fir_bbh_bank_seobnrv5.hdf"),
            "/home/ahnitz/projects/claude/searchdev/bbh_test/bank_test56_flow15_seobnrv5/bank_single/fir_bbh_bank_seobnrv5.hdf",
        ]
        for candidate in candidates:
            if os.path.exists(candidate):
                logging.info(
                    "Bank file %s missing fir_data; falling back to %s",
                    args.bank_file,
                    candidate,
                )
                args.bank_file = candidate
                break

    instruments = ["H1", "L1"]
    if getattr(args, "channel_name", None):
        try:
            present = [
                ifo
                for ifo in ["H1", "L1", "V1", "K1"]
                if args.channel_name[ifo] is not None
            ]
            if present:
                instruments = sorted(present)
        except Exception:
            pass

    # Auto-detect injection file when processing an *INJECTIONS* trigger file
    has_inj_trig = any("INJECTION" in os.path.basename(fn).upper() for fn in args.trigger_files)
    inj_unset = not getattr(args, "injection_file", None) or all(
        args.injection_file[ifo] is None for ifo in instruments
    )
    if has_inj_trig and inj_unset:
        search_dirs = []
        for fn in args.trigger_files:
            d = os.path.dirname(os.path.abspath(fn))
            search_dirs.extend([d, os.path.join(os.path.dirname(d), "inj_files"), os.path.join(os.path.dirname(os.path.dirname(d)), "output", "inj_files")])
        search_dirs.append(os.getcwd())
        found_inj = None
        for sd in search_dirs:
            if not os.path.isdir(sd):
                continue
            for pat in ("*INJ2HDF*.hdf", "*SPLIT_INJ*.hdf", "*OPTIMAL_SNR_MERGE*INJECTIONS*.hdf"):
                matches = sorted(glob.glob(os.path.join(sd, pat)))
                if matches:
                    found_inj = matches[0]
                    break
            if found_inj:
                break
        if found_inj:
            logging.info("Auto-detected injection file %s for injection coincidence run", found_inj)
            args.injection_file = DictWithDefaultReturn(str, {ifo: found_inj for ifo in instruments})

    # Auto-detect {ifo}-FIT_OVER_PARAM statistic files when ranking_statistic == 'exp_fit'
    if args.ranking_statistic == "exp_fit" or (args.statistic_files and len(args.statistic_files) > 0):
        if not args.ranking_statistic:
            args.ranking_statistic = "exp_fit"
        for ifo in instruments:
            has_ifo_fit = False
            for sf in args.statistic_files:
                if os.path.exists(sf):
                    try:
                        with h5py.File(sf, "r") as hf:
                            if hf.attrs.get("stat") == f"{ifo}-fit_coeffs":
                                has_ifo_fit = True
                                break
                    except Exception:
                        pass
            if not has_ifo_fit:
                search_dirs = []
                for fn in args.trigger_files + args.statistic_files:
                    d = os.path.dirname(os.path.abspath(fn))
                    search_dirs.extend([d, os.path.join(os.path.dirname(d), "full_data"), os.path.join(os.path.dirname(os.path.dirname(d)), "output", "full_data")])
                search_dirs.append(os.getcwd())
                for sd in search_dirs:
                    if not os.path.isdir(sd):
                        continue
                    matches = sorted(glob.glob(os.path.join(sd, f"{ifo}-FIT_OVER_PARAM*.hdf")))
                    if matches:
                        logging.info("Auto-detected %s fit file: %s", ifo, matches[0])
