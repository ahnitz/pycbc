def fix_frame_files_args(raw_argv=None):
    if raw_argv is None:
        raw_argv = sys.argv[1:]
    channel_ifos = []
    for i, a in enumerate(raw_argv):
        if a == "--channel-name" and i + 1 < len(raw_argv):
            for part in raw_argv[i + 1 :]:
                if part.startswith("--"):
                    break
                if ":" in part:
                    channel_ifos.append(part.split(":")[0])

    new_argv = []
    in_frame_files = False
    for a in raw_argv:
        if a == "--frame-files":
            in_frame_files = True
            new_argv.append(a)
        elif in_frame_files:
            if a.startswith("--"):
                in_frame_files = False
                new_argv.append(a)
            else:
                if ":" in a:
                    new_argv.append(a)
                else:
                    base = os.path.basename(a)
                    m = re.match(r"^[A-Z]-([A-Z0-9]{2})_", base)
                    if m:
                        new_argv.append(f"{m.group(1)}:{a}")
                    elif len(channel_ifos) == 1:
                        new_argv.append(f"{channel_ifos[0]}:{a}")
                    else:
                        new_argv.append(a)
        else:
            new_argv.append(a)
    return new_argv


def parse_loudest_keep_values(loudest_keep_str):
    """Parse --loudest-keep-values string (e.g. '[7.5:1,6.0:10,4.0:50,2.0:250,0.0:1000]')
    into descending thresholds `threshes` (starting with +inf) and integer decimation
    factors `total_factors` (one per interval `[threshes[kidx], threshes[kidx-1])`).
    """
    if not loudest_keep_str:
        return None, None
    s = str(loudest_keep_str).strip()
    if not s or s == "None":
        return None, None
    raw_t = []
    raw_f = []
    for decstr in s.strip("[]").split(","):
        decstr = decstr.strip()
        if not decstr or ":" not in decstr:
            continue
        thresh_s, factor_s = decstr.split(":", 1)
        factor_f = float(factor_s)
        if factor_f % 1:
            raise RuntimeError("Non-integer decimation is not supported")
        factor_i = int(factor_f)
        if factor_i < 1:
            raise RuntimeError("Negative or zero decimation does not make sense")
        raw_t.append(float(thresh_s))
        raw_f.append(factor_i)

    if not raw_t:
        return None, None

    order = np.argsort(raw_t)[::-1]
    raw_t = np.asarray(raw_t, dtype=np.float64)[order]
    raw_f = np.asarray(raw_f, dtype=np.int64)[order]

    # Check if factors are already cumulative multiples (e.g. [1, 10, 50, 250, 1000])
    is_cumulative = all(
        raw_f[i] >= raw_f[i - 1] and (raw_f[i] % raw_f[i - 1] == 0)
        for i in range(1, len(raw_f))
    )
    if is_cumulative and raw_f[0] == 1:
        threshes = np.concatenate(([np.inf], raw_t))
        total_factors = raw_f
    else:
        # Legacy step-factor format where factor==1 is skipped and cumprod is applied
        t_list = [np.inf]
        f_list = [1]
        for t_val, f_val in zip(raw_t, raw_f):
            if f_val == 1:
                continue
            t_list.append(float(t_val))
            f_list.append(int(f_val))
        threshes = np.asarray(t_list, dtype=np.float64)
        total_factors = np.cumprod(np.asarray(f_list, dtype=np.int64))
    return threshes, total_factors


def setup_strain_and_segments(args, instruments, flow, segs_by_ifo=None):
    """Condition strain data and build frequency-domain segments with PSDs.
    Supports breaking up multi-segment / discontinuous analysis intervals.
    """
    import copy
    from pycbc.types.optparse import DictWithDefaultReturn

    args.merge_injection_windows = True
    gwstrain_start_time = {}
    segments = {ifo: [] for ifo in instruments}
    sample_rate = None
    flen = None
    delta_f = None

    for count, ifo in enumerate(instruments):
        logging.info("Conditioning strain and segments for %s...", ifo)

        active_segs = []
        if segs_by_ifo and ifo in segs_by_ifo:
            starts, ends = segs_by_ifo[ifo]
            t_s = (
                float(args.trig_start_time[ifo])
                if hasattr(args.trig_start_time, "__getitem__")
                else float(args.trig_start_time or 0)
            )
            t_e = (
                float(args.trig_end_time[ifo])
                if hasattr(args.trig_end_time, "__getitem__")
                else float(args.trig_end_time or float("inf"))
            )
            for s, e in zip(starts, ends):
                if e > t_s and s < t_e:
                    active_segs.append((max(float(s), t_s), min(float(e), t_e)))
            active_segs.sort()

        if not active_segs:
            t_s = (
                float(args.trig_start_time[ifo])
                if hasattr(args.trig_start_time, "__getitem__")
                else float(args.trig_start_time or 0)
            )
            t_e = (
                float(args.trig_end_time[ifo])
                if hasattr(args.trig_end_time, "__getitem__")
                else float(args.trig_end_time or 0)
            )
            active_segs = [(t_s, t_e)]

        for seg_start, seg_end in active_segs:
            if seg_end - seg_start < 512.0:
                logging.info(
                    "Skipping sub-segment [%s, %s] for %s (duration %.1fs < 512s)",
                    seg_start,
                    seg_end,
                    ifo,
                    seg_end - seg_start,
                )
                continue

            try:
                sub_args = copy.deepcopy(args)
                sub_args.trig_start_time = DictWithDefaultReturn(int, {ifo: int(seg_start)})
                sub_args.trig_end_time = DictWithDefaultReturn(int, {ifo: int(seg_end)})
                sub_args.gps_start_time = DictWithDefaultReturn(int, {ifo: int(seg_start)})
                sub_args.gps_end_time = DictWithDefaultReturn(int, {ifo: int(seg_end)})

                ifo_strain = pycbc.strain.from_cli_single_ifo(
                    sub_args, ifo, inj_filter_rejector=None, dyn_range_fac=pycbc.DYN_RANGE_FAC
                )

                if ifo not in gwstrain_start_time:
                    gwstrain_start_time[ifo] = float(ifo_strain.start_time)

                raw_strain_for_psd = (
                    ifo_strain.copy()
                    if getattr(sub_args, "overwhiten_strain", False)
                    else ifo_strain
                )

                if getattr(sub_args, "subtract_lines", False):
                    from pycbc.filter.overwhiten import subtract_coherent_lines

                    orig_injs = getattr(ifo_strain, "injections", None)
                    orig_gating = getattr(ifo_strain, "gating_info", None)
                    f_low_sub = max(25.0, getattr(sub_args, "overwhiten_f_low", 25.0))
                    ifo_strain, _ = subtract_coherent_lines(ifo_strain, f_low=f_low_sub)
                    ifo_strain = ifo_strain.astype(np.float32)
                    if orig_injs is not None:
                        ifo_strain.injections = orig_injs
                    if orig_gating is not None:
                        ifo_strain.gating_info = orig_gating

                single_det_opt = pycbc.types.optparse.copy_opts_for_single_ifo(sub_args, ifo)
                if getattr(sub_args, "overwhiten_strain", False):
                    from pycbc.filter.overwhiten import overwhiten_strain

                    orig_injs = getattr(ifo_strain, "injections", None)
                    orig_gating = getattr(ifo_strain, "gating_info", None)
                    f_low_ow = getattr(sub_args, "overwhiten_f_low", 18.0)
                    max_dur_ow = getattr(sub_args, "overwhiten_max_filter_duration", 4.0)
                    inpaint_ow = getattr(sub_args, "inpaint_edges", False)
                    ow_psd_model = getattr(single_det_opt, "overwhiten_psd_model", None)
                    if ow_psd_model is None:
                        ow_psd_model = getattr(
                            single_det_opt, "psd_estimation_method", None
                        ) or getattr(single_det_opt, "psd_estimation", "welch")
                    ifo_strain, _, _ = overwhiten_strain(
                        ifo_strain,
                        f_low=f_low_ow,
                        max_filter_duration=max_dur_ow,
                        f_high=getattr(sub_args, "high_frequency_cutoff", None),
                        inpaint_edges=inpaint_ow,
                        psd_model_type=ow_psd_model,
                    )
                    ifo_strain = ifo_strain.astype(np.float32)
                    ifo_strain._is_overwhitened = True
                    if orig_injs is not None:
                        ifo_strain.injections = orig_injs
                    if orig_gating is not None:
                        ifo_strain.gating_info = orig_gating

                ifo_segments = pycbc.strain.StrainSegments.from_cli_single_ifo(
                    sub_args, ifo_strain, ifo
                )
                if sample_rate is None:
                    sample_rate = float(ifo_strain.sample_rate)
                    flen = ifo_segments.freq_len
                    delta_f = ifo_segments.delta_f
                else:
                    if float(ifo_strain.sample_rate) != sample_rate:
                        raise ValueError(f"Sample rate mismatch for {ifo}")
                    if ifo_segments.freq_len != flen or ifo_segments.delta_f != delta_f:
                        raise ValueError(f"Segment frequency grid mismatch for {ifo}")

                fd_segs = ifo_segments.fourier_segments()
                pycbc.psd.associate_psds_to_segments(
                    single_det_opt,
                    fd_segs,
                    raw_strain_for_psd,
                    flen,
                    delta_f,
                    flow,
                    dyn_range_factor=pycbc.DYN_RANGE_FAC,
                    precision="single",
                )
                strain_epoch_val = float(ifo_strain.start_time)
                if not getattr(sub_args, "overwhiten_strain", False):
                    for seg in fd_segs:
                        seg[:] = seg / seg.psd
                        seg.strain_epoch = strain_epoch_val
                else:
                    for seg in fd_segs:
                        if seg.dtype != np.complex64:
                            seg._data = seg._data.astype(np.complex64)
                        seg.strain_epoch = strain_epoch_val
                segments[ifo].extend(fd_segs)
                del ifo_strain
                if raw_strain_for_psd is not None:
                    del raw_strain_for_psd
                del ifo_segments
            except Exception as exc:
                logging.warning(
                    "Skipping sub-segment [%s, %s] for %s due to error: %s",
                    seg_start,
                    seg_end,
                    ifo,
                    exc,
                )
                continue

    return segments, gwstrain_start_time, sample_rate, flen, delta_f


def load_primary_triggers(
    trigger_files,
    bank_file,
    instruments,
    primary_snr_threshold=6.0,
    primary_newsnr_threshold=5.5,
    primary_max_rchisq=5.0,
    min_secondary_snr=2.8,
    use_newsnr=True,
    veto_files=None,
    segment_name=None,
    template_fraction_range="0/1",
    hash_to_gid=None,
    sngl_ranking="newsnr_sgveto_autochisq",
    statistic_keywords=None,
    trig_start_time=None,
    trig_end_time=None,
    max_timeslide_extent=300.0,
    return_secondary_info=False,
):
    """Load primary triggers and per-template secondary trigger lookup tables
    from raw or merged trigger HDF5 files, applying full signal-consistency
    weighting (newsnr_sgveto_autochisq + hollow veto + rchisq gate + CAT2 vetoes).
    """
    if hash_to_gid is None:
        with HFile(bank_file, "r") as bf:
            hashes = bf["template_hash"][:]
        hash_to_gid = {int(h): idx for idx, h in enumerate(hashes)}
    n_templates = len(hash_to_gid)

    kw_dict = {}
    if statistic_keywords:
        for item in statistic_keywords:
            if isinstance(item, dict):
                kw_dict.update(item)
            elif ":" in str(item):
                k, v = str(item).split(":", 1)
                try:
                    if "." in v or "e" in v.lower():
                        v = float(v)
                    else:
                        v = int(v)
                except ValueError:
                    pass
                kw_dict[k] = v

    tid_min, tid_max = 0, n_templates
    if template_fraction_range and template_fraction_range != "0/1":
        part_str, tot_str = template_fraction_range.split("/")
        part, tot = int(part_str), int(tot_str)
        tid_min = int(n_templates * part / float(tot))
        tid_max = int(n_templates * (part + 1) / float(tot))

    primaries = {ifo: [] for ifo in instruments}
    segs_by_ifo = {ifo: ([], []) for ifo in instruments}
    valid_segs_by_ifo = {ifo: igwn_segs.segmentlist([]) for ifo in instruments}
    sec_trigs_by_ifo_gid = {ifo: {} for ifo in instruments}
    non_thresh_times = []

    raw_cache_by_ifo = {ifo: [] for ifo in instruments}

    for fn in trigger_files:
        if not os.path.exists(fn):
            continue
        with HFile(fn, "r") as f:
            for ifo in instruments:
                if ifo not in f or not isinstance(f[ifo], h5py.Group):
                    continue
                g = f[ifo]
                s_starts = []
                s_ends = []
                if "search/start_time" in g and "search/end_time" in g:
                    s_starts = g["search/start_time"][:].tolist()
                    s_ends = g["search/end_time"][:].tolist()
                    segs_by_ifo[ifo][0].extend(s_starts)
                    segs_by_ifo[ifo][1].extend(s_ends)
                if "search/non_threshold_time" in g:
                    try:
                        val = float(np.max(np.asarray(g["search/non_threshold_time"])))
                        if val > 0:
                            non_thresh_times.append(val)
                    except Exception:
                        pass

                # Build valid segmentlist (science segments minus CAT2 vetoes)
                if len(s_starts) > 0 and len(s_starts) == len(s_ends):
                    ifo_vsegs = veto.start_end_to_segments(
                        np.asarray(s_starts, dtype=np.float64),
                        np.asarray(s_ends, dtype=np.float64),
                    ).coalesce()
                else:
                    ifo_vsegs = igwn_segs.segmentlist(
                        [igwn_segs.segment(-1e12, 1e12)]
                    )
                if veto_files and segment_name:
                    for vf, sname in zip(veto_files, segment_name):
                        try:
                            v_seg = veto.select_segments_by_definer(
                                vf, ifo=ifo, segment_name=sname
                            )
                            ifo_vsegs = (ifo_vsegs - v_seg).coalesce()
                        except Exception:
                            pass
                valid_segs_by_ifo[ifo] = (valid_segs_by_ifo[ifo] | ifo_vsegs).coalesce()

                if "snr" not in g or len(g["snr"]) == 0:
                    continue

                t_start = 0.0
                if trig_start_time is not None:
                    if hasattr(trig_start_time, "__getitem__") and ifo in trig_start_time:
                        t_start = float(trig_start_time[ifo])
                    else:
                        try:
                            t_start = float(trig_start_time)
                        except (TypeError, ValueError):
                            t_start = 0.0
                t_end = float("inf")
                if trig_end_time is not None:
                    if hasattr(trig_end_time, "__getitem__") and ifo in trig_end_time:
                        t_end = float(trig_end_time[ifo])
                    else:
                        try:
                            t_end = float(trig_end_time)
                        except (TypeError, ValueError):
                            t_end = float("inf")

                end_time_all = g["end_time"][:]
                t_win_min = (t_start - max_timeslide_extent - 30.0) if t_start > 0 else -float("inf")
                t_win_max = (t_end + max_timeslide_extent + 30.0) if np.isfinite(t_end) else float("inf")
                win_mask = (end_time_all >= t_win_min) & (end_time_all < t_win_max)
                if not np.any(win_mask):
                    continue

                win_idx = np.flatnonzero(win_mask)
                end_time_w = end_time_all[win_idx]
                snr_w = g["snr"][:][win_idx]
                coa_phase_w = g["coa_phase"][:][win_idx]
                sigmasq_w = g["sigmasq"][:][win_idx]
                chisq_w = g["chisq"][:][win_idx] if "chisq" in g else np.zeros_like(snr_w)
                chisq_dof_w = (
                    g["chisq_dof"][:][win_idx]
                    if "chisq_dof" in g
                    else np.ones(len(snr_w), dtype=np.int32)
                )
                sg_chisq_w = (
                    g["sg_chisq"][:][win_idx]
                    if "sg_chisq" in g
                    else np.ones_like(snr_w)
                )
                if "template_id" in g:
                    tids_w = g["template_id"][:][win_idx].astype(np.int64)
                else:
                    th_w = g["template_hash"][:][win_idx]
                    tids_w = np.array([hash_to_gid[int(h)] for h in th_w], dtype=np.int64)

                dof_val = np.where(chisq_dof_w > 1, 2.0 * chisq_dof_w - 2.0, 1.0)
                rchisq_w = np.where(chisq_w > 0, chisq_w / dof_val, 1.0)
                nsnr_w = ranking.newsnr(snr_w, rchisq_w)

                # Build lightweight slice dict so get_sngls_ranking_from_trigs runs only on win_idx
                sub_trigs = {
                    "snr": snr_w,
                    "chisq": chisq_w,
                    "chisq_dof": chisq_dof_w,
                    "sg_chisq": sg_chisq_w,
                    "end_time": end_time_w,
                    "template_id": tids_w,
                }
                for opt_col in (
                    "cont_chisq",
                    "cont_chisq_dof",
                    "auto_chisq",
                    "auto_chisq_dof",
                    "hollow_density",
                    "psd_var_val",
                    "template_duration",
                ):
                    if opt_col in g:
                        sub_trigs[opt_col] = g[opt_col][:][win_idx]

                if use_newsnr:
                    if sngl_ranking and sngl_ranking in ranking.sngls_ranking_function_dict:
                        try:
                            eff_amp_w = np.asarray(
                                ranking.get_sngls_ranking_from_trigs(
                                    sub_trigs, sngl_ranking, **kw_dict
                                ),
                                dtype=np.float32,
                            )
                        except Exception as e:
                            logging.warning(
                                "Failed calculating %s: %s, falling back to newsnr_sgveto",
                                sngl_ranking,
                                e,
                            )
                            eff_amp_w = np.asarray(
                                ranking.newsnr_sgveto(snr_w, rchisq_w, sg_chisq_w),
                                dtype=np.float32,
                            )
                    else:
                        eff_amp_w = np.asarray(
                            ranking.newsnr_sgveto(snr_w, rchisq_w, sg_chisq_w),
                            dtype=np.float32,
                        )
                else:
                    eff_amp_w = snr_w.astype(np.float32)

                # Check valid segment membership (science minus CAT2 vetoes)
                in_valid_w = np.ones(len(end_time_w), dtype=bool)
                if len(valid_segs_by_ifo[ifo]) > 0:
                    vs_s, vs_e = veto.segments_to_start_end(valid_segs_by_ifo[ifo])
                    v_keep = veto.indices_within_times(end_time_w, vs_s, vs_e)
                    in_valid_w = np.zeros(len(end_time_w), dtype=bool)
                    in_valid_w[v_keep] = True
                elif veto_files and segment_name:
                    for vf, sname in zip(veto_files, segment_name):
                        v_idx, _ = veto.indices_outside_segments(
                            end_time_w, [vf], ifo=ifo, segment_name=sname
                        )
                        v_mask = np.zeros(len(end_time_w), dtype=bool)
                        v_mask[v_idx] = True
                        in_valid_w &= v_mask

                # Primary trigger gate: require full eff_amp >= primary_newsnr_threshold
                p_gate = (
                    (tids_w >= tid_min)
                    & (tids_w < tid_max)
                    & (snr_w >= primary_snr_threshold)
                    & in_valid_w
                )
                if t_start > 0:
                    p_gate &= end_time_w >= t_start
                if np.isfinite(t_end) and t_end > 0:
                    p_gate &= end_time_w < t_end
                if primary_max_rchisq is not None and primary_max_rchisq > 0:
                    p_gate &= rchisq_w <= primary_max_rchisq
                if primary_newsnr_threshold is not None and primary_newsnr_threshold > 0:
                    p_gate &= (nsnr_w >= primary_newsnr_threshold) & (
                        eff_amp_w >= primary_newsnr_threshold
                    )

                if np.any(p_gate):
                    sub = np.flatnonzero(p_gate)
                    for j in sub:
                        primaries[ifo].append(
                            {
                                "trig_id": int(win_idx[j]),
                                "template_id": int(tids_w[j]),
                                "end_time": float(end_time_w[j]),
                                "snr": float(snr_w[j]),
                                "eff_snr": float(eff_amp_w[j]),
                                "coa_phase": float(coa_phase_w[j]),
                                "sigmasq": float(sigmasq_w[j]),
                                "rchisq": float(rchisq_w[j]),
                            }
                        )

                if return_secondary_info:
                    rchisq_sec_w = np.where(
                        (chisq_w > 0) & (snr_w >= 4.5), chisq_w / dof_val, 0.0
                    )
                    is_vetoed_w = ~in_valid_w
                    if primary_max_rchisq is not None and primary_max_rchisq > 0:
                        is_vetoed_w |= rchisq_w > primary_max_rchisq
                    if min_secondary_snr is not None and min_secondary_snr > 0:
                        is_vetoed_w |= eff_amp_w < min_secondary_snr
                    raw_cache_by_ifo[ifo].append(
                        (
                            tids_w,
                            end_time_w,
                            win_idx.astype(np.int32),
                            snr_w.astype(np.float32),
                            eff_amp_w.astype(np.float32),
                            rchisq_sec_w.astype(np.float32),
                            coa_phase_w.astype(np.float32),
                            sigmasq_w.astype(np.float32),
                            is_vetoed_w,
                        )
                    )

    if return_secondary_info:
        active_gids = set()
        for ifo in instruments:
            for c in primaries[ifo]:
                active_gids.add(c["template_id"])
        active_gids_arr = np.array(sorted(active_gids), dtype=np.int64)

        for ifo in instruments:
            if not raw_cache_by_ifo[ifo] or len(active_gids_arr) == 0:
                continue
            tids_all = np.concatenate([x[0] for x in raw_cache_by_ifo[ifo]])
            keep_m = np.isin(tids_all, active_gids_arr)
            if not np.any(keep_m):
                continue
            tids_k = tids_all[keep_m]
            et_k = np.concatenate([x[1] for x in raw_cache_by_ifo[ifo]])[keep_m]
            tid_idx_k = np.concatenate([x[2] for x in raw_cache_by_ifo[ifo]])[keep_m]
            snr_k = np.concatenate([x[3] for x in raw_cache_by_ifo[ifo]])[keep_m]
            eff_k = np.concatenate([x[4] for x in raw_cache_by_ifo[ifo]])[keep_m]
            rch_k = np.concatenate([x[5] for x in raw_cache_by_ifo[ifo]])[keep_m]
            phi_k = np.concatenate([x[6] for x in raw_cache_by_ifo[ifo]])[keep_m]
            sq_k = np.concatenate([x[7] for x in raw_cache_by_ifo[ifo]])[keep_m]
            veto_k = np.concatenate([x[8] for x in raw_cache_by_ifo[ifo]])[keep_m]

            order = np.lexsort((et_k, tids_k))
            tids_k = tids_k[order]
            et_k = et_k[order]
            tid_idx_k = tid_idx_k[order]
            snr_k = snr_k[order]
            eff_k = eff_k[order]
            rch_k = rch_k[order]
            phi_k = phi_k[order]
            sq_k = sq_k[order]
            veto_k = veto_k[order]

            uniq_gids, split_starts, counts = np.unique(
                tids_k, return_index=True, return_counts=True
            )
            for ug, st_i, cnt in zip(uniq_gids, split_starts, counts):
                sl = slice(st_i, st_i + cnt)
                sec_trigs_by_ifo_gid[ifo][int(ug)] = {
                    "end_time": et_k[sl],
                    "trig_id": tid_idx_k[sl],
                    "snr": snr_k[sl],
                    "eff_snr": eff_k[sl],
                    "rchisq": rch_k[sl],
                    "coa_phase": phi_k[sl],
                    "sigmasq": sq_k[sl],
                    "is_vetoed": veto_k[sl],
                }
        del raw_cache_by_ifo

    inferred_non_thresh = max(non_thresh_times) if non_thresh_times else None
    if return_secondary_info:
        return (
            primaries,
            segs_by_ifo,
            inferred_non_thresh,
            sec_trigs_by_ifo_gid,
            valid_segs_by_ifo,
            kw_dict,
        )
    return primaries, segs_by_ifo, inferred_non_thresh


def build_single_template_evaluator(
    instruments,
    sample_rate,
    half_P=8,
    half_K=46,
    vsamples=128,
    sky_initial_samples=200000,
    d_min=1.0,
    d_max=10000.0,
):
    """Build a reusable :class:`SingleTemplate` instance configured with
    :class:`DistMarg` phase, distance, sky, time, inclination, and polarization
    marginalization on relative-epoch SNR snippets centered on the primary peak.
    """
    dt = 1.0 / float(sample_rate)
    K = 2 * int(half_K) + 1

    sh = {}
    for ifo in instruments:
        ts = TimeSeries(
            np.zeros(K, dtype=np.complex64), delta_t=dt, epoch=-half_K * dt
        )
        ts.data[half_K] = 8.0
        sh[ifo] = ts
    hh = {ifo: 1.0 for ifo in instruments}

    tc_half = max((half_P - 2) * dt, 2.0 * dt)
    vparams = ["tc", "ra", "dec", "inclination", "polarization", "distance"]
    prior = JointDistribution(
        vparams,
        Uniform(tc=(-tc_half, tc_half)),
        UniformAngle(ra=(0.0, 2.0)),
        CosAngle(dec=None),
        SinAngle(inclination=None),
        UniformAngle(polarization=(0.0, 2.0)),
        UniformRadius(distance=(float(d_min), float(d_max))),
    )

    # Fix RNG seed so Monte Carlo extrinsic vector & sky-delay grid initialization is deterministic
    np.random.seed(42)

    model = SingleTemplate(
        vparams,
        data=None,
        low_frequency_cutoff=None,
        sample_rate=sample_rate,
        sh=sh,
        hh=hh,
        prior=prior,
        static_params={},
        marginalize_phase=True,
        marginalize_distance=True,
        marginalize_distance_samples=2000,
        marginalize_distance_interpolator=True,
        marginalize_distance_snr_range=(0.02, 500.0),
        marginalize_distance_density=(256, 128),
        marginalize_vector_params="tc,ra,dec,inclination,polarization",
        marginalize_vector_samples=int(vsamples),
        marginalize_sky_initial_samples=int(sky_initial_samples),
    )
    model.update()

    # Pre-warm sky time-delay tables for single-IFO and multi-IFO orderings
    warm_orders = []
    for ifo_p in instruments:
        others = [i for i in instruments if i != ifo_p]
        for r in range(1, len(others) + 1):
            for comb in combinations(others, r):
                warm_orders.append([ifo_p] + list(comb))
        warm_orders.append([ifo_p])

    for ifo_order in warm_orders:
        model.keep_ifos = list(ifo_order)
        snrs_warm = {
            ifo: TimeSeries(
                np.ones(K, dtype=np.complex64) * 8.0,
                delta_t=dt,
                epoch=-half_K * dt,
            )
            for ifo in ifo_order
        }
        model.tstart = {ifo: -half_K * dt for ifo in ifo_order}
        model.tend = {ifo: half_K * dt for ifo in ifo_order}
        model.reset_vector_params()
        _ = model.current_params
        model.draw_sky_times(snrs_warm)

    return model


def evaluate_coinc_windows(
    model,
    ifo_p,
    z_p_snip,
    sigmasq_p,
    sample_rate,
    ifo_s=None,
    z_s_snips=None,
    sigmasq_s=None,
    sec_snips_by_ifo=None,
    sigmasq_by_ifo=None,
):
    """Evaluate single- or multi-detector marginal logLR over the primary peak
    snippet ``z_p_snip`` and optional secondary snippet windows using
    :meth:`SingleTemplate._loglr`.
    """
    dt = 1.0 / float(sample_rate)
    half_P = len(z_p_snip) // 2
    sig_p = float(np.sqrt(max(sigmasq_p, 1e-12)))

    ts_snr_p = TimeSeries(
        np.asarray(z_p_snip, dtype=np.complex64),
        delta_t=dt,
        epoch=-half_P * dt,
        copy=False,
    )
    ts_sh_p = TimeSeries(
        np.asarray(z_p_snip * sig_p, dtype=np.complex64),
        delta_t=dt,
        epoch=-half_P * dt,
        copy=False,
    )

    if sec_snips_by_ifo is None:
        if z_s_snips is not None and ifo_s is not None:
            sec_snips_by_ifo = {ifo_s: z_s_snips}
            sigmasq_by_ifo = {ifo_s: sigmasq_s}
        else:
            sec_snips_by_ifo = {}
            sigmasq_by_ifo = {}

    if not sec_snips_by_ifo:
        model.sh = {ifo_p: ts_sh_p}
        model.snr = {ifo_p: ts_snr_p}
        model.hh = {ifo_p: float(max(sigmasq_p, 1e-12))}
        model.keep_ifos = [ifo_p]
        model.tstart = {ifo_p: -half_P * dt}
        model.tend = {ifo_p: half_P * dt}
        model.reset_vector_params()
        return float(model._loglr())

    sec_ifos = list(sec_snips_by_ifo.keys())
    first_snips = sec_snips_by_ifo[sec_ifos[0]]
    n_win, K = first_snips.shape
    half_K = K // 2

    buf_snr = {}
    buf_sh = {}
    sig_sec = {}
    sh_dict = {ifo_p: ts_sh_p}
    snr_dict = {ifo_p: ts_snr_p}
    hh_dict = {ifo_p: float(max(sigmasq_p, 1e-12))}
    tstart_dict = {ifo_p: -half_P * dt}
    tend_dict = {ifo_p: half_P * dt}

    for ifo_sec in sec_ifos:
        sq_s = float(max(sigmasq_by_ifo[ifo_sec], 1e-12))
        sig_sec[ifo_sec] = float(np.sqrt(sq_s))
        b_snr = np.empty(K, dtype=np.complex64)
        b_sh = np.empty(K, dtype=np.complex64)
        buf_snr[ifo_sec] = b_snr
        buf_sh[ifo_sec] = b_sh
        snr_dict[ifo_sec] = TimeSeries(b_snr, delta_t=dt, epoch=-half_K * dt, copy=False)
        sh_dict[ifo_sec] = TimeSeries(b_sh, delta_t=dt, epoch=-half_K * dt, copy=False)
        hh_dict[ifo_sec] = sq_s
        tstart_dict[ifo_sec] = -half_K * dt
        tend_dict[ifo_sec] = half_K * dt

    model.sh = sh_dict
    model.snr = snr_dict
    model.hh = hh_dict
    model.keep_ifos = [ifo_p] + sec_ifos
    model.tstart = tstart_dict
    model.tend = tend_dict

    out = np.empty(n_win, dtype=np.float32)
    for w in range(n_win):
        for ifo_sec in sec_ifos:
            row = sec_snips_by_ifo[ifo_sec][w]
            buf_snr[ifo_sec][:] = row
            np.multiply(row, sig_sec[ifo_sec], out=buf_sh[ifo_sec])
        model.reset_vector_params()
        out[w] = float(model._loglr())
    return out


def compute_sngl_lognoiserate(rank_method, ifo, gid, eff_snr_arr):
    """Compute single-detector log noise rate density `snglstat` for template
    `gid` in detector `ifo` at effective SNR(s) `eff_snr_arr`, matching
    `ExpFitStatistic.lognoiserate` (`pycbc/events/stat.py` lines 1401-1426).
    """
    fits = rank_method.fits_by_tid[ifo]
    alphai = float(fits["smoothed_fit_coeff"][gid])
    ratei = float(fits["smoothed_rate_above_thresh"][gid])
    thresh = float(fits["thresh"])
    eff_snr = np.asarray(eff_snr_arr, dtype=np.float32)

    if alphai <= 0 or ratei <= 0 or np.isnan(alphai) or np.isnan(ratei):
        return np.full_like(eff_snr, 20.0, dtype=np.float32)

    log_a_r = float(np.log(alphai) + np.log(ratei))
    lognoisel = -alphai * (eff_snr - thresh) + log_a_r

    if not np.isinf(rank_method.alphabelow):
        bt = eff_snr < thresh
        if np.any(bt):
            if getattr(rank_method, "cap_alpha_below", False):
                ab_eff = min(alphai, float(rank_method.alphabelow))
                lognoisel_bt = -ab_eff * (eff_snr[bt] - thresh) + log_a_r
            else:
                ab_eff = float(rank_method.alphabelow)
                lognoisel_bt = (
                    -ab_eff * (eff_snr[bt] - thresh)
                    + float(np.log(ab_eff) + np.log(ratei))
                )
            if lognoisel.ndim == 0:
                lognoisel = np.asarray(lognoisel_bt[0], dtype=np.float32)
            else:
                lognoisel[bt] = lognoisel_bt
    return lognoisel


def compute_coarse_autocorr(top_tmpl, psd, sample_rate, high_frequency_cutoff, half_len=32):
    """Compute normalized complex autocorrelation A(tau) for lags [-half_len, +half_len]
    at `sample_rate` from the frequency-domain template and PSD.
    """
    n_samps = int(round(sample_rate * 4.0))
    df_4s = 1.0 / 4.0
    stride = max(1, int(round(df_4s / float(top_tmpl.delta_f))))
    k_max = min(len(top_tmpl), len(psd), int((high_frequency_cutoff or (sample_rate * 0.45)) / float(top_tmpl.delta_f)))
    ht = np.asarray(top_tmpl[:k_max:stride], dtype=np.complex64)
    p = np.asarray(psd[:k_max:stride], dtype=np.float32)
    valid = p > 0
    power = np.zeros(n_samps, dtype=np.float32)
    idx_f = np.arange(len(ht))[valid]
    idx_f = idx_f[idx_f < n_samps]
    power[idx_f] = (np.abs(ht[idx_f]) ** 2) / p[idx_f]
    power[0] = 0.0
    acf_full = np.fft.ifft(power)
    if np.abs(acf_full[0]) <= 0:
        out = np.zeros(2 * half_len + 1, dtype=np.complex64)
        out[half_len] = 1.0
        return out
    acf_full = acf_full / np.real(acf_full[0])
    lags = np.arange(-half_len, half_len + 1)
    return acf_full[lags % n_samps].astype(np.complex64)


def evaluate_segment_primaries(
    primaries,
    segments,
    gwstrain_start_time,
    sample_rate,
    delta_f,
    bank,
    instruments,
    model,
    half_P=8,
    half_K=46,
    timeslide_interval=0.1,
    asym_num_bins=2500,
    zero_lag_only=False,
    background_stat_threshold=9.0,
    pivot_ifo="H1",
    high_frequency_cutoff=950.0,
    disable_dynamic_snr_renorm=False,
    dynamic_snr_window=8.0,
    dynamic_snr_hollow=0.5,
    dynamic_snr_variance_floor=1.0,
    dynamic_snr_max_boost=None,
    primary_snr_threshold=6.0,
    primary_max_rchisq=5.0,
    min_secondary_snr=2.8,
    sec_trigs_by_ifo_gid=None,
    valid_segs_by_ifo=None,
    rank_method=None,
    coinc_threshold=0.002,
    loudest_keep_threshes=None,
    loudest_keep_factors=None,
    statistic_keywords_dict=None,
    include_singles=False,
):
    """Evaluate marginal logLR across all primary triggers on conditioned ``segments``
    using ``SingleTemplate`` / ``DistMarg`` combined with ``ExpFitStatistic``
    template-calibrated noise models and full primary/secondary signal-consistency
    weighting.
    """
    fine_to_top, _ = bank.build_hierarchy_maps()
    if sec_trigs_by_ifo_gid is None:
        sec_trigs_by_ifo_gid = {ifo: {} for ifo in instruments}
    if statistic_keywords_dict is None:
        statistic_keywords_dict = {}

    # Pre-extract valid segment start/end arrays per IFO for O(log N) secondary window vetoing
    valid_se_by_ifo = {}
    if valid_segs_by_ifo is not None:
        for ifo in instruments:
            if ifo in valid_segs_by_ifo and len(valid_segs_by_ifo[ifo]) > 0:
                vs_s, vs_e = veto.segments_to_start_end(valid_segs_by_ifo[ifo])
                valid_se_by_ifo[ifo] = (
                    np.asarray(vs_s, dtype=np.float64),
                    np.asarray(vs_e, dtype=np.float64),
                )

    # Precompute 2-detector coincidence noise area & PhaseTD volume normalization if rank_method is used
    use_exp_fit = (
        rank_method is not None
        and hasattr(rank_method, "fits_by_tid")
        and all(ifo in rank_method.fits_by_tid for ifo in instruments)
    )
    if use_exp_fit:
        if getattr(rank_method, "kwargs", {}).get("phasetd", False) and not getattr(
            rank_method, "has_hist", False
        ):
            try:
                rank_method.get_hist()
            except Exception:
                pass
        noise_twindow = float(
            coinc_rate.multiifo_noise_coincident_area(instruments, coinc_threshold)
        )
        if getattr(rank_method, "has_hist", False):
            n_ifos = len(instruments)
            snr_range = (rank_method.srbmax - rank_method.srbmin) * rank_method.swidth
            hist_vol = noise_twindow * ((2.0 * np.pi * snr_range) ** (n_ifos - 1))
        else:
            hist_vol = 1.0
        const_noise_offset = (
            float(np.log(max(noise_twindow, 1e-12)))
            - float(getattr(rank_method, "benchmark_lograte", -14.6))
            - float(np.log(max(hist_vol, 1e-12)))
        )
        stat_corr = float(getattr(rank_method, "stat_correction", 0.0))
        min_stat_val = float(getattr(rank_method, "min_stat", -50.0))
        C_COH_OFFSET = 18.0
        RHO_CAP = 9.0

    seg_bounds = {ifo: [] for ifo in instruments}
    for ifo in instruments:
        for s_num, st in enumerate(segments[ifo]):
            t0_ifo = getattr(st, "strain_epoch", gwstrain_start_time.get(ifo, 0.0))
            s_start = st.seg_slice.start
            a0 = t0_ifo + (s_start + st.analyze.start) / sample_rate
            a1 = t0_ifo + (s_start + st.analyze.stop) / sample_rate
            seg_bounds[ifo].append((s_num, s_start, a0, a1))

    def find_seg(ifo, t_gps):
        for s_num, s_start, a0, a1 in seg_bounds[ifo]:
            if a0 <= t_gps < a1:
                return s_num, s_start
        return None

    tap_sr = int(bank.sample_rate)
    dat_sr = int(sample_rate)
    decim = decimation_factor(tap_sr, dat_sr)
    half_acorr = 24

    def prepare_subseg_top(ifo, s_num, top_id, batch_gids):
        st = segments[ifo][s_num]
        top_tmpl = bank.get_coarse_template(top_id)
        top_ser, norm_val = make_reference_series(
            st,
            st.psd,
            top_tmpl,
            high_frequency_cutoff=high_frequency_cutoff,
            tap_sample_rate=tap_sr,
            data_sample_rate=dat_sr,
        )
        rf = (
            None
            if disable_dynamic_snr_renorm
            else DynamicSNRRenormFactor(
                top_ser,
                dt=float(st.delta_t),
                scale=float(st.delta_t / decim),
                window_duration=dynamic_snr_window,
                hollow_duration=dynamic_snr_hollow,
                variance_floor=dynamic_snr_variance_floor,
                max_boost_factor=dynamic_snr_max_boost,
            )
        )
        td_bank, meta = bank.get_group_corr_bank(
            top_id,
            batch_gids,
            tap_sample_rate=tap_sr,
            data_sample_rate=dat_sr,
        )
        acorr = compute_coarse_autocorr(
            top_tmpl, st.psd, sample_rate, high_frequency_cutoff, half_len=half_acorr
        )
        return st, top_ser, norm_val, rf, td_bank, meta, acorr

    res = {
        "stat": [],
        "slide": [],
        "tmpl": [],
        "dec": [],
        "time": {ifo: [] for ifo in instruments},
        "tid": {ifo: [] for ifo in instruments},
        "filt_time": 0.0,
        "eval_time": 0.0,
        "n_snippets": 0,
    }

    P = 2 * int(half_P) + 1
    K = 2 * int(half_K) + 1
    slide_step_sec = float(timeslide_interval) if timeslide_interval else 0.0
    slide_step_samp = max(1, int(round(slide_step_sec * sample_rate))) if slide_step_sec > 0 else 1
    half_num_slides = 0 if (zero_lag_only or slide_step_sec <= 0) else int(asym_num_bins) // 2

    # Group both primary-peak and secondary-window reconstruction tasks by (s_num, ifo, top_id)
    prim_by_subseg_top = collections.defaultdict(list)
    sec_by_subseg_top = collections.defaultdict(list)
    single_only_candidates = []
    multi_candidates = []

    for ifo_p in instruments:
        other_ifos = [i for i in instruments if i != ifo_p]
        for cand in primaries[ifo_p]:
            gid = cand["template_id"]
            top_id = fine_to_top[gid]
            m_p = find_seg(ifo_p, cand["end_time"])
            if m_p is not None:
                s_num_p, s_start_p = m_p
                prim_by_subseg_top[(s_num_p, ifo_p, top_id)].append((cand, s_start_p))
            else:
                z_p = np.zeros(P, dtype=np.complex64)
                z_p[half_P] = cand["eff_snr"] * np.exp(1j * cand["coa_phase"])
                cand["z_p_snip"] = z_p

            active_secs = []
            for ifo_s in other_ifos:
                m_s = find_seg(ifo_s, cand["end_time"])
                if m_s is not None:
                    s_num_s, s_start_s = m_s
                    active_secs.append((ifo_s, s_num_s, s_start_s))

            if not active_secs:
                single_only_candidates.append((ifo_p, cand))
            else:
                cand["sec_reconstructed"] = {}
                multi_candidates.append(
                    (ifo_p, [x[0] for x in active_secs], cand)
                )
                for ifo_s, s_num_s, s_start_s in active_secs:
                    sec_by_subseg_top[(s_num_s, ifo_s, top_id)].append(
                        (ifo_p, cand, s_start_s)
                    )

    # Phase 1: Reconstruct primary snippets from strain only when single-detector triggers
    # are requested or rank_method is not used; otherwise synthesize the 17-sample peak snippet
    # directly from the template autocorrelation and the trigger's measured (eff_snr, coa_phase)
    # inside Phase 3 (avoiding duplicate 512-s FFTs on the primary detector).
    if include_singles or not use_exp_fit:
        t0_p = time.perf_counter()
        for (s_num, ifo, top_id), p_list in prim_by_subseg_top.items():
            batch_gids = [c[0]["template_id"] for c in p_list]
            st, top_ser, norm_val, rf, td_bank, meta, acorr = prepare_subseg_top(
                ifo, s_num, top_id, batch_gids
            )
            t0_ifo = getattr(st, "strain_epoch", gwstrain_start_time.get(ifo, 0.0))
            acorr_p = acorr[half_acorr - half_P : half_acorr + half_P + 1]
            for cand, s_start_p in p_list:
                gid = cand["template_id"]
                phys_center_p = (
                    int(round((cand["end_time"] - t0_ifo) * sample_rate)) - s_start_p
                )
                slot22, comp22, sh22, _ = meta[gid]
                z_p = reconstruct_fir_snr_span(
                    top_ser,
                    comp22,
                    sh22,
                    phys_center_p - half_P,
                    phys_center_p + half_P + 1,
                    renorm_factor=rf,
                    tap_sample_rate=tap_sr,
                    data_sample_rate=dat_sr,
                    td_bank=td_bank,
                    template_index=slot22,
                )
                if z_p is not None and len(z_p) == P:
                    peak_abs = float(np.max(np.abs(z_p)))
                    if peak_abs >= 0.75 * cand["snr"] and peak_abs > 1e-6:
                        z_p = (z_p * (cand["eff_snr"] / peak_abs)).astype(np.complex64)
                    else:
                        z_p = (
                            acorr_p * (cand["eff_snr"] * np.exp(1j * cand["coa_phase"]))
                        ).astype(np.complex64)
                    cand["z_p_snip"] = z_p
                else:
                    cand["z_p_snip"] = (
                        acorr_p * (cand["eff_snr"] * np.exp(1j * cand["coa_phase"]))
                    ).astype(np.complex64)
            del st, top_ser, norm_val, rf, td_bank, meta, acorr
        res["filt_time"] += time.perf_counter() - t0_p

    # Phase 2: Evaluate single-only candidates only if explicitly requested (e.g. unit tests)
    if include_singles:
        t_ev0 = time.perf_counter()
        for ifo_p, cand in single_only_candidates:
            lr_1d = evaluate_coinc_windows(
                model,
                ifo_p,
                cand["z_p_snip"],
                cand["sigmasq"],
                sample_rate,
            )
            res["stat"].append(np.array([lr_1d], dtype=np.float32))
            res["slide"].append(np.array([0], dtype=np.int32))
            res["tmpl"].append(np.array([cand["template_id"]], dtype=np.int32))
            res["dec"].append(np.array([1], dtype=np.int32))
            for ifo in instruments:
                if ifo == ifo_p:
                    res["time"][ifo].append(np.array([cand["end_time"]], dtype=np.float64))
                    res["tid"][ifo].append(np.array([cand["trig_id"]], dtype=np.int32))
                else:
                    res["time"][ifo].append(np.array([-1.0], dtype=np.float64))
                    res["tid"][ifo].append(np.array([-1], dtype=np.int32))
        res["eval_time"] += time.perf_counter() - t_ev0

    # Phase 3: Streaming secondary snippet reconstruction, signal-consistency weighting,
    # pre-evaluation decimation pruning, and coherent marginal logLR evaluation
    match_tol_sec = (half_K / float(sample_rate)) + 0.020
    acorr_lags = np.arange(-half_acorr, half_acorr + 1)
    acorr_nonzero = acorr_lags != 0
    acorr_lags_nz = acorr_lags[acorr_nonzero]

    for (s_num, ifo_s, top_id), s_list in sec_by_subseg_top.items():
        batch_gids = [c[1]["template_id"] for c in s_list]
        t0_f = time.perf_counter()
        st, top_ser, norm_val, rf, td_bank, meta, acorr = prepare_subseg_top(
            ifo_s, s_num, top_id, batch_gids
        )
        t0_ifo = getattr(st, "strain_epoch", gwstrain_start_time.get(ifo_s, 0.0))
        a_start = st.analyze.start
        a_stop = st.analyze.stop
        acorr_nz = acorr[acorr_nonzero]
        acorr_p = acorr[half_acorr - half_P : half_acorr + half_P + 1]
        acorr_var = np.maximum(2.0 * (1.0 - np.abs(acorr_nz) ** 2), 0.10).astype(np.float32)

        vs_s_ifo, vs_e_ifo = valid_se_by_ifo.get(ifo_s, (None, None))

        for ifo_p, cand, s_start_s in s_list:
            if "z_p_snip" not in cand:
                cand["z_p_snip"] = (
                    acorr_p * (cand["eff_snr"] * np.exp(1j * cand["coa_phase"]))
                ).astype(np.complex64)
            gid = cand["template_id"]
            t_p = cand["end_time"]
            eff_snr_p = cand["eff_snr"]
            base_sigmasq_p = max(float(cand["sigmasq"]), 1e-12)

            phys_center_s = (
                int(round((t_p - t0_ifo) * sample_rate)) - s_start_s
            )
            min_m = max(
                int(np.ceil((a_start + half_K + half_acorr - phys_center_s) / float(slide_step_samp))),
                -half_num_slides,
            )
            max_m = min(
                int(
                    np.floor(
                        (a_stop - 1 - half_K - half_acorr - phys_center_s) / float(slide_step_samp)
                    )
                ),
                half_num_slides,
            )
            if min_m > max_m:
                continue

            slides = np.arange(min_m, max_m + 1, dtype=np.int32)
            phys_span_start = phys_center_s + min_m * slide_step_samp - half_K - half_acorr
            phys_span_stop = phys_center_s + max_m * slide_step_samp + half_K + half_acorr + 1
            rel_starts = (slides - min_m) * slide_step_samp + half_acorr

            slot22, comp22, sh22, sc22 = meta[gid]
            z_sec_22 = reconstruct_fir_snr_span(
                top_ser,
                comp22,
                sh22,
                phys_span_start,
                phys_span_stop,
                renorm_factor=rf,
                tap_sample_rate=tap_sr,
                data_sample_rate=dat_sr,
                td_bank=td_bank,
                template_index=slot22,
            )
            if z_sec_22 is None:
                continue

            snips_view = sliding_window_view(z_sec_22, K)[rel_starts]
            peak_k_all = np.argmax(np.abs(snips_view), axis=1)
            max_abs_arr = np.abs(snips_view[np.arange(len(slides)), peak_k_all]).astype(np.float32)

            t_s_center_arr = t_p + slides * slide_step_sec
            t_peak_arr = t_s_center_arr + (peak_k_all - half_K) / float(sample_rate)

            # 1. Science & CAT2 veto segment check on secondary detector window
            valid_win = np.ones(len(slides), dtype=bool)
            if vs_s_ifo is not None and len(vs_s_ifo) > 0:
                seg_idx = np.searchsorted(vs_s_ifo, t_s_center_arr - 0.05, side="right") - 1
                valid_win &= (seg_idx >= 0) & (
                    (t_s_center_arr + 0.05) <= vs_e_ifo[np.maximum(seg_idx, 0)]
                )

            # 2. Match secondary windows against recorded triggers in sec_trigs_by_ifo_gid[ifo_s][gid]
            st_tab = sec_trigs_by_ifo_gid.get(ifo_s, {}).get(gid, None)
            matched_trig_idx = np.full(len(slides), -1, dtype=np.int32)
            if st_tab is not None and len(st_tab["end_time"]) > 0:
                et_tab = st_tab["end_time"]
                n_tab = len(et_tab)
                for q_times in (t_peak_arr, t_s_center_arr):
                    pos = np.searchsorted(et_tab, q_times)
                    i_left = np.clip(pos - 1, 0, n_tab - 1)
                    i_right = np.clip(pos, 0, n_tab - 1)
                    d_left = np.abs(q_times - et_tab[i_left])
                    d_right = np.abs(q_times - et_tab[i_right])
                    best_i = np.where(d_left <= d_right, i_left, i_right)
                    best_d = np.minimum(d_left, d_right)
                    newly_matched = (matched_trig_idx < 0) & (best_d <= match_tol_sec)
                    matched_trig_idx[newly_matched] = best_i[newly_matched]

            has_match = matched_trig_idx >= 0
            eff_snr_s_arr = max_abs_arr.copy()
            trig_id_s_arr = np.full(len(slides), -1, dtype=np.int32)
            base_sigmasq_s = max(float(norm_val * sc22), 1e-12)
            sigmasq_s_arr = np.full(len(slides), base_sigmasq_s, dtype=np.float64)

            if np.any(has_match):
                m_idx = np.flatnonzero(has_match)
                t_idx = matched_trig_idx[m_idx]
                # Reject any window matching a vetoed trigger (rchisq > 5.0, eff_snr < min_secondary_snr, or CAT2 veto)
                valid_win[m_idx] &= ~st_tab["is_vetoed"][t_idx]
                eff_snr_s_arr[m_idx] = st_tab["eff_snr"][t_idx]
                trig_id_s_arr[m_idx] = st_tab["trig_id"][t_idx]
                sigmasq_s_arr[m_idx] = np.maximum(st_tab["sigmasq"][t_idx], 1e-12)

            # For unmatched windows:
            # - Any peak with raw SNR >= primary_snr_threshold (6.0) that is NOT in f[ifo_s]
            #   was vetoed or throttled during the primary pass -> reject immediately!
            # - Any peak with raw SNR < min_secondary_snr -> reject immediately!
            unmatched = ~has_match
            if min_secondary_snr is not None and min_secondary_snr > 0:
                valid_win[unmatched] &= max_abs_arr[unmatched] >= min_secondary_snr
            if primary_snr_threshold is not None and primary_snr_threshold > 0:
                valid_win[unmatched] &= max_abs_arr[unmatched] < primary_snr_threshold
            eff_snr_s_arr[unmatched] = max_abs_arr[unmatched]

            if not np.any(valid_win):
                del snips_view, z_sec_22
                continue

            coinc_slides_all = slides if ifo_p == pivot_ifo else -slides

            # Fast pre-filter using raw_u >= eff_u before computing snippet autochisq on unmatched windows
            if use_exp_fit:
                snglstat_p = float(
                    compute_sngl_lognoiserate(rank_method, ifo_p, gid, eff_snr_p)
                ) - float(np.log(max(eff_snr_p, 2.8)))
                bm_vol = float(rank_method.benchmark_logvol[gid])
                has_sv = not np.isnan(bm_vol) and getattr(
                    rank_method, "kwargs", {}
                ).get("sensitive_volume", True)

                v_pre = np.flatnonzero(valid_win)
                eff_s_pre = eff_snr_s_arr[v_pre]
                snglstat_s_pre = compute_sngl_lognoiserate(
                    rank_method, ifo_s, gid, eff_s_pre
                ) - np.log(np.maximum(eff_s_pre, 2.8)).astype(np.float32)
                ln_noise_pre = snglstat_p + snglstat_s_pre + const_noise_offset
                mean_sq_pre = 0.5 * (base_sigmasq_p + sigmasq_s_arr[v_pre])
                sv_pre = (
                    (1.5 * np.log(np.maximum(mean_sq_pre, 1e-12)) - bm_vol).astype(
                        np.float32
                    )
                    if has_sv
                    else np.zeros(len(v_pre), dtype=np.float32)
                )
                rho_net_pre = np.sqrt(eff_snr_p ** 2 + eff_s_pre ** 2)
                gamma_pre = np.minimum(1.0, RHO_CAP / np.maximum(rho_net_pre, 1e-6))
                sig_rat_ps_pre = np.sqrt(
                    base_sigmasq_p / np.maximum(sigmasq_s_arr[v_pre], 1e-12)
                ).astype(np.float32)
                sig_rat_sp_pre = 1.0 / np.maximum(sig_rat_ps_pre, 1e-6)
                dp_sky_pre = np.maximum(
                    0.0,
                    np.maximum(
                        eff_snr_p - 1.35 * sig_rat_ps_pre * eff_s_pre,
                        eff_s_pre - 1.35 * sig_rat_sp_pre * eff_snr_p,
                    ),
                )
                dp_null_pre = np.maximum(
                    0.0,
                    np.maximum(
                        eff_snr_p - 2.0 * sig_rat_ps_pre * eff_s_pre,
                        eff_s_pre - 2.0 * sig_rat_sp_pre * eff_snr_p,
                    ),
                )
                dl_ub_pre = (
                    (C_COH_OFFSET - 16.8)
                    - 4.0 * np.log(1.0 / np.maximum(gamma_pre, 1e-6))
                    - 0.5 * (gamma_pre ** 2) * (dp_sky_pre ** 2 / 2.8225)
                    - 0.5 * (1.0 - gamma_pre ** 2) * (dp_null_pre ** 2 / 5.0)
                )
                s_ub_pre = dl_ub_pre + sv_pre - ln_noise_pre + stat_corr
                c_slides_pre = coinc_slides_all[v_pre]

                if loudest_keep_threshes is not None and len(loudest_keep_threshes) > 1:
                    keep_pre = c_slides_pre == 0
                    bg_pre = c_slides_pre != 0
                    if np.any(bg_pre):
                        can_bg = np.zeros(len(v_pre), dtype=bool)
                        for kidx in range(1, len(loudest_keep_threshes)):
                            fac_k = int(loudest_keep_factors[kidx - 1])
                            can_bg |= (s_ub_pre >= loudest_keep_threshes[kidx]) & (
                                (c_slides_pre % fac_k) == 0
                            )
                        keep_pre[bg_pre] = can_bg[bg_pre]
                else:
                    keep_pre = (c_slides_pre == 0) | (
                        s_ub_pre >= background_stat_threshold
                    )
                valid_win[v_pre[~keep_pre]] = False

                if not np.any(valid_win):
                    del snips_view, z_sec_22
                    continue

            # For surviving secondary windows without a full chisq test in st_tab
            # (unmatched OR matched sub-threshold triggers with rchisq <= 0.0),
            # compute snippet-level autocorrelation reduced chisq and apply newsnr_sgveto_autochisq
            needs_snip_chisq = unmatched.copy()
            if np.any(has_match):
                m_idx = np.flatnonzero(has_match)
                t_idx = matched_trig_idx[m_idx]
                needs_snip_chisq[m_idx] = (st_tab["rchisq"][t_idx] <= 0.0) & (
                    max_abs_arr[m_idx] >= 0.75 * st_tab["snr"][t_idx]
                )
            unmatched_surv = np.flatnonzero(valid_win & needs_snip_chisq)
            if len(unmatched_surv) > 0:
                p_centers = rel_starts[unmatched_surv] + peak_k_all[unmatched_surv]
                z_peaks = z_sec_22[p_centers]
                z_neighbors = z_sec_22[p_centers[:, None] + acorr_lags_nz[None, :]]
                resid2 = np.abs(z_neighbors - z_peaks[:, None] * acorr_nz[None, :]) ** 2
                auto_rchisq_u = np.mean(resid2 / acorr_var[None, :], axis=1).astype(np.float32)
                raw_u = max_abs_arr[unmatched_surv]
                eff_u = np.asarray(
                    ranking.newsnr_sgveto_autochisq(
                        raw_u,
                        np.ones_like(raw_u),
                        np.ones_like(raw_u),
                        auto_rchisq_u,
                        **statistic_keywords_dict,
                    ),
                    dtype=np.float32,
                )
                keep_u = np.ones(len(unmatched_surv), dtype=bool)
                if primary_max_rchisq is not None and primary_max_rchisq > 0:
                    keep_u &= auto_rchisq_u <= primary_max_rchisq
                if min_secondary_snr is not None and min_secondary_snr > 0:
                    keep_u &= eff_u >= min_secondary_snr
                valid_win[unmatched_surv[~keep_u]] = False
                eff_snr_s_arr[unmatched_surv[keep_u]] = eff_u[keep_u]

            if not np.any(valid_win):
                del snips_view, z_sec_22
                continue

            # 3. Pre-evaluation upper-bound & decimation pruning with exact eff_snr_s
            if use_exp_fit:
                v_idx = np.flatnonzero(valid_win)
                eff_s_v = eff_snr_s_arr[v_idx]
                snglstat_s_v = compute_sngl_lognoiserate(
                    rank_method, ifo_s, gid, eff_s_v
                ) - np.log(np.maximum(eff_s_v, 2.8)).astype(np.float32)
                ln_noise_v = snglstat_p + snglstat_s_v + const_noise_offset

                min_sq_v = np.minimum(base_sigmasq_p, sigmasq_s_arr[v_idx])
                mean_sq_v = 0.5 * (base_sigmasq_p + sigmasq_s_arr[v_idx])
                if not has_sv:
                    sv_fac_v = np.zeros(len(v_idx), dtype=np.float32)
                else:
                    sv_fac_v = (1.5 * np.log(np.maximum(mean_sq_v, 1e-12)) - bm_vol).astype(
                        np.float32
                    )

                rho_net_v = np.sqrt(eff_snr_p ** 2 + eff_s_v ** 2)
                gamma_v = np.minimum(1.0, RHO_CAP / np.maximum(rho_net_v, 1e-6))
                sig_rat_ps_v = np.sqrt(
                    base_sigmasq_p / np.maximum(sigmasq_s_arr[v_idx], 1e-12)
                ).astype(np.float32)
                sig_rat_sp_v = 1.0 / np.maximum(sig_rat_ps_v, 1e-6)
                dp_sky_v = np.maximum(
                    0.0,
                    np.maximum(
                        eff_snr_p - 1.35 * sig_rat_ps_v * eff_s_v,
                        eff_s_v - 1.35 * sig_rat_sp_v * eff_snr_p,
                    ),
                )
                dp_null_v = np.maximum(
                    0.0,
                    np.maximum(
                        eff_snr_p - 2.0 * sig_rat_ps_v * eff_s_v,
                        eff_s_v - 2.0 * sig_rat_sp_v * eff_snr_p,
                    ),
                )
                dl_ub_v = (
                    (C_COH_OFFSET - 16.8)
                    - 4.0 * np.log(1.0 / np.maximum(gamma_v, 1e-6))
                    - 0.5 * (gamma_v ** 2) * (dp_sky_v ** 2 / 2.8225)
                    - 0.5 * (1.0 - gamma_v ** 2) * (dp_null_v ** 2 / 5.0)
                )
                s_ub_v = dl_ub_v + sv_fac_v - ln_noise_v + stat_corr
                c_slides_v = coinc_slides_all[v_idx]

                if loudest_keep_threshes is not None and len(loudest_keep_threshes) > 1:
                    # Determine which windows can survive tiered decimation
                    eval_mask_v = c_slides_v == 0
                    bg_v = c_slides_v != 0
                    if np.any(bg_v):
                        can_keep_bg = np.zeros(len(v_idx), dtype=bool)
                        for kidx in range(1, len(loudest_keep_threshes)):
                            fac_k = int(loudest_keep_factors[kidx - 1])
                            can_keep_bg |= (s_ub_v >= loudest_keep_threshes[kidx]) & (
                                (c_slides_v % fac_k) == 0
                            )
                        eval_mask_v[bg_v] = can_keep_bg[bg_v]
                else:
                    eval_mask_v = (c_slides_v == 0) | (s_ub_v >= background_stat_threshold)

                surv_sub = np.flatnonzero(eval_mask_v)
                if len(surv_sub) == 0:
                    del snips_view, z_sec_22
                    continue
                surv_idx = v_idx[surv_sub]
                ln_noise_surv = ln_noise_v[surv_sub]
                sv_fac_surv = sv_fac_v[surv_sub]
                min_sq_surv = min_sq_v[surv_sub]
            else:
                ub_arr = 0.5 * (eff_snr_p ** 2 + eff_snr_s_arr ** 2) - 14.5
                valid_win &= (slides == 0) | (ub_arr >= background_stat_threshold)
                surv_idx = np.flatnonzero(valid_win)
                if len(surv_idx) == 0:
                    del snips_view, z_sec_22
                    continue

            surv_slides = slides[surv_idx]
            surv_coinc_slides = coinc_slides_all[surv_idx]
            surv_snips = np.array(snips_view[surv_idx], dtype=np.complex64, copy=True)
            surv_eff_s = eff_snr_s_arr[surv_idx]
            surv_raw_s = max_abs_arr[surv_idx]
            surv_tid_s = trig_id_s_arr[surv_idx]
            surv_match_idx = matched_trig_idx[surv_idx]
            del snips_view, z_sec_22

            # 4. Rescale each surviving secondary snippet by its signal-consistency weight
            #    w_s = eff_snr_s / max(|z_s|) (or synthesize from template autocorrelation if strain lacked injection)
            for w in range(len(surv_idx)):
                m_i = surv_match_idx[w]
                if m_i >= 0 and surv_raw_s[w] < 0.75 * st_tab["snr"][m_i]:
                    t_trig = float(st_tab["end_time"][m_i])
                    phi_trig = float(st_tab["coa_phase"][m_i])
                    t_win_c = t_p + surv_slides[w] * slide_step_sec
                    k_trig = int(round((t_trig - t_win_c) * sample_rate)) + half_K
                    k_lags = np.arange(K) - k_trig
                    in_ac = np.abs(k_lags) <= half_acorr
                    row_s = np.zeros(K, dtype=np.complex64)
                    row_s[in_ac] = acorr[k_lags[in_ac] + half_acorr] * (
                        surv_eff_s[w] * np.exp(1j * phi_trig)
                    )
                    surv_snips[w] = row_s
                else:
                    scale_w = float(surv_eff_s[w]) / max(float(surv_raw_s[w]), 1e-6)
                    surv_snips[w] *= min(scale_w, 1.0)

            t_ev_c0 = time.perf_counter()
            if use_exp_fit:
                # Scale (z_p, z_s) by gamma = min(1.0, RHO_CAP / rho_net) and normalize sigmasq by ref_sq
                # so SingleTemplate._loglr() natively integrates the exact 3D network sensitive volume
                rho_net_surv = np.sqrt(eff_snr_p ** 2 + surv_eff_s ** 2)
                gamma_surv = np.minimum(1.0, RHO_CAP / np.maximum(rho_net_surv, 1e-6)).astype(
                    np.float32
                )
                ref_sq_tmpl = (
                    max(float(np.exp((2.0 / 3.0) * bm_vol)), 1e-12) if has_sv else None
                )
                lr_marg = np.empty(len(surv_idx), dtype=np.float32)
                for w in range(len(surv_idx)):
                    gm = float(gamma_surv[w])
                    ref_sq = (
                        ref_sq_tmpl
                        if ref_sq_tmpl is not None
                        else max(float(min_sq_surv[w]), 1e-12)
                    )
                    sq_p_n = float(base_sigmasq_p / ref_sq)
                    sq_s_n = float(sigmasq_s_arr[surv_idx[w]] / ref_sq)
                    lr_marg[w] = evaluate_coinc_windows(
                        model,
                        ifo_p,
                        cand["z_p_snip"] * gm,
                        sq_p_n,
                        sample_rate,
                        sec_snips_by_ifo={ifo_s: surv_snips[w : w + 1] * gm},
                        sigmasq_by_ifo={ifo_s: sq_s_n},
                    )[0]
                sig_rat_ps_surv = np.sqrt(
                    base_sigmasq_p / np.maximum(sigmasq_s_arr[surv_idx], 1e-12)
                ).astype(np.float32)
                sig_rat_sp_surv = 1.0 / np.maximum(sig_rat_ps_surv, 1e-6)
                dp_null_surv = np.maximum(
                    0.0,
                    np.maximum(
                        eff_snr_p - 2.0 * sig_rat_ps_surv * surv_eff_s,
                        surv_eff_s - 2.0 * sig_rat_sp_surv * eff_snr_p,
                    ),
                )
                amp_null_pen_surv = (
                    -0.5 * (1.0 - gamma_surv ** 2) * (dp_null_surv ** 2 / 5.0)
                )
                dl_coh = (
                    (lr_marg - 0.5 * (gamma_surv * rho_net_surv) ** 2)
                    - 4.0 * np.log(1.0 / np.maximum(gamma_surv, 1e-6))
                    + amp_null_pen_surv
                    + C_COH_OFFSET
                )
                dl_floor = (
                    sv_fac_surv
                    + (C_COH_OFFSET - 35.8)
                    - 4.0 * np.log(np.maximum(rho_net_surv, 5.0) / 5.0)
                    + amp_null_pen_surv
                )
                dl_coh = np.maximum(dl_coh, dl_floor)
                s_vals = (dl_coh - ln_noise_surv + stat_corr).astype(np.float32)
                s_vals = np.maximum(s_vals, min_stat_val)
            else:
                s_vals = evaluate_coinc_windows(
                    model,
                    ifo_p,
                    cand["z_p_snip"],
                    base_sigmasq_p,
                    sample_rate,
                    sec_snips_by_ifo={ifo_s: surv_snips},
                    sigmasq_by_ifo={ifo_s: base_sigmasq_s},
                )
            res["eval_time"] += time.perf_counter() - t_ev_c0
            res["n_snippets"] += len(surv_slides)

            # 5. Apply post-evaluation tiered decimation and threshold selection
            if use_exp_fit and loudest_keep_threshes is not None and len(loudest_keep_threshes) > 1:
                keep = np.zeros(len(surv_slides), dtype=bool)
                dec_out = np.ones(len(surv_slides), dtype=np.int32)

                # Zero-lag candidates
                fg_m = surv_coinc_slides == 0
                if zero_lag_only:
                    keep[fg_m] = True
                else:
                    keep[fg_m] = s_vals[fg_m] >= loudest_keep_threshes[-1]
                dec_out[fg_m] = 1

                # Time-slide background candidates across decimation tiers
                bg_m = surv_coinc_slides != 0
                if np.any(bg_m):
                    for kidx in range(1, len(loudest_keep_threshes)):
                        fac_k = int(loudest_keep_factors[kidx - 1])
                        in_tier = (
                            bg_m
                            & (s_vals >= loudest_keep_threshes[kidx])
                            & (s_vals < loudest_keep_threshes[kidx - 1])
                            & ((surv_coinc_slides % fac_k) == 0)
                        )
                        keep[in_tier] = True
                        dec_out[in_tier] = fac_k
            else:
                keep = (surv_coinc_slides == 0) | (s_vals >= background_stat_threshold)
                dec_out = np.ones(len(surv_slides), dtype=np.int32)

            if np.any(keep):
                k_idx = np.flatnonzero(keep)
                kept_slides = surv_slides[k_idx]
                coinc_slides = surv_coinc_slides[k_idx]
                n_k = len(k_idx)
                res["stat"].append(s_vals[k_idx])
                res["slide"].append(coinc_slides.astype(np.int32))
                res["tmpl"].append(np.full(n_k, gid, dtype=np.int32))
                res["dec"].append(dec_out[k_idx].astype(np.int32))

                for ifo in instruments:
                    if ifo == ifo_p:
                        res["time"][ifo].append(
                            np.full(n_k, t_p, dtype=np.float64)
                        )
                        res["tid"][ifo].append(
                            np.full(n_k, cand["trig_id"], dtype=np.int32)
                        )
                    elif ifo == ifo_s:
                        sub_b = surv_snips[k_idx]
                        peak_k = np.argmax(np.abs(sub_b), axis=1)
                        dt_peak = (peak_k - half_K) / float(sample_rate)
                        t_s_arr = t_p + kept_slides * slide_step_sec + dt_peak
                        # Use exact trigger end_time when matched to a recorded trigger
                        k_match = surv_match_idx[k_idx]
                        has_m_k = k_match >= 0
                        if np.any(has_m_k):
                            t_s_arr[has_m_k] = st_tab["end_time"][k_match[has_m_k]]
                        res["time"][ifo].append(t_s_arr.astype(np.float64))
                        res["tid"][ifo].append(surv_tid_s[k_idx].astype(np.int32))
                    else:
                        res["time"][ifo].append(np.full(n_k, -1.0, dtype=np.float64))
                        res["tid"][ifo].append(np.full(n_k, -1, dtype=np.int32))

            del surv_slides, surv_snips, s_vals

        res["filt_time"] += time.perf_counter() - t0_f
        del st, top_ser, norm_val, rf, td_bank, meta, acorr
    return res


