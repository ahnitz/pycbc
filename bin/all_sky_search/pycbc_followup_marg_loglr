    ):
        args.psd_segment_stride = DictWithDefaultReturn(
            float, {ifo: 8.0 for ifo in instruments}
        )

    if not getattr(args, "psd_inverse_length", None) or all(
        args.psd_inverse_length[ifo] is None for ifo in instruments
    ):
        args.psd_inverse_length = DictWithDefaultReturn(
            float, {ifo: 16.0 for ifo in instruments}
        )

    if not getattr(args, "psd_num_segments", None) or all(
        args.psd_num_segments[ifo] is None for ifo in instruments
    ):
        args.psd_num_segments = DictWithDefaultReturn(
            int, {ifo: 63 for ifo in instruments}
        )

    if not getattr(args, "autogating_threshold", None) or all(
        args.autogating_threshold[ifo] is None for ifo in instruments
    ):
        args.autogating_threshold = DictWithDefaultReturn(
            float, {ifo: 50.0 for ifo in instruments}
        )

    if not getattr(args, "autogating_cluster", None) or all(
        args.autogating_cluster[ifo] is None for ifo in instruments
    ):
        args.autogating_cluster = DictWithDefaultReturn(
            float, {ifo: 0.5 for ifo in instruments}
        )

    if not getattr(args, "autogating_width", None) or all(
        args.autogating_width[ifo] is None for ifo in instruments
    ):
        args.autogating_width = DictWithDefaultReturn(
            float, {ifo: 0.25 for ifo in instruments}
        )

    if not getattr(args, "autogating_taper", None) or all(
        args.autogating_taper[ifo] is None for ifo in instruments
    ):
        args.autogating_taper = DictWithDefaultReturn(
            float, {ifo: 0.05 for ifo in instruments}
        )

    if not getattr(args, "autogating_pad", None) or all(
        args.autogating_pad[ifo] is None for ifo in instruments
    ):
        args.autogating_pad = DictWithDefaultReturn(
            float, {ifo: 0.25 for ifo in instruments}
        )

    if not getattr(args, "gating_method", None) or all(
        args.gating_method[ifo] is None for ifo in instruments
    ):
        args.gating_method = DictWithDefaultReturn(
            str, {ifo: "paint" for ifo in instruments}
        )

    if not getattr(args, "paint_method", None) or all(
        args.paint_method[ifo] is None for ifo in instruments
    ):
        args.paint_method = DictWithDefaultReturn(
            str, {ifo: "auto" for ifo in instruments}
        )

    if not getattr(args, "paint_ridge", None) or all(
        args.paint_ridge[ifo] is None for ifo in instruments
    ):
        args.paint_ridge = DictWithDefaultReturn(
            float, {ifo: 0.001 for ifo in instruments}
        )

    if not getattr(args, "gps_start_time", None) or all(
        args.gps_start_time[ifo] is None for ifo in instruments
    ):
        if hasattr(args, "trig_start_time") and args.trig_start_time is not None:
            if hasattr(args.trig_start_time, "__getitem__"):
                t_starts = [
                    args.trig_start_time[ifo]
                    for ifo in instruments
                    if args.trig_start_time[ifo] is not None
                ]
                t_s = min(t_starts) if t_starts else None
            else:
                t_s = float(args.trig_start_time)
            if t_s is not None:
                args.gps_start_time = DictWithDefaultReturn(
                    int, {ifo: int(t_s) - 24 for ifo in instruments}
                )

    if not getattr(args, "gps_end_time", None) or all(
        args.gps_end_time[ifo] is None for ifo in instruments
    ):
        if hasattr(args, "trig_end_time") and args.trig_end_time is not None:
            if hasattr(args.trig_end_time, "__getitem__"):
                t_ends = [
                    args.trig_end_time[ifo]
                    for ifo in instruments
                    if args.trig_end_time[ifo] is not None
                ]
                t_e = max(t_ends) if t_ends else None
            else:
                t_e = float(args.trig_end_time)
            if t_e is not None:
                args.gps_end_time = DictWithDefaultReturn(
                    int, {ifo: int(t_e) + 24 for ifo in instruments}
                )

    pycbc.strain.verify_strain_options_multi_ifo(args, parser, instruments)
    pycbc.strain.StrainSegments.verify_segment_options_multi_ifo(args, parser, instruments)
    pycbc.psd.verify_psd_options_multi_ifo(args, parser, instruments)
    pycbc.scheme.verify_processing_options(args, parser)
    pycbc.fft.verify_fft_options(args, parser)
    pycbc.fft.from_cli(args)

    flow = args.low_frequency_cutoff
    if flow is None:
        with HFile(args.bank_file, "r") as bf:
            if "f_lower" in bf:
                flow = float(np.min(bf["f_lower"][:]))
            else:
                flow = 15.0
        args.low_frequency_cutoff = flow

    if args.high_frequency_cutoff is None:
        if isinstance(args.sample_rate, dict) and len(args.sample_rate) > 0:
            sr_val = float(min(args.sample_rate.values()))
        else:
            sr_val = float(args.sample_rate or 2048.0)
        args.high_frequency_cutoff = 0.9 * (sr_val / 2.0)

    t0 = time.perf_counter()
    (
        primaries,
        segs_by_ifo,
        inferred_non_thresh,
        sec_trigs_by_ifo_gid,
        valid_segs_by_ifo,
        kw_dict,
    ) = load_primary_triggers(
        args.trigger_files,
        args.bank_file,
        instruments,
        primary_snr_threshold=args.primary_snr_threshold,
        primary_newsnr_threshold=args.primary_newsnr_threshold,
        primary_max_rchisq=args.primary_max_rchisq,
        min_secondary_snr=args.min_secondary_snr,
        use_newsnr=not args.raw_snr_only,
        veto_files=args.veto_files,
        segment_name=args.segment_name,
        template_fraction_range=args.template_fraction_range,
        sngl_ranking=args.sngl_ranking,
        statistic_keywords=args.statistic_keywords,
        trig_start_time=args.trig_start_time,
        trig_end_time=args.trig_end_time,
        return_secondary_info=True,
    )

    if args.asym_num_bins is None:
        if inferred_non_thresh is not None and args.timeslide_interval and args.timeslide_interval > 0:
            args.asym_num_bins = int(
                round(inferred_non_thresh / args.timeslide_interval)
            )
        else:
            args.asym_num_bins = 2500

    n_prim_total = sum(len(v) for v in primaries.values())
    logging.info(
        "Loaded %d primary triggers (%s) in %.2f s",
        n_prim_total,
        ", ".join(f"{ifo}:{len(primaries[ifo])}" for ifo in instruments),
        time.perf_counter() - t0,
    )

    with pycbc.scheme.from_cli(args):
        t_strain0 = time.perf_counter()
        if n_prim_total == 0:
            segments, gwstrain_start_time, sample_rate, flen, delta_f = (
                {ifo: [] for ifo in instruments},
                {},
                None,
                None,
                None,
            )
        else:
            segments, gwstrain_start_time, sample_rate, flen, delta_f = (
                setup_strain_and_segments(
                    args, instruments, args.low_frequency_cutoff, segs_by_ifo=segs_by_ifo
                )
            )
        logging.info("Strain & segment setup completed in %.2f s", time.perf_counter() - t_strain0)

        if flen is None or any(len(segments[ifo]) == 0 for ifo in instruments) or n_prim_total == 0:
            logging.warning(
                "No coincident segments or primary triggers to evaluate for %s. Writing empty coinc file %s.",
                instruments,
                args.output_file,
            )
            write_coinc_hdf(
                args.output_file,
                [],
                [],
                [],
                [],
                {ifo: [] for ifo in instruments},
                {ifo: [] for ifo in instruments},
                segs_by_ifo,
                instruments,
                pivot_ifo=args.pivot_ifo,
                fixed_ifo=args.fixed_ifo,
                timeslide_interval=args.timeslide_interval,
                asym_num_bins=args.asym_num_bins,
                cluster_window=args.cluster_window,
                t_start=t_start,
            )
            return

        t_init0 = time.perf_counter()
        bank = RatioFilterBank(
            args.bank_file,
            filter_length=flen,
            delta_f=delta_f,
            dtype=np.complex64,
            enable_compressed_waveforms=args.enable_compressed_waveforms,
        )

        max_light_time = 0.010
        if len(instruments) >= 2:
            dets = {ifo: Detector(ifo) for ifo in instruments}
            max_light_time = max(
                dets[i1].light_travel_time_to_detector(dets[i2])
                for i1, i2 in combinations(instruments, 2)
            )
        half_P = int(args.peak_half_samples)
        half_K = int(np.ceil((max_light_time + args.coinc_threshold) * sample_rate)) + half_P

        use_norm_dist = rank_method is not None
        model = build_single_template_evaluator(
            instruments,
            sample_rate=sample_rate,
            half_P=half_P,
            half_K=half_K,
            vsamples=args.n_mc,
            d_min=0.001 if use_norm_dist else 1.0,
            d_max=10.0 if use_norm_dist else 10000.0,
        )
        logging.info(
            "Initialized bank (num_levels=%d, %d templates) and SingleTemplate evaluator in %.2f s",
            bank.num_levels,
            len(bank.table),
            time.perf_counter() - t_init0,
        )

        res = evaluate_segment_primaries(
            primaries=primaries,
            segments=segments,
            gwstrain_start_time=gwstrain_start_time,
            sample_rate=sample_rate,
            delta_f=delta_f,
            bank=bank,
            instruments=instruments,
            model=model,
            half_P=half_P,
            half_K=half_K,
            timeslide_interval=args.timeslide_interval,
            asym_num_bins=args.asym_num_bins,
            zero_lag_only=args.zero_lag_only,
            background_stat_threshold=args.background_stat_threshold,
            pivot_ifo=args.pivot_ifo,
            high_frequency_cutoff=args.high_frequency_cutoff,
            disable_dynamic_snr_renorm=args.disable_dynamic_snr_renorm,
            dynamic_snr_window=args.dynamic_snr_window,
            dynamic_snr_hollow=args.dynamic_snr_hollow,
            dynamic_snr_variance_floor=args.dynamic_snr_variance_floor,
            dynamic_snr_max_boost=args.dynamic_snr_max_boost,
            primary_snr_threshold=args.primary_snr_threshold,
            primary_max_rchisq=args.primary_max_rchisq,
            min_secondary_snr=args.min_secondary_snr,
            sec_trigs_by_ifo_gid=sec_trigs_by_ifo_gid,
            valid_segs_by_ifo=valid_segs_by_ifo,
            rank_method=rank_method,
            coinc_threshold=args.coinc_threshold,
            loudest_keep_threshes=loudest_keep_threshes,
            loudest_keep_factors=loudest_keep_factors,
            statistic_keywords_dict=kw_dict,
            include_singles=args.include_singles,
        )

        logging.info(
            "Snippet reconstruction: %.2f s | Snippet marginal logLR (%d evaluations): %.2f s",
            res["filt_time"],
            res["n_snippets"],
            res["eval_time"],
        )

        write_coinc_hdf(
            args.output_file,
            res["stat"],
            res["slide"],
            res["tmpl"],
            res["dec"],
            res["time"],
            res["tid"],
            segs_by_ifo,
            instruments,
            pivot_ifo=args.pivot_ifo,
            fixed_ifo=args.fixed_ifo,
            timeslide_interval=args.timeslide_interval,
            asym_num_bins=args.asym_num_bins,
            cluster_window=args.cluster_window,
            t_start=t_start,
        )


if __name__ == "__main__":
    main()
