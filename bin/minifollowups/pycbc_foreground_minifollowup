"""Followup foreground events"""

import argparse
import logging
import os
import re

import numpy
import pycbc.workflow as wf
import pycbc.workflow.minifollowups as mini
from pycbc import add_common_pycbc_options, init_logging
from pycbc.events import coinc, select_segments_by_definer
from pycbc.io import HFile, get_all_subkeys
from pycbc.results import layout
from pycbc.types import MultiDetOptionAction
from pycbc.workflow.core import resolve_url_to_file

parser = argparse.ArgumentParser(description=__doc__[1:])
add_common_pycbc_options(parser)
parser.add_argument("--bank-file", help="HDF format template bank file")
parser.add_argument(
    "--statmap-file", help="HDF format clustered coincident trigger result file"
)
parser.add_argument(
    "--single-detector-triggers",
    nargs="+",
    action=MultiDetOptionAction,
    help="HDF format merged single detector trigger files",
)
parser.add_argument(
    "--inspiral-segments",
    help="xml segment files containing the inspiral analysis times",
)
parser.add_argument(
    "--inspiral-data-read-name",
    help="Name of inspiral segmentlist containing data read in by each analysis job.",
)
parser.add_argument(
    "--inspiral-data-analyzed-name",
    help="Name of inspiral segmentlist containing data analyzed by each analysis job.",
)
parser.add_argument(
    "--analysis-category",
    type=str,
    required=False,
    default="background_exc",
    choices=["foreground", "background", "background_exc"],
    help="Designates whether to look at foreground triggers "
    'background triggers (including "little dogs") '
    'or background triggers (with "little dogs" removed)',
)
parser.add_argument(
    "--sort-variable",
    default="stat",
    help="Which subgroup of --analysis-category to use for sorting. Default=stat",
)
parser.add_argument(
    "--sort-order",
    default="descending",
    choices=["ascending", "descending"],
    help="Which direction to use when sorting on --sort-variable. Default=descending",
)
parser.add_argument(
    "--num-events",
    type=int,
    default=None,
    help="Number of events to follow up (overrides [workflow-minifollowups] num-events)",
)
parser.add_argument(
    "--ifar-threshold",
    type=float,
    default=None,
    help="IFAR threshold (years) to continue following up events down to",
)
parser.add_argument(
    "--far-threshold",
    type=float,
    default=None,
    help="FAR threshold (yr^-1) to continue following up events down to",
)
parser.add_argument(
    "--min-events",
    type=int,
    default=None,
    help="Minimum number of events to follow up when using --ifar-threshold",
)
parser.add_argument(
    "--max-events",
    type=int,
    default=None,
    help="Maximum number of events to follow up when using --ifar-threshold",
)

wf.add_workflow_command_line_group(parser)
wf.add_workflow_settings_cli(parser, include_subdax_opts=True)
args = parser.parse_args()

# Default logging level is info: --verbose adds to this
init_logging(args.verbose, default_level=1)

workflow = wf.Workflow(args)

wf.makedir(args.output_dir)

# create a FileList that will contain all output files
layouts = []

tmpltbank_file = resolve_url_to_file(os.path.abspath(args.bank_file))
coinc_file = resolve_url_to_file(os.path.abspath(args.statmap_file))
insp_segs = resolve_url_to_file(os.path.abspath(args.inspiral_segments))

single_triggers = []
single_triggers_by_ifo = {}
fsdt = {}
insp_data_seglists = {}
insp_analysed_seglists = {}
for ifo in args.single_detector_triggers:
    fname = args.single_detector_triggers[ifo]
    shared_ifos = [
        det for det, path in args.single_detector_triggers.items() if path == fname
    ]
    strig_file = resolve_url_to_file(
        os.path.abspath(fname), attrs={"ifos": shared_ifos}
    )
    if strig_file not in single_triggers:
        single_triggers.append(strig_file)
    single_triggers_by_ifo[ifo] = strig_file
    fsdt[ifo] = HFile(args.single_detector_triggers[ifo], "r")
    insp_data_seglists[ifo] = select_segments_by_definer(
        args.inspiral_segments, segment_name=args.inspiral_data_read_name, ifo=ifo
    )
    insp_analysed_seglists[ifo] = select_segments_by_definer(
        args.inspiral_segments, segment_name=args.inspiral_data_analyzed_name, ifo=ifo
    )
    # NOTE: make_singles_timefreq needs a coalesced set of segments. If this is
    #       being used to determine command-line options for other codes,
    #       please think if that code requires coalesced, or not, segments.
    insp_data_seglists[ifo].coalesce()
    insp_analysed_seglists[ifo].coalesce()

tags = args.tags or []
if args.num_events is not None:
    num_events = args.num_events
elif workflow.cp.has_option_tags("workflow-minifollowups", "num-events", tags):
    num_events = int(
        workflow.cp.get_opt_tags("workflow-minifollowups", "num-events", tags)
    )
else:
    num_events = 10

# Support continuing until a FAR / IFAR threshold with min/max bounds
ifar_threshold = args.ifar_threshold
if ifar_threshold is None and args.far_threshold is not None and args.far_threshold > 0:
    ifar_threshold = 1.0 / args.far_threshold
if ifar_threshold is None and workflow.cp.has_option_tags(
    "workflow-minifollowups", "ifar-threshold", tags
):
    ifar_threshold = float(
        workflow.cp.get_opt_tags("workflow-minifollowups", "ifar-threshold", tags)
    )
elif ifar_threshold is None and workflow.cp.has_option_tags(
    "workflow-minifollowups", "far-threshold", tags
):
    far_val = float(
        workflow.cp.get_opt_tags("workflow-minifollowups", "far-threshold", tags)
    )
    if far_val > 0:
        ifar_threshold = 1.0 / far_val

if args.min_events is not None:
    min_events = args.min_events
elif workflow.cp.has_option_tags("workflow-minifollowups", "min-events", tags):
    min_events = int(
        workflow.cp.get_opt_tags("workflow-minifollowups", "min-events", tags)
    )
else:
    min_events = num_events if ifar_threshold is None else 5

if args.max_events is not None:
    max_events = args.max_events
elif workflow.cp.has_option_tags("workflow-minifollowups", "max-events", tags):
    max_events = int(
        workflow.cp.get_opt_tags("workflow-minifollowups", "max-events", tags)
    )
else:
    max_events = max(num_events, 50)
f = HFile(args.statmap_file, "r")
file_val = args.analysis_category
stat = f[f"{file_val}/stat"][:]

if args.sort_variable not in f[file_val]:
    all_datasets = [
        re.sub(file_val, "", ds).strip("/") for ds in get_all_subkeys(f, file_val)
    ]
    raise KeyError(
        f"Sort variable {args.sort_variable} not in {file_val}: sort"
        f"choices in {file_val} are " + ", ".join(all_datasets)
    )

# In case we are doing background minifollowup with repeated events,
# we must include the ordering / template / trigger / time info for
# _many_ more events to make sure we get enough
events_to_read = max(num_events, max_events) * 100

# We've asked for more events than there are!
num_events = min(num_events, len(stat))
events_to_read = min(events_to_read, len(stat))

# Get the indices of the events we are considering in the order specified
f_cat = f[file_val]
primary_sort = f_cat[args.sort_variable][:]
if args.sort_variable == "stat":
    tie_breaker = (
        f_cat["ifar_exc"][:]
        if "ifar_exc" in f_cat
        else (f_cat["ifar"][:] if "ifar" in f_cat else primary_sort)
    )
else:
    tie_breaker = stat
sorting = numpy.lexsort((tie_breaker, primary_sort))
if args.sort_order == "descending":
    sorting = sorting[::-1]
event_idx = sorting[0:events_to_read]
stat = stat[event_idx]

# Save the time / trigger / template ids for the events
times = {}
tids = {}
ifo_list = f.attrs["ifos"].split(" ")
for ifo in ifo_list:
    times[ifo] = f_cat[ifo]["time"][:][event_idx]
    tids[ifo] = f_cat[ifo]["trigger_id"][:][event_idx]
bank_ids = f_cat["template_id"][:][event_idx]
ifars = None
if "ifar_exc" in f_cat:
    ifars = f_cat["ifar_exc"][:][event_idx]
elif "ifar" in f_cat:
    ifars = f_cat["ifar"][:][event_idx]
f.close()

bank_data = HFile(args.bank_file, "r")

# loop over number of loudest events to be followed up
event_times = {}
skipped_data = []
event_count = 0
curr_idx = -1
while curr_idx < (events_to_read - 1):
    curr_idx += 1
    # Check stopping conditions
    if event_count >= min_events:
        if ifar_threshold is not None and ifars is not None:
            if numpy.all(ifars[curr_idx:] < ifar_threshold):
                break
        elif event_count >= num_events:
            break
    if event_count >= max_events:
        break
    files = wf.FileList([])
    duplicate = False

    # Times and trig ids for trigger timeseries plot
    ifo_times_strings = []
    ifo_tids_strings = []

    # Mean time to use as reference for zerolag
    mtime = coinc.mean_if_greater_than_zero([times[ifo][curr_idx] for ifo in times])[0]

    for ifo in times:
        plottime = times[ifo][curr_idx]
        if plottime == -1:  # Ifo is not in coinc
            # Use mean time instead and don't plot special trigger
            plottime = mtime
        else:  # Do plot special trigger
            ifo_tids_strings += ["%s:%d" % (ifo, int(tids[ifo][curr_idx]))]
        ifo_times_strings += ["%s:%s" % (ifo, plottime)]

        # For background do not want to follow up 10 background coincs with the
        # same event in ifo 1 and different events in ifo 2, so record times
        if ifo not in event_times:
            event_times[ifo] = []
        # Only do this for background coincident triggers & not sentinel time -1
        if (
            "background" in args.analysis_category
            and times[ifo][curr_idx] != -1
            and int(times[ifo][curr_idx]) in event_times[ifo]
        ):
            skipped_data.append((ifo, int(times[ifo][curr_idx])))
            duplicate = True
            break

    if duplicate:
        continue
    for ifo in times:
        event_times[ifo].append(int(times[ifo][curr_idx]))

    ifo_times = " ".join(ifo_times_strings)
    ifo_tids = " ".join(ifo_tids_strings)

    event_count += 1
    if skipped_data:
        layouts += (
            mini.make_skipped_html(
                workflow, skipped_data, args.output_dir, tags=[f"SKIP_{event_count}"]
            ),
        )
        skipped_data = []

    bank_id = int(bank_ids[curr_idx])

    cinfo = mini.make_coinc_info(
        workflow,
        single_triggers,
        tmpltbank_file,
        coinc_file,
        args.output_dir,
        n_loudest=curr_idx,
        sort_order=args.sort_order,
        sort_var=args.sort_variable,
        tags=args.tags + [str(event_count)],
    )
    files += mini.make_trigger_timeseries(
        workflow,
        single_triggers,
        ifo_times,
        args.output_dir,
        special_tids=ifo_tids,
        tags=args.tags + [str(event_count)],
    )

    params = mini.get_single_template_params(
        curr_idx, times, bank_data, bank_ids[curr_idx], fsdt, tids
    )

    _, sngl_tmplt_plots = mini.make_single_template_plots(
        workflow,
        insp_segs,
        args.inspiral_data_read_name,
        args.inspiral_data_analyzed_name,
        params,
        args.output_dir,
        data_segments=insp_data_seglists,
        tags=args.tags + [str(event_count)],
    )
    files += sngl_tmplt_plots

    for ifo in times:
        single = single_triggers_by_ifo[ifo]
        time = times[ifo][curr_idx]
        if time == -1:
            # If this detector did not trigger, still make the plot, but use
            # the average time of detectors which did trigger
            time = coinc.mean_if_greater_than_zero([times[k][curr_idx] for k in times])[
                0
            ]
        for seg in insp_analysed_seglists[ifo]:
            if time in seg:
                files += mini.make_singles_timefreq(
                    workflow,
                    single,
                    tmpltbank_file,
                    time,
                    args.output_dir,
                    data_segments=insp_data_seglists[ifo],
                    tags=args.tags + [str(event_count)],
                    ifo=ifo,
                )
                files += mini.make_qscan_plot(
                    workflow,
                    ifo,
                    time,
                    args.output_dir,
                    data_segments=insp_data_seglists[ifo],
                    tags=args.tags + [str(event_count)],
                )
                break
        else:
            logging.info(
                f"Trigger time {time} is not valid in {ifo}, skipping singles plots"
            )

    event_layouts = [tuple(cinfo)] + list(layout.grouper(files, 2))
    layouts += event_layouts
    ifar_val = ifars[curr_idx] if (ifars is not None and curr_idx < len(ifars)) else 0.0
    stat_val = stat[curr_idx]
    layout.two_column_layout(
        args.output_dir,
        event_layouts,
        unique=f"_{event_count:03d}",
        collapse="true",
        title=f"Event #{event_count} | Stat={stat_val:.2f} | IFAR_exc={ifar_val:.3g} yr | GPS={mtime:.2f}",
    )

workflow.save()
if event_count == 0:
    layout.two_column_layout(args.output_dir, layouts)
